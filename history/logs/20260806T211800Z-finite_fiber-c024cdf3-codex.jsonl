{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'cand=../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF19-extracted/aristotle-finite_fiber-v3h3ap9z_aristotle/FiniteFiber/QuasilocalStateGNSInterface.lean; wc -l \"$cand\"; sed -n '\"'401,860p' \\\"\"'$cand\"; printf '\"'%s\\\\n' '--- import registration ---'; sed -n '1,240p' FiniteFiber.lean; printf '%s\\\\n' '--- current modules required by candidate ---'; for f in FiniteFiber/FullPauliDirectedLocalSystem.lean FiniteFiber/FiniteRegionPhasedPauliMatrices.lean FiniteFiber/FiniteRegionEmbeddingCoherence.lean; do test -e \\\"\"'$f\" && echo \"present $f\" || echo \"MISSING $f\"; done; printf '\"'%s\\\\n' '--- remote summary ---'; sed -n '1,220p' ../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF19-extracted/aristotle-finite_fiber-v3h3ap9z_aristotle/ARISTOTLE_SUMMARY.md\"","aggregated_output":"511 ../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF19-extracted/aristotle-finite_fiber-v3h3ap9z_aristotle/FiniteFiber/QuasilocalStateGNSInterface.lean\n\n/-- **Coherence of the local representations** along the directed system. -/\ntheorem localRepresentation_localInclusion (F F' : Finset Site) (hFF' : F ⊆ F')\n    (x : finiteRegionQubitAlgebra F) :\n    W.localRepresentation F' (localInclusion hFF' x) = W.localRepresentation F x := by\n  rw [localRepresentation_apply, localRepresentation_apply, Q.embed_localInclusion]\n\n/-- The finite-stage matrix coefficient of the local representation. -/\ntheorem inner_gnsVector_localRepresentation (F : Finset Site)\n    (x : finiteRegionQubitAlgebra F) :\n    ⟪W.gnsVector, W.localRepresentation F x W.gnsVector⟫_ℂ = S.localState F x :=\n  W.inner_gnsVector_gnsRepresentation_embed F x\n\n/--\n**Stabilizer invariance of the GNS vector.**  Every local stabilizer fixes\n`|Ω⟩` in the GNS representation.\n-/\ntheorem gnsRepresentation_fullPauliRegionMatrix_gnsVector (F : Finset Site)\n    (g : ↥(S.regionStabilizer F).group) :\n    W.localRepresentation F (fullPauliRegionMatrix F (g : FullPauliWord Site))\n        W.gnsVector = W.gnsVector :=\n  gnsStarAlgHom_apply_gnsCyclicVector_eq_of_deviation_eq_zero W.state _\n    (W.state_deviation_eq_zero F g)\n\nend QuasilocalStabilizerState\n\n/-! ### Positivity of the finite local states -/\n\nsection Positivity\n\nopen scoped MatrixOrder\n\n/-- The trace pairing of two positive semidefinite matrices is nonnegative. -/\ntheorem posSemidef_trace_mul_nonneg {n : Type*} [Fintype n] [DecidableEq n]\n    {M N : Matrix n n ℂ} (hM : M.PosSemidef) (hN : N.PosSemidef) :\n    0 ≤ (M * N).trace := by\n  have hs : CFC.sqrt M * CFC.sqrt M = M := CFC.sqrt_mul_sqrt_self M (ha := hM.nonneg)\n  have hsq : (CFC.sqrt M).PosSemidef := Matrix.nonneg_iff_posSemidef.mp (CFC.sqrt_nonneg M)\n  have h : ((CFC.sqrt M).conjTranspose * N * CFC.sqrt M).PosSemidef :=\n    hN.conjTranspose_mul_mul_same _\n  have h2 := h.trace_nonneg\n  rw [hsq.isHermitian.eq] at h2\n  calc (0 : ℂ) ≤ (CFC.sqrt M * N * CFC.sqrt M).trace := h2\n    _ = (M * N).trace := by rw [Matrix.trace_mul_comm, ← mul_assoc, hs]\n\n/--\n**The finite local stabilizer state is a positive linear functional** on the\nfinite local matrix algebra, in the Loewner order.  This is the finite-stage\npositivity behind the manuscript's approximation argument.\n-/\nnoncomputable def FullPauliStabilizerSystem.localPositiveState\n    (S : FullPauliStabilizerSystem Site) (F : Finset Site) :\n    finiteRegionQubitAlgebra F →ₚ[ℂ] ℂ where\n  __ := S.localState F\n  monotone' := by\n    intro x y hxy\n    have hpos : (y - x).PosSemidef := Matrix.le_iff.mp hxy\n    have h := posSemidef_trace_mul_nonneg (S.regionDensity_posSemidef F) hpos\n    rw [mul_sub, Matrix.trace_sub] at h\n    change S.localState F x ≤ S.localState F y\n    rw [S.localState_apply, S.localState_apply]\n    exact sub_nonneg.mp h\n\n@[simp] theorem FullPauliStabilizerSystem.localPositiveState_apply\n    (S : FullPauliStabilizerSystem Site) (F : Finset Site)\n    (x : finiteRegionQubitAlgebra F) :\n    S.localPositiveState F x = S.localState F x := rfl\n\nend Positivity\n\n/-! ### Non-vacuity of the completion interface -/\n\n/--\n**The interface is non-vacuous.**  Over the empty site type every finite region\nis empty, and the finite local algebra of the empty region is itself a C-star\nalgebra satisfying all four conditions of `QuasilocalEmbedding`.\n-/\nnoncomputable def emptySiteQuasilocalEmbedding :\n    QuasilocalEmbedding Empty (finiteRegionQubitAlgebra (∅ : Finset Empty)) where\n  embed F := finiteRegionEmbed F ∅ (by\n    intro x _\n    exact (IsEmpty.false x).elim)\n  embed_injective F := finiteRegionEmbed_injective F ∅ _\n  embed_localInclusion F F' h x := by\n    have hF : F ⊆ (∅ : Finset Empty) := fun x _ => (IsEmpty.false x).elim\n    have hF' : F' ⊆ (∅ : Finset Empty) := fun x _ => (IsEmpty.false x).elim\n    exact finiteRegionEmbed_trans F F' ∅ h hF' x\n  dense_localAlgebra := by\n    intro x\n    refine subset_closure (Set.mem_iUnion.mpr ⟨∅, x, ?_⟩)\n    exact finiteRegionEmbed_self ∅ x\n\nsection EmptySiteState\n\nopen scoped MatrixOrder\n\n/--\n**The state interface is non-vacuous too.**  Over the empty site type the\nfinite local state of the empty region is a global state for the witness\ncompletion, so `QuasilocalStabilizerState` is inhabited for every consistent\nstabilizer system on `Empty`.\n-/\nnoncomputable def emptySiteQuasilocalStabilizerState\n    (S : FullPauliStabilizerSystem Empty) :\n    QuasilocalStabilizerState S emptySiteQuasilocalEmbedding where\n  state := S.localPositiveState ∅\n  state_embed F x := S.localState_localInclusion F ∅ (fun y _ => (IsEmpty.false y).elim) x\n\nend EmptySiteState\n\nend FiniteFiber\n--- import registration ---\nimport FiniteFiber.Basic\nimport FiniteFiber.TracialCorner\nimport FiniteFiber.FiniteFibers\nimport FiniteFiber.StrongSupport\nimport FiniteFiber.VectorCorner\nimport FiniteFiber.GNSVector\nimport FiniteFiber.GNSOrbit\nimport FiniteFiber.FiniteStabilizer\nimport FiniteFiber.FiniteStabilizerTrace\nimport FiniteFiber.StabilizerSequence\nimport FiniteFiber.StabilizerFiniteFiber\nimport FiniteFiber.FinitePauli\nimport FiniteFiber.FiniteQubitMatrix\nimport FiniteFiber.FiniteDensity\nimport FiniteFiber.FinitePauliStabilizer\nimport FiniteFiber.FinitePauliGNS\nimport FiniteFiber.FiniteLocalPauli\nimport FiniteFiber.FiniteNestedPauli\nimport FiniteFiber.FiniteLocalGroupSupport\nimport FiniteFiber.ProjectivePauliLattice\nimport FiniteFiber.FullPauliLattice\nimport FiniteFiber.OneSitePauliNormalForm\nimport FiniteFiber.FiniteTensorMatrixChain\nimport FiniteFiber.FiniteRegionQubitAlgebra\nimport FiniteFiber.FiniteRegionPauliMatrices\nimport FiniteFiber.FiniteRegionEmbeddingCoherence\nimport FiniteFiber.FiniteRegionPhasedPauliMatrices\nimport FiniteFiber.FiniteRegionFullPauliMultiplication\nimport FiniteFiber.FiniteNestedTensorState\nimport FiniteFiber.FiniteStabilizerStateChain\nimport FiniteFiber.SequentialLocalFunctional\nimport FiniteFiber.CountablePauliRepresentation\n--- current modules required by candidate ---\npresent FiniteFiber/FullPauliDirectedLocalSystem.lean\npresent FiniteFiber/FiniteRegionPhasedPauliMatrices.lean\npresent FiniteFiber/FiniteRegionEmbeddingCoherence.lean\n--- remote summary ---\n# Summary of changes for run c024cdf3-1bf8-439f-85f3-825e012a8af4\n**FF19 delivered: `FiniteFiber/QuasilocalStateGNSInterface.lean` (new file, the only file added; no other file was modified).**\n\n`lake build FiniteFiber.QuasilocalStateGNSInterface` succeeds with no errors and no warnings; `lake build` (all default targets) and the existing axiom-audit test still pass. The file contains no `sorry`/`admit`/`axiom`/`opaque`/`unsafe`/`implemented_by`, and every result in it depends only on `propext`, `Classical.choice`, `Quot.sound`.\n\n**The conditional inputs, enumerated exactly.** There are exactly two, both bundled as explicit Lean structures and both listed in the module docstring:\n\n1. `QuasilocalEmbedding Site A` — the C*-completion input: (i) a unital star embedding `𝒜_F →⋆ₐ[ℂ] A` of each finite region algebra into a C*-algebra `A`; (ii) injectivity of each embedding; (iii) compatibility with the FF18 identity-padding inclusions `localInclusion`; (iv) norm density of the union of the images.\n2. `QuasilocalStabilizerState S Q` — the global state input: (v) a positive linear functional `ω : A →ₚ[ℂ] ℂ`; (vi) `ω(embed F x) = S.localState F x` for every finite region.\n\nNothing else is assumed. In particular the following are **derived**, not postulated: the continuity/norm bound of the embeddings (`norm_embed`: each embedding is isometric, from injectivity), continuity of `ω` (positive functionals on a C*-algebra are bounded), the normalization `ω(1) = 1` (from the empty region), and uniqueness of the extension.\n\n**Proved in the packet.**\n- Algebraic direct-limit facts: region-independence of the image of a full-Pauli word; monotonicity of the images; directedness (`exists_localSet_common_region`); the local star subalgebra `localStarAlgebra Γ` of every subregion `Γ`, monotone in `Γ`, with density and `topologicalClosure = ⊤` for `Γ = univ`.\n- Finite-stage evaluation: `ω(embed F x) = Tr(ρ_F x)`, region-independence of the value on a word, and expectation one for every local stabilizer.\n- Uniqueness of the quasilocal stabilizer state (the manuscript's B.L.T. step).\n- Finite-stage positivity: the finite local state is a positive linear functional in the Loewner order, via a general checked lemma that the trace pairing of two positive semidefinite matrices is nonnegative.\n- GNS connection through the existing generic bridge in `FiniteFiber/GNSVector.lean`: the cyclic unit vector `Ω`, the reconstruction formula `⟪Ω, π(a)Ω⟫ = ω(a)` and its finite-stage form `⟪Ω, π(embed F x)Ω⟫ = Tr(ρ_F x)`, cyclicity, the local representations `π ∘ embed F` with coherence along the directed system, and invariance `π(embed F g)Ω = Ω` under every local stabilizer.\n- Non-vacuity of both interfaces (`emptySiteQuasilocalEmbedding`, `emptySiteQuasilocalStabilizerState`), so neither bundle of hypotheses is contradictory.\n\n**Not claimed.** No construction of the completion or of the global state for an infinite lattice, no product/tensor factorization of the GNS representation, no normality statement, no von Neumann algebra generated by the local algebras, and no type classification. Those remain the open items, with the two input bundles above the exact interface at which they enter.\n\nAll work is committed and pushed.","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"The returned snapshot contains one new candidate module plus unrelated remote metadata/manuscript copies, all of which remain quarantined. The candidate’s stated route is coherent with FF18: it keeps the completion and extension as explicit structures, then derives local evaluations and GNS consequences. I’m now promoting only that module through the patch mechanism and will test it exclusively in the live built project."}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed 's/\"'^/+/'\"' ../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF19-extracted/aristotle-finite_fiber-v3h3ap9z_aristotle/FiniteFiber/QuasilocalStateGNSInterface.lean\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed 's/\"'^/+/'\"' ../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF19-extracted/aristotle-finite_fiber-v3h3ap9z_aristotle/FiniteFiber/QuasilocalStateGNSInterface.lean\"","aggregated_output":"+import FiniteFiber.FullPauliDirectedLocalSystem\n+import FiniteFiber.GNSVector\n+import Mathlib.Analysis.CStarAlgebra.Hom\n+import Mathlib.Analysis.CStarAlgebra.PositiveLinearMap\n+\n+/-!\n+# The quasilocal state and GNS interface for the actual local system\n+\n+The directed system of `FiniteFiber.FullPauliDirectedLocalSystem` supplies, for\n+every finite region `F : Finset Site`, the finite local matrix algebra\n+`finiteRegionQubitAlgebra F`, the identity-padding inclusions `localInclusion`,\n+and — for a consistent stabilizer system `S` — the compatible finite local\n+states `S.localState F`.  This file adds the *smallest explicit interface*\n+which turns that purely finite/algebraic data into the manuscript's quasilocal\n+C-star algebra `𝒜 = closure (⋃_F 𝒜_F)`, its stabilizer state `ω`, and the GNS\n+data attached to `ω` by Mathlib.\n+\n+## The conditional inputs, enumerated exactly\n+\n+Exactly two bundles of data are assumed; nothing else in this file is\n+conditional.\n+\n+`QuasilocalEmbedding Site A` (the C-star completion input), with fields\n+\n+1. `embed`  : for each finite region a unital star-algebra map\n+   `𝒜_F →⋆ₐ[ℂ] A` into a C-star algebra `A`;\n+2. `embed_injective` : each `embed F` is injective (the local algebras are\n+   faithfully represented in `A`);\n+3. `embed_localInclusion` : `embed F' ∘ localInclusion h = embed F` for\n+   `F ⊆ F'` — the manuscript's identification `𝒜_F ≃ 𝒜_F ⊗ id_{F' \\ F}`;\n+4. `dense_localAlgebra` : the union of the images is norm dense in `A`, i.e.\n+   `A` really is the norm completion of `𝒜_loc`.\n+\n+`QuasilocalStabilizerState S Q` (the global state input), with fields\n+\n+5. `state` : a positive linear functional `ω : A →ₚ[ℂ] ℂ`;\n+6. `state_embed` : `ω (embed F x) = S.localState F x` for every finite region\n+   `F` — `ω` extends the compatible finite stabilizer functionals.\n+\n+Everything else is *derived* here.  In particular the following are **not**\n+assumed:\n+\n+* the continuity bound of the embeddings: `‖embed F x‖ = ‖x‖` is proved from\n+  injectivity (`norm_embed`), so `embed F` is an isometry;\n+* the continuity of `ω`: positive linear functionals on a C-star algebra are\n+  automatically bounded in Mathlib, so `continuous_state` is proved;\n+* normalization `ω 1 = 1`, which is derived from field 6 at `F = ∅`;\n+* uniqueness of the extension (`state_eq`, the B.L.T. uniqueness step of\n+  Proposition `prop:define_state`), derived from continuity and density.\n+\n+## What is proved\n+\n+* Algebraic direct-limit facts: the images of the finite local algebras are\n+  directed (`exists_localSet_common_region`), and for every subregion\n+  `Γ : Set Site` the local elements supported in `Γ` form a star subalgebra\n+  `Q.localStarAlgebra Γ` of `A` (`𝒜_{Γ,loc}`), monotone in `Γ` and dense for\n+  `Γ = univ`.\n+* Finite-stage evaluation: `state_embed_fullPauliRegionMatrix` (every local\n+  stabilizer has expectation one), region-independence of the value on a word\n+  (`state_embed_eq_of_supportedIn`), and normalization.\n+* The GNS connection through the generic bridge of `FiniteFiber.GNSVector`:\n+  the cyclic unit vector `Ω`, the reconstruction formula\n+  `⟪Ω, π(embed F x) Ω⟫ = S.localState F x`, cyclicity, the local\n+  representations `π ∘ embed F` and their coherence along the directed system,\n+  and the invariance `π(embed F g) Ω = Ω` of the GNS vector under every local\n+  stabilizer.\n+* Finite-stage positivity: the finite local state `ω_F(x) = Tr(ρ_F x)` is a\n+  positive linear functional for the Loewner order\n+  (`FullPauliStabilizerSystem.localPositiveState`).\n+* Non-vacuity of both interfaces: `emptySiteQuasilocalEmbedding` and\n+  `emptySiteQuasilocalStabilizerState`.\n+\n+## What is *not* claimed\n+\n+No product/tensor factorization of the GNS representation, no normality\n+statement, no von Neumann algebra generated by the local algebras, no type\n+classification, and no construction of `A` or of `ω` for an infinite lattice:\n+those remain the explicit inputs listed above.\n+-/\n+\n+namespace FiniteFiber\n+\n+open scoped BigOperators ComplexOrder InnerProductSpace\n+open scoped FiniteFiber.FiniteRegionQubitMatrix\n+\n+variable {Site : Type*} [DecidableEq Site]\n+\n+/-! ### Finite-stage facts about involutive supported words -/\n+\n+/-- `pauliSign` is a real sign, hence star-invariant. -/\n+@[simp] theorem star_pauliSign (b : Bool) : star (pauliSign b) = pauliSign b := by\n+  cases b <;> simp [pauliSign]\n+\n+/-- The finite-region matrix of an involutive word supported in `F` is self-adjoint. -/\n+theorem fullPauliRegionMatrix_isSelfAdjoint (F : Finset Site) (a : FullPauliWord Site)\n+    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :\n+    IsSelfAdjoint (fullPauliRegionMatrix F a) := by\n+  rw [fullPauliRegionMatrix_eq_pauliSign_smul F a ha hinv]\n+  show star _ = _\n+  rw [star_smul, star_pauliSign,\n+    (finiteRegionPauliMatrix_isSelfAdjoint F (regionPauliLabels F a))]\n+\n+/-- The finite-region matrix of an involutive word supported in `F` squares to `1`. -/\n+theorem fullPauliRegionMatrix_mul_self (F : Finset Site) (a : FullPauliWord Site)\n+    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :\n+    fullPauliRegionMatrix F a * fullPauliRegionMatrix F a = 1 := by\n+  rw [← fullPauliRegionMatrix_mul F a a ha, hinv, fullPauliRegionMatrix_one]\n+\n+/-- The deviation element `(g - 1)^*(g - 1)` of an involutive supported word. -/\n+theorem star_sub_one_mul_sub_one_fullPauliRegionMatrix\n+    (F : Finset Site) (a : FullPauliWord Site)\n+    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :\n+    star (fullPauliRegionMatrix F a - 1) * (fullPauliRegionMatrix F a - 1) =\n+      (2 : ℂ) • (1 : finiteRegionQubitAlgebra F) -\n+        (2 : ℂ) • fullPauliRegionMatrix F a := by\n+  have hsa : star (fullPauliRegionMatrix F a) = fullPauliRegionMatrix F a :=\n+    fullPauliRegionMatrix_isSelfAdjoint F a ha hinv\n+  have hsq := fullPauliRegionMatrix_mul_self F a ha hinv\n+  rw [star_sub, star_one, hsa, sub_mul, mul_sub, mul_sub, hsq, one_mul, mul_one]\n+  simp only [mul_one]\n+  module\n+\n+/-! ### The explicit C-star completion input -/\n+\n+variable (Site) in\n+/--\n+**The C-star completion input.**  A concrete C-star algebra `A` together with\n+faithful unital star embeddings of every finite local algebra which are\n+compatible with the identity padding of the directed system and whose images\n+are norm dense.  This is exactly the manuscript's quasilocal algebra\n+`𝒜 = closure (⋃_{F} 𝒜_F)` together with the identification\n+`𝒜_F ≃ 𝒜_F ⊗ id_{F' \\ F}`.\n+-/\n+structure QuasilocalEmbedding (A : Type*) [CStarAlgebra A] where\n+  /-- The star embedding of the finite local algebra of a region. -/\n+  embed : ∀ F : Finset Site, finiteRegionQubitAlgebra F →⋆ₐ[ℂ] A\n+  /-- The finite local algebras are faithfully represented. -/\n+  embed_injective : ∀ F : Finset Site, Function.Injective (embed F)\n+  /-- The embeddings are compatible with the identity padding of the directed system. -/\n+  embed_localInclusion : ∀ (F F' : Finset Site) (h : F ⊆ F')\n+    (x : finiteRegionQubitAlgebra F), embed F' (localInclusion h x) = embed F x\n+  /-- The local elements are norm dense: `A` is the completion of `⋃_F 𝒜_F`. -/\n+  dense_localAlgebra : Dense (⋃ F : Finset Site, Set.range (embed F))\n+\n+namespace QuasilocalEmbedding\n+\n+variable {A : Type*} [CStarAlgebra A] (Q : QuasilocalEmbedding Site A)\n+\n+/-- **The continuity bound is derived, not assumed**: each embedding is isometric. -/\n+theorem norm_embed (F : Finset Site) (x : finiteRegionQubitAlgebra F) :\n+    ‖Q.embed F x‖ = ‖x‖ :=\n+  NonUnitalStarAlgHom.norm_map (Q.embed F) (Q.embed_injective F) x\n+\n+/-- Each embedding is an isometry. -/\n+theorem isometry_embed (F : Finset Site) : Isometry (Q.embed F) :=\n+  AddMonoidHomClass.isometry_of_norm (Q.embed F) (Q.norm_embed F)\n+\n+/-- Each embedding is continuous. -/\n+theorem continuous_embed (F : Finset Site) : Continuous (Q.embed F) :=\n+  (Q.isometry_embed F).continuous\n+\n+@[simp] theorem embed_one (F : Finset Site) : Q.embed F 1 = 1 := map_one _\n+\n+/--\n+A full-Pauli word has a single image in `A`: its finite-region matrices on all\n+regions containing its support agree there.\n+-/\n+theorem embed_fullPauliRegionMatrix_eq (F F' : Finset Site) (hFF' : F ⊆ F')\n+    (a : FullPauliWord Site) (ha : a.SupportedIn F) :\n+    Q.embed F' (fullPauliRegionMatrix F' a) = Q.embed F (fullPauliRegionMatrix F a) := by\n+  rw [← localInclusion_fullPauliRegionMatrix F F' hFF' a ha,\n+    Q.embed_localInclusion F F' hFF']\n+\n+/-- The image of a smaller region is contained in the image of a larger one. -/\n+theorem range_embed_mono (F F' : Finset Site) (hFF' : F ⊆ F') :\n+    Set.range (Q.embed F) ⊆ Set.range (Q.embed F') := by\n+  rintro _ ⟨x, rfl⟩\n+  exact ⟨localInclusion hFF' x, Q.embed_localInclusion F F' hFF' x⟩\n+\n+/-! ### The local star algebra of a subregion -/\n+\n+/--\n+The set of elements of `A` which are local in the subregion `Γ`: images of the\n+finite local algebras of the finite regions contained in `Γ`.  This is the\n+manuscript's `𝒜_{Γ,loc} = ⋃_{F ⋐ Γ} 𝒜_F`.\n+-/\n+def localSet (Γ : Set Site) : Set A :=\n+  {x | ∃ F : Finset Site, ↑F ⊆ Γ ∧ x ∈ Set.range (Q.embed F)}\n+\n+theorem mem_localSet_iff (Γ : Set Site) (x : A) :\n+    x ∈ Q.localSet Γ ↔ ∃ F : Finset Site, ↑F ⊆ Γ ∧ ∃ y, Q.embed F y = x := Iff.rfl\n+\n+theorem embed_mem_localSet {Γ : Set Site} {F : Finset Site} (hF : ↑F ⊆ Γ)\n+    (x : finiteRegionQubitAlgebra F) : Q.embed F x ∈ Q.localSet Γ :=\n+  ⟨F, hF, ⟨x, rfl⟩⟩\n+\n+theorem localSet_mono {Γ Δ : Set Site} (h : Γ ⊆ Δ) : Q.localSet Γ ⊆ Q.localSet Δ := by\n+  rintro x ⟨F, hF, hx⟩\n+  exact ⟨F, hF.trans h, hx⟩\n+\n+/-- The local set of the whole lattice is the union of all the images. -/\n+theorem localSet_univ : Q.localSet (Set.univ : Set Site) = ⋃ F : Finset Site,\n+    Set.range (Q.embed F) := by\n+  ext x\n+  simp [localSet]\n+\n+/--\n+**Directedness of the local system.**  Any two elements local in `Γ` are images\n+of one and the same finite region contained in `Γ`.\n+-/\n+theorem exists_localSet_common_region {Γ : Set Site} {x y : A}\n+    (hx : x ∈ Q.localSet Γ) (hy : y ∈ Q.localSet Γ) :\n+    ∃ G : Finset Site, ↑G ⊆ Γ ∧ ∃ a b : finiteRegionQubitAlgebra G,\n+      Q.embed G a = x ∧ Q.embed G b = y := by\n+  obtain ⟨F, hF, a, rfl⟩ := hx\n+  obtain ⟨F', hF', b, rfl⟩ := hy\n+  refine ⟨F ∪ F', ?_, localInclusion Finset.subset_union_left a,\n+    localInclusion Finset.subset_union_right b, ?_, ?_⟩\n+  · rw [Finset.coe_union]\n+    exact Set.union_subset hF hF'\n+  · exact Q.embed_localInclusion F (F ∪ F') Finset.subset_union_left a\n+  · exact Q.embed_localInclusion F' (F ∪ F') Finset.subset_union_right b\n+\n+/--\n+**The local star algebra of a subregion.**  The local elements of `Γ` form a\n+star subalgebra of `A`: sums, products and adjoints of elements local in `F`\n+and `E` are local in `F ∪ E`.\n+-/\n+def localStarAlgebra (Γ : Set Site) : StarSubalgebra ℂ A where\n+  carrier := Q.localSet Γ\n+  mul_mem' := by\n+    intro x y hx hy\n+    obtain ⟨G, hG, a, b, rfl, rfl⟩ := Q.exists_localSet_common_region hx hy\n+    exact ⟨G, hG, ⟨a * b, map_mul _ _ _⟩⟩\n+  add_mem' := by\n+    intro x y hx hy\n+    obtain ⟨G, hG, a, b, rfl, rfl⟩ := Q.exists_localSet_common_region hx hy\n+    exact ⟨G, hG, ⟨a + b, map_add _ _ _⟩⟩\n+  algebraMap_mem' := by\n+    intro r\n+    exact ⟨∅, by simp, ⟨algebraMap ℂ _ r, AlgHomClass.commutes _ r⟩⟩\n+  star_mem' := by\n+    rintro x ⟨F, hF, a, rfl⟩\n+    exact ⟨F, hF, ⟨star a, map_star _ _⟩⟩\n+\n+@[simp] theorem coe_localStarAlgebra (Γ : Set Site) :\n+    (Q.localStarAlgebra Γ : Set A) = Q.localSet Γ := rfl\n+\n+theorem localStarAlgebra_mono {Γ Δ : Set Site} (h : Γ ⊆ Δ) :\n+    Q.localStarAlgebra Γ ≤ Q.localStarAlgebra Δ := Q.localSet_mono h\n+\n+/-- **The quasilocal algebra.**  The global local star algebra is dense in `A`. -/\n+theorem dense_localStarAlgebra_univ :\n+    Dense (Q.localStarAlgebra (Set.univ : Set Site) : Set A) := by\n+  rw [coe_localStarAlgebra, localSet_univ]\n+  exact Q.dense_localAlgebra\n+\n+/-- The topological closure of the global local star algebra is all of `A`. -/\n+theorem localStarAlgebra_univ_topologicalClosure :\n+    (Q.localStarAlgebra (Set.univ : Set Site)).topologicalClosure = ⊤ := by\n+  apply SetLike.ext'\n+  simpa using Q.dense_localStarAlgebra_univ.closure_eq\n+\n+end QuasilocalEmbedding\n+\n+/-! ### The explicit global state input -/\n+\n+variable {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]\n+\n+/--\n+**The global state input.**  A positive linear functional on the quasilocal\n+algebra `A` which restricts on every finite local algebra to the compatible\n+finite stabilizer state `ω_F(x) = Tr(ρ_F x)`.  This is the state of\n+Proposition `prop:define_state`; the interface supplies it, it is not\n+constructed here.\n+-/\n+structure QuasilocalStabilizerState (S : FullPauliStabilizerSystem Site)\n+    (Q : QuasilocalEmbedding Site A) where\n+  /-- The global positive linear functional. -/\n+  state : A →ₚ[ℂ] ℂ\n+  /-- It extends the compatible finite local stabilizer states. -/\n+  state_embed : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),\n+    state (Q.embed F x) = S.localState F x\n+\n+namespace QuasilocalStabilizerState\n+\n+variable {S : FullPauliStabilizerSystem Site} {Q : QuasilocalEmbedding Site A}\n+variable (W : QuasilocalStabilizerState S Q)\n+\n+/-- **Continuity is derived, not assumed**: positive functionals on `A` are bounded. -/\n+theorem continuous_state : Continuous (W.state : A → ℂ) := by fun_prop\n+\n+omit [StarOrderedRing A] in\n+/-- **Normalization is derived**: `ω(1) = 1`, from the empty region. -/\n+@[simp] theorem state_one : W.state 1 = 1 := by\n+  have h := W.state_embed ∅ 1\n+  rwa [Q.embed_one, S.localState_one] at h\n+\n+omit [StarOrderedRing A] in\n+/-- The state is positive, by definition of a positive linear map. -/\n+theorem state_nonneg {x : A} (hx : 0 ≤ x) : 0 ≤ W.state x := W.state.map_nonneg hx\n+\n+/--\n+**Uniqueness of the continuous extension** (the B.L.T. step of the\n+manuscript's Proposition): a positive functional extending the compatible\n+finite local states is unique.\n+-/\n+theorem state_eq (W W' : QuasilocalStabilizerState S Q) :\n+    (W.state : A → ℂ) = (W'.state : A → ℂ) := by\n+  refine Continuous.ext_on Q.dense_localAlgebra W.continuous_state W'.continuous_state ?_\n+  rintro x hx\n+  simp only [Set.mem_iUnion, Set.mem_range] at hx\n+  obtain ⟨F, y, rfl⟩ := hx\n+  rw [W.state_embed, W'.state_embed]\n+\n+omit [StarOrderedRing A] in\n+/-- The value of the state on a local element is the finite-stage trace value. -/\n+theorem state_embed_apply (F : Finset Site) (x : finiteRegionQubitAlgebra F) :\n+    W.state (Q.embed F x) = ((S.regionDensity F) * x).trace := W.state_embed F x\n+\n+omit [StarOrderedRing A] in\n+/--\n+**Finite-stage evaluation is region independent**: the value on a full-Pauli\n+word does not depend on which region containing its support is used.\n+-/\n+theorem state_embed_eq_of_supportedIn (F F' : Finset Site) (hFF' : F ⊆ F')\n+    (a : FullPauliWord Site) (ha : a.SupportedIn F) :\n+    W.state (Q.embed F' (fullPauliRegionMatrix F' a)) =\n+      W.state (Q.embed F (fullPauliRegionMatrix F a)) := by\n+  rw [Q.embed_fullPauliRegionMatrix_eq F F' hFF' a ha]\n+\n+omit [StarOrderedRing A] in\n+/-- **Every local stabilizer has expectation one in the global state.** -/\n+theorem state_embed_fullPauliRegionMatrix (F : Finset Site)\n+    (g : ↥(S.regionStabilizer F).group) :\n+    W.state (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site))) = 1 := by\n+  rw [W.state_embed, S.localState_fullPauliRegionMatrix F g]\n+\n+omit [StarOrderedRing A] in\n+/-- The deviation of a local stabilizer from the unit is null in the state. -/\n+theorem state_deviation_eq_zero (F : Finset Site)\n+    (g : ↥(S.regionStabilizer F).group) :\n+    W.state (star (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site)) - 1) *\n+      (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site)) - 1)) = 0 := by\n+  obtain ⟨hmem, hsupp⟩ := (S.mem_regionStabilizer_group_iff F (g : FullPauliWord Site)).mp\n+    g.property\n+  have hinv : (g : FullPauliWord Site) * (g : FullPauliWord Site) = 1 :=\n+    S.involutive _ hmem\n+  have hstar : star (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site)) - 1) *\n+      (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site)) - 1) =\n+      Q.embed F (star (fullPauliRegionMatrix F (g : FullPauliWord Site) - 1) *\n+        (fullPauliRegionMatrix F (g : FullPauliWord Site) - 1)) := by\n+    rw [map_mul, map_star, map_sub, map_one]\n+  rw [hstar, star_sub_one_mul_sub_one_fullPauliRegionMatrix F _ hsupp hinv,\n+    W.state_embed, map_sub, map_smul, map_smul, S.localState_one,\n+    S.localState_fullPauliRegionMatrix F g]\n+  simp\n+\n+/-! ### The GNS data of the quasilocal state -/\n+\n+/-- The GNS Hilbert space of the quasilocal stabilizer state. -/\n+protected abbrev GNS := W.state.GNS\n+\n+/-- The cyclic GNS vector `|Ω⟩` of the quasilocal stabilizer state. -/\n+noncomputable def gnsVector : W.GNS := gnsCyclicVector W.state\n+\n+/-- The GNS representation `π_ω` of the quasilocal algebra. -/\n+noncomputable def gnsRepresentation : A →⋆ₐ[ℂ] (W.GNS →L[ℂ] W.GNS) :=\n+  W.state.gnsStarAlgHom\n+\n+/-- The GNS vector is a unit vector. -/\n+theorem norm_gnsVector : ‖W.gnsVector‖ = 1 :=\n+  norm_gnsCyclicVector_eq_one W.state W.state_one\n+\n+/-- **The GNS reconstruction formula** `ω(a) = ⟪Ω, π_ω(a) Ω⟫`. -/\n+theorem inner_gnsVector_gnsRepresentation (a : A) :\n+    ⟪W.gnsVector, W.gnsRepresentation a W.gnsVector⟫_ℂ = W.state a :=\n+  inner_gnsCyclicVector_gnsStarAlgHom_apply W.state a\n+\n+/-- The finite-stage form of the reconstruction formula. -/\n+theorem inner_gnsVector_gnsRepresentation_embed (F : Finset Site)\n+    (x : finiteRegionQubitAlgebra F) :\n+    ⟪W.gnsVector, W.gnsRepresentation (Q.embed F x) W.gnsVector⟫_ℂ = S.localState F x := by\n+  rw [inner_gnsVector_gnsRepresentation, W.state_embed]\n+\n+/-- The GNS vector is cyclic for the represented quasilocal algebra. -/\n+theorem denseRange_gnsRepresentation_gnsVector :\n+    DenseRange (fun a : A => W.gnsRepresentation a W.gnsVector) :=\n+  denseRange_gnsStarAlgHom_apply_gnsCyclicVector W.state\n+\n+/--\n+The represented finite local algebra `𝒰_F = π_ω(𝒜_F)` of the manuscript, as a\n+star-algebra map from the finite matrix algebra.\n+-/\n+noncomputable def localRepresentation (F : Finset Site) :\n+    finiteRegionQubitAlgebra F →⋆ₐ[ℂ] (W.GNS →L[ℂ] W.GNS) :=\n+  W.gnsRepresentation.comp (Q.embed F)\n+\n+theorem localRepresentation_apply (F : Finset Site) (x : finiteRegionQubitAlgebra F) :\n+    W.localRepresentation F x = W.gnsRepresentation (Q.embed F x) := rfl\n+\n+/-- **Coherence of the local representations** along the directed system. -/\n+theorem localRepresentation_localInclusion (F F' : Finset Site) (hFF' : F ⊆ F')\n+    (x : finiteRegionQubitAlgebra F) :\n+    W.localRepresentation F' (localInclusion hFF' x) = W.localRepresentation F x := by\n+  rw [localRepresentation_apply, localRepresentation_apply, Q.embed_localInclusion]\n+\n+/-- The finite-stage matrix coefficient of the local representation. -/\n+theorem inner_gnsVector_localRepresentation (F : Finset Site)\n+    (x : finiteRegionQubitAlgebra F) :\n+    ⟪W.gnsVector, W.localRepresentation F x W.gnsVector⟫_ℂ = S.localState F x :=\n+  W.inner_gnsVector_gnsRepresentation_embed F x\n+\n+/--\n+**Stabilizer invariance of the GNS vector.**  Every local stabilizer fixes\n+`|Ω⟩` in the GNS representation.\n+-/\n+theorem gnsRepresentation_fullPauliRegionMatrix_gnsVector (F : Finset Site)\n+    (g : ↥(S.regionStabilizer F).group) :\n+    W.localRepresentation F (fullPauliRegionMatrix F (g : FullPauliWord Site))\n+        W.gnsVector = W.gnsVector :=\n+  gnsStarAlgHom_apply_gnsCyclicVector_eq_of_deviation_eq_zero W.state _\n+    (W.state_deviation_eq_zero F g)\n+\n+end QuasilocalStabilizerState\n+\n+/-! ### Positivity of the finite local states -/\n+\n+section Positivity\n+\n+open scoped MatrixOrder\n+\n+/-- The trace pairing of two positive semidefinite matrices is nonnegative. -/\n+theorem posSemidef_trace_mul_nonneg {n : Type*} [Fintype n] [DecidableEq n]\n+    {M N : Matrix n n ℂ} (hM : M.PosSemidef) (hN : N.PosSemidef) :\n+    0 ≤ (M * N).trace := by\n+  have hs : CFC.sqrt M * CFC.sqrt M = M := CFC.sqrt_mul_sqrt_self M (ha := hM.nonneg)\n+  have hsq : (CFC.sqrt M).PosSemidef := Matrix.nonneg_iff_posSemidef.mp (CFC.sqrt_nonneg M)\n+  have h : ((CFC.sqrt M).conjTranspose * N * CFC.sqrt M).PosSemidef :=\n+    hN.conjTranspose_mul_mul_same _\n+  have h2 := h.trace_nonneg\n+  rw [hsq.isHermitian.eq] at h2\n+  calc (0 : ℂ) ≤ (CFC.sqrt M * N * CFC.sqrt M).trace := h2\n+    _ = (M * N).trace := by rw [Matrix.trace_mul_comm, ← mul_assoc, hs]\n+\n+/--\n+**The finite local stabilizer state is a positive linear functional** on the\n+finite local matrix algebra, in the Loewner order.  This is the finite-stage\n+positivity behind the manuscript's approximation argument.\n+-/\n+noncomputable def FullPauliStabilizerSystem.localPositiveState\n+    (S : FullPauliStabilizerSystem Site) (F : Finset Site) :\n+    finiteRegionQubitAlgebra F →ₚ[ℂ] ℂ where\n+  __ := S.localState F\n+  monotone' := by\n+    intro x y hxy\n+    have hpos : (y - x).PosSemidef := Matrix.le_iff.mp hxy\n+    have h := posSemidef_trace_mul_nonneg (S.regionDensity_posSemidef F) hpos\n+    rw [mul_sub, Matrix.trace_sub] at h\n+    change S.localState F x ≤ S.localState F y\n+    rw [S.localState_apply, S.localState_apply]\n+    exact sub_nonneg.mp h\n+\n+@[simp] theorem FullPauliStabilizerSystem.localPositiveState_apply\n+    (S : FullPauliStabilizerSystem Site) (F : Finset Site)\n+    (x : finiteRegionQubitAlgebra F) :\n+    S.localPositiveState F x = S.localState F x := rfl\n+\n+end Positivity\n+\n+/-! ### Non-vacuity of the completion interface -/\n+\n+/--\n+**The interface is non-vacuous.**  Over the empty site type every finite region\n+is empty, and the finite local algebra of the empty region is itself a C-star\n+algebra satisfying all four conditions of `QuasilocalEmbedding`.\n+-/\n+noncomputable def emptySiteQuasilocalEmbedding :\n+    QuasilocalEmbedding Empty (finiteRegionQubitAlgebra (∅ : Finset Empty)) where\n+  embed F := finiteRegionEmbed F ∅ (by\n+    intro x _\n+    exact (IsEmpty.false x).elim)\n+  embed_injective F := finiteRegionEmbed_injective F ∅ _\n+  embed_localInclusion F F' h x := by\n+    have hF : F ⊆ (∅ : Finset Empty) := fun x _ => (IsEmpty.false x).elim\n+    have hF' : F' ⊆ (∅ : Finset Empty) := fun x _ => (IsEmpty.false x).elim\n+    exact finiteRegionEmbed_trans F F' ∅ h hF' x\n+  dense_localAlgebra := by\n+    intro x\n+    refine subset_closure (Set.mem_iUnion.mpr ⟨∅, x, ?_⟩)\n+    exact finiteRegionEmbed_self ∅ x\n+\n+section EmptySiteState\n+\n+open scoped MatrixOrder\n+\n+/--\n+**The state interface is non-vacuous too.**  Over the empty site type the\n+finite local state of the empty region is a global state for the witness\n+completion, so `QuasilocalStabilizerState` is inhabited for every consistent\n+stabilizer system on `Empty`.\n+-/\n+noncomputable def emptySiteQuasilocalStabilizerState\n+    (S : FullPauliStabilizerSystem Empty) :\n+    QuasilocalStabilizerState S emptySiteQuasilocalEmbedding where\n+  state := S.localPositiveState ∅\n+  state_embed F x := S.localState_localInclusion F ∅ (fun y _ => (IsEmpty.false y).elim) x\n+\n+end EmptySiteState\n+\n+end FiniteFiber\n","exit_code":0,"status":"completed"}}
