imit :=\n885:  A.directedFamily.sourceOf n x\n886-\n887-/-- The canonical map of a target stage into the target limit. -/\n888-noncomputable abbrev targetOf (n : ℕ) (y : pauliAlgebra (A.targetForm n)) : A.TargetLimit :=\n889:  A.directedFamily.targetOf n y\n890-\n891-/-- **The algebraic `alpha` of the local-hyperbolic coordinates.**  It is\n892-constructed, not assumed: the finite-stage star equivalences come from the P52\n893-coordinate data through P29, their commuting squares are the P30 theorem, and\n894-the limit equivalence is the P23/P31 construction. -/\n895-noncomputable def alpha : A.SourceLimit ≃⋆ₐ[ℂ] A.TargetLimit :=\n896:  A.directedFamily.alpha\n897-\n898-/-- **The Pauli-word formula for `alpha`.**  On the image of a stage-`n` Pauli\n899-word, `alpha` is the phase-corrected Pauli word of the image label. -/\n900-theorem alpha_word (n : ℕ) (v : A.SourceLabel n) :\n901-    A.alpha (A.sourceOf n (pauliWord (A.sourceForm n) v)) =\n902-      A.targetOf n (A.phase n v • pauliWord (A.targetForm n) (A.stageLabelMap n v)) :=\n903:  A.directedFamily.alpha_word n v\n904-\n905-/-- The calibration phase is a fourth root of unity, in particular nonzero. -/\n906-theorem phase_ne_zero (n : ℕ) (v : A.SourceLabel n) : A.phase n v ≠ 0 :=\n--\n909-/-- **The manuscript's `α(Z_i) = P(z_i)`, phase-calibrated.**  On the Pauli word\n910-of the `Z` coordinate of a stage-`n` site, `alpha` is a fourth-root-of-unity\n911-multiple of the regional Pauli word of the hyperbolic vector `z i`. -/\n912:theorem alpha_zWord (n : ℕ) (i : A.Coord n) (u : A.TargetLabel n)\n913-    (hu : (u : PhaseSpace L) = A.family.z (i : I)) :\n914-    A.alpha (A.sourceOf n (pauliWord (A.sourceForm n) ((A.stageCoordinates n).z i))) =\n915-      A.targetOf n (A.phase n ((A.stageCoordinates n).z i) •\n--\n919-      Subtype.ext ((A.stageLabelMap_z n i).trans hu.symm)]\n920-\n921-/-- **The manuscript's `α(X_i) = P(x_i)`, phase-calibrated.** -/\n922:theorem alpha_xWord (n : ℕ) (i : A.Coord n) (u : A.TargetLabel n)\n923-    (hu : (u : PhaseSpace L) = A.family.x (i : I)) :\n924-    A.alpha (A.sourceOf n (pauliWord (A.sourceForm n) ((A.stageCoordinates n).x i))) =\n925-      A.targetOf n (A.phase n ((A.stageCoordinates n).x i) •\n--\n933-theorem alpha_symm_word (n : ℕ) (v : A.SourceLabel n) :\n934-    A.alpha.symm (A.targetOf n (pauliWord (A.targetForm n) (A.stageLabelMap n v))) =\n935-      (A.phase n v)⁻¹ • A.sourceOf n (pauliWord (A.sourceForm n) v) :=\n936:  A.directedFamily.alpha_symm_targetWord n v (A.phase_ne_zero n v)\n937-\n938-/-- **Existence and uniqueness of the algebraic `alpha`.**  There is exactly one\n939-star-algebra equivalence of the two algebraic direct limits obeying the\n940-phase-calibrated Pauli-word formula at every stage. -/\n941:theorem existsUnique_alpha :\n942-    ∃! psi : A.SourceLimit ≃⋆ₐ[ℂ] A.TargetLimit,\n943-      ∀ (n : ℕ) (v : A.SourceLabel n),\n944-        psi (A.sourceOf n (pauliWord (A.sourceForm n) v)) =\n945-          A.targetOf n (A.phase n v • pauliWord (A.targetForm n) (A.stageLabelMap n v)) :=\n946:  A.directedFamily.existsUnique_alpha\n947-\n948-end AlphaData\n949-\n--\n1011-noncomputable def standardAlphaData : AlphaData ℕ ℕ where\n1012-  family := standardFamily ℕ\n1013-  exhaustion := standardExhaustion\n1014:  symplectic v w := by\n1015-    rw [standardFamily_coordinateMap, standardFamily_coordinateMap]\n1016:  stage_surjective n u hu := by\n1017-    refine ⟨u, ?_, standardFamily_coordinateMap ℕ u⟩\n1018-    rw [LocalHyperbolicFamily.mem_sourceLabels_iff]\n1019-    intro p hp\n","exit_code":0,"status":"completed"}}
