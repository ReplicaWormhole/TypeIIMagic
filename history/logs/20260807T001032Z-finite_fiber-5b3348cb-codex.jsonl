t axioms FiniteFiber.cornerPairing_comm_of_localAlgebra\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.cornerPairing_comm_of_mem_localOperatorAlgebra\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.cornerProjection_isFullProjection\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.tracial_cornerProjection\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.faithful_cornerProjection\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.supportCornerConclusion\n+#print axioms FiniteFiber.bicommutant\n+#print axioms FiniteFiber.mem_bicommutant_iff\n+#print axioms FiniteFiber.QuasilocalStabilizerState.generatedByLocalAlgebra_localVonNeumannAlgebra\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.tracial_cornerProjection_localVonNeumannAlgebra\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.faithful_cornerProjection_localVonNeumannAlgebra\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.cornerProjection_isFullProjection_localVonNeumannAlgebra\n+#print axioms FiniteFiber.FiniteRangeStabilizerSystem.supportCornerConclusion_localVonNeumannAlgebra\n+\n /-- The exported scoped C-star instance makes the finite-region norm theorem usable downstream. -/\n example {Site : Type*} [DecidableEq Site] (F F' : Finset Site) (hFF' : F ⊆ F')\n     (A : FiniteFiber.finiteRegionQubitAlgebra F) :\n57:`FiniteRangeStabilizerSystem.supportCornerConclusion_localVonNeumannAlgebra`\n97:lemma amplifyInj_apply (n : ℕ) (j : Fin n) (v : H) (i : Fin n) :\n103:lemma sum_amplifyInj (n : ℕ) (v : PiLp 2 fun _ : Fin n => H) :\n110:lemma amplify_one (n : ℕ) : amplify n (1 : H →L[ℂ] H) = 1 := by\n114:lemma amplify_zero (n : ℕ) : amplify n (0 : H →L[ℂ] H) = 0 := by\n118:lemma amplify_add (n : ℕ) (a b : H →L[ℂ] H) :\n123:lemma amplify_smul (n : ℕ) (c : ℂ) (a : H →L[ℂ] H) :\n128:lemma amplify_mul (n : ℕ) (a b : H →L[ℂ] H) :\n132:lemma amplify_star (n : ℕ) (a : H →L[ℂ] H) :\n148:lemma amplify_amplifyInj (n : ℕ) (a : H →L[ℂ] H) (j : Fin n) (v : H) :\n162:lemma amplifyEntry_apply (n : ℕ)\n167:lemma apply_coord_eq_sum_amplifyEntry (n : ℕ)\n178:lemma amplifyEntry_commutes (n : ℕ) (𝒜 : Set (H →L[ℂ] H))\n195:lemma amplify_commutes_of_amplifyEntry (n : ℕ) {x : H →L[ℂ] H}\n215:theorem exists_mem_norm_sub_apply_lt\n296:theorem exists_mem_norm_sub_apply_lt_two\n318:theorem star_centralizer_coe_subset (𝒜 : StarSubalgebra ℂ (H →L[ℂ] H)) :\n329:theorem centralizer_union_star_centralizer (𝒜 : StarSubalgebra ℂ (H →L[ℂ] H)) :\n334:theorem coe_starSubalgebra_centralizer_centralizer (𝒜 : StarSubalgebra ℂ (H →L[ℂ] H)) :\n354:theorem coe_bicommutant (𝒜 : StarSubalgebra ℂ (H →L[ℂ] H)) :\n359:theorem mem_bicommutant_iff (𝒜 : StarSubalgebra ℂ (H →L[ℂ] H)) (x : H →L[ℂ] H) :\n368:theorem le_bicommutant (𝒜 : StarSubalgebra ℂ (H →L[ℂ] H)) {a : H →L[ℂ] H} (ha : a ∈ 𝒜) :\n381:theorem norm_apply_le_of_isStarProjection {p : H →L[ℂ] H} (hp : IsStarProjection p) (v : H) :\n403:theorem vectorFunctional_tendsto_of_strong {ι : Type*} {l : Filter ι} (xi : H)\n411:theorem vectorFunctional_star_mul_self (xi : H) (a : H →L[ℂ] H) :\n420:theorem vectorFunctional_star_mul_self_eq_zero_iff (xi : H) (a : H →L[ℂ] H) :\n431:theorem vectorFunctional_eq_one_of_fixes {q : H →L[ℂ] H} {xi : H}\n453:theorem cornerElement_mul_apply_eq_zero_of_tracial\n483:theorem VectorCornerData.cornerElement_eq_zero_of_vectorFunctional_star_mul_self_eq_zero\n530:theorem trace_projection_sandwich_comm {n : Type*} [Fintype n] [DecidableEq n]\n544:theorem FullPauliStabilizerSystem.regionCodeProjector_isIdempotent\n549:theorem FullPauliStabilizerSystem.regionCodeProjector_isStarProjection\n554:theorem FullPauliStabilizerSystem.regionDensity_eq_smul_regionCodeProjector\n564:theorem FullPauliStabilizerSystem.localState_regionCodeProjector_comm\n608:theorem mem_localOperatorAlgebra_iff (T : W.GNS →L[ℂ] W.GNS) :\n620:theorem representation_mem_localOperatorAlgebra (F : Finset Site)\n627:theorem localOperatorAlgebra_le {M : VonNeumannAlgebra W.GNS}\n640:theorem dense_localOperatorAlgebra_orbit :\n688:def localStabilizerEquiv (n : ℕ) :\n707:theorem supportProjection_eq_representation\n754:theorem cornerPairing_eq_inner_right {q : H →L[ℂ] H} (hq : IsSelfAdjoint q) {xi : H}\n767:theorem cornerPairing_eq_inner_left {q : H →L[ℂ] H} (hq : IsSelfAdjoint q) {xi : H}\n787:theorem cornerPairing_comm_of_local\n837:theorem cornerPairing_comm_of_localAlgebra\n850:theorem cornerPairing_eq_vectorFunctional_mul\n860:theorem tracial_of_cornerPairing_comm\n874:theorem tendsto_apply_of_stronglyTendsTo {p : ℕ → H →L[ℂ] H} {q : H →L[ℂ] H}\n886:theorem tendsto_sandwich_apply {p : ℕ → H →L[ℂ] H} {q : H →L[ℂ] H}\n902:theorem tendsto_vectorFunctional_sandwich {p : ℕ → H →L[ℂ] H} {q : H →L[ℂ] H}\n916:theorem cornerPairing_comm_of_eventually {p : ℕ → H →L[ℂ] H} {q : H →L[ℂ] H}\n943:theorem supportProjection_isStarProjection (n : ℕ) :\n955:theorem norm_supportProjection_apply_le (n : ℕ) (v : W.GNS) :\n964:theorem vectorFunctional_supportProjection_sandwich\n992:theorem cornerPairing_comm_of_local_embed (M : VonNeumannAlgebra W.GNS)\n1014:theorem cornerPairing_comm_of_mem_localOperatorAlgebra (M : VonNeumannAlgebra W.GNS)\n1056:def GeneratedByLocalAlgebra (M : VonNeumannAlgebra W.GNS) : Prop :=\n1076:theorem cornerProjection_ne_zero' : R.cornerProjection W ≠ 0 :=\n1080:theorem vectorFunctional_cornerProjection_eq_one :\n1091:theorem cornerProjection_isFullProjection :\n1120:theorem tracial_cornerProjection\n1155:  tracial ha hb := R.tracial_cornerProjection W M hM hgen ha hb\n1164:theorem supportCornerConclusion (hgen : W.GeneratedByLocalAlgebra M) :\n1166:  finiteRange_supportCornerConclusion_of_gnsOrbit R W M hM\n1174:theorem faithful_cornerProjection (hgen : W.GeneratedByLocalAlgebra M)\n1199:theorem representation_mem_localVonNeumannAlgebra (W : QuasilocalStabilizerState S Q)\n1205:theorem generatedByLocalAlgebra_localVonNeumannAlgebra\n1222:theorem tracial_cornerProjection_localVonNeumannAlgebra\n1227:  R.tracial_cornerProjection W W.localVonNeumannAlgebra\n1232:theorem faithful_cornerProjection_localVonNeumannAlgebra\n1236:  R.faithful_cornerProjection W W.localVonNeumannAlgebra\n1241:theorem cornerProjection_isFullProjection_localVonNeumannAlgebra :\n1243:  R.cornerProjection_isFullProjection W W.localVonNeumannAlgebra\n1247:theorem cornerProjection_ne_zero_localVonNeumannAlgebra :\n1253:theorem vectorFunctional_cornerProjection_eq_one_localVonNeumannAlgebra :\n1268:theorem supportCornerConclusion_localVonNeumannAlgebra :\n1270:  R.supportCornerConclusion W W.localVonNeumannAlgebra\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"remote=../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF22-extracted/aristotle-finite_fiber-jwxyqzjl_aristotle; sed -n '1010,1285p' \\\"\"'$remote/FiniteFiber/FiniteRangeTracialCorner.lean\"; rg -n \"'\"\\\\b(sorry|admit|axiom|opaque|unsafe|implemented_by)\\\\b\\\" \\\"\"'$remote/FiniteFiber/FiniteRangeTracialCorner.lean\" || true; sed -n '\"'1,240p' <original-home>/.codex/adversarial_review.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"remote=../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF22-extracted/aristotle-finite_fiber-jwxyqzjl_aristotle; sed -n '1010,1285p' \\\"\"'$remote/FiniteFiber/FiniteRangeTracialCorner.lean\"; rg -n \"'\"\\\\b(sorry|admit|axiom|opaque|unsafe|implemented_by)\\\\b\\\" \\\"\"'$remote/FiniteFiber/FiniteRangeTracialCorner.lean\" || true; sed -n '\"'1,240p' <original-home>/.codex/adversarial_review.md\"","aggregated_output":"  exact R.stabilizerSystem.localState_regionCodeProjector_comm (R.region n)\n    (localInclusion h₀ a) (localInclusion h₁ b)\n\n/-- The same statement for arbitrary members of the represented local algebra. -/\ntheorem cornerPairing_comm_of_mem_localOperatorAlgebra (M : VonNeumannAlgebra W.GNS)\n    (hM : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),\n      W.gnsRepresentation (Q.embed F x) ∈ M)\n    {u w : W.GNS →L[ℂ] W.GNS} (hu : u ∈ W.localOperatorAlgebra)\n    (hw : w ∈ W.localOperatorAlgebra) :\n    cornerPairing (R.cornerProjection W) W.gnsVector u w\n      = cornerPairing (R.cornerProjection W) W.gnsVector w u := by\n  obtain ⟨F₀, a, rfl⟩ := (W.mem_localOperatorAlgebra_iff u).mp hu\n  obtain ⟨F₁, b, rfl⟩ := (W.mem_localOperatorAlgebra_iff w).mp hw\n  exact R.cornerPairing_comm_of_local_embed W M hM a b\n\nend FiniteRangeStabilizerSystem\n\nend LocalTraciality\n\n/-! ## Part IX. Fullness, traciality and the assembled FF20 premises -/\n\nsection Assembly\n\nvariable {Site : Type*} [DecidableEq Site]\nvariable {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]\n\nopen scoped FiniteFiber.FiniteRegionQubitMatrix\n\nnamespace QuasilocalStabilizerState\n\nvariable {S : FullPauliStabilizerSystem Site} {Q : QuasilocalEmbedding Site A}\nvariable (W : QuasilocalStabilizerState S Q)\n\n/--\n**The one genuinely extra hypothesis of this packet.**  `M` is *generated by* the\nrepresented local algebra: every element of `M` commutes with every operator commuting\nwith `π_ω(𝒜_loc)`, i.e. `M ⊆ 𝒜''`.  Together with the FF21 hypothesis `hM` (`𝒜 ⊆ M`) this\nsays exactly `M = π_ω(𝒜_loc)'' = M_Γ`, the algebra the manuscript works with.\n\nIt is a *definitional identification* of `M`, not an analytic gap.  It cannot simply be\ndeleted: for the strictly larger algebra `M = B(H)` (which still satisfies `hM`) the\napproximation argument below produces the local symmetry only for operators in the strong\nclosure of the local algebra, so the vector state on the corner is in general not tracial.\nFor the canonical algebra `M_Γ = π_ω(𝒜_loc)''` the hypothesis holds by construction; see\n`QuasilocalStabilizerState.generatedByLocalAlgebra_localVonNeumannAlgebra`.\n-/\ndef GeneratedByLocalAlgebra (M : VonNeumannAlgebra W.GNS) : Prop :=\n  ∀ x ∈ M, ∀ t : W.GNS →L[ℂ] W.GNS,\n    (∀ a ∈ W.localOperatorAlgebra, a * t = t * a) → x * t = t * x\n\nend QuasilocalStabilizerState\n\nnamespace FiniteRangeStabilizerSystem\n\nvariable (R : FiniteRangeStabilizerSystem Site) {Q : QuasilocalEmbedding Site A}\nvariable (W : QuasilocalStabilizerState R.stabilizerSystem Q)\nvariable (M : VonNeumannAlgebra W.GNS)\nvariable (hM : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),\n  W.gnsRepresentation (Q.embed F x) ∈ M)\n\ninclude hM\n\n/-! ### Premise 2: the support projection is nonzero -/\n\n/-- **FF20 premise 2 (derived).**  The corner projection `q` is nonzero, because it fixes\nthe unit GNS vector. -/\ntheorem cornerProjection_ne_zero' : R.cornerProjection W ≠ 0 :=\n  R.cornerProjection_ne_zero W M hM\n\n/-- The corner functional is a state on the corner: `τ_q(q) = 1`. -/\ntheorem vectorFunctional_cornerProjection_eq_one :\n    vectorFunctional W.gnsVector (R.cornerProjection W) = 1 :=\n  vectorFunctional_eq_one_of_fixes (R.cornerProjection_gnsVector W M hM) W.norm_gnsVector\n\n/-! ### Premise 3: fullness -/\n\n/--\n**FF20 premise 3 (derived).**  The corner projection is *full*: no nonzero central\nprojection of `M` annihilates it.  The orbit argument uses only cyclicity of `Ω` for the\nrepresented local algebra; no traciality is needed.\n-/\ntheorem cornerProjection_isFullProjection :\n    IsFullProjection M (R.cornerProjection W) := by\n  refine ⟨R.cornerProjection_isProjectionIn W M hM, ?_⟩\n  intro z hz hz0 hzq\n  refine hz0 ?_\n  have hzxi : z W.gnsVector = 0 := by\n    have h1 : (z * R.cornerProjection W) W.gnsVector\n        = z (R.cornerProjection W W.gnsVector) := rfl\n    rw [R.cornerProjection_gnsVector W M hM] at h1\n    rw [← h1, hzq]\n    rfl\n  have horbit : Set.EqOn z (0 : W.GNS →L[ℂ] W.GNS)\n      {v : W.GNS | ∃ T ∈ W.localOperatorAlgebra, T W.gnsVector = v} := by\n    rintro v ⟨T, hT, rfl⟩\n    have hTM : T ∈ M := W.localOperatorAlgebra_le hM T hT\n    have hcomm : (z * T) W.gnsVector = (T * z) W.gnsVector := by rw [hz.2 T hTM]\n    have hval : z (T W.gnsVector) = T (z W.gnsVector) := hcomm\n    show z (T W.gnsVector) = (0 : W.GNS →L[ℂ] W.GNS) _\n    rw [hval, hzxi, map_zero]\n    rfl\n  exact DFunLike.coe_injective (Continuous.ext_on W.dense_localOperatorAlgebra_orbit\n    z.continuous (0 : W.GNS →L[ℂ] W.GNS).continuous horbit)\n\n/-! ### Premise 1: traciality and faithfulness on `q M q` -/\n\n/--\n**FF20 premise 1, traciality (conditional on `GeneratedByLocalAlgebra`).**  The corner\nvector functional is tracial on `q M q`.\n-/\ntheorem tracial_cornerProjection\n    (hgen : W.GeneratedByLocalAlgebra M)\n    {a b : W.GNS →L[ℂ] W.GNS}\n    (ha : IsCornerElement M (R.cornerProjection W) a)\n    (hb : IsCornerElement M (R.cornerProjection W) b) :\n    vectorFunctional W.gnsVector (a * b) = vectorFunctional W.gnsVector (b * a) := by\n  refine tracial_of_cornerPairing_comm (M := M) (fun x hx y hy => ?_) ha hb\n  exact cornerPairing_comm_of_localAlgebra\n    (R.cornerProjection_isProjectionIn W M hM).2.isSelfAdjoint\n    (R.cornerProjection_gnsVector W M hM) W.localOperatorAlgebra\n    (fun u hu w hw => R.cornerPairing_comm_of_mem_localOperatorAlgebra W M hM hu hw)\n    (hgen x hx) (hgen y hy)\n\n/-! ### The assembled orbit data -/\n\n/--\n**The three FF20 premises, assembled.**  With the definitional identification\n`M = π_ω(𝒜_loc)''` supplied by `hgen`, the finite-range stabilizer model satisfies all\nthe analytic hypotheses `GNSOrbitConditions` which FF20 had to assume.  The regional\nalgebra is the represented local algebra and the complementary algebra is the scalars.\n-/\nnoncomputable def gnsOrbitConditions (hgen : W.GeneratedByLocalAlgebra M) :\n    GNSOrbitConditions M (R.cornerProjection W) W.gnsVector where\n  region := (W.localOperatorAlgebra : Set (W.GNS →L[ℂ] W.GNS))\n  complement := {1}\n  region_mem a ha := W.localOperatorAlgebra_le hM a ha\n  region_commutes_complement a _ b hb := by\n    rw [Set.mem_singleton_iff] at hb; rw [hb, mul_one, one_mul]\n  commutes_complement x _ b hb := by\n    rw [Set.mem_singleton_iff] at hb; rw [hb, mul_one, one_mul]\n  product_orbit_dense := by\n    refine Dense.mono ?_ W.dense_localOperatorAlgebra_orbit\n    refine le_trans ?_ Submodule.subset_span\n    rintro v ⟨T, hT, rfl⟩\n    exact ⟨T, hT, 1, rfl, by rw [mul_one]⟩\n  tracial ha hb := R.tracial_cornerProjection W M hM hgen ha hb\n\n/--\n**The full support-corner conclusion at the finite-range stabilizer model.**  Feeding the\nassembled premises into FF20 yields fullness, faithfulness on support subprojections, the\nnonzero finite compression of every central summand, and semifiniteness of `M`.\n\n(No no-type-III statement is derived here; that is FF23.)\n-/\ntheorem supportCornerConclusion (hgen : W.GeneratedByLocalAlgebra M) :\n    SupportCornerConclusion M (R.cornerProjection W) W.gnsVector :=\n  finiteRange_supportCornerConclusion_of_gnsOrbit R W M hM\n    (R.gnsOrbitConditions W M hM hgen)\n\n/--\n**FF20 premise 1, faithfulness (conditional on `GeneratedByLocalAlgebra`).**  The corner\nstate is faithful on all of `q M q`: `τ_q(x^* x) = 0` forces `x = 0`.  This strengthens\nthe projection-only faithfulness recorded in `SupportCornerConclusion`.\n-/\ntheorem faithful_cornerProjection (hgen : W.GeneratedByLocalAlgebra M)\n    {x : W.GNS →L[ℂ] W.GNS} (hx : IsCornerElement M (R.cornerProjection W) x)\n    (hzero : vectorFunctional W.gnsVector (star x * x) = 0) : x = 0 :=\n  VectorCornerData.cornerElement_eq_zero_of_vectorFunctional_star_mul_self_eq_zero\n    ((R.gnsOrbitConditions W M hM hgen).toVectorCornerData\n      (R.cornerProjection_isProjectionIn W M hM)\n      (R.cornerProjection_gnsVector W M hM)) hx hzero\n\nend FiniteRangeStabilizerSystem\n\n/-! ### The canonical algebra `M_Γ = π_ω(𝒜_loc)''`: the premises become unconditional -/\n\nnamespace QuasilocalStabilizerState\n\nvariable {S : FullPauliStabilizerSystem Site} {Q : QuasilocalEmbedding Site A}\n\n/--\nThe manuscript's algebra `M_Γ`: the von Neumann algebra generated by the represented local\nalgebra, i.e. its bicommutant.\n-/\nnoncomputable def localVonNeumannAlgebra (W : QuasilocalStabilizerState S Q) :\n    VonNeumannAlgebra W.GNS :=\n  bicommutant W.localOperatorAlgebra\n\n/-- `M_Γ` contains every represented finite local algebra: the FF21 hypothesis `hM`. -/\ntheorem representation_mem_localVonNeumannAlgebra (W : QuasilocalStabilizerState S Q)\n    (F : Finset Site) (x : finiteRegionQubitAlgebra F) :\n    W.gnsRepresentation (Q.embed F x) ∈ W.localVonNeumannAlgebra :=\n  le_bicommutant _ (W.representation_mem_localOperatorAlgebra F x)\n\n/-- **`M_Γ` satisfies the extra hypothesis by construction.** -/\ntheorem generatedByLocalAlgebra_localVonNeumannAlgebra\n    (W : QuasilocalStabilizerState S Q) :\n    W.GeneratedByLocalAlgebra W.localVonNeumannAlgebra :=\n  fun x hx => (mem_bicommutant_iff _ x).mp hx\n\nend QuasilocalStabilizerState\n\nnamespace FiniteRangeStabilizerSystem\n\nvariable (R : FiniteRangeStabilizerSystem Site) {Q : QuasilocalEmbedding Site A}\nvariable (W : QuasilocalStabilizerState R.stabilizerSystem Q)\n\n/--\n**FF20 premise 1 for the canonical algebra, unconditionally.**  For `M = M_Γ = π_ω(𝒜_loc)''`\nthe corner vector functional is tracial on `q M q`; no extra hypothesis is needed, because\n`GeneratedByLocalAlgebra` holds by construction of the bicommutant.\n-/\ntheorem tracial_cornerProjection_localVonNeumannAlgebra\n    {a b : W.GNS →L[ℂ] W.GNS}\n    (ha : IsCornerElement W.localVonNeumannAlgebra (R.cornerProjection W) a)\n    (hb : IsCornerElement W.localVonNeumannAlgebra (R.cornerProjection W) b) :\n    vectorFunctional W.gnsVector (a * b) = vectorFunctional W.gnsVector (b * a) :=\n  R.tracial_cornerProjection W W.localVonNeumannAlgebra\n    W.representation_mem_localVonNeumannAlgebra\n    W.generatedByLocalAlgebra_localVonNeumannAlgebra ha hb\n\n/-- **Faithfulness on `q M_Γ q`, unconditionally.** -/\ntheorem faithful_cornerProjection_localVonNeumannAlgebra\n    {x : W.GNS →L[ℂ] W.GNS}\n    (hx : IsCornerElement W.localVonNeumannAlgebra (R.cornerProjection W) x)\n    (hzero : vectorFunctional W.gnsVector (star x * x) = 0) : x = 0 :=\n  R.faithful_cornerProjection W W.localVonNeumannAlgebra\n    W.representation_mem_localVonNeumannAlgebra\n    W.generatedByLocalAlgebra_localVonNeumannAlgebra hx hzero\n\n/-- **Fullness of `q` in `M_Γ`, unconditionally.** -/\ntheorem cornerProjection_isFullProjection_localVonNeumannAlgebra :\n    IsFullProjection W.localVonNeumannAlgebra (R.cornerProjection W) :=\n  R.cornerProjection_isFullProjection W W.localVonNeumannAlgebra\n    W.representation_mem_localVonNeumannAlgebra\n\n/-- **The corner projection is nonzero, unconditionally.** -/\ntheorem cornerProjection_ne_zero_localVonNeumannAlgebra :\n    R.cornerProjection W ≠ 0 :=\n  R.cornerProjection_ne_zero W W.localVonNeumannAlgebra\n    W.representation_mem_localVonNeumannAlgebra\n\n/-- **Normalization `τ_q(q) = 1`, unconditionally.** -/\ntheorem vectorFunctional_cornerProjection_eq_one_localVonNeumannAlgebra :\n    vectorFunctional W.gnsVector (R.cornerProjection W) = 1 :=\n  R.vectorFunctional_cornerProjection_eq_one W W.localVonNeumannAlgebra\n    W.representation_mem_localVonNeumannAlgebra\n\n/--\n**The main theorem of this packet.**  For a finite-range consistent stabilizer system on a\ncountable locally finite lattice, a quasilocal completion `Q` and its global stabilizer\nstate `W`, the canonical corner projection `q` of the represented local code-space supports\nis a nonzero full projection of the manuscript's algebra `M_Γ = π_ω(𝒜_loc)''`, the corner\nvector state `τ_q` is a faithful tracial state on `q M_Γ q`, and the whole\n`SupportCornerConclusion` of FF20 holds — with **no** additional hypothesis.\n\n(The no-type-III conclusion is *not* asserted here; that is FF23.)\n-/\ntheorem supportCornerConclusion_localVonNeumannAlgebra :\n    SupportCornerConclusion W.localVonNeumannAlgebra (R.cornerProjection W) W.gnsVector :=\n  R.supportCornerConclusion W W.localVonNeumannAlgebra\n    W.representation_mem_localVonNeumannAlgebra\n    W.generatedByLocalAlgebra_localVonNeumannAlgebra\n\nend FiniteRangeStabilizerSystem\n\nend Assembly\n\nend FiniteFiber\n# Adversarial Review Protocol\n\nUse this before closing substantive Codex work. The goal is to find defects, not\nto summarize accomplishments.\n\n## Scope\n\n1. Identify the artifact types touched: `code`, `math`, `tex`, `computation`,\n   `source-backed`, `workflow`.\n2. Inspect the diff or new artifact against the user's request.\n3. Report findings by severity first. If there are no findings, say so and state\n   the remaining risk.\n\n## Universal Checks\n\n- Did the work answer the actual latest user request?\n- Did it modify unrelated files or broaden scope?\n- Did it overwrite, reformat, or revert pre-existing user changes?\n- Are generated files, caches, logs, plots, PDFs, or build artifacts handled\n  intentionally?\n- Are final claims stronger than the evidence supports?\n- Are verification commands actually relevant to the changed artifact?\n\n## Code Checks\n\n- Does the changed behavior match the stated interface and edge cases?\n- Are tests missing for a changed behavior, bug fix, parser, numerical routine,\n  CLI command, or user-facing workflow?\n- Are errors handled where inputs, files, network calls, or external tools can\n  fail?\n- Is there hidden global state, path sensitivity, nondeterminism, race risk, or\n  stale cache behavior?\n- Did dependency, config, or environment changes alter unrelated workflows?\n\n## Math Checks\n\n- Are all assumptions, domains, signs, conventions, normalizations, and boundary\n  conditions stated before use?\n- Are definitions used consistently throughout the derivation?\n- Is any implication actually reversible, or was a one-way statement used both\n  ways?\n- Are there division-by-zero, invertibility, regularity, convergence, branch-cut,\n  gauge, or boundary-term assumptions?\n- Do limiting cases, dimensions/units, symmetries, and known special cases agree?\n- Are symbolic substitutions justified rather than smuggling in the result?\n- Are claims labeled correctly as proof, derivation, check, conjecture, or\n  numerical evidence?\n\n## TeX And Source-Backed Checks\n\n- Does the document compile if compilation was expected?\n- Are labels, references, citations, bibliography entries, and figure paths valid?\n- Are source-backed claims tied to exact locators when required?\n- Is quoted or paraphrased material clearly separated from the agent's synthesis?\n- Does the exposition define terms before using them in load-bearing statements?\n\n## Computation Checks\n\n- Is the computation reproducible from a recorded command?\n- Are inputs, random seeds, versions, tolerances, and units documented when they\n  affect the result?\n- Are outputs interpreted correctly and not over-promoted beyond the computation?\n- Were independent sanity checks used where feasible: small cases, limiting\n  cases, dimensional analysis, symbolic identities, or alternate algorithms?\n\n## Closeout Template\n\nUse this structure internally, then surface the concise version to the user:\n\n```text\nFindings:\n- [severity] file/path:line - issue and consequence.\n\nChecks run:\n- command -> result.\n\nResidual risk:\n- what was not checked, or why the artifact is not a proof/complete validation.\n\nCleanup:\n- remaining dirty/untracked files and whether they are intentional.\n```\n","exit_code":0,"status":"completed"}}
