\\\n===== live existing relevant paths =====\\\\\\\\n'\\nrg --files FiniteFiber tests | rg 'FiniteRegionFullPauli|FullPauliMultiplication|AxiomAudit'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\nhistory/logs/20260806T180625Z-finite_fiber-f17e2043-codex.jsonl:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"CANDIDATE='../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF15-extracted/aristotle-finite_fiber-38r6u_k1_aristotle'\\nfor f in FiniteFiber/FiniteRegionFullPauliMultiplication.lean tests/FullPauliMultiplicationAxiomAudit.lean FiniteFiber.lean; do\\n  printf '\\\\\\\\n===== candidate %s =====\\\\\\\\n' \\\\\\\"\\\"'$f\\\"\\n  sed -n '\\\"'1,280p' \\\\\\\"\\\"'$CANDIDATE/$f\\\"\\ndone\\nprintf '\\\"'\\\\\\\\n===== candidate/live comparisons =====\\\\\\\\n'\\nfor f in FiniteFiber/FiniteRegionPhasedPauliMatrices.lean FiniteFiber/FiniteRegionEmbeddingCoherence.lean FiniteFiber/FullPauliLattice.lean FiniteFiber.lean tests/AxiomAudit.lean; do\\n  diff -u \\\\\\\"\\\"'$f\\\" \\\"$CANDIDATE/$f\\\" || true\\ndone\\nprintf '\\\"'\\\\\\\\n===== forbidden-token scan candidate module =====\\\\\\\\n'\\nrg -n '\\\\\\\\b(sorry|admit|axiom|opaque|unsafe|implemented_by|native_decide)\\\\\\\\b' \\\\\\\"\\\"'$CANDIDATE/FiniteFiber/FiniteRegionFullPauliMultiplication.lean\\\" \\\"$CANDIDATE/tests/FullPauliMultiplicationAxiomAudit.lean\\\" || true\\nprintf '\\\"'\\\\\\\\n===== live existing relevant paths =====\\\\\\\\n'\\nrg --files FiniteFiber tests | rg 'FiniteRegionFullPauli|FullPauliMultiplication|AxiomAudit'\\\"\",\"aggregated_output\":\"\\n===== candidate FiniteFiber/FiniteRegionFullPauliMultiplication.lean =====\\nimport FiniteFiber.FiniteRegionPhasedPauliMatrices\\nimport FiniteFiber.FiniteRegionEmbeddingCoherence\\n\\n/-!\\n# Finite-region multiplicativity of the full-Pauli normal form\\n\\nThis file supplies the finite-region operator-level bridge which\\n`FiniteFiber.FullPauliLattice` and `FiniteFiber.FiniteRegionPhasedPauliMatrices`\\ndeliberately left open: the raw normal-form matrices of a finite region\\nmultiply exactly as the algebraic normal form `FullPauliWord Site` does, with\\nthe phase correction given by the *existing* cocycle `FullPauliWord.cocycle`.\\n\\nThe development is in three steps.\\n\\n* One site: `normalFormOneSiteMatrix_mul` proves\\n  `X^{x₁} Z^{z₁} · X^{x₂} Z^{z₂} = (-1)^{z₁ x₂} X^{x₁+x₂} Z^{z₁+z₂}`,\\n  the single anticommutation input, with the sign written through the\\n  existing embedding `FullPauliWord.phaseEmbed`.\\n* Finite region, projective labels: `finiteRegionNormalFormMatrix_mul` uses the\\n  tensor factorization `finiteRegionTensorMatrix_mul` of a product of\\n  entrywise-product matrices to get\\n  `raw_F(p) · raw_F(q) = i ^ c_F(p,q) • raw_F(p+q)` with the summed sign\\n  `finiteRegionNormalFormCocycle`.\\n* Full words: `fullPauliRegionMatrix` attaches the scalar `zmod4PhaseFactor`\\n  of the central `ZMod 4` phase, and `fullPauliRegionMatrix_mul` is the exact\\n  identity `matrix (a * b) = matrix a * matrix b` for words supported in `F`.\\n  The identity word maps to `1` and the central word\\n  `FullPauliWord.negativeIdentity` maps to `(-1) • 1`.\\n\\nThe convention is the one already fixed by `OneSitePauliNormalForm`: the factor\\norder is `X` then `Z`, so the `(1,1)` one-site raw matrix is `-i · Y` and its\\nHermitian correction is `3 : ZMod 4`.  The cocycle is *not* redefined here: the\\nregion-level sign is proved equal to `FullPauliWord.cocycle` in\\n`cocycle_eq_finiteRegionNormalFormCocycle`.\\n\\nNothing else is claimed: no quasilocal completion, no state, no GNS\\nconstruction, and no infinite finite-projection theorem.\\n-/\\n\\nnamespace FiniteFiber\\n\\nopen scoped BigOperators\\n\\n/-! ### Two scalar computations -/\\n\\n/-- The defining formula of the sign embedding `ZMod 2 → ZMod 4`. -/\\ntheorem phaseEmbed_apply (c : ZMod 2) :\\n    FullPauliWord.phaseEmbed c = if c = 0 then 0 else 2 := rfl\\n\\n/-- The phase factor of the sign exponent `2` is `-1`. -/\\n@[simp] theorem zmod4PhaseFactor_two : zmod4PhaseFactor (2 : ZMod 4) = -1 := by\\n  have hval : (2 : ZMod 4).val = 2 := rfl\\n  rw [zmod4PhaseFactor, hval, pow_two, Complex.I_mul_I]\\n\\n/-- The phase factor attached to a binary sign exponent is `±1`. -/\\ntheorem zmod4PhaseFactor_phaseEmbed (c : ZMod 2) :\\n    zmod4PhaseFactor (FullPauliWord.phaseEmbed c) = if c = 0 then 1 else -1 := by\\n  by_cases hc : c = 0\\n  · rw [phaseEmbed_apply, if_pos hc, if_pos hc, zmod4PhaseFactor_zero]\\n  · rw [phaseEmbed_apply, if_neg hc, if_neg hc, zmod4PhaseFactor_two]\\n\\n/-! ### The one-site multiplication relation -/\\n\\nset_option maxHeartbeats 1000000 in\\n/--\\n**The one-site relation.**  With the convention `X` then `Z`, the raw\\nnormal-form matrices satisfy\\n\\n`X^{x₁} Z^{z₁} · X^{x₂} Z^{z₂} = (-1)^{z₁ x₂} · X^{x₁+x₂} Z^{z₁+z₂}`,\\n\\nthe sign being the `ZMod 2` product `z₁ x₂` transported by the existing\\nembedding `FullPauliWord.phaseEmbed`.\\n-/\\ntheorem normalFormOneSiteMatrix_mul (p q : ProjectivePauliLabel) :\\n    normalFormOneSiteMatrix p * normalFormOneSiteMatrix q =\\n      zmod4PhaseFactor (FullPauliWord.phaseEmbed (p.2 * q.1)) •\\n        normalFormOneSiteMatrix (p + q) := by\\n  obtain ⟨x₁, z₁⟩ := p\\n  obtain ⟨x₂, z₂⟩ := q\\n  fin_cases x₁ <;> fin_cases z₁ <;> fin_cases x₂ <;> fin_cases z₂ <;>\\n    · ext i j\\n      fin_cases i <;> fin_cases j <;>\\n        norm_num +decide [normalFormOneSiteMatrix, zmod4PhaseFactor_phaseEmbed,\\n          PauliLabel.matrix, Matrix.mul_apply, Fin.sum_univ_succ,\\n          Matrix.one_fin_two, Prod.ext_iff]\\n\\n/-! ### Multiplication of finite-region tensor matrices -/\\n\\nvariable {Site : Type*} [DecidableEq Site]\\n\\n/--\\nThe finite-region matrix built entrywise from one-site matrices, i.e. the\\ntensor product `⨂ i ∈ F, A i` written in the computational basis.\\n-/\\nnoncomputable def finiteRegionTensorMatrix\\n    (F : Finset Site) (A : ↥F → Matrix (Fin 2) (Fin 2) ℂ) :\\n    finiteRegionQubitAlgebra F :=\\n  fun x y => ∏ i : ↥F, A i (x i) (y i)\\n\\n/--\\n**The finite tensor/product factorization.**  A product of finite-region\\ntensor matrices is the tensor matrix of the sitewise products.\\n-/\\ntheorem finiteRegionTensorMatrix_mul\\n    (F : Finset Site) (A B : ↥F → Matrix (Fin 2) (Fin 2) ℂ) :\\n    finiteRegionTensorMatrix F A * finiteRegionTensorMatrix F B =\\n      finiteRegionTensorMatrix F (fun i => A i * B i) := by\\n  classical\\n  funext x z\\n  rw [Matrix.mul_apply]\\n  simp only [finiteRegionTensorMatrix]\\n  have hentry : ∀ i : ↥F,\\n      (A i * B i) (x i) (z i) = ∑ t : Fin 2, A i (x i) t * B i t (z i) := by\\n    intro i\\n    rw [Matrix.mul_apply]\\n  rw [Finset.prod_congr rfl fun i _ => hentry i]\\n  rw [Finset.prod_univ_sum (fun _ : ↥F => (Finset.univ : Finset (Fin 2)))\\n    (fun i t => A i (x i) t * B i t (z i))]\\n  rw [Fintype.piFinset_univ]\\n  exact Finset.sum_congr rfl fun y _ => (Finset.prod_mul_distrib).symm\\n\\n/-! ### Multiplication of finite-region projective normal-form matrices -/\\n\\n/--\\nThe summed finite-region sign exponent of two projective label functions: the\\n`ZMod 4` exponent recording, site by site, the `Z`-past-`X` crossings.\\n-/\\nnoncomputable def finiteRegionNormalFormCocycle\\n    (F : Finset Site) (p q : ↥F → ProjectivePauliLabel) : ZMod 4 :=\\n  ∑ i : ↥F, FullPauliWord.phaseEmbed ((p i).2 * (q i).1)\\n\\nomit [DecidableEq Site] in\\n/-- The raw normal-form matrix is the tensor matrix of the one-site raw matrices. -/\\ntheorem finiteRegionNormalFormMatrix_eq_tensor\\n    (F : Finset Site) (p : ↥F → ProjectivePauliLabel) :\\n    finiteRegionNormalFormMatrix F p =\\n      finiteRegionTensorMatrix F (fun i => normalFormOneSiteMatrix (p i)) := rfl\\n\\n/--\\n**Finite-region projective multiplication.**  The raw normal-form matrices of\\na finite region multiply with the summed sign exponent\\n`finiteRegionNormalFormCocycle`.\\n-/\\ntheorem finiteRegionNormalFormMatrix_mul\\n    (F : Finset Site) (p q : ↥F → ProjectivePauliLabel) :\\n    finiteRegionNormalFormMatrix F p * finiteRegionNormalFormMatrix F q =\\n      zmod4PhaseFactor (finiteRegionNormalFormCocycle F p q) •\\n        finiteRegionNormalFormMatrix F (p + q) := by\\n  classical\\n  rw [finiteRegionNormalFormMatrix_eq_tensor, finiteRegionNormalFormMatrix_eq_tensor,\\n    finiteRegionTensorMatrix_mul]\\n  funext x y\\n  simp only [finiteRegionTensorMatrix, finiteRegionNormalFormMatrix,\\n    finiteRegionNormalFormCocycle, Matrix.smul_apply, smul_eq_mul,\\n    zmod4PhaseFactor_sum, ← Finset.prod_mul_distrib]\\n  refine Finset.prod_congr rfl fun i _ => ?_\\n  rw [normalFormOneSiteMatrix_mul (p i) (q i)]\\n  simp [Matrix.smul_apply]\\n\\n/-! ### The region sign exponent is the existing cocycle -/\\n\\nomit [DecidableEq Site] in\\n/-- The `X` coordinate of a projective word is its sitewise first component. -/\\ntheorem xCoordinate_apply (w : ProjectivePauliWord Site) (i : Site) :\\n    FullPauliWord.xCoordinate w i = (w i).1 := rfl\\n\\nomit [DecidableEq Site] in\\n/-- The `Z` coordinate of a projective word is its sitewise second component. -/\\ntheorem zCoordinate_apply (w : ProjectivePauliWord Site) (i : Site) :\\n    FullPauliWord.zCoordinate w i = (w i).2 := rfl\\n\\nomit [DecidableEq Site] in\\n/--\\nFor a left argument supported in the finite region `F`, the binary dot product\\nis the plain sum of pointwise products over `F`.\\n-/\\ntheorem binaryDot_eq_sum_of_support_subset\\n    (F : Finset Site) (u v : Site →₀ ZMod 2) (hu : u.support ⊆ F) :\\n    FullPauliWord.binaryDot u v = ∑ i ∈ F, u i * v i := by\\n  classical\\n  have hsum : FullPauliWord.binaryDot u v = u.sum (fun i c => c * v i) := rfl\\n  rw [hsum, Finsupp.sum_of_support_subset u hu (fun i c => c * v i)\\n    (fun i _ => by simp)]\\n\\n/-- The projective label of a full Pauli word restricted to a finite region. -/\\nnoncomputable def restrictLabel (F : Finset Site) (w : ProjectivePauliWord Site) :\\n    ↥F → ProjectivePauliLabel := fun i => w i.val\\n\\nomit [DecidableEq Site] in\\n/-- Restriction to a region turns the sum of words into the pointwise sum. -/\\ntheorem restrictLabel_add (F : Finset Site) (u v : ProjectivePauliWord Site) :\\n    restrictLabel F (u + v) = restrictLabel F u + restrictLabel F v := rfl\\n\\nomit [DecidableEq Site] in\\n/--\\n**The region sign exponent is the manuscript cocycle.**  For a left word whose\\nsupport lies in `F`, the summed finite-region exponent of the restricted\\nlabels equals the already existing `FullPauliWord.cocycle`.\\n-/\\ntheorem cocycle_eq_finiteRegionNormalFormCocycle\\n    (F : Finset Site) (u v : ProjectivePauliWord Site) (hu : u.support ⊆ F) :\\n    FullPauliWord.cocycle u v =\\n      finiteRegionNormalFormCocycle F (restrictLabel F u) (restrictLabel F v) := by\\n  classical\\n  have hsupp : (FullPauliWord.zCoordinate u).support ⊆ F := by\\n    intro i hi\\n    apply hu\\n    rw [Finsupp.mem_support_iff] at hi ⊢\\n    intro h\\n    exact hi (by rw [zCoordinate_apply, h]; rfl)\\n  rw [FullPauliWord.cocycle,\\n    binaryDot_eq_sum_of_support_subset F _ _ hsupp]\\n  rw [map_sum]\\n  have hcoe : finiteRegionNormalFormCocycle F (restrictLabel F u) (restrictLabel F v) =\\n      ∑ i ∈ F, FullPauliWord.phaseEmbed ((u i).2 * (v i).1) :=\\n    Finset.sum_coe_sort F (fun i => FullPauliWord.phaseEmbed ((u i).2 * (v i).1))\\n  rw [hcoe]\\n  exact Finset.sum_congr rfl fun i _ => by\\n    rw [zCoordinate_apply, xCoordinate_apply]\\n\\n/-! ### The full-word finite-region matrix -/\\n\\n/--\\nThe finite-region matrix of a full Pauli word `i^phase X^x Z^z`: the scalar\\nphase factor `i ^ phase` times the raw normal-form matrix of the restricted\\nprojective label.\\n-/\\nnoncomputable def fullPauliRegionMatrix\\n    (F : Finset Site) (a : FullPauliWord Site) : finiteRegionQubitAlgebra F :=\\n  zmod4PhaseFactor a.phase • finiteRegionNormalFormMatrix F (restrictLabel F a.label)\\n\\n/--\\n**The finite-region full-Pauli multiplication theorem.**  For a word `a`\\nsupported in the finite region `F` and an arbitrary word `b`, the finite-region\\nmatrices multiply exactly:\\n\\n`matrix (a * b) = matrix a * matrix b`,\\n\\nthe phase correction being precisely `FullPauliWord.cocycle a.label b.label`.\\nOnly the support hypothesis on the *left* factor is needed, since the cocycle\\nsums the `Z` coordinate of `a` against the `X` coordinate of `b`; in\\nparticular the identity holds for any two words supported in `F`.\\n-/\\ntheorem fullPauliRegionMatrix_mul\\n    (F : Finset Site) (a b : FullPauliWord Site) (ha : a.label.support ⊆ F) :\\n    fullPauliRegionMatrix F (a * b) =\\n      fullPauliRegionMatrix F a * fullPauliRegionMatrix F b := by\\n  classical\\n  have hphase : (a * b).phase =\\n      a.phase + b.phase + FullPauliWord.cocycle a.label b.label := rfl\\n  have hlabel : (a * b).label = a.label + b.label := rfl\\n  rw [fullPauliRegionMatrix, fullPauliRegionMatrix, fullPauliRegionMatrix,\\n    hphase, hlabel, restrictLabel_add, Matrix.smul_mul, Matrix.mul_smul,\\n    finiteRegionNormalFormMatrix_mul, smul_smul, smul_smul,\\n    zmod4PhaseFactor_add, zmod4PhaseFactor_add,\\n    cocycle_eq_finiteRegionNormalFormCocycle F a.label b.label ha]\\n\\n/-- The identity full Pauli word is represented by the identity matrix. -/\\ntheorem fullPauliRegionMatrix_one (F : Finset Site) :\\n    fullPauliRegionMatrix F (1 : FullPauliWord Site) = 1 := by\\n  have hphase : (1 : FullPauliWord Site).phase = 0 := rfl\\n  have hlabel : restrictLabel F (1 : FullPauliWord Site).label = fun _ => 0 := rfl\\n  rw [fullPauliRegionMatrix, hphase, hlabel, zmod4PhaseFactor_zero, one_smul,\\n    finiteRegionNormalFormMatrix_zero]\\n\\n/-- The central word `-1` is represented by the scalar `-1` times the identity. -/\\ntheorem fullPauliRegionMatrix_negativeIdentity (F : Finset Site) :\\n    fullPauliRegionMatrix F (FullPauliWord.negativeIdentity (Site := Site)) =\\n      (-1 : ℂ) • 1 := by\\n  have hphase : (FullPauliWord.negativeIdentity (Site := Site)).phase = 2 := rfl\\n  have hlabel :\\n      restrictLabel F (FullPauliWord.negativeIdentity (Site := Site)).label =\\n        fun _ => 0 := rfl\\n  rw [fullPauliRegionMatrix, hphase, hlabel, zmod4PhaseFactor_two,\\n    finiteRegionNormalFormMatrix_zero]\\n\\nend FiniteFiber\\n\\n===== candidate tests/FullPauliMultiplicationAxiomAudit.lean =====\\nimport FiniteFiber.FiniteRegionFullPauliMultiplication\\n\\n/-!\\n# Axiom audit for the finite-region full-Pauli multiplication theorems\\n\\nRun with `lake env lean tests/FullPauliMultiplicationAxiomAudit.lean`.  The\\nexpected output contains only Lean's standard logical axioms (`propext`,\\n`Classical.choice`, and `Quot.sound`), and no project-local axioms.\\n-/\\n\\n#print axioms FiniteFiber.normalFormOneSiteMatrix_mul\\n#print axioms FiniteFiber.finiteRegionTensorMatrix_mul\\n#print axioms FiniteFiber.finiteRegionNormalFormMatrix_mul\\n#print axioms FiniteFiber.binaryDot_eq_sum_of_support_subset\\n#print axioms FiniteFiber.cocycle_eq_finiteRegionNormalFormCocycle\\n#print axioms FiniteFiber.fullPauliRegionMatrix_mul\\n#print axioms FiniteFiber.fullPauliRegionMatrix_one\\n#print axioms FiniteFiber.fullPauliRegionMatrix_negativeIdentity\\n\\n===== candidate FiniteFiber.lean =====\\nimport FiniteFiber.Basic\\nimport FiniteFiber.TracialCorner\\nimport FiniteFiber.FiniteFibers\\nimport FiniteFiber.StrongSupport\\nimport FiniteFiber.VectorCorner\\nimport FiniteFiber.GNSVector\\nimport FiniteFiber.GNSOrbit\\nimport FiniteFiber.FiniteStabilizer\\nimport FiniteFiber.FiniteStabilizerTrace\\nimport FiniteFiber.StabilizerSequence\\nimport FiniteFiber.StabilizerFiniteFiber\\nimport FiniteFiber.FinitePauli\\nimport FiniteFiber.FiniteQubitMatrix\\nimport FiniteFiber.FiniteDensity\\nimport FiniteFiber.FinitePauliStabilizer\\nimport FiniteFiber.FinitePauliGNS\\nimport FiniteFiber.FiniteLocalPauli\\nimport FiniteFiber.FiniteNestedPauli\\nimport FiniteFiber.FiniteLocalGroupSupport\\nimport FiniteFiber.ProjectivePauliLattice\\nimport FiniteFiber.FullPauliLattice\\nimport FiniteFiber.OneSitePauliNormalForm\\nimport FiniteFiber.FiniteTensorMatrixChain\\nimport FiniteFiber.FiniteRegionQubitAlgebra\\nimport FiniteFiber.FiniteRegionPauliMatrices\\nimport FiniteFiber.FiniteRegionEmbeddingCoherence\\nimport FiniteFiber.FiniteRegionPhasedPauliMatrices\\nimport FiniteFiber.FiniteNestedTensorState\\nimport FiniteFiber.FiniteStabilizerStateChain\\nimport FiniteFiber.SequentialLocalFunctional\\nimport FiniteFiber.CountablePauliRepresentation\\n\\n===== candidate/live comparisons =====\\n\\n===== forbidden-token scan candidate module =====\\n\\n===== live existing relevant paths =====\\ntests/AxiomAudit.lean\\nFiniteFiber/FiniteRegionFullPauliMultiplication.lean\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nhistory/logs/20260806T180625Z-finite_fiber-f17e2043-codex.jsonl:13:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"agent_message\",\"text\":\"The response was already archived and extracted in the designated quarantine area. Its only candidate source is byte-identical to the live untracked module; I’m treating that as a candidate already staged by the supervisor, not as permission to adopt the archive’s other metadata. I’m now checking the proof’s dependencies and live builds.\"}}\nhistory/logs/20260806T180625Z-finite_fiber-f17e2043-codex.jsonl:15:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"rg -n 'FF13|FF14|FiniteRegionPhased|FiniteRegionEmbedding|FullPauli|AxiomAudit|Status discipline' HANDOFF.md\\nsed -n '140,360p' HANDOFF.md\\nsed -n '1,240p' tests/AxiomAudit.lean\\nsed -n '1,220p' lakefile.lean\\nrg -n '\\\\\\\\b(sorry|admit|axiom|opaque|unsafe|implemented_by|native_decide)\\\\\\\\b' FiniteFiber/FiniteRegionFullPauliMultiplication.lean tests/FullPauliMultiplicationAxiomAudit.lean || true\\nrg -n 'finiteRegionNormalFormMatrix|zmod4PhaseFactor_sum|finiteRegionTensorMatrix|finiteRegionNormalFormMatrix_zero|cocycle|phaseEmbed' FiniteFiber/FiniteRegionPhasedPauliMatrices.lean FiniteFiber/FullPauliLattice.lean FiniteFiber/FiniteRegionPauliMatrices.lean FiniteFiber/OneSitePauliNormalForm.lean\\\"\",\"aggregated_output\":\"21:16. `FiniteFiber/FullPauliLattice.lean`.\\n118:`ProjectivePauliLattice.lean` and `FullPauliLattice.lean` now construct the\\n225:multiply `FullPauliWord`: the `i^phase X^x Z^z` normal form still needs its\\n249:reuse `FullPauliWord.phaseEmbed`, which is the distinct sign map\\n294:## Status discipline\\n321:lake build FiniteFiber.FullPauliLattice\\n337:lake env lean tests/AxiomAudit.lean\\n361:## FF13--FF14 integration\\n363:FF13 and FF14 are integrated and independently adversarially approved.\\n364:`FiniteRegionPhasedPauliMatrices.lean` proves the finite-region summed-phase\\n365:normal form and identity padding. `FiniteRegionEmbeddingCoherence.lean`\\n374:lake env lean FiniteFiber/FiniteRegionEmbeddingCoherence.lean\\n375:lake env lean FiniteFiber/FiniteRegionPhasedPauliMatrices.lean\\n376:lake build FiniteFiber.FiniteRegionEmbeddingCoherence\\n377:lake build FiniteFiber.FiniteRegionPhasedPauliMatrices\\n379:lake env lean tests/AxiomAudit.lean\\nprevious candidate-only local-instance limitation.  It remains independent of\\nthe full Pauli/stabilizer matrix realization and has no multi-region\\ncoherence, colimit, state, or GNS claim.\\n`FiniteNestedTensorState.lean` uses this to derive the tensor decomposition\\nof literal-coordinate nested stabilizer data, then proves its finite-density\\nand state compatibility.  `FiniteStabilizerStateChain.lean` defines longer\\ntransitions by `Nat.leRecOn` from physical one-site inclusions.  It proves\\ntheir identity and composition laws at the typed endpoints, preserves the\\nunital star-algebra structure and the finite operator norm, and proves\\ninjectivity; the resulting linear maps are a checked `DirectedSystem`.  A\\nstepwise compatible family of actual\\nfinite stabilizer densities restricts along every such transition.  Its\\nendpoint-to-added-block theorem identifies the maps with the original\\nlength-indexed recursion and transfers the checked signed-Pauli padding law.\\nFinally,\\n`SequentialLocalFunctional.lean` descends these compatible values to the\\ncorresponding `Module.DirectLimit` as a complex-linear functional.  It does\\nnot construct multiplication or star on that quotient, positivity there, a\\nnorm completion, or a quasilocal state.\\n\\n## I004 countable-representation status\\n\\n`CountablePauliRepresentation.lean` is the beginning of the subsequent\\ncountable-lattice realization.  It defines the discrete countable binary\\nconfiguration Hilbert space, count-measure translation operators, and bounded\\none-site phase multipliers.  It proves their almost-everywhere action formulas,\\ntranslation norm preservation, the zero-shift identity, translation\\ncomposition, and the complete elementary `X`/`Z` generator relations:\\ninvolution, same-family commutation, same-site anticommutation, and\\ndistinct-site mixed commutation.  It also proves the additive initial/tail\\n`Finsupp.filter` decomposition of configurations, including recomposition,\\nthe two coordinate-vanishing properties, and the restrictions of a one-site\\ngenerator to its appropriate side of a cut.  This is not yet an $L^2$\\nfactorization.  The package does not yet prove a full phased Pauli\\nrepresentation, the finite/tail matrix-algebra factorization, a concrete local\\nstar-subalgebra chain, a norm-closed quasi-local algebra, or a global state.\\nThe detailed resume record is\\n`../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/HANDOFF.md`.\\nThe independent I004 reviews are at\\n`../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/reviews/`.\\nThe final live FF05--FF07 closeout review is at\\n`../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF05-FF07-live-closeout-adversarial-review.md`.\\nFF08, project `5a41c5b2-24ef-4f49-9d6f-03e203a80ff3`, is accepted and\\nintegrated.  Its quarantined archive contributes only the additive initial/tail\\nsplit of `CountablePauliConfiguration`; the remote README attribution,\\nstale HANDOFF deletion, and metadata were rejected.  The review is at\\n`../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_responses/FF08-integration-adversarial-review.md`.\\nFF09 is a remote-only candidate, project\\n`f78a4014-b751-45d0-af0a-b1e8a9e32c11`: it asks only for the additive\\nequivalence between the checked initial/tail configuration subgroups and has\\nnot been retrieved or integrated.\\n\\nFF09 was subsequently set aside as off-track for the finite-fiber theorem:\\nit remains remote-only and must not be retrieved or integrated merely because\\nit completes an additive configuration decomposition.  FF10, project\\n`88d5f994-e829-4ded-b04a-b38c650e4f8b`, has been accepted and integrated as\\n`FiniteFiber/FiniteRegionQubitAlgebra.lean`.  Its archive SHA-256 is\\n`7ca2f97893a1fc872626a0a7095b14887504c36939aa3b1e584cf086b0fa5778`; the\\nremote snapshot remains quarantined under `aristotle_responses/FF10-extracted/`.\\nOnly its candidate Lean file was used.  The returned local C-star instance was\\npromoted to a named scoped instance so that the public norm theorem is usable\\nby downstream files.  The module gives arbitrary finite-region qubit matrix\\nalgebras and the one-inclusion `F \\\\subseteq F'` map `A \\\\mapsto A \\\\otimes 1`;\\nit does not assert Pauli/stabilizer realization, triple-region coherence, a\\ndirected colimit, quasilocal closure, state/GNS data, or the finite-fiber\\ntheorem.  The task and its prompt review are under\\n`../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_tasks/FF10-finite-region-qubit-local-algebras.md`\\nand `aristotle_responses/FF10-prompt-adversarial-review.md`; the post-result\\nreview is `aristotle_responses/FF10-integration-adversarial-review.md`.\\n\\nFF11, project `76d70d89-bf7a-490b-a1ee-6c3512437110`, was accepted and\\nintegrated on August 5, 2026 as `FiniteFiber/FiniteRegionPauliMatrices.lean`.\\nIts archive SHA-256 is\\n`acaaeac3024447b211faf050224b9146e978d90c105da094a22b9226d84b529a` and the\\ncomplete remote snapshot remains quarantined under\\n`aristotle_responses/FF11-extracted/`.  Only\\n`AristotleCandidates/FiniteRegionPauliMatrices.lean` was integrated; it is\\nbyte-identical to the live source.  The remote README attribution insertion,\\nstale deletion of the FF11 handoff status, `ARISTOTLE_SUMMARY.md`, and its\\nunverified claim of a commit/push were rejected.\\n\\nThe module realizes a phase-free Hermitian `PauliLabel` string as the\\ncoordinate-free product of one-site matrix entries on every finite-region\\nbasis.  It proves the all-identity and self-adjoint facts and that\\n`finiteRegionEmbed` pads labels by `I`.  It deliberately does not represent or\\nmultiply `FullPauliWord`: the `i^phase X^x Z^z` normal form still needs its\\nfinite-region `ZMod 4`/Y-count phase aggregation.  No syntactic support/local-algebra\\nidentification, triple-region coherence, colimit, state/GNS, or finite-fiber\\nclaim is made.  Both independent reviews approve the surgical integration;\\nthe task, prompt review, and post-result review are at\\n`../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_tasks/FF11-finite-region-pauli-matrices.md`,\\n`aristotle_responses/FF11-prompt-adversarial-review.md`, and\\n`aristotle_responses/FF11-integration-adversarial-review.md`.\\n\\nFF12, project `c091ae7a-c696-4863-a46f-72c8ab6ca624`, was accepted and\\nintegrated on August 5, 2026 as `FiniteFiber/OneSitePauliNormalForm.lean`.\\nIts archive SHA-256 is\\n`624b130a2c08061fa8f60edf33397c5a2dd82b4817569c0acdcd7f14c9da6cbf` and its\\ncomplete remote snapshot remains quarantined under\\n`aristotle_responses/FF12-extracted/`.  Only\\n`AristotleCandidates/OneSitePauliNormalForm.lean` was integrated; it is\\nbyte-identical to the live source with SHA-256\\n`6d9e4ae4f3c0ae3a3c3b9d35322d42ddd8d518a07f75441b6b1a61a3984cfc99`.  The\\nremote README attribution insertion, stale removal of the live FF12 status\\nfrom the handoff, and `ARISTOTLE_SUMMARY.md` were rejected.\\n\\nThe module proves the one-site conversion from the Hermitian representative\\nto the raw normal form: `X Z = i^3 Y = -iY`.  Its phase correction is\\nnonadditive and equals `3` only at the projective `Y` coordinate; it does not\\nreuse `FullPauliWord.phaseEmbed`, which is the distinct sign map\\n`1 ↦ 2`.  It does not define a finite-region or full-word representation,\\nprove multiplication or cocycle compatibility, identify syntactic support\\nwith local-algebra membership, or claim coherence, a colimit, state/GNS, or\\nthe finite-fiber theorem.  Both independent post-result reviews approve the\\nintegration.  The task, prompt review, and post-result review are at\\n`../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I004-countable-pauli-quasilocal-realization/aristotle_tasks/FF12-one-site-pauli-normal-form.md`,\\n`aristotle_responses/FF12-prompt-adversarial-review.md`, and\\n`aristotle_responses/FF12-integration-adversarial-review.md`.\\n\\nA later global stabilizer/GNS layer must still establish:\\n\\n1. the actual countable-lattice Pauli/stabilizer realization in the checked\\n   finite-region algebras, including a proof that finite support containment\\n   is the manuscript's local-algebra membership condition;\\n2. aggregation of the now checked one-site `ZMod 4` correction over arbitrary\\n   finite regions, its exact padding behavior, and then a full matrix\\n   realization of the phased normal form compatible with its cocycle.  The\\n   literal ordered-block factorization and syntactic discarded-label detection\\n   for an enumerated complement are checked, but no countable-lattice\\n   local-algebra identification follows yet;\\n3. a noncommutative star-algebra colimit on the coherent finite system, then a\\n   norm-closed quasilocal algebra and a positive global state.  The current\\n   module direct limit and its functional are intentionally weaker than this;\\n4. construction of the quasi-local state whose generic GNS vector is supplied\\n   by `GNSVector.lean`, together with compatibility strong enough to lift the\\n   finite `FinitePauliGNS.lean` stabilizer-invariance result to every global\\n   local stabilizer;\\n5. the regional/complementary GNS product-orbit density statement;\\n6. corner traciality from finite matrix traces, bounded strong continuity, and\\n   Kaplansky density;\\n6. any direct-integral or type-III conclusion.\\n\\nNone of those six upstream facts should be marked proved until represented by\\nchecked Lean code.\\n\\n## Upstream-mathlib direction\\n\\nMathlib v4.28 supplies `VonNeumannAlgebra H` and `IsStarProjection`, but not\\nthe finite-projection/Murray--von Neumann/type vocabulary used here.  Candidate\\nupstream paths are under `Mathlib/Analysis/VonNeumannAlgebra/`.  Before an\\nupstream PR, replace the provisional `FiniteFiber` names by names agreed with\\nmathlib maintainers and split generic star-algebra lemmas from concrete\\nvon-Neumann-algebra statements.\\n\\n## Status discipline\\n\\n- A passing Lean build proves only the named abstract theorem.\\n- A compiled TeX note is not proof of the mathematics.\\n- An adversarial mathematical-fidelity review is required after every\\n  substantive theorem/API change.\\n\\n## Current verification record\\n\\nThe checked finite-group/support-corner core is complete as of August 3, 2026.  Reproduce its\\nverification from this package directory with:\\n\\n```bash\\nlake build FiniteFiber.Basic\\nlake build FiniteFiber.TracialCorner\\nlake build FiniteFiber.FiniteFibers\\nlake build FiniteFiber.FiniteStabilizer\\nlake build FiniteFiber.FiniteStabilizerTrace\\nlake build FiniteFiber.FinitePauli\\nlake build FiniteFiber.FiniteQubitMatrix\\nlake build FiniteFiber.FiniteDensity\\nlake build FiniteFiber.FinitePauliStabilizer\\nlake build FiniteFiber.FinitePauliGNS\\nlake build FiniteFiber.FiniteLocalPauli\\nlake build FiniteFiber.FiniteNestedPauli\\nlake build FiniteFiber.FiniteLocalGroupSupport\\nlake build FiniteFiber.ProjectivePauliLattice\\nlake build FiniteFiber.FullPauliLattice\\nlake build FiniteFiber.OneSitePauliNormalForm\\nlake build FiniteFiber.FiniteTensorMatrixChain\\nlake build FiniteFiber.FiniteRegionQubitAlgebra\\nlake build FiniteFiber.FiniteRegionPauliMatrices\\nlake build FiniteFiber.FiniteNestedTensorState\\nlake build FiniteFiber.FiniteStabilizerStateChain\\nlake build FiniteFiber.SequentialLocalFunctional\\nlake build FiniteFiber.CountablePauliRepresentation\\nlake build FiniteFiber.StrongSupport\\nlake build FiniteFiber.StabilizerSequence\\nlake build FiniteFiber.VectorCorner\\nlake build FiniteFiber.GNSVector\\nlake build FiniteFiber.GNSOrbit\\nlake build FiniteFiber.StabilizerFiniteFiber\\nlake build\\nlake env lean tests/AxiomAudit.lean\\n```\\n\\nThe audit is expected to report only `propext`, `Classical.choice`, and\\n`Quot.sound`.  The independent closeout reports are at:\\n\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I001-full-tracial-corner/reviews/math_fidelity_review.md`\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I001-full-tracial-corner/reviews/lean_api_review.md`\\n\\nThe approved I002 adversarial reports are:\\n\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I002-stabilizer-gns-realization/reviews/math_fidelity_review.md`\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I002-stabilizer-gns-realization/reviews/lean_api_review.md`\\n\\nThe I003 finite-Pauli/density investigation and its adversarial reports are:\\n\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I003-finite-pauli-density-realization/technical.tex`\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I003-finite-pauli-density-realization/reviews/math_fidelity_review.md`\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I003-finite-pauli-density-realization/reviews/lean_api_review.md`\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I003-finite-pauli-density-realization/reviews/finite_sequential_directed_system_math_fidelity_review.md`\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I003-finite-pauli-density-realization/reviews/finite_sequential_directed_system_lean_api_review.md`\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I003-finite-pauli-density-realization/reviews/finite_sequential_norm_math_fidelity_review.md`\\n- `../work/2026-08-finite-fiber-von-neumann-formalization/investigations/I003-finite-pauli-density-realization/reviews/finite_sequential_norm_lean_api_review.md`\\n\\nimport FiniteFiber\\n\\nopen scoped FiniteFiber.FiniteRegionQubitMatrix\\n\\n/-!\\n# Axiom audit for the public support-corner theorems\\n\\nRun with `lake env lean tests/AxiomAudit.lean`.  The expected output contains\\nonly Lean's standard logical axioms (`propext`, `Classical.choice`, and\\n`Quot.sound`), and no project-local axioms.\\n-/\\n\\n#print axioms FiniteFiber.finite_of_subprojection_of_faithful_tracial_corner\\n#print axioms FiniteFiber.central_mul_finite_of_faithful_tracial_corner\\n#print axioms FiniteFiber.full_tracial_corner_semifinite\\n#print axioms FiniteFiber.canonical_central_witness_of_full_tracial_corner\\n#p