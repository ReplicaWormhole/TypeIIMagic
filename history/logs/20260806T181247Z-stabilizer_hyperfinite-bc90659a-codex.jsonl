{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,115p' Formalization/AlgebraicLimitStarHom.lean && sed -n '110,155p' .lake/packages/mathlib/Mathlib/Order/DirectedInverseSystem.lean && printf '\\\\n--- candidate theorem declarations ---\\\\n' && rg -n '\"'^(noncomputable def|theorem|structure|namespace)'\"' AristotleCandidates/AlgebraicLimitOperatorRepresentation.lean && printf '\\\\n--- forbidden declaration scan all integrated P37-only paths ---\\\\n' && rg -n '\\\\b(sorry|admit|axiom|opaque|unsafe|implemented_by|native_decide)\\\\b' AristotleCandidates/AlgebraicLimitOperatorRepresentation.lean aristotle_responses/P37-extracted/aristotle-stabilizer_hyperfinite-y537ze25_aristotle/ARISTOTLE_SUMMARY.md || true\"","aggregated_output":"      exact (star_of i x).symm }\n\n@[simp]\ntheorem algebraicLimitStageStarAlgHom_apply (i : ι) (x : A i) :\n    algebraicLimitStageStarAlgHom (f := f) i x =\n      DirectLimit.Module.of ℂ ι A f i x :=\n  rfl\n\n/-- The star-algebra map induced by compatible maps on a directed system of\nfinite stages. -/\nnoncomputable def algebraicLimitStarAlgHom\n    (g : ∀ i, A i →⋆ₐ[ℂ] B)\n    (compatible : ∀ i j (h : i ≤ j) x, g j (f i j h x) = g i x) :\n    DirectLimit A f →⋆ₐ[ℂ] B :=\n  let lift : DirectLimit A f →+* B :=\n    DirectLimit.Ring.lift A f B (fun i => (g i).toRingHom) compatible\n  { lift with\n    commutes' := by\n      intro c\n      let i : ι := Classical.arbitrary ι\n      rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,\n        DirectLimit.one_def i, DirectLimit.smul_def]\n      change lift (DirectLimit.Ring.of A f i (c • (1 : A i))) = c • (1 : B)\n      rw [DirectLimit.Ring.lift_of]\n      simpa only [Algebra.algebraMap_eq_smul_one] using (g i).commutes c\n    map_star' := by\n      intro z\n      induction z using DirectLimit.induction with\n      | _ i x =>\n        change lift (star (DirectLimit.Module.of ℂ ι A f i x)) =\n          star (lift (DirectLimit.Module.of ℂ ι A f i x))\n        rw [star_of]\n        change lift (DirectLimit.Ring.of A f i (star x)) =\n          star (lift (DirectLimit.Ring.of A f i x))\n        rw [DirectLimit.Ring.lift_of, DirectLimit.Ring.lift_of]\n        exact (g i).map_star' x }\n\n/-- The induced map has the prescribed value on every finite-stage element. -/\n@[simp]\ntheorem algebraicLimitStarAlgHom_of\n    (g : ∀ i, A i →⋆ₐ[ℂ] B)\n    (compatible : ∀ i j (h : i ≤ j) x, g j (f i j h x) = g i x)\n    (i : ι) (x : A i) :\n    algebraicLimitStarAlgHom g compatible (DirectLimit.Module.of ℂ ι A f i x) = g i x :=\n  by\n    change DirectLimit.Ring.lift A f B (fun i => (g i).toRingHom) compatible\n      (DirectLimit.Ring.of A f i x) = g i x\n    exact DirectLimit.Ring.lift_of _ _ _ _ _\n\n/-- Compatible finite-stage star-algebra maps determine at most one\nstar-algebra map out of the algebraic direct limit. -/\ntheorem algebraicLimitStarAlgHom_unique\n    (g : ∀ i, A i →⋆ₐ[ℂ] B)\n    (compatible : ∀ i j (h : i ≤ j) x, g j (f i j h x) = g i x)\n    (phi : DirectLimit A f →⋆ₐ[ℂ] B)\n    (h_phi : ∀ i x, phi (DirectLimit.Module.of ℂ ι A f i x) = g i x) :\n    phi = algebraicLimitStarAlgHom g compatible := by\n  apply StarAlgHom.ext\n  intro z\n  induction z using DirectLimit.induction with\n  | _ i x =>\n    change phi (DirectLimit.Module.of ℂ ι A f i x) =\n      algebraicLimitStarAlgHom g compatible (DirectLimit.Module.of ℂ ι A f i x)\n    rw [algebraicLimitStarAlgHom_of]\n    exact h_phi i x\n\nsection Equivalences\n\nvariable {D : ι → Type*}\nvariable [∀ i, Semiring (D i)] [∀ i, StarRing (D i)] [∀ i, Algebra ℂ (D i)]\nvariable {h : ∀ i j : ι, i ≤ j → D i →⋆ₐ[ℂ] D j}\nvariable [DirectedSystem D (h · · ·)]\n\n/-- Compatible finite-stage star-algebra equivalences induce a star-algebra\nequivalence of the corresponding algebraic directed limits. -/\nnoncomputable def algebraicLimitStarAlgEquiv\n    (e : ∀ i, A i ≃⋆ₐ[ℂ] D i)\n    (compatible : ∀ i j (le : i ≤ j) x,\n      e j (f i j le x) = h i j le (e i x)) :\n    DirectLimit A f ≃⋆ₐ[ℂ] DirectLimit D h := by\n  let forwardStages : ∀ i, A i →⋆ₐ[ℂ] DirectLimit D h :=\nvariable (F) in\n/-- The direct limit of a directed system. -/\nabbrev _root_.DirectLimit : Type _ := Quotient (setoid f)\n\nvariable {f} in\ntheorem eq_of_le (x : Σ i, F i) (i : ι) (h : x.1 ≤ i) :\n    (⟦x⟧ : DirectLimit F f) = ⟦⟨i, f _ _ h x.2⟩⟧ :=\n  Quotient.sound (r_of_le _ x i h)\n\n@[elab_as_elim] protected theorem induction {C : DirectLimit F f → Prop}\n    (ih : ∀ i x, C ⟦⟨i, x⟩⟧) (x : DirectLimit F f) : C x :=\n  Quotient.ind (fun _ ↦ ih _ _) x\n\ntheorem exists_eq_mk (z : DirectLimit F f) : ∃ i x, z = ⟦⟨i, x⟩⟧ := by rcases z; exact ⟨_, _, rfl⟩\n\ntheorem exists_eq_mk₂ (z w : DirectLimit F f) : ∃ i x y, z = ⟦⟨i, x⟩⟧ ∧ w = ⟦⟨i, y⟩⟧ :=\n  z.inductionOn₂ w fun x y ↦\n    have ⟨i, hxi, hyi⟩ := exists_ge_ge x.1 y.1\n    ⟨i, _, _, eq_of_le x i hxi, eq_of_le y i hyi⟩\n\ntheorem exists_eq_mk₃ (w u v : DirectLimit F f) :\n    ∃ i x y z, w = ⟦⟨i, x⟩⟧ ∧ u = ⟦⟨i, y⟩⟧ ∧ v = ⟦⟨i, z⟩⟧ :=\n  w.inductionOn₃ u v fun x y z ↦\n    have ⟨i, hxi, hyi, hzi⟩ := directed_of₃ (· ≤ ·) x.1 y.1 z.1\n    ⟨i, _, _, _, eq_of_le x i hxi, eq_of_le y i hyi, eq_of_le z i hzi⟩\n\n@[elab_as_elim] protected theorem induction₂ {C : DirectLimit F f → DirectLimit F f → Prop}\n    (ih : ∀ i x y, C ⟦⟨i, x⟩⟧ ⟦⟨i, y⟩⟧) (x y : DirectLimit F f) : C x y := by\n  obtain ⟨_, _, _, rfl, rfl⟩ := exists_eq_mk₂ f x y; apply ih\n\n@[elab_as_elim] protected theorem induction₃\n    {C : DirectLimit F f → DirectLimit F f → DirectLimit F f → Prop}\n    (ih : ∀ i x y z, C ⟦⟨i, x⟩⟧ ⟦⟨i, y⟩⟧ ⟦⟨i, z⟩⟧) (x y z : DirectLimit F f) : C x y z := by\n  obtain ⟨_, _, _, _, rfl, rfl, rfl⟩ := exists_eq_mk₃ f x y z; apply ih\n\ntheorem mk_injective (h : ∀ i j hij, Function.Injective (f i j hij)) (i) :\n    Function.Injective fun x ↦ (⟦⟨i, x⟩⟧ : DirectLimit F f) :=\n  fun _ _ eq ↦ have ⟨_, _, _, eq⟩ := Quotient.eq.mp eq; h _ _ _ eq\n\nsection map₀\n\nvariable [Nonempty ι] (ih : ∀ i, F i)\n\n/-- \"Nullary map\" to construct an element in the direct limit. -/\nnoncomputable def map₀ : DirectLimit F f := ⟦⟨Classical.arbitrary ι, ih _⟩⟧\n\n\n--- candidate theorem declarations ---\n46:namespace StabilizerHyperfinite\n66:noncomputable def algebraicLimitOperatorRep\n75:theorem algebraicLimitOperatorRep_of\n84:theorem algebraicLimitOperatorRep_of_apply\n96:theorem algebraicLimitOperatorRep_stage_congr\n108:theorem algebraicLimitOperatorRep_congr_of_eq\n120:theorem algebraicLimitOperatorRep_unique\n133:theorem connecting_injective_of_stage_rep_injective\n146:theorem algebraicLimitOperatorRep_injective\n164:theorem algebraicLimitOperatorRep_star\n173:theorem algebraicLimitOperatorRep_mul\n183:theorem algebraicLimitOperatorRep_one\n200:structure QubitOperatorRepresentationData (H : Type*) [NormedAddCommGroup H]\n207:namespace QubitOperatorRepresentationData\n214:noncomputable def limitRep : QubitUHFAlgebra →⋆ₐ[ℂ] (H →L[ℂ] H) :=\n219:theorem limitRep_of (n : ℕ) (x : QubitTensorPower n) :\n227:theorem limitRep_of_apply (n : ℕ) (x : QubitTensorPower n) (v : H) :\n234:theorem rho_congr_of_eq {n m : ℕ} {x : QubitTensorPower n} {y : QubitTensorPower m}\n243:theorem limitRep_unique (pi : QubitUHFAlgebra →⋆ₐ[ℂ] (H →L[ℂ] H))\n253:theorem limitRep_injective (h_inj : ∀ n, Function.Injective (D.rho n)) :\n\n--- forbidden declaration scan all integrated P37-only paths ---\naristotle_responses/P37-extracted/aristotle-stabilizer_hyperfinite-y537ze25_aristotle/ARISTOTLE_SUMMARY.md:2:Created `AristotleCandidates/AlgebraicLimitOperatorRepresentation.lean` (infrastructure only, no manuscript claim). `lake build AristotleCandidates.AlgebraicLimitOperatorRepresentation` succeeds with no warnings, the file contains no `sorry`/`admit`/`axiom`/`opaque`/`unsafe`, and the results depend only on the standard axioms `propext`, `Classical.choice`, `Quot.sound`.\n","exit_code":0,"status":"completed"}}
