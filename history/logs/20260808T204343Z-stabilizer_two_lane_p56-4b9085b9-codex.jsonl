{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"nl -ba AristotleCandidates/RegionalProductStateIdentity.lean | sed -n '500,810p'\nrg -n 'ProductStateBound|cstarRegionalState_cstarAlpha|regionalStabilizerState_alpha_word|regionalStabilizerState_alpha|cstarState_identity' AristotleCandidates/RegionalProductStateIdentity.lean\nrg -n 'def .*State|isAlgebraicState|positive|Positivity|IsPositive' AristotleCandidates/RegionalProductStateIdentity.lean\nfind aristotle_responses/P56-regional-product-state-identity-137c05f7-4b9085b9-quarantine -type f | wc -l\ngit status --short\"","aggregated_output":"   500\t@[simp] theorem regionalStabilizerState_one : A.regionalStabilizerState 1 = 1 := by\n   501\t  rw [← A.targetOf_one 0, A.regionalStabilizerState_of,\n   502\t    show (1 : pauliAlgebra (A.targetForm 0)) = pauliWord (A.targetForm 0) 0 from\n   503\t      (pauliWord_zero _).symm, A.stageRegionalState_word]\n   504\t  have h0 : ((0 : A.TargetLabel 0) : PhaseSpace L) = A.family.coordinateMap 0 := by simp\n   505\t  rw [h0, A.regionalWordValue_coordinateMap (Submodule.zero_mem _)]\n   506\t  simp [A.qGlobal_zero]\n   507\t\n   508\t/-! ## 6. The finite Pauli-word identity -/\n   509\t\n   510\t/-- **The finite-word state identity** (`main.tex:1927-1943`).  On every finite\n   511\tcoordinate Pauli word, the regional stabilizer state pulled back by the exact\n   512\tP53/P55D `alpha` is the pure/mixed product expectation of the word: it is `1`\n   513\twhen the word has no `X` exponent and all its `Z` exponents on selected\n   514\tcoordinates — equivalently, when the regional string lies in `W_Γ` — and `0`\n   515\totherwise. -/\n   516\ttheorem regionalStabilizerState_alpha_word (n : ℕ) (v : A.SourceLabel n) :\n   517\t    A.regionalStabilizerState (A.alpha (A.sourceOf n (pauliWord (A.sourceForm n) v))) =\n   518\t      A.productExpectation (v : PauliCoordinateLabels I) := by\n   519\t  classical\n   520\t  rw [A.alpha_word n v, A.regionalStabilizerState_of, map_smul, A.stageRegionalState_word,\n   521\t    smul_eq_mul, A.stageLabelMap_coe]\n   522\t  by_cases hv : (v : PauliCoordinateLabels I) ∈ A.allowedLabels\n   523\t  · rw [A.regionalWordValue_coordinateMap hv, A.productExpectation_of_mem hv]\n   524\t    exact mul_inv_cancel₀ (A.phase_ne_zero n v)\n   525\t  · rw [A.regionalWordValue_of_not_mem\n   526\t      (fun h => hv ((A.coordinateMap_mem_stabilizerLabels_iff _).mp h)),\n   527\t      A.productExpectation_of_not_mem hv, mul_zero]\n   528\t\n   529\t/-- **The algebraic state identity.**  On the whole algebraic quasi-local Pauli\n   530\talgebra, `\\tilde\\omega = \\omega_S \\circ \\alpha` is the pure/mixed product state.\n   531\tThis is the manuscript's \"since the states agree on a basis of operators, they\n   532\tare the same states\", at the algebraic level. -/\n   533\ttheorem regionalStabilizerState_alpha (z : A.SourceLimit) :\n   534\t    A.regionalStabilizerState (A.alpha z) = A.sourceProductState z := by\n   535\t  refine sourceLimit_linear_ext A\n   536\t    (A.regionalStabilizerState.comp A.alpha.toAlgEquiv.toLinearMap) A.sourceProductState\n   537\t    (fun n v => ?_) z\n   538\t  show A.regionalStabilizerState (A.alpha (A.sourceOf n (pauliWord (A.sourceForm n) v))) = _\n   539\t  rw [A.regionalStabilizerState_alpha_word, A.sourceProductState_word]\n   540\t\n   541\t/-- Composition form of the algebraic state identity. -/\n   542\ttheorem regionalStabilizerState_comp_alpha :\n   543\t    A.regionalStabilizerState.comp A.alpha.toAlgEquiv.toLinearMap = A.sourceProductState :=\n   544\t  LinearMap.ext A.regionalStabilizerState_alpha\n   545\t\n   546\t/-- Inverse form of the algebraic state identity. -/\n   547\ttheorem sourceProductState_alpha_symm (y : A.TargetLimit) :\n   548\t    A.sourceProductState (A.alpha.symm y) = A.regionalStabilizerState y := by\n   549\t  rw [← A.regionalStabilizerState_alpha (A.alpha.symm y), StarAlgEquiv.apply_symm_apply]\n   550\t\n   551\t/-! ## 7. The regional stabilizer elements -/\n   552\t\n   553\tsection Stabilizer\n   554\t\n   555\tvariable {A}\n   556\t\n   557\t/-- On allowed labels the source Pauli pairing vanishes: allowed words carry no\n   558\t`X` exponent, so they commute and are self-adjoint. -/\n   559\ttheorem sourceForm_eq_zero_of_allowed_right {n : ℕ} (v w : A.SourceLabel n)\n   560\t    (hw : (w : PauliCoordinateLabels I) ∈ A.allowedLabels) :\n   561\t    (A.sourceForm n).form v w = 0 := by\n   562\t  obtain ⟨hx, -⟩ := (A.mem_allowedLabels_iff _).mp hw\n   563\t  show (coordPairing I).form (v : PauliCoordinateLabels I) (w : PauliCoordinateLabels I) = 0\n   564\t  refine Finset.sum_eq_zero (fun p _ => ?_)\n   565\t  rcases p with i | i\n   566\t  · simp [hx i]\n   567\t  · simp\n   568\t\n   569\t/-- Allowed source Pauli words multiply without a sign. -/\n   570\ttheorem pauliWord_mul_of_allowed {n : ℕ} (v w : A.SourceLabel n)\n   571\t    (hw : (w : PauliCoordinateLabels I) ∈ A.allowedLabels) :\n   572\t    pauliWord (A.sourceForm n) v * pauliWord (A.sourceForm n) w =\n   573\t      pauliWord (A.sourceForm n) (v + w) := by\n   574\t  rw [pauliWord_mul, sourceForm_eq_zero_of_allowed_right v w hw, pauliSign_zero, one_smul]\n   575\t\n   576\t/-- Allowed source Pauli words are self-adjoint. -/\n   577\ttheorem pauliWord_star_of_allowed {n : ℕ} (v : A.SourceLabel n)\n   578\t    (hv : (v : PauliCoordinateLabels I) ∈ A.allowedLabels) :\n   579\t    star (pauliWord (A.sourceForm n) v) = pauliWord (A.sourceForm n) v := by\n   580\t  rw [pauliWord_star, sourceForm_eq_zero_of_allowed_right v v hv, pauliSign_zero, one_smul,\n   581\t    pauli_neg_eq_self]\n   582\t\n   583\tvariable (A)\n   584\t\n   585\t/-- **The regional stabilizer elements.**  The image under the P53/P55D `alpha`\n   586\tof an allowed coordinate Pauli word: a phase-calibrated regional Pauli word\n   587\twhose string is the stabilizer vector `\\sum_i z_i`. -/\n   588\tnoncomputable def stabilizerElement (n : ℕ) (v : A.SourceLabel n) : A.TargetLimit :=\n   589\t  A.alpha (A.sourceOf n (pauliWord (A.sourceForm n) v))\n   590\t\n   591\t/-- The regional stabilizer element is the calibrated regional Pauli word of the\n   592\timage string. -/\n   593\ttheorem stabilizerElement_eq (n : ℕ) (v : A.SourceLabel n) :\n   594\t    A.stabilizerElement n v =\n   595\t      A.targetOf n (A.phase n v • pauliWord (A.targetForm n) (A.stageLabelMap n v)) :=\n   596\t  A.alpha_word n v\n   597\t\n   598\t/-- The string of a regional stabilizer element lies in `W_Γ`. -/\n   599\ttheorem stageLabelMap_mem_stabilizerLabels {n : ℕ} (v : A.SourceLabel n)\n   600\t    (hv : (v : PauliCoordinateLabels I) ∈ A.allowedLabels) :\n   601\t    ((A.stageLabelMap n v : A.TargetLabel n) : PhaseSpace L) ∈ A.stabilizerLabels := by\n   602\t  rw [A.stageLabelMap_coe]\n   603\t  exact (A.coordinateMap_mem_stabilizerLabels_iff _).mpr hv\n   604\t\n   605\t@[simp] theorem stabilizerElement_zero (n : ℕ) : A.stabilizerElement n 0 = 1 := by\n   606\t  rw [stabilizerElement, pauliWord_zero, A.sourceOf_one, map_one]\n   607\t\n   608\t/-- The regional stabilizer elements form a group under multiplication. -/\n   609\ttheorem stabilizerElement_mul {n : ℕ} (v w : A.SourceLabel n)\n   610\t    (hw : (w : PauliCoordinateLabels I) ∈ A.allowedLabels) :\n   611\t    A.stabilizerElement n v * A.stabilizerElement n w = A.stabilizerElement n (v + w) := by\n   612\t  rw [stabilizerElement, stabilizerElement, stabilizerElement, ← map_mul, ← A.sourceOf_mul,\n   613\t    pauliWord_mul_of_allowed v w hw]\n   614\t\n   615\t/-- The regional stabilizer elements are self-adjoint. -/\n   616\ttheorem stabilizerElement_star {n : ℕ} (v : A.SourceLabel n)\n   617\t    (hv : (v : PauliCoordinateLabels I) ∈ A.allowedLabels) :\n   618\t    star (A.stabilizerElement n v) = A.stabilizerElement n v := by\n   619\t  rw [stabilizerElement, ← map_star, ← A.sourceOf_star, pauliWord_star_of_allowed v hv]\n   620\t\n   621\t/-- **The stabilizer-state property.**  The regional state has expectation `1`\n   622\ton every regional stabilizer element, i.e. the elements `α(O)` of allowed words\n   623\tare exactly the `+1`-eigenvalue stabilizer operators of the state. -/\n   624\ttheorem regionalStabilizerState_stabilizerElement {n : ℕ} (v : A.SourceLabel n)\n   625\t    (hv : (v : PauliCoordinateLabels I) ∈ A.allowedLabels) :\n   626\t    A.regionalStabilizerState (A.stabilizerElement n v) = 1 := by\n   627\t  rw [stabilizerElement, A.regionalStabilizerState_alpha_word, A.productExpectation_of_mem hv]\n   628\t\n   629\tend Stabilizer\n   630\t\n   631\t/-! ## 8. The identity on the concrete C⋆-algebras -/\n   632\t\n   633\tnamespace SourceConcreteRep\n   634\t\n   635\tvariable {A} (R : A.SourceConcreteRep)\n   636\t\n   637\t/-- **The continuous state identity** (`main.tex:1944-1946`, \"since the states\n   638\tagree on a basis of operators, they are the same states\").\n   639\t\n   640\tIf `f` is *any* continuous linear functional on the P55C concrete source\n   641\tC⋆-algebra restricting to the pure/mixed product state on the dense algebraic\n   642\timage, and `g` is *any* continuous linear functional on the P55C concrete\n   643\tregional C⋆-algebra restricting to the regional stabilizer state on the dense\n   644\talgebraic image, then `g ∘ alpha = f` for the exact P55D C⋆ `alpha`.  No\n   645\tboundedness or continuity premise beyond the continuity of `f` and `g`\n   646\tthemselves is used. -/\n   647\ttheorem cstarState_identity (f : R.sourceCStar →L[ℂ] ℂ) (g : R.targetCStar →L[ℂ] ℂ)\n   648\t    (hf : ∀ z : A.SourceLimit, f (R.sourceEmbedding z) = A.sourceProductState z)\n   649\t    (hg : ∀ y : A.TargetLimit, g (R.targetEmbedding y) = A.regionalStabilizerState y)\n   650\t    (T : R.sourceCStar) : g (R.cstarAlpha T) = f T := by\n   651\t  have hfun : (fun T : R.sourceCStar => g (R.cstarAlpha T)) = fun T => f T := by\n   652\t    refine Continuous.ext_on R.sourceEmbedding_denseRange\n   653\t      (g.continuous.comp R.continuous_cstarAlpha) f.continuous ?_\n   654\t    rintro _ ⟨z, rfl⟩\n   655\t    show g (R.cstarAlpha (R.sourceEmbedding z)) = f (R.sourceEmbedding z)\n   656\t    rw [R.cstarAlpha_sourceEmbedding, hg, hf, A.regionalStabilizerState_alpha]\n   657\t  exact congrFun hfun T\n   658\t\n   659\t/-- A continuous functional on the concrete source C⋆-algebra is determined by\n   660\tits restriction to the dense algebraic image. -/\n   661\ttheorem cstarSourceState_unique (f f' : R.sourceCStar →L[ℂ] ℂ)\n   662\t    (hf : ∀ z : A.SourceLimit, f (R.sourceEmbedding z) = A.sourceProductState z)\n   663\t    (hf' : ∀ z : A.SourceLimit, f' (R.sourceEmbedding z) = A.sourceProductState z) : f = f' := by\n   664\t  refine ContinuousLinearMap.ext (fun T => ?_)\n   665\t  have hfun : (f : R.sourceCStar → ℂ) = f' :=\n   666\t    Continuous.ext_on R.sourceEmbedding_denseRange f.continuous f'.continuous\n   667\t      (by rintro _ ⟨z, rfl⟩; rw [hf z, hf' z])\n   668\t  exact congrFun hfun T\n   669\t\n   670\t/-- A continuous functional on the concrete regional C⋆-algebra is determined by\n   671\tits restriction to the dense algebraic image. -/\n   672\ttheorem cstarRegionalState_unique (g g' : R.targetCStar →L[ℂ] ℂ)\n   673\t    (hg : ∀ y : A.TargetLimit, g (R.targetEmbedding y) = A.regionalStabilizerState y)\n   674\t    (hg' : ∀ y : A.TargetLimit, g' (R.targetEmbedding y) = A.regionalStabilizerState y) :\n   675\t    g = g' := by\n   676\t  refine ContinuousLinearMap.ext (fun T => ?_)\n   677\t  have hfun : (g : R.targetCStar → ℂ) = g' :=\n   678\t    Continuous.ext_on R.targetEmbedding_denseRange g.continuous g'.continuous\n   679\t      (by rintro _ ⟨y, rfl⟩; rw [hg y, hg' y])\n   680\t  exact congrFun hfun T\n   681\t\n   682\t/-! ### Existence of the two continuous states\n   683\t\n   684\tThe only auxiliary assumption of this module: the algebraic product state is\n   685\tbounded for the concrete C⋆-norm of P55C.  It is the analytic input that the\n   686\tmanuscript leaves implicit when it passes from Pauli words to the quasi-local\n   687\tC⋆-algebra.  Nothing else — no supplied state, no supplied extension, no\n   688\tsupplied density interface — is assumed: the extension itself is constructed\n   689\tand proved unique. -/\n   690\t\n   691\t/-- **Auxiliary assumption (product-state boundedness).**  A norm bound for the\n   692\talgebraic pure/mixed product state with respect to the concrete C⋆-norm of the\n   693\tP55C representation. -/\n   694\tstructure ProductStateBound where\n   695\t  /-- The bound constant. -/\n   696\t  const : ℝ\n   697\t  /-- The bound itself. -/\n   698\t  norm_le : ∀ z : A.SourceLimit,\n   699\t    ‖A.sourceProductState z‖ ≤ const * ‖R.sourceEmbedding z‖\n   700\t\n   701\tvariable {R}\n   702\t\n   703\ttheorem uniformContinuous_sourceProductState (hb : R.ProductStateBound) :\n   704\t    letI := R.sourceNormedRing\n   705\t    letI := R.sourceNormedAlgebra\n   706\t    UniformContinuous A.sourceProductState := by\n   707\t  letI := R.sourceNormedRing\n   708\t  letI := R.sourceNormedAlgebra\n   709\t  exact (AddMonoidHomClass.lipschitz_of_bound A.sourceProductState hb.const\n   710\t    (fun z => hb.norm_le z)).uniformContinuous\n   711\t\n   712\t/-- **The continuous pure/mixed product state** on the concrete source\n   713\tC⋆-algebra, constructed by density from the algebraic product state. -/\n   714\tnoncomputable def cstarProductState (hb : R.ProductStateBound) : R.sourceCStar →L[ℂ] ℂ :=\n   715\t  letI := R.sourceNormedRing\n   716\t  letI := R.sourceNormedAlgebra\n   717\t  extendCLM (i := (R.sourceEmbedding : A.SourceLimit →⋆ₐ[ℂ] R.sourceCStar).toAlgHom.toLinearMap)\n   718\t    R.isometry_sourceEmbedding R.sourceEmbedding_denseRange\n   719\t    (uniformContinuous_sourceProductState hb)\n   720\t\n   721\t@[simp] theorem cstarProductState_sourceEmbedding (hb : R.ProductStateBound)\n   722\t    (z : A.SourceLimit) :\n   723\t    cstarProductState hb (R.sourceEmbedding z) = A.sourceProductState z := by\n   724\t  letI := R.sourceNormedRing\n   725\t  letI := R.sourceNormedAlgebra\n   726\t  exact extendCLM_apply (i := (R.sourceEmbedding :\n   727\t      A.SourceLimit →⋆ₐ[ℂ] R.sourceCStar).toAlgHom.toLinearMap)\n   728\t    R.isometry_sourceEmbedding R.sourceEmbedding_denseRange\n   729\t    (uniformContinuous_sourceProductState hb) z\n   730\t\n   731\tvariable (R)\n   732\t\n   733\t/-- The inverse of the P55D C⋆ `alpha`, as a continuous linear map. -/\n   734\tnoncomputable def cstarAlphaSymmCLM : R.targetCStar →L[ℂ] R.sourceCStar where\n   735\t  toFun := R.cstarAlpha.symm\n   736\t  map_add' := map_add _\n   737\t  map_smul' c x := map_smul R.cstarAlpha.symm c x\n   738\t  cont := R.continuous_cstarAlpha_symm\n   739\t\n   740\t@[simp] theorem cstarAlphaSymmCLM_apply (T : R.targetCStar) :\n   741\t    R.cstarAlphaSymmCLM T = R.cstarAlpha.symm T := rfl\n   742\t\n   743\tvariable {R}\n   744\t\n   745\t/-- **The continuous regional stabilizer state** on the concrete regional\n   746\tC⋆-algebra.  It exists as soon as the product state is bounded, and it is the\n   747\tunique continuous functional restricting to the algebraic regional stabilizer\n   748\tstate. -/\n   749\tnoncomputable def cstarRegionalState (hb : R.ProductStateBound) : R.targetCStar →L[ℂ] ℂ :=\n   750\t  (cstarProductState hb).comp R.cstarAlphaSymmCLM\n   751\t\n   752\t@[simp] theorem cstarRegionalState_targetEmbedding (hb : R.ProductStateBound)\n   753\t    (y : A.TargetLimit) :\n   754\t    cstarRegionalState hb (R.targetEmbedding y) = A.regionalStabilizerState y := by\n   755\t  show cstarProductState hb (R.cstarAlpha.symm (R.targetEmbedding y)) = _\n   756\t  rw [R.cstarAlpha_symm_targetEmbedding, cstarProductState_sourceEmbedding,\n   757\t    A.sourceProductState_alpha_symm]\n   758\t\n   759\t/-- **The final continuous state equality.**  The continuous regional stabilizer\n   760\tstate, pulled back by the exact P55D C⋆ `alpha`, is the continuous pure/mixed\n   761\tproduct state on the whole concrete quasi-local C⋆-algebra. -/\n   762\ttheorem cstarRegionalState_cstarAlpha (hb : R.ProductStateBound) (T : R.sourceCStar) :\n   763\t    cstarRegionalState hb (R.cstarAlpha T) = cstarProductState hb T :=\n   764\t  cstarState_identity R _ _ (cstarProductState_sourceEmbedding hb)\n   765\t    (cstarRegionalState_targetEmbedding hb) T\n   766\t\n   767\t/-- Function form of the final continuous state equality. -/\n   768\ttheorem cstarRegionalState_comp_cstarAlpha (hb : R.ProductStateBound) :\n   769\t    (fun T : R.sourceCStar => cstarRegionalState hb (R.cstarAlpha T)) =\n   770\t      fun T => cstarProductState hb T :=\n   771\t  funext (cstarRegionalState_cstarAlpha hb)\n   772\t\n   773\tend SourceConcreteRep\n   774\t\n   775\t/-! ## 9. The branch-uniform regional state identity -/\n   776\t\n   777\t/-- The branch-uniform continuous state identity for the P55C/P55D branch\n   778\trepresentation datum and the exact P55D `A.regionalCStarAlpha`. -/\n   779\ttheorem regionalCStarAlpha_state_identity\n   780\t    (f : A.SourceConcreteCStar →L[ℂ] ℂ) (g : A.TargetConcreteCStar →L[ℂ] ℂ)\n   781\t    (hf : ∀ z : A.SourceLimit, f (A.sourceCStarEmbedding z) = A.sourceProductState z)\n   782\t    (hg : ∀ y : A.TargetLimit, g (A.targetCStarEmbedding y) = A.regionalStabilizerState y)\n   783\t    (T : A.SourceConcreteCStar) : g (A.regionalCStarAlpha T) = f T :=\n   784\t  SourceConcreteRep.cstarState_identity (A.branchSourceRep) f g hf hg T\n   785\t\n   786\tend AlphaData\n   787\t\n   788\t/-! ## 10. Non-vacuity -/\n   789\t\n   790\t/-- For the tautological P53 data every coordinate is selected, so the allowed\n   791\twords are exactly the `X`-free coordinate words. -/\n   792\ttheorem standardAlphaData_mem_allowedLabels_iff (c : PauliCoordinateLabels ℕ) :\n   793\t    c ∈ standardAlphaData.allowedLabels ↔ ∀ i : ℕ, c (Sum.inr i) = 0 := by\n   794\t  rw [AlphaData.mem_allowedLabels_iff]\n   795\t  exact ⟨fun h => h.1, fun h => ⟨h, fun i _ => Set.mem_univ i⟩⟩\n   796\t\n   797\t/-- **Non-vacuity.**  For the tautological P53 data the algebraic state identity\n   798\tholds and the two states are unital, so neither is the zero functional. -/\n   799\ttheorem standardAlphaData_state_identity :\n   800\t    (∀ z, standardAlphaData.regionalStabilizerState (standardAlphaData.alpha z) =\n   801\t      standardAlphaData.sourceProductState z) ∧\n   802\t    standardAlphaData.sourceProductState 1 = 1 ∧\n   803\t    standardAlphaData.regionalStabilizerState 1 = 1 :=\n   804\t  ⟨AlphaData.regionalStabilizerState_alpha _, AlphaData.sourceProductState_one _,\n   805\t    AlphaData.regionalStabilizerState_one _⟩\n   806\t\n   807\tend LocalHyperbolicAlpha\n   808\t\n   809\tend StabilizerHyperfinite\n45:4. **The finite-word identity** `regionalStabilizerState_alpha_word` and its\n46:   consequence on the whole algebraic limit `regionalStabilizerState_alpha`:\n52:6. **The continuous state identity** `SourceConcreteRep.cstarState_identity`\n61:   equality is `cstarRegionalState_cstarAlpha`.\n66:`AlphaData.SourceConcreteRep.ProductStateBound`: a norm bound\n70:(`cstarState_identity`) assumes nothing beyond continuity of the two given\n516:theorem regionalStabilizerState_alpha_word (n : ℕ) (v : A.SourceLabel n) :\n533:theorem regionalStabilizerState_alpha (z : A.SourceLimit) :\n539:  rw [A.regionalStabilizerState_alpha_word, A.sourceProductState_word]\n544:  LinearMap.ext A.regionalStabilizerState_alpha\n549:  rw [← A.regionalStabilizerState_alpha (A.alpha.symm y), StarAlgEquiv.apply_symm_apply]\n627:  rw [stabilizerElement, A.regionalStabilizerState_alpha_word, A.productExpectation_of_mem hv]\n647:theorem cstarState_identity (f : R.sourceCStar →L[ℂ] ℂ) (g : R.targetCStar →L[ℂ] ℂ)\n656:    rw [R.cstarAlpha_sourceEmbedding, hg, hf, A.regionalStabilizerState_alpha]\n694:structure ProductStateBound where\n703:theorem uniformContinuous_sourceProductState (hb : R.ProductStateBound) :\n714:noncomputable def cstarProductState (hb : R.ProductStateBound) : R.sourceCStar →L[ℂ] ℂ :=\n721:@[simp] theorem cstarProductState_sourceEmbedding (hb : R.ProductStateBound)\n749:noncomputable def cstarRegionalState (hb : R.ProductStateBound) : R.targetCStar →L[ℂ] ℂ :=\n752:@[simp] theorem cstarRegionalState_targetEmbedding (hb : R.ProductStateBound)\n762:theorem cstarRegionalState_cstarAlpha (hb : R.ProductStateBound) (T : R.sourceCStar) :\n764:  cstarState_identity R _ _ (cstarProductState_sourceEmbedding hb)\n768:theorem cstarRegionalState_comp_cstarAlpha (hb : R.ProductStateBound) :\n771:  funext (cstarRegionalState_cstarAlpha hb)\n784:  SourceConcreteRep.cstarState_identity (A.branchSourceRep) f g hf hg T\n804:  ⟨AlphaData.regionalStabilizerState_alpha _, AlphaData.sourceProductState_one _,\n74:here (it needs finite-dimensional positive square roots and the isometry of\n291:/-- **The manuscript's selection rule, positive half.**  The product-state\n353:noncomputable def stageProductState (n : ℕ) : pauliAlgebra (A.sourceForm n) →ₗ[ℂ] ℂ :=\n375:noncomputable def sourceProductState : A.SourceLimit →ₗ[ℂ] ℂ :=\n437:noncomputable def stageRegionalState (n : ℕ) : pauliAlgebra (A.targetForm n) →ₗ[ℂ] ℂ :=\n455:noncomputable def regionalStabilizerState : A.TargetLimit →ₗ[ℂ] ℂ :=\n714:noncomputable def cstarProductState (hb : R.ProductStateBound) : R.sourceCStar →L[ℂ] ℂ :=\n749:noncomputable def cstarRegionalState (hb : R.ProductStateBound) : R.targetCStar →L[ℂ] ℂ :=\n223\n M PLAN.md\n M aristotle_tasks/P49-finite-corner-trace.md\n M aristotle_tasks/P50-normal-faithful-corner-trace.md\n M aristotle_tasks/P51-full-finite-corner-central-exclusion.md\n M aristotle_tasks/P55-regional-concrete-cstar-alpha.md\n M aristotle_tasks/P60-full-corner-semifinite-weight.md\n M work/TWO-LANE-FORMALIZATION-DECISION.md\n?? AristotleCandidates/FiniteCornerTrace.lean\n?? AristotleCandidates/FullCornerSemifiniteWeight.lean\n?? AristotleCandidates/FullFiniteCornerCentralExclusion.lean\n?? AristotleCandidates/Ka