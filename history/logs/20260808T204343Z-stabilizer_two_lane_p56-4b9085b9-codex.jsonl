xedQubitState.lean:205:theorem qubitPureMixedState_finiteQubitPauliWord (pure : ℕ → Bool) (n : ℕ)\nFormalization/FinitePureMixedQubitState.lean:229:theorem qubitPureMixedState_finiteQubitPauliWord_eq_indicator\nFormalization/FinitePureMixedQubitState.lean:238:theorem qubitPureMixedUHFState_finiteQubitPauliWord (pure : ℕ → Bool) (n : ℕ)\nFormalization/FinitePureMixedQubitState.lean:248:theorem qubitPureMixedUHFState_finiteQubitPauliWord_eq_indicator\nFormalization/FinitePureMixedQubitState.lean:259:theorem qubitPureMixedState_allMixed (n : ℕ) :\nFormalization/FinitePureMixedQubitState.lean:269:theorem qubitPureMixedUHFState_allMixed :\nFormalization/FinitePureMixedQubitState.lean:277:theorem onePureQubitState_not_isUnitalTracial :\nFormalization/FinitePureMixedQubitState.lean:291:theorem onePureQubitState_not_isAlgebraicTracialState :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:81:theorem sourceLimit_linear_ext {X : Type*} [AddCommMonoid X] [Module ℂ X]\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:107:noncomputable def regionalEmbedding : A.SourceLimit →⋆ₐ[ℂ] R.targetCStar :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:120:theorem regionalEmbedding_injective : Function.Injective R.regionalEmbedding :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:125:theorem regionalEmbedding_denseRange : DenseRange R.regionalEmbedding := by\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:140:theorem isometry_sourceEmbedding :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:149:theorem isometry_regionalEmbedding :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:159:theorem norm_regionalEmbedding_eq (z : A.SourceLimit) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:170:noncomputable def cstarAlpha : R.sourceCStar ≃⋆ₐ[ℂ] R.targetCStar :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:186:theorem coe_cstarAlpha_sourceEmbedding (z : A.SourceLimit) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:190:theorem continuous_cstarAlpha : Continuous R.cstarAlpha := by\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:197:theorem isometry_cstarAlpha : Isometry R.cstarAlpha := by\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:203:theorem norm_cstarAlpha (T : R.sourceCStar) : ‖R.cstarAlpha T‖ = ‖T‖ :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:207:theorem cstarAlpha_surjective : Function.Surjective R.cstarAlpha :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:210:theorem cstarAlpha_injective : Function.Injective R.cstarAlpha :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:213:theorem cstarAlpha_bijective : Function.Bijective R.cstarAlpha :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:221:theorem cstarAlpha_sourceEmbedding_of (n : ℕ) (x : pauliAlgebra (A.sourceForm n)) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:229:theorem cstarAlpha_sourceEmbedding_word (n : ℕ) (v : A.SourceLabel n) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:245:theorem cstarAlpha_symm_targetEmbedding_of (n : ℕ) (y : pauliAlgebra (A.targetForm n)) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:253:theorem cstarAlpha_symm_targetEmbedding_word (n : ℕ) (v : A.SourceLabel n) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:260:theorem coe_cstarAlpha_symm_targetEmbedding (y : A.TargetLimit) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:266:theorem isometry_cstarAlpha_symm : Isometry R.cstarAlpha.symm :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:271:theorem continuous_cstarAlpha_symm : Continuous R.cstarAlpha.symm :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:280:theorem coe_cstarAlpha (T : R.sourceCStar) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:295:theorem existsUnique_cstarAlpha :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:308:theorem cstarAlpha_unique (e : R.sourceCStar ≃⋆ₐ[ℂ] R.targetCStar) (hcont : Continuous e)\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:317:theorem cstarAlpha_unique_word (e : R.sourceCStar ≃⋆ₐ[ℂ] R.targetCStar) (hcont : Continuous e)\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:337:theorem existsUnique_cstarAlpha_word :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:371:noncomputable def regionalCStarAlpha : A.SourceConcreteCStar ≃⋆ₐ[ℂ] A.TargetConcreteCStar :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:378:theorem regionalCStarAlpha_stage (n : ℕ) (x : pauliAlgebra (A.sourceForm n)) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:383:theorem regionalCStarAlpha_word (n : ℕ) (v : A.SourceLabel n) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:394:theorem regionalCStarAlpha_symm_stage (n : ℕ) (y : pauliAlgebra (A.targetForm n)) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:399:theorem regionalCStarAlpha_symm_word (n : ℕ) (v : A.SourceLabel n) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:407:theorem isometry_regionalCStarAlpha : Isometry A.regionalCStarAlpha :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:410:theorem regionalCStarAlpha_surjective : Function.Surjective A.regionalCStarAlpha :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:413:theorem regionalCStarAlpha_injective : Function.Injective A.regionalCStarAlpha :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:416:theorem continuous_regionalCStarAlpha : Continuous A.regionalCStarAlpha :=\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:421:theorem coe_regionalCStarAlpha (T : A.SourceConcreteCStar) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:426:theorem existsUnique_regionalCStarAlpha :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:433:theorem existsUnique_regionalCStarAlpha_word :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:446:theorem coe_regionalCStarAlpha_infinite [Infinite I] (z : A.SourceLimit) :\nAristotleCandidates/RegionalConcreteCStarAlpha.lean:458:theorem coe_regionalCStarAlpha_finite [Finite I] (z : A.SourceLimit) :\nAristotleCandidates/RegionalConcreteCSt