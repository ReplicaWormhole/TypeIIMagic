9:structure RegionalConcreteCompletionData where\n173:noncomputable def sourceSubalgebra : StarSubalgebra ℂ (M.H →L[ℂ] M.H) :=\n179:noncomputable def toCStarCompletionData : CStarCompletionData where\n196:noncomputable abbrev SourceCStar : Type _ := M.toCStarCompletionData.SourceCStar\n200:noncomputable abbrev sourceEmbed : M.limitData.SourceLimit →⋆ₐ[ℂ] M.SourceCStar :=\n205:noncomputable abbrev alphaCStarMap : M.SourceCStar ≃⋆ₐ[ℂ] M.TargetCStar :=\n210:noncomputable def stageElem (i : M.limitData.Index) (x : M.limitData.Source i) :\n216:theorem val_stageElem (i : M.limitData.Index) (x : M.limitData.Source i) :\n221:theorem alphaCStar_stageElem (i : M.limitData.Index) (x : M.limitData.Source i) :\n228:theorem coe_sourceSubalgebra_eq_closure_iUnion :\n235:theorem sourceSubalgebra_isLeast :\n241:theorem denseRange_sourceEmbed : Dense (Set.range M.sourceEmbed) :=\n245:theorem injective_sourceEmbed (h_inj : ∀ i, Function.Injective (M.rho i)) :\n252:theorem alphaCStar_sourceEmbed (z : M.limitData.SourceLimit) :\n257:theorem alphaCStar_symm_targetEmbed (w : M.limitData.TargetLimit) :\n262:theorem isometry_alphaCStar : Isometry M.alphaCStarMap :=\n266:theorem isometry_alphaCStar_symm : Isometry M.alphaCStarMap.symm :=\n269:theorem continuous_alphaCStar : Continuous M.alphaCStarMap :=\n272:theorem norm_alphaCStar (a : M.SourceCStar) : ‖M.alphaCStarMap a‖ = ‖a‖ :=\n277:theorem alphaCStar_unique_of_continuous (g : M.SourceCStar → M.TargetCStar)\n288:theorem eq_of_stage_formulas\n302:theorem funext_of_stage_formulas (g h : M.SourceCStar → M.TargetCStar)\n319:structure StatePreservingData where\n354:noncomputable abbrev SourceCStar : Type _ := M.completion.SourceCStar\n357:abbrev TargetCStar : Type _ := M.completion.TargetCStar\n360:noncomputable abbrev alphaCStar : M.SourceCStar ≃⋆ₐ[ℂ] M.TargetCStar :=\n364:noncomputable def toAlphaGNSData : AlphaGNSData where\n381:theorem sourceState_eq_pullback (a : M.SourceCStar) :\n388:theorem continuous_sourceState : Continuous fun a : M