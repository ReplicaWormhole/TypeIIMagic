{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"nl -ba AristotleCandidates/FullCornerSemifiniteWeight.lean | sed -n '120,150p;280,320p;345,390p;490,550p;640,680p;895,930p;940,1005p;1065,1175p'\"","aggregated_output":"   120\t\n   121\tA *normalized countable comparison family* for the projection `q` of `M` is a sequence of\n   122\tpartial isometries of `M` whose source projections lie below `q`, whose range projections are\n   123\tpairwise orthogonal with partial sums converging strongly to `1`, and whose zeroth member has\n   124\tsource and range projection exactly `q`.\n   125\t\n   126\tThis is the only assumption of the packet beyond the P50U corner data; no property of the\n   127\tglobal weight constructed from it is assumed. -/\n   128\tstructure ComparisonFamily (M : VonNeumannAlgebra H) (q : H →L[ℂ] H)\n   129\t    (v : ℕ → H →L[ℂ] H) : Prop where\n   130\t  /-- Each comparison operator lies in `M`. -/\n   131\t  mem : ∀ n, v n ∈ M\n   132\t  /-- Each `v n` is a partial isometry: its source `v n ^* v n` is idempotent. -/\n   133\t  idem_src : ∀ n, IsIdempotentElem (srcProj v n)\n   134\t  /-- Comparison: every source projection lies below `q`. -/\n   135\t  src_le : ∀ n, VonNeumannAlgebra.ProjLe (srcProj v n) q\n   136\t  /-- The range projections are pairwise orthogonal. -/\n   137\t  orthogonal : ∀ m n, m ≠ n → rngProj v m * rngProj v n = 0\n   138\t  /-- Convergence: the partial sums of the range projections converge strongly to `1`. -/\n   139\t  sum_strong : ∀ ξ : H, Tendsto (fun N => partialProj v N ξ) atTop (𝓝 ξ)\n   140\t  /-- Normalization of the distinguished zeroth member: its source projection is `q`.\n   141\t  (Required by the specification of a normalized family; the proofs below use it only\n   142\t  through `src_le 0`.) -/\n   143\t  src_zero : srcProj v 0 = q\n   144\t  /-- Normalization of the distinguished zeroth member: its range projection is `q`. -/\n   145\t  rng_zero : rngProj v 0 = q\n   146\t\n   147\tnamespace ComparisonFamily\n   148\t\n   149\tvariable {M : VonNeumannAlgebra H} {q : H →L[ℂ] H} {v : ℕ → H →L[ℂ] H}\n   150\t\n   280\tnoncomputable def weightTerm (q : H →L[ℂ] H) (Ω : H) (v : ℕ → H →L[ℂ] H) (x : H →L[ℂ] H)\n   281\t    (n : ℕ) : ℝ≥0∞ :=\n   282\t  ENNReal.ofReal ((cornerTau q Ω (star (v n) * x * v n)).re)\n   283\t\n   284\t/-- **The global extended-positive weight.**  `W x = ∑' n, Re (tau_q (v n ^* x v n))`, the\n   285\tmonotone `ℝ≥0∞`-valued series of transported P50U corner traces.\n   286\t\n   287\tThis is a *definition*, not an assumed interface: every weight law below is proved from it. -/\n   288\tnoncomputable def globalWeight (q : H →L[ℂ] H) (Ω : H) (v : ℕ → H →L[ℂ] H)\n   289\t    (x : H →L[ℂ] H) : ℝ≥0∞ :=\n   290\t  ∑' n, weightTerm q Ω v x n\n   291\t\n   292\ttheorem globalWeight_def (q : H →L[ℂ] H) (Ω : H) (v : ℕ → H →L[ℂ] H) (x : H →L[ℂ] H) :\n   293\t    globalWeight q Ω v x = ∑' n, weightTerm q Ω v x n := rfl\n   294\t\n   295\t/-- The transported corner trace is the vector state at `v n Ω`. -/\n   296\ttheorem cornerTau_conj (hf : ComparisonFamily M q v) (x : H →L[ℂ] H) (n : ℕ) :\n   297\t    cornerTau q Ω (star (v n) * x * v n) = ⟪v n Ω, x (v n Ω)⟫_ℂ := by\n   298\t  have hcomp : q * (star (v n) * x * v n) * q = star (v n) * x * v n := by\n   299\t    calc q * (star (v n) * x * v n) * q = (q * star (v n)) * x * (v n * q) := by noncomm_ring\n   300\t      _ = star (v n) * x * v n := by rw [hf.q_mul_star n, hf.mul_q n]\n   301\t  rw [cornerTau_apply, hcomp]\n   302\t  show ⟪Ω, (star (v n)) (x (v n Ω))⟫_ℂ = _\n   303\t  rw [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_right]\n   304\t\n   305\t/-- The weight terms in vector-state form. -/\n   306\ttheorem weightTerm_eq (hf : ComparisonFamily M q v) (x : H →L[ℂ] H) (n : ℕ) :\n   307\t    weightTerm q Ω v x n = ENNReal.ofReal ((⟪v n Ω, x (v n Ω)⟫_ℂ).re) := by\n   308\t  rw [weightTerm, cornerTau_conj hf]\n   309\t\n   310\t/-- The global weight as a sum of vector states. -/\n   311\ttheorem globalWeight_eq (hf : ComparisonFamily M q v) (x : H →L[ℂ] H) :\n   312\t    globalWeight q Ω v x = ∑' n, ENNReal.ofReal ((⟪v n Ω, x (v n Ω)⟫_ℂ).re) :=\n   313\t  tsum_congr fun n => weightTerm_eq hf x n\n   314\t\n   315\tomit [CompleteSpace H] in\n   316\t/-- The quadratic form of a positive operator is nonnegative in the convention `⟪ξ, x ξ⟫`. -/\n   317\ttheorem reInner_nonneg_of_isPositive {x : H →L[ℂ] H} (hx : x.IsPositive) (ξ : H) :\n   318\t    0 ≤ (⟪ξ, x ξ⟫_ℂ).re := by\n   319\t  have h := hx.2 ξ\n   320\t  rw [ContinuousLinearMap.reApplyInnerSelf_apply] at h\n   345\t\n   346\t/-! ## §4  Additivity, positive homogeneity and monotonicity -/\n   347\t\n   348\tsection Laws\n   349\t\n   350\tvariable {M : VonNeumannAlgebra H} {q : H →L[ℂ] H} {Ω : H} {v : ℕ → H →L[ℂ] H}\n   351\t\n   352\t/-- **Additivity of the weight on the positive cone.** -/\n   353\ttheorem globalWeight_add (hf : ComparisonFamily M q v) {x y : H →L[ℂ] H}\n   354\t    (hx : x.IsPositive) (hy : y.IsPositive) :\n   355\t    globalWeight q Ω v (x + y) = globalWeight q Ω v x + globalWeight q Ω v y := by\n   356\t  rw [globalWeight_eq hf, globalWeight_eq hf, globalWeight_eq hf,\n   357\t    ← ENNReal.tsum_add]\n   358\t  refine tsum_congr fun n => ?_\n   359\t  have h : (⟪v n Ω, (x + y) (v n Ω)⟫_ℂ).re\n   360\t      = (⟪v n Ω, x (v n Ω)⟫_ℂ).re + (⟪v n Ω, y (v n Ω)⟫_ℂ).re := by\n   361\t    simp\n   362\t  rw [h, ENNReal.ofReal_add (reInner_nonneg_of_isPositive hx _)\n   363\t    (reInner_nonneg_of_isPositive hy _)]\n   364\t\n   365\t/-- **Positive homogeneity of the weight.** -/\n   366\ttheorem globalWeight_smul (hf : ComparisonFamily M q v) {c : ℝ} (hc : 0 ≤ c)\n   367\t    (x : H →L[ℂ] H) :\n   368\t    globalWeight q Ω v ((c : ℂ) • x) = ENNReal.ofReal c * globalWeight q Ω v x := by\n   369\t  rw [globalWeight_eq hf, globalWeight_eq hf, ← ENNReal.tsum_mul_left]\n   370\t  refine tsum_congr fun n => ?_\n   371\t  have h : (⟪v n Ω, ((c : ℂ) • x) (v n Ω)⟫_ℂ).re = c * (⟪v n Ω, x (v n Ω)⟫_ℂ).re := by\n   372\t    simp [Complex.mul_re]\n   373\t  rw [h, ENNReal.ofReal_mul hc]\n   374\t\n   375\t/-- The weight vanishes at `0`. -/\n   376\t@[simp] theorem globalWeight_zero (q : H →L[ℂ] H) (Ω : H) (v : ℕ → H →L[ℂ] H) :\n   377\t    globalWeight q Ω v 0 = 0 := by\n   378\t  simp [globalWeight, weightTerm]\n   379\t\n   380\t/-- **Monotonicity** for the quadratic-form order. -/\n   381\ttheorem globalWeight_mono (hf : ComparisonFamily M q v) {x y : H →L[ℂ] H}\n   382\t    (h : ∀ ξ : H, (⟪ξ, x ξ⟫_ℂ).re ≤ (⟪ξ, y ξ⟫_ℂ).re) :\n   383\t    globalWeight q Ω v x ≤ globalWeight q Ω v y := by\n   384\t  rw [globalWeight_eq hf, globalWeight_eq hf]\n   385\t  exact ENNReal.tsum_le_tsum fun n => ENNReal.ofReal_le_ofReal (h _)\n   386\t\n   387\tend Laws\n   388\t\n   389\t/-! ## §5  Traciality\n   390\t\n   490\t  refine tsum_congr fun n => ?_\n   491\t  rw [inner_star_mul_self, ← tsum_rngProj_norm_sq hf (a (v n Ω))]\n   492\t  exact tsum_congr fun m => by rw [norm_rngProj_apply hf]\n   493\t\n   494\t/-- **Traciality of the global weight.**  `W (a^* a) = W (a a^*)` for every `a ∈ M`. -/\n   495\ttheorem globalWeight_tracial (hf : ComparisonFamily M q v)\n   496\t    (h : IsFaithfulUltraweakNormalTracialCorner M q Ω) {a : H →L[ℂ] H} (ha : a ∈ M) :\n   497\t    globalWeight q Ω v (star a * a) = globalWeight q Ω v (a * star a) := by\n   498\t  have hq1 : star q = q := hf.q_isStarProjection.isSelfAdjoint.star_eq\n   499\t  -- the corner elements `b n m = v m ^* a v n`\n   500\t  have hcorner : ∀ n m : ℕ, ‖(star (star (v n) * a * v m)) Ω‖ = ‖(star (v n) * a * v m) Ω‖ := by\n   501\t    intro n m\n   502\t    refine norm_star_apply_eq_of_cornerTracial h.tracial hq1\n   503\t      (mul_mem (mul_mem (star_mem (hf.mem n)) ha) (hf.mem m)) ?_ ?_\n   504\t    · calc q * (star (v n) * a * v m) = (q * star (v n)) * a * v m := by noncomm_ring\n   505\t        _ = star (v n) * a * v m := by rw [hf.q_mul_star n]\n   506\t    · calc (star (v n) * a * v m) * q = star (v n) * a * (v m * q) := by noncomm_ring\n   507\t        _ = star (v n) * a * v m := by rw [hf.mul_q m]\n   508\t  have hstar : ∀ n m : ℕ,\n   509\t      star (v m) * star a * v n = star (star (v n) * a * v m) := by\n   510\t    intro n m\n   511\t    rw [star_mul, star_mul, star_star]\n   512\t    noncomm_ring\n   513\t  calc globalWeight q Ω v (star a * a)\n   514\t      = ∑' n, ∑' m, ENNReal.ofReal (‖(star (v m) * a * v n) Ω‖ ^ 2) :=\n   515\t        globalWeight_star_mul_self hf a\n   516\t    _ = ∑' m, ∑' n, ENNReal.ofReal (‖(star (v m) * a * v n) Ω‖ ^ 2) := ENNReal.tsum_comm\n   517\t    _ = ∑' n, ∑' m, ENNReal.ofReal (‖(star (v n) * a * v m) Ω‖ ^ 2) := rfl\n   518\t    _ = ∑' n, ∑' m, ENNReal.ofReal (‖(star (v m) * star a * v n) Ω‖ ^ 2) := by\n   519\t        refine tsum_congr fun n => tsum_congr fun m => ?_\n   520\t        rw [hstar n m, hcorner n m]\n   521\t    _ = globalWeight q Ω v (a * star a) := by\n   522\t        have h1 := globalWeight_star_mul_self (Ω := Ω) hf (star a)\n   523\t        rw [star_star] at h1\n   524\t        exact h1.symm\n   525\t\n   526\tend Tracial\n   527\t\n   528\t/-! ## §6  Faithfulness -/\n   529\t\n   530\tsection Faithful\n   531\t\n   532\tvariable {M : VonNeumannAlgebra H} {q : H →L[ℂ] H} {Ω : H} {v : ℕ → H →L[ℂ] H}\n   533\t\n   534\t/-- **Faithfulness of the global weight.**  If `a ∈ M` and `W (a^* a) = 0` then `a = 0`.\n   535\t\n   536\tThe argument is: vanishing of the `n`-th term makes the corner element `v n ^* a^* a v n`\n   537\tannihilate `Ω`, hence vanish by faithfulness of the P50U corner state; the C⋆-identity then\n   538\tgives `a v n = 0`, so `a` kills every range projection, and therefore `a = 0` by the strong\n   539\tconvergence of the partial sums. -/\n   540\ttheorem globalWeight_faithful (hf : ComparisonFamily M q v)\n   541\t    (h : IsFaithfulUltraweakNormalTracialCorner M q Ω) (hqΩ : q Ω = Ω)\n   542\t    {a : H →L[ℂ] H} (ha : a ∈ M) (h0 : globalWeight q Ω v (star a * a) = 0) : a = 0 := by\n   543\t  have hqsa : IsSelfAdjoint q := hf.q_isStarProjection.isSelfAdjoint\n   544\t  -- Step 1: every term vanishes.\n   545\t  have hterm : ∀ n, a (v n Ω) = 0 := by\n   546\t    intro n\n   547\t    have h1 : ∑' n, ENNReal.ofReal ((⟪v n Ω, (star a * a) (v n Ω)⟫_ℂ).re) = 0 := by\n   548\t      rw [← globalWeight_eq hf]; exact h0\n   549\t    have h2 := (ENNReal.tsum_eq_zero.mp h1) n\n   550\t    rw [inner_star_mul_self] at h2\n   640\t\n   641\t/-- **Normality of the global weight (ultraweak form).**\n   642\t\n   643\tIf `x` is an increasing sequence for the quadratic-form order converging *ultraweakly* to `y`\n   644\t— the standard hypothesis for normality of a weight — then `W y` is the supremum of the\n   645\t`W (x k)`.\n   646\t\n   647\tThe only continuity input is P50U's ultraweak-normal bounded corner functional. -/\n   648\ttheorem globalWeight_iSup_of_ultraweakTendsto (hf : ComparisonFamily M q v)\n   649\t    (h : IsFaithfulUltraweakNormalTracialCorner M q Ω)\n   650\t    {x : ℕ → H →L[ℂ] H} {y : H →L[ℂ] H}\n   651\t    (hmono : ∀ k, ∀ ξ : H, (⟪ξ, x k ξ⟫_ℂ).re ≤ (⟪ξ, x (k + 1) ξ⟫_ℂ).re)\n   652\t    (hconv : Tendsto (fun k => toUltraweak (x k)) atTop (𝓝 (toUltraweak y))) :\n   653\t    (⨆ k, globalWeight q Ω v (x k)) = globalWeight q Ω v y := by\n   654\t  have hmono' : ∀ n, Monotone fun k => weightTerm q Ω v (x k) n := by\n   655\t    intro n\n   656\t    refine monotone_nat_of_le_succ fun k => ?_\n   657\t    rw [weightTerm_eq hf, weightTerm_eq hf]\n   658\t    exact ENNReal.ofReal_le_ofReal (hmono k (v n Ω))\n   659\t  have hterm : ∀ n, (⨆ k, weightTerm q Ω v (x k) n) = weightTerm q Ω v y n := by\n   660\t    intro n\n   661\t    exact tendsto_nhds_unique (tendsto_atTop_iSup (hmono' n))\n   662\t      (tendsto_weightTerm_of_ultraweakTendsto (v := v) h n hconv)\n   663\t  calc (⨆ k, globalWeight q Ω v (x k)) = ∑' n, ⨆ k, weightTerm q Ω v (x k) n :=\n   664\t        iSup_tsum_of_monotone hmono'\n   665\t    _ = globalWeight q Ω v y := tsum_congr hterm\n   666\t\n   667\t/-- **Normality of the global weight (strong-convergence form).**\n   668\t\n   669\tThe same monotone-supremum law for an increasing sequence converging in the strong operator\n   670\tsense; this version uses the vector-state realization of the corner functional rather than\n   671\tits ultraweak continuity. -/\n   672\ttheorem globalWeight_iSup_of_stronglyTendsto (hf : ComparisonFamily M q v)\n   673\t    {x : ℕ → H →L[ℂ] H} {y : H →L[ℂ] H}\n   674\t    (hmono : ∀ k, ∀ ξ : H, (⟪ξ, x k ξ⟫_ℂ).re ≤ (⟪ξ, x (k + 1) ξ⟫_ℂ).re)\n   675\t    (hconv : ∀ ξ : H, Tendsto (fun k => x k ξ) atTop (𝓝 (y ξ))) :\n   676\t    (⨆ k, globalWeight q Ω v (x k)) = globalWeight q Ω v y := by\n   677\t  have hmono' : ∀ n, Monotone fun k => weightTerm q Ω v (x k) n := by\n   678\t    intro n\n   679\t    refine monotone_nat_of_le_succ fun k => ?_\n   680\t    rw [weightTerm_eq hf, weightTerm_eq hf]\n   895\t      simp\n   896\t    have hA := hcont\n   897\t    simp only [hzero] at hA\n   898\t    exact tendsto_nhds_unique hA tendsto_const_nhds\n   899\t  have hlin : (x : H →ₗ[ℂ] H) = 0 := (inner_map_self_eq_zero (x : H →ₗ[ℂ] H)).mp hquad\n   900\t  exact ContinuousLinearMap.ext fun ξ => congrFun (congrArg (fun t : H →ₗ[ℂ] H => (t : H → H))\n   901\t    hlin) ξ\n   902\t\n   903\t/-- **Semifiniteness of the global weight.**\n   904\t\n   905\tThe finite partial sums `f_N = ∑_{m<N} v m v m ^*` are projections of `M` with finite weight,\n   906\tthey converge strongly to `1`, every compression `f_N x f_N` has finite weight, and no nonzero\n   907\toperator is annihilated by all of these compressions.  Hence the elements of finite\n   908\tweight are not confined to a proper corner: the weight is semifinite. -/\n   909\ttheorem globalWeight_semifinite (hf : ComparisonFamily M q v) :\n   910\t    (∀ N, IsStarProjection (partialProj v N) ∧ partialProj v N ∈ M ∧\n   911\t        globalWeight q Ω v (partialProj v N) < ⊤) ∧\n   912\t      (∀ ξ : H, Tendsto (fun N => partialProj v N ξ) atTop (𝓝 ξ)) ∧\n   913\t      (∀ x : H →L[ℂ] H, ∀ N, globalWeight q Ω v (partialProj v N * x * partialProj v N) < ⊤) ∧\n   914\t      (∀ x : H →L[ℂ] H, x ≠ 0 → ∃ N,\n   915\t        partialProj v N * x * partialProj v N ≠ 0 ∧\n   916\t        globalWeight q Ω v (partialProj v N * x * partialProj v N) < ⊤) := by\n   917\t  refine ⟨fun N => ⟨partialProj_isStarProjection hf N, partialProj_mem hf N,\n   918\t      globalWeight_partialProj_lt_top hf N⟩, hf.sum_strong,\n   919\t    fun x N => globalWeight_compress_lt_top hf x N, fun x hx0 => ?_⟩\n   920\t  by_contra hcon\n   921\t  push_neg at hcon\n   922\t  refine hx0 (eq_zero_of_compress_eq_zero hf fun N => ?_)\n   923\t  by_contra hN\n   924\t  exact absurd (globalWeight_compress_lt_top hf x N) (by simpa using hcon N hN)\n   925\t\n   926\tend Semifinite\n   927\t\n   928\t/-! ## §9  Where the comparison family comes from\n   929\t\n   930\tThe classical route to the hypothesis of this packet is the σ-finite comparison theorem: for a\n   940\tsection Existence\n   941\t\n   942\t/-- **From an orthogonal decomposition of `1` by projections subequivalent to `q` to a\n   943\tcomparison family.**\n   944\t\n   945\tThe hypotheses `he0`, `horth`, `hsum`, `hequiv` are exactly the output of the σ-finite\n   946\tcomparison theorem; that theorem itself is *not* proved here, so this statement is\n   947\tconditional. -/\n   948\ttheorem exists_comparisonFamily_of_orthogonal_decomposition {M : VonNeumannAlgebra H}\n   949\t    {q : H →L[ℂ] H} (hq : M.IsProjection q) (e : ℕ → H →L[ℂ] H) (he0 : e 0 = q)\n   950\t    (horth : ∀ m n, m ≠ n → e m * e n = 0)\n   951\t    (hsum : ∀ ξ : H, Tendsto (fun N => (∑ m ∈ Finset.range N, e m) ξ) atTop (𝓝 ξ))\n   952\t    (hequiv : ∀ n, ∃ p, M.IsProjection p ∧ VonNeumannAlgebra.ProjLe p q ∧ M.MvNEquiv p (e n)) :\n   953\t    ∃ v : ℕ → H →L[ℂ] H, ComparisonFamily M q v ∧ ∀ n, rngProj v n = e n := by\n   954\t  classical\n   955\t  choose p hpproj hple hpequiv using hequiv\n   956\t  choose w hw using hpequiv\n   957\t  set v : ℕ → H →L[ℂ] H := fun n => if n = 0 then q else w n with hvdef\n   958\t  have hv0 : v 0 = q := by simp [hvdef]\n   959\t  have hvn : ∀ n, n ≠ 0 → v n = w n := fun n hn => by simp [hvdef, hn]\n   960\t  have hrng : ∀ n, rngProj v n = e n := by\n   961\t    intro n\n   962\t    by_cases hn : n = 0\n   963\t    · subst hn\n   964\t      rw [rngProj, hv0, hq.star_eq, hq.mul_self, he0]\n   965\t    · rw [rngProj, hvn n hn]\n   966\t      exact (hw n).2.2\n   967\t  have hsrc : ∀ n, srcProj v n = if n = 0 then q else p n := by\n   968\t    intro n\n   969\t    by_cases hn : n = 0\n   970\t    · subst hn\n   971\t      rw [srcProj, hv0, hq.star_eq, hq.mul_self, if_pos rfl]\n   972\t    · rw [srcProj, hvn n hn, (hw n).2.1, if_neg hn]\n   973\t  refine ⟨v, ?_, hrng⟩\n   974\t  refine\n   975\t    { mem := ?_, idem_src := ?_, src_le := ?_, orthogonal := ?_, sum_strong := ?_,\n   976\t      src_zero := ?_, rng_zero := ?_ }\n   977\t  · intro n\n   978\t    by_cases hn : n = 0\n   979\t    · rw [hn, hv0]; exact hq.2\n   980\t    · rw [hvn n hn]; exact (hw n).1\n   981\t  · intro n\n   982\t    rw [hsrc n]\n   983\t    by_cases hn : n = 0\n   984\t    · rw [if_pos hn]; exact hq.mul_self\n   985\t    · rw [if_neg hn]; exact (hpproj n).mul_self\n   986\t  · intro n\n   987\t    rw [hsrc n]\n   988\t    by_cases hn : n = 0\n   989\t    · rw [if_pos hn]; exact ⟨hq.mul_self, hq.mul_self⟩\n   990\t    · rw [if_neg hn]; exact hple n\n   991\t  · intro m n hmn\n   992\t    rw [hrng m, hrng n]\n   993\t    exact horth m n hmn\n   994\t  · intro ξ\n   995\t    have h1 : ∀ N, partialProj v N = ∑ m ∈ Finset.range N, e m := by\n   996\t      intro N\n   997\t      rw [partialProj]\n   998\t      exact Finset.sum_congr rfl fun m _ => hrng m\n   999\t    simpa [h1] using hsum ξ\n  1000\t  · rw [hsrc 0, if_pos rfl]\n  1001\t  · rw [hrng 0, he0]\n  1002\t\n  1003\t/-- **Non-vacuity of the comparison premises.**  The unit projection of any concrete von\n  1004\tNeumann algebra carries a normalized countable comparison family, namely the one whose zeroth\n  1005\tmember is `1` and whose remaining members vanish.  This is a consistency check on the\n  1065\t/-! ## §10  The exported P60 theorem -/\n  1066\t\n  1067\tsection Export\n  1068\t\n  1069\tvariable {M : VonNeumannAlgebra H} {q : H →L[ℂ] H} {Ω : H} {v : ℕ → H →L[ℂ] H}\n  1070\t\n  1071\t/-- **The full list of weight laws proved in this file**, bundled as a single predicate for\n  1072\tthe exported statements.  It is a *conclusion*, never a hypothesis: no theorem of this file\n  1073\tassumes it. -/\n  1074\tdef IsGlobalFaithfulNormalSemifiniteTrace (M : VonNeumannAlgebra H) (q : H →L[ℂ] H) (Ω : H)\n  1075\t    (v : ℕ → H →L[ℂ] H) : Prop :=\n  1076\t  (∀ x y : H →L[ℂ] H, x.IsPositive → y.IsPositive →\n  1077\t      globalWeight q Ω v (x + y) = globalWeight q Ω v x + globalWeight q Ω v y) ∧\n  1078\t    (∀ c : ℝ, 0 ≤ c → ∀ x : H →L[ℂ] H,\n  1079\t      globalWeight q Ω v ((c : ℂ) • x) = ENNReal.ofReal c * globalWeight q Ω v x) ∧\n  1080\t    (∀ a ∈ M, globalWeight q Ω v (star a * a) = globalWeight q Ω v (a * star a)) ∧\n  1081\t    (∀ a ∈ M, globalWeight q Ω v (star a * a) = 0 → a = 0) ∧\n  1082\t    (∀ (x : ℕ → H →L[ℂ] H) (y : H →L[ℂ] H),\n  1083\t      (∀ k, ∀ ξ : H, (⟪ξ, x k ξ⟫_ℂ).re ≤ (⟪ξ, x (k + 1) ξ⟫_ℂ).re) →\n  1084\t      Tendsto (fun k => toUltraweak (x k)) atTop (𝓝 (toUltraweak y)) →\n  1085\t      (⨆ k, globalWeight q Ω v (x k)) = globalWeight q Ω v y) ∧\n  1086\t    (∀ N : ℕ, globalWeight q Ω v (partialProj v N)\n  1087\t      = ∑ m ∈ Finset.range N, ENNReal.ofReal ((cornerTau q Ω (srcProj v m)).re)) ∧\n  1088\t    (∀ x ∈ M, q * x = x → x * q = x →\n  1089\t      globalWeight q Ω v x = ENNReal.ofReal ((cornerTau q Ω x).re)) ∧\n  1090\t    ((∀ N, IsStarProjection (partialProj v N) ∧ partialProj v N ∈ M ∧\n  1091\t        globalWeight q Ω v (partialProj v N) < ⊤) ∧\n  1092\t      (∀ ξ : H, Tendsto (fun N => partialProj v N ξ) atTop (𝓝 ξ)) ∧\n  1093\t      (∀ x : H →L[ℂ] H, ∀ N,\n  1094\t        globalWeight q Ω v (partialProj v N * x * partialProj v N) < ⊤) ∧\n  1095\t      (∀ x : H →L[ℂ] H, x ≠ 0 → ∃ N,\n  1096\t        partialProj v N * x * partialProj v N ≠ 0 ∧\n  1097\t        globalWeight q Ω v (partialProj v N * x * partialProj v N) < ⊤))\n  1098\t\n  1099\t/-- **Exported P60 theorem: the global faithful normal semifinite weight.**\n  1100\t\n  1101\tInput data:\n  1102\t\n  1103\t* `hf`, a normalized countable comparison family for `q` in `M` (the explicit optional\n  1104\t  assumption of this packet: partial isometries of `M` with source projections below `q`,\n  1105\t  pairwise orthogonal range projections whose partial sums converge strongly to `1`, and\n  1106\t  `v 0` with source and range projection `q`);\n  1107\t* `h`, P50U's literally ultraweak-normal faithful tracial corner state on `q M q`; and\n  1108\t* `hqΩ`, the corner normalization `q Ω = Ω`.\n  1109\t\n  1110\tConclusion: `globalWeight q Ω v` is\n  1111\t\n  1112\t1. additive on the positive cone;\n  1113\t2. positively homogeneous;\n  1114\t3. tracial: `W (a^* a) = W (a a^*)` for `a ∈ M`;\n  1115\t4. faithful: `W (a^* a) = 0 → a = 0` for `a ∈ M`;\n  1116\t5. normal in the monotone-supremum sense for increasing ultraweakly convergent sequences;\n  1117\t6. computed on the finite partial sums `∑_{m<N} v m v m ^*` by the finite sum of the corner\n  1118\t   traces of the source projections;\n  1119\t7. equal, on the corner `q M q`, to the P50U corner trace; and\n  1120\t8. semifinite.\n  1121\t\n  1122\tNo weight law is assumed; each one is the corresponding theorem proved above. -/\n  1123\ttheorem full_corner_global_semifinite_weight (hf : ComparisonFamily M q v)\n  1124\t    (h : IsFaithfulUltraweakNormalTracialCorner M q Ω) (hqΩ : q Ω = Ω) :\n  1125\t    IsGlobalFaithfulNormalSemifiniteTrace M q Ω v := by\n  1126\t  refine ⟨fun x y hx hy => globalWeight_add hf hx hy,\n  1127\t    fun c hc x => globalWeight_smul hf hc x,\n  1128\t    fun a ha => globalWeight_tracial hf h ha,\n  1129\t    fun a ha h0 => globalWeight_faithful hf h hqΩ ha h0,\n  1130\t    fun x y hmono hconv => globalWeight_iSup_of_ultraweakTendsto hf h hmono hconv,\n  1131\t    fun N => globalWeight_partialProj hf N,\n  1132\t    fun x hx hqx hxq => globalWeight_corner hf h hx hqx hxq,\n  1133\t    globalWeight_semifinite hf⟩\n  1134\t\n  1135\tend Export\n  1136\t\n  1137\t/-! ## §11  The P51 full finite corner, globalized\n  1138\t\n  1139\tThis is the packet's optional strengthening in the form that uses P51 and P50U directly: the\n  1140\tinput is the P51/P50U data (the compatible finite-codespace system, its decreasing projection\n  1141\ttower, the represented regional C⋆-algebra, the commuting complement and the dense-vector\n  1142\tpremise) *together with* an explicitly supplied comparison family for the strong-limit\n  1143\tprojection `q`.  The conclusion records P51's finiteness and fullness of `q` alongside the new\n  1144\tglobal weight laws.\n  1145\t\n  1146\tThe comparison family is a hypothesis, never a consequence of fullness: nothing here claims\n  1147\tthat P51 already supplied a global weight. -/\n  1148\t\n  1149\tsection P51Globalization\n  1150\t\n  1151\tvariable {ι : ℕ → Type*} [∀ n, Fintype (ι n)] [∀ n, DecidableEq (ι n)]\n  1152\t\n  1153\t/-- **Optional Lane-G strengthening.**  Under the P51/P50U hypotheses together with a\n  1154\tnormalized countable comparison family `v` for the strong-limit projection `q`, the projection\n  1155\t`q` is a full finite projection of `M = A''` (P51) and `globalWeight q Ω v` is a faithful,\n  1156\tnormal (monotone-supremum law), tracial, semifinite extended-positive weight on `M`\n  1157\trestricting to the P50U corner trace on `q M q`. -/\n  1158\ttheorem full_finite_corner_globalized_weight {Ω : H}\n  1159\t    (D : CompatibleFiniteCodespaceSystem Ω ι)\n  1160\t    (hp : IsDecreasingProjTower D.toFiniteCodespaceSystem.stagePro