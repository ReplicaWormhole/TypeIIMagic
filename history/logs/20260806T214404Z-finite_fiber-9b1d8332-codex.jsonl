depends on axioms: [propext,\n Classical.choice,\n Quot.sound]\n'FiniteFiber.actualStabilizerSystem_semifinite_of_gnsOrbit' depends on axioms: [propext, Classical.choice, Quot.sound]\n-- declarations --\n97:noncomputable def wordElement (a : FullPauliWord Site) : A :=\n104:theorem embed_eq_wordElement (F : Finset Site) (a : FullPauliWord Site)\n117:theorem wordElement_mul (a b : FullPauliWord Site) :\n138:theorem isSelfAdjoint_wordElement (a : FullPauliWord Site) (ha : a * a = 1) :\n171:theorem isSelfAdjoint_stabilizerRepresentation (g : ↥S.group) :\n185:noncomputable def stabilizerAction :\n198:theorem stabilizerRepresentation_gnsVector (g : ↥S.group) :\n209:theorem stabilizerAction_representation_gnsVector (g : ↥S.group) :\n215:theorem stabilizerRepresentation_mem {M : VonNeumannAlgebra W.GNS}\n254:theorem actualStabilizerSystem_supportCornerConclusion_of_gnsOrbit\n275:theorem actualStabilizerSystem_canonicalSupportCornerConclusion_of_gnsOrbit\n300:theorem actualStabilizerSystem_central_witness_of_gnsOrbit\n315:theorem actualStabilizerSystem_semifinite_of_gnsOrbit\n-- explicit global premises --\n216:    (hM : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),\n254:theorem actualStabilizerSystem_supportCornerConclusion_of_gnsOrbit\n255:    (W : QuasilocalStabilizerState S Q) (M : VonNeumannAlgebra W.GNS)\n256:    (hM : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),\n258:    (T : ℕ → Subgroup ↥S.group) [∀ n, Fintype (T n)]\n259:    (hmonotone : ∀ n m : ℕ, n ≤ m → T n ≤ T m)\n261:    (hstrong : StronglyTendsTo (stabilizerAverageSequence W.stabilizerAction T) q)\n262:    (C : GNSOrbitConditions M q W.gnsVector) :\n275:theorem actualStabilizerSystem_canonicalSupportCornerConclusion_of_gnsOrbit\n276:    (W : QuasilocalStabilizerState S Q) (M : VonNeumannAlgebra W.GNS)\n277:    (hM : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),\n279:    (T : ℕ → Subgroup ↥S.group) [∀ n, Fintype (T n)]\n280:    (hmonotone : ∀ n m : ℕ, n ≤ m → T n ≤ T m)\n281:    (C : GNSOrbitConditions M\n300:theorem actualStabilizerSystem_central_witness_of_gnsOrbit\n301:    (W : QuasilocalStabilizerState S Q) (M : VonNeumannAlgebra W.GNS)\n302:    (hM : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),\n304:    (T : ℕ → Subgroup ↥S.group) [∀ n, Fintype (T n)]\n305:    (hmonotone : ∀ n m : ℕ, n ≤ m → T n ≤ T m)\n307:    (hstrong : StronglyTendsTo (stabilizerAverageSequence W.stabilizerAction T) q)\n308:    (C : GNSOrbitConditions M q W.gnsVector)\n309:    (hz : IsCentralProjection M z) (hz_nonzero : z ≠ 0) :\n315:theorem actualStabilizerSystem_semifinite_of_gnsOrbit\n316:    (W : QuasilocalStabilizerState S Q) (M : VonNeumannAlgebra W.GNS)\n317:    (hM : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),\n319:    (T : ℕ → Subgroup ↥S.group) [∀ n, Fintype (T n)]\n320:    (hmonotone : ∀ n m : ℕ, n ≤ m → T n ≤ T m)\n322:    (hstrong : StronglyTendsTo (stabilizerAverageSequence W.stabilizerAction T) q)\n323:    (C : GNSOrbitConditions M q W.gnsVector) :\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' <original-home>/.codex/adversarial_review.md && printf '\\\\n-- candidate diff --\\\\n' && git diff -- FiniteFiber/ActualStabilizerSupportCorner.lean && printf '\\\\n-- dependencies and interfaces --\\\\n' && sed -n '1,260p' FiniteFiber/QuasilocalStateGNSInterface.lean && printf '\\\\n-- target abstract theorem --\\\\n' && rg -n -A38 -B12 'stabilizerAverageSequence_(canonical)?SupportCornerConclusion_of_gnsOrbit' FiniteFiber/StabilizerFiniteFiber.lean FiniteFiber/StabilizerSequence.lean\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' <original-home>/.codex/adversarial_review.md && printf '\\\\n-- candidate diff --\\\\n' && git diff -- FiniteFiber/ActualStabilizerSupportCorner.lean && printf '\\\\n-- dependencies and interfaces --\\\\n' && sed -n '1,260p' FiniteFiber/QuasilocalStateGNSInterface.lean && printf '\\\\n-- target abstract theorem --\\\\n' && rg -n -A38 -B12 'stabilizerAverageSequence_(canonical)?SupportCornerConclusion_of_gnsOrbit' FiniteFiber/StabilizerFiniteFiber.lean FiniteFiber/StabilizerSequence.lean\"","aggregated_output":"# Adversarial Review Protocol\n\nUse this before closing substantive Codex work. The goal is to find defects, not\nto summarize accomplishments.\n\n## Scope\n\n1. Identify the artifact types touched: `code`, `math`, `tex`, `computation`,\n   `source-backed`, `workflow`.\n2. Inspect the diff or new artifact against the user's request.\n3. Report findings by severity first. If there are no findings, say so and state\n   the remaining risk.\n\n## Universal Checks\n\n- Did the work answer the actual latest user request?\n- Did it modify unrelated files or broaden scope?\n- Did it overwrite, reformat, or revert pre-existing user changes?\n- Are generated files, caches, logs, plots, PDFs, or build artifacts handled\n  intentionally?\n- Are final claims stronger than the evidence supports?\n- Are verification commands actually relevant to the changed artifact?\n\n## Code Checks\n\n- Does the changed behavior match the stated interface and edge cases?\n- Are tests missing for a changed behavior, bug fix, parser, numerical routine,\n  CLI command, or user-facing workflow?\n- Are errors handled where inputs, files, network calls, or external tools can\n  fail?\n- Is there hidden global state, path sensitivity, nondeterminism, race risk, or\n  stale cache behavior?\n- Did dependency, config, or environment changes alter unrelated workflows?\n\n## Math Checks\n\n- Are all assumptions, domains, signs, conventions, normalizations, and boundary\n  conditions stated before use?\n- Are definitions used consistently throughout the derivation?\n- Is any implication actually reversible, or was a one-way statement used both\n  ways?\n- Are there division-by-zero, invertibility, regularity, convergence, branch-cut,\n  gauge, or boundary-term assumptions?\n- Do limiting cases, dimensions/units, symmetries, and known special cases agree?\n- Are symbolic substitutions justified rather than smuggling in the result?\n- Are claims labeled correctly as proof, derivation, check, conjecture, or\n  numerical evidence?\n\n## TeX And Source-Backed Checks\n\n- Does the document compile if compilation was expected?\n- Are labels, references, citations, bibliography entries, and figure paths valid?\n- Are source-backed claims tied to exact locators when required?\n- Is quoted or paraphrased material clearly separated from the agent's synthesis?\n- Does the exposition define terms before using them in load-bearing statements?\n\n## Computation Checks\n\n- Is the computation reproducible from a recorded command?\n- Are inputs, random seeds, versions, tolerances, and units documented when they\n  affect the result?\n- Are outputs interpreted correctly and not over-promoted beyond the computation?\n- Were independent sanity checks used where feasible: small cases, limiting\n  cases, dimensional analysis, symbolic identities, or alternate algorithms?\n\n## Closeout Template\n\nUse this structure internally, then surface the concise version to the user:\n\n```text\nFindings:\n- [severity] file/path:line - issue and consequence.\n\nChecks run:\n- command -> result.\n\nResidual risk:\n- what was not checked, or why the artifact is not a proof/complete validation.\n\nCleanup:\n- remaining dirty/untracked files and whether they are intentional.\n```\n\n-- candidate diff --\n\n-- dependencies and interfaces --\nimport FiniteFiber.FullPauliDirectedLocalSystem\nimport FiniteFiber.GNSVector\nimport Mathlib.Analysis.CStarAlgebra.Hom\nimport Mathlib.Analysis.CStarAlgebra.PositiveLinearMap\n\n/-!\n# The quasilocal state and GNS interface for the actual local system\n\nThe directed system of `FiniteFiber.FullPauliDirectedLocalSystem` supplies, for\nevery finite region `F : Finset Site`, the finite local matrix algebra\n`finiteRegionQubitAlgebra F`, the identity-padding inclusions `localInclusion`,\nand — for a consistent stabilizer system `S` — the compatible finite local\nstates `S.localState F`.  This file adds the *smallest explicit interface*\nwhich turns that purely finite/algebraic data into the manuscript's quasilocal\nC-star algebra `𝒜 = closure (⋃_F 𝒜_F)`, its stabilizer state `ω`, and the GNS\ndata attached to `ω` by Mathlib.\n\n## The conditional inputs, enumerated exactly\n\nExactly two bundles of data are assumed; nothing else in this file is\nconditional.\n\n`QuasilocalEmbedding Site A` (the C-star completion input), with fields\n\n1. `embed`  : for each finite region a unital star-algebra map\n   `𝒜_F →⋆ₐ[ℂ] A` into a C-star algebra `A`;\n2. `embed_injective` : each `embed F` is injective (the local algebras are\n   faithfully represented in `A`);\n3. `embed_localInclusion` : `embed F' ∘ localInclusion h = embed F` for\n   `F ⊆ F'` — the manuscript's identification `𝒜_F ≃ 𝒜_F ⊗ id_{F' \\ F}`;\n4. `dense_localAlgebra` : the union of the images is norm dense in `A`, i.e.\n   `A` really is the norm completion of `𝒜_loc`.\n\n`QuasilocalStabilizerState S Q` (the global state input), with fields\n\n5. `state` : a positive linear functional `ω : A →ₚ[ℂ] ℂ`;\n6. `state_embed` : `ω (embed F x) = S.localState F x` for every finite region\n   `F` — `ω` extends the compatible finite stabilizer functionals.\n\nEverything else is *derived* here.  In particular the following are **not**\nassumed:\n\n* the continuity bound of the embeddings: `‖embed F x‖ = ‖x‖` is proved from\n  injectivity (`norm_embed`), so `embed F` is an isometry;\n* the continuity of `ω`: positive linear functionals on a C-star algebra are\n  automatically bounded in Mathlib, so `continuous_state` is proved;\n* normalization `ω 1 = 1`, which is derived from field 6 at `F = ∅`;\n* uniqueness of the extension (`state_eq`, the B.L.T. uniqueness step of\n  Proposition `prop:define_state`), derived from continuity and density.\n\n## What is proved\n\n* Algebraic direct-limit facts: the images of the finite local algebras are\n  directed (`exists_localSet_common_region`), and for every subregion\n  `Γ : Set Site` the local elements supported in `Γ` form a star subalgebra\n  `Q.localStarAlgebra Γ` of `A` (`𝒜_{Γ,loc}`), monotone in `Γ` and dense for\n  `Γ = univ`.\n* Finite-stage evaluation: `state_embed_fullPauliRegionMatrix` (every local\n  stabilizer has expectation one), region-independence of the value on a word\n  (`state_embed_eq_of_supportedIn`), and normalization.\n* The GNS connection through the generic bridge of `FiniteFiber.GNSVector`:\n  the cyclic unit vector `Ω`, the reconstruction formula\n  `⟪Ω, π(embed F x) Ω⟫ = S.localState F x`, cyclicity, the local\n  representations `π ∘ embed F` and their coherence along the directed system,\n  and the invariance `π(embed F g) Ω = Ω` of the GNS vector under every local\n  stabilizer.\n* Finite-stage positivity: the finite local state `ω_F(x) = Tr(ρ_F x)` is a\n  positive linear functional for the Loewner order\n  (`FullPauliStabilizerSystem.localPositiveState`).\n* Non-vacuity of both interfaces: `emptySiteQuasilocalEmbedding` and\n  `emptySiteQuasilocalStabilizerState`.\n\n## What is *not* claimed\n\nNo product/tensor factorization of the GNS representation, no normality\nstatement, no von Neumann algebra generated by the local algebras, no type\nclassification, and no construction of `A` or of `ω` for an infinite lattice:\nthose remain the explicit inputs listed above.\n-/\n\nnamespace FiniteFiber\n\nopen scoped BigOperators ComplexOrder InnerProductSpace\nopen scoped FiniteFiber.FiniteRegionQubitMatrix\n\nvariable {Site : Type*} [DecidableEq Site]\n\n/-! ### Finite-stage facts about involutive supported words -/\n\n/-- `pauliSign` is a real sign, hence star-invariant. -/\n@[simp] theorem star_pauliSign (b : Bool) : star (pauliSign b) = pauliSign b := by\n  cases b <;> simp [pauliSign]\n\n/-- The finite-region matrix of an involutive word supported in `F` is self-adjoint. -/\ntheorem fullPauliRegionMatrix_isSelfAdjoint (F : Finset Site) (a : FullPauliWord Site)\n    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :\n    IsSelfAdjoint (fullPauliRegionMatrix F a) := by\n  rw [fullPauliRegionMatrix_eq_pauliSign_smul F a ha hinv]\n  show star _ = _\n  rw [star_smul, star_pauliSign,\n    (finiteRegionPauliMatrix_isSelfAdjoint F (regionPauliLabels F a))]\n\n/-- The finite-region matrix of an involutive word supported in `F` squares to `1`. -/\ntheorem fullPauliRegionMatrix_mul_self (F : Finset Site) (a : FullPauliWord Site)\n    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :\n    fullPauliRegionMatrix F a * fullPauliRegionMatrix F a = 1 := by\n  rw [← fullPauliRegionMatrix_mul F a a ha, hinv, fullPauliRegionMatrix_one]\n\n/-- The deviation element `(g - 1)^*(g - 1)` of an involutive supported word. -/\ntheorem star_sub_one_mul_sub_one_fullPauliRegionMatrix\n    (F : Finset Site) (a : FullPauliWord Site)\n    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :\n    star (fullPauliRegionMatrix F a - 1) * (fullPauliRegionMatrix F a - 1) =\n      (2 : ℂ) • (1 : finiteRegionQubitAlgebra F) -\n        (2 : ℂ) • fullPauliRegionMatrix F a := by\n  have hsa : star (fullPauliRegionMatrix F a) = fullPauliRegionMatrix F a :=\n    fullPauliRegionMatrix_isSelfAdjoint F a ha hinv\n  have hsq := fullPauliRegionMatrix_mul_self F a ha hinv\n  rw [star_sub, star_one, hsa, sub_mul, mul_sub, mul_sub, hsq, one_mul, mul_one]\n  simp only [mul_one]\n  module\n\n/-! ### The explicit C-star completion input -/\n\nvariable (Site) in\n/--\n**The C-star completion input.**  A concrete C-star algebra `A` together with\nfaithful unital star embeddings of every finite local algebra which are\ncompatible with the identity padding of the directed system and whose images\nare norm dense.  This is exactly the manuscript's quasilocal algebra\n`𝒜 = closure (⋃_{F} 𝒜_F)` together with the identification\n`𝒜_F ≃ 𝒜_F ⊗ id_{F' \\ F}`.\n-/\nstructure QuasilocalEmbedding (A : Type*) [CStarAlgebra A] where\n  /-- The star embedding of the finite local algebra of a region. -/\n  embed : ∀ F : Finset Site, finiteRegionQubitAlgebra F →⋆ₐ[ℂ] A\n  /-- The finite local algebras are faithfully represented. -/\n  embed_injective : ∀ F : Finset Site, Function.Injective (embed F)\n  /-- The embeddings are compatible with the identity padding of the directed system. -/\n  embed_localInclusion : ∀ (F F' : Finset Site) (h : F ⊆ F')\n    (x : finiteRegionQubitAlgebra F), embed F' (localInclusion h x) = embed F x\n  /-- The local elements are norm dense: `A` is the completion of `⋃_F 𝒜_F`. -/\n  dense_localAlgebra : Dense (⋃ F : Finset Site, Set.range (embed F))\n\nnamespace QuasilocalEmbedding\n\nvariable {A : Type*} [CStarAlgebra A] (Q : QuasilocalEmbedding Site A)\n\n/-- **The continuity bound is derived, not assumed**: each embedding is isometric. -/\ntheorem norm_embed (F : Finset Site) (x : finiteRegionQubitAlgebra F) :\n    ‖Q.embed F x‖ = ‖x‖ :=\n  NonUnitalStarAlgHom.norm_map (Q.embed F) (Q.embed_injective F) x\n\n/-- Each embedding is an isometry. -/\ntheorem isometry_embed (F : Finset Site) : Isometry (Q.embed F) :=\n  AddMonoidHomClass.isometry_of_norm (Q.embed F) (Q.norm_embed F)\n\n/-- Each embedding is continuous. -/\ntheorem continuous_embed (F : Finset Site) : Continuous (Q.embed F) :=\n  (Q.isometry_embed F).continuous\n\n@[simp] theorem embed_one (F : Finset Site) : Q.embed F 1 = 1 := map_one _\n\n/--\nA full-Pauli word has a single image in `A`: its finite-region matrices on all\nregions containing its support agree there.\n-/\ntheorem embed_fullPauliRegionMatrix_eq (F F' : Finset Site) (hFF' : F ⊆ F')\n    (a : FullPauliWord Site) (ha : a.SupportedIn F) :\n    Q.embed F' (fullPauliRegionMatrix F' a) = Q.embed F (fullPauliRegionMatrix F a) := by\n  rw [← localInclusion_fullPauliRegionMatrix F F' hFF' a ha,\n    Q.embed_localInclusion F F' hFF']\n\n/-- The image of a smaller region is contained in the image of a larger one. -/\ntheorem range_embed_mono (F F' : Finset Site) (hFF' : F ⊆ F') :\n    Set.range (Q.embed F) ⊆ Set.range (Q.embed F') := by\n  rintro _ ⟨x, rfl⟩\n  exact ⟨localInclusion hFF' x, Q.embed_localInclusion F F' hFF' x⟩\n\n/-! ### The local star algebra of a subregion -/\n\n/--\nThe set of elements of `A` which are local in the subregion `Γ`: images of the\nfinite local algebras of the finite regions contained in `Γ`.  This is the\nmanuscript's `𝒜_{Γ,loc} = ⋃_{F ⋐ Γ} 𝒜_F`.\n-/\ndef localSet (Γ : Set Site) : Set A :=\n  {x | ∃ F : Finset Site, ↑F ⊆ Γ ∧ x ∈ Set.range (Q.embed F)}\n\ntheorem mem_localSet_iff (Γ : Set Site) (x : A) :\n    x ∈ Q.localSet Γ ↔ ∃ F : Finset Site, ↑F ⊆ Γ ∧ ∃ y, Q.embed F y = x := Iff.rfl\n\ntheorem embed_mem_localSet {Γ : Set Site} {F : Finset Site} (hF : ↑F ⊆ Γ)\n    (x : finiteRegionQubitAlgebra F) : Q.embed F x ∈ Q.localSet Γ :=\n  ⟨F, hF, ⟨x, rfl⟩⟩\n\ntheorem localSet_mono {Γ Δ : Set Site} (h : Γ ⊆ Δ) : Q.localSet Γ ⊆ Q.localSet Δ := by\n  rintro x ⟨F, hF, hx⟩\n  exact ⟨F, hF.trans h, hx⟩\n\n/-- The local set of the whole lattice is the union of all the images. -/\ntheorem localSet_univ : Q.localSet (Set.univ : Set Site) = ⋃ F : Finset Site,\n    Set.range (Q.embed F) := by\n  ext x\n  simp [localSet]\n\n/--\n**Directedness of the local system.**  Any two elements local in `Γ` are images\nof one and the same finite region contained in `Γ`.\n-/\ntheorem exists_localSet_common_region {Γ : Set Site} {x y : A}\n    (hx : x ∈ Q.localSet Γ) (hy : y ∈ Q.localSet Γ) :\n    ∃ G : Finset Site, ↑G ⊆ Γ ∧ ∃ a b : finiteRegionQubitAlgebra G,\n      Q.embed G a = x ∧ Q.embed G b = y := by\n  obtain ⟨F, hF, a, rfl⟩ := hx\n  obtain ⟨F', hF', b, rfl⟩ := hy\n  refine ⟨F ∪ F', ?_, localInclusion Finset.subset_union_left a,\n    localInclusion Finset.subset_union_right b, ?_, ?_⟩\n  · rw [Finset.coe_union]\n    exact Set.union_subset hF hF'\n  · exact Q.embed_localInclusion F (F ∪ F') Finset.subset_union_left a\n  · exact Q.embed_localInclusion F' (F ∪ F') Finset.subset_union_right b\n\n/--\n**The local star algebra of a subregion.**  The local elements of `Γ` form a\nstar subalgebra of `A`: sums, products and adjoints of elements local in `F`\nand `E` are local in `F ∪ E`.\n-/\ndef localStarAlgebra (Γ : Set Site) : StarSubalgebra ℂ A where\n  carrier := Q.localSet Γ\n  mul_mem' := by\n    intro x y hx hy\n    obtain ⟨G, hG, a, b, rfl, rfl⟩ := Q.exists_localSet_common_region hx hy\n    exact ⟨G, hG, ⟨a * b, map_mul _ _ _⟩⟩\n  add_mem' := by\n    intro x y hx hy\n    obtain ⟨G, hG, a, b, rfl, rfl⟩ := Q.exists_localSet_common_region hx hy\n    exact ⟨G, hG, ⟨a + b, map_add _ _ _⟩⟩\n  algebraMap_mem' := by\n    intro r\n    exact ⟨∅, by simp, ⟨algebraMap ℂ _ r, AlgHomClass.commutes _ r⟩⟩\n  star_mem' := by\n    rintro x ⟨F, hF, a, rfl⟩\n    exact ⟨F, hF, ⟨star a, map_star _ _⟩⟩\n\n@[simp] theorem coe_localStarAlgebra (Γ : Set Site) :\n    (Q.localStarAlgebra Γ : Set A) = Q.localSet Γ := rfl\n\ntheorem localStarAlgebra_mono {Γ Δ : Set Site} (h : Γ ⊆ Δ) :\n    Q.localStarAlgebra Γ ≤ Q.localStarAlgebra Δ := Q.localSet_mono h\n\n/-- **The quasilocal algebra.**  The global local star algebra is dense in `A`. -/\ntheorem dense_localStarAlgebra_univ :\n    Dense (Q.localStarAlgebra (Set.univ : Set Site) : Set A) := by\n  rw [coe_localStarAlgebra, localSet_univ]\n  exact Q.dense_localAlgebra\n\n/-- The topological closure of the global local star algebra is all of `A`. -/\ntheorem localStarAlgebra_univ_topologicalClosure :\n    (Q.localStarAlgebra (Set.univ : Set Site)).topologicalClosure = ⊤ := by\n\n-- target abstract theorem --\nFiniteFiber/StabilizerFiniteFiber.lean-39-    SupportCornerConclusion M q xi := by\nFiniteFiber/StabilizerFiniteFiber.lean-40-  let D : DecreasingProjectionSequence M (stabilizerAverageSequence A S) :=\nFiniteFiber/StabilizerFiniteFiber.lean-41-    stabilizerAverageSequence_decreasingProjectionSequence A S hmem hmonotone\nFiniteFiber/StabilizerFiniteFiber.lean-42-  exact D.supportCornerConclusion_of_gnsOrbit hstrong\nFiniteFiber/StabilizerFiniteFiber.lean-43-    (stabilizerAverageSequence_fixes A S xi hfix) C\nFiniteFiber/StabilizerFiniteFiber.lean-44-\nFiniteFiber/StabilizerFiniteFiber.lean-45-/--\nFiniteFiber/StabilizerFiniteFiber.lean-46-Conditional canonical strong-limit form of the stabilizer finite-fiber\nFiniteFiber/StabilizerFiniteFiber.lean-47-theorem.  Given the supplied subgroup sequence and GNS-orbit conditions, the\nFiniteFiber/StabilizerFiniteFiber.lean-48-limit is constructed from the decreasing local supports, so no separate\nFiniteFiber/StabilizerFiniteFiber.lean-49-convergence hypothesis is needed.\nFiniteFiber/StabilizerFiniteFiber.lean-50--/\nFiniteFiber/StabilizerFiniteFiber.lean:51:theorem stabilizerAverageSequence_canonicalSupportCornerConclusion_of_gnsOrbit\nFiniteFiber/StabilizerFiniteFiber.lean-52-    {M : VonNeumannAlgebra H} {xi : H}\nFiniteFiber/StabilizerFiniteFiber.lean-53-    (A : SelfAdjointFiniteGroupAction (H := H) (G := K))\nFiniteFiber/StabilizerFiniteFiber.lean-54-    (S : ℕ → Subgroup K) [∀ n, Fintype (S n)]\nFiniteFiber/StabilizerFiniteFiber.lean-55-    (hmem : ∀ n : ℕ, ∀ s : S n, A.representation (s : K) ∈ M)\nFiniteFiber/StabilizerFiniteFiber.lean-56-    (hmonotone : ∀ n m : ℕ, n ≤ m → S n ≤ S m)\nFiniteFiber/StabilizerFiniteFiber.lean-57-    (hfix : ∀ n : ℕ, ∀ s : S n, A.representation (s : K) xi = xi)\nFiniteFiber/StabilizerFiniteFiber.lean-58-    (C : GNSOrbitConditions M\nFiniteFiber/StabilizerFiniteFiber.lean-59-      (decreasingProjectionStrongLimit (stabilizerAverageSequence A S)) xi) :\nFiniteFiber/StabilizerFiniteFiber.lean-