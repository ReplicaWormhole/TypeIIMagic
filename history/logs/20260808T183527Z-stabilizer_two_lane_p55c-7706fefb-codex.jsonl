{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'task_root=aristotle_responses/P55C-local-hyperbolic-concrete-representations-c0959aa3-7706fefb-quarantine/aristotle-stabilizer_two_lane_p55c-6vvgku8k_aristotle; nl -ba \"$task_root/AristotleCandidates/LocalHyperbolicConcreteRepresentations.lean\" | sed -n '\"'245,460p'\"","aggregated_output":"   245\t\n   246\t/-- Because the regional representation is the source representation composed\n   247\twith the *bijection* `A.alpha.symm`, the two operator ranges are literally the\n   248\tsame set of bounded operators, hence so are the two closures.\n   249\t\n   250\tThis is a statement about ranges only.  **No** C⋆-extension of `alpha` between\n   251\tthe two closures is constructed or claimed here; that is the separate P55D\n   252\tgate. -/\n   253\ttheorem targetCStar_eq_sourceCStar : R.targetCStar = R.sourceCStar := by\n   254\t  refine rangeCStar_congr ?_\n   255\t  ext T\n   256\t  constructor\n   257\t  · rintro ⟨y, rfl⟩\n   258\t    exact ⟨A.alpha.symm y, rfl⟩\n   259\t  · rintro ⟨z, rfl⟩\n   260\t    exact ⟨A.alpha z, by simp⟩\n   261\t\n   262\t/-! ### The pulled-back pre-C⋆ structure on the algebraic source limit -/\n   263\t\n   264\t/-- The norm pulled back from the faithful representation. -/\n   265\tnoncomputable def sourceNorm (z : A.SourceLimit) : ℝ := ‖R.rep z‖\n   266\t\n   267\ttheorem sourceNorm_nonneg (z : A.SourceLimit) : 0 ≤ R.sourceNorm z := norm_nonneg _\n   268\t\n   269\t/-- **Definiteness of the pulled-back norm**, i.e. faithfulness in normed\n   270\tform. -/\n   271\ttheorem sourceNorm_eq_zero_iff (z : A.SourceLimit) : R.sourceNorm z = 0 ↔ z = 0 := by\n   272\t  constructor\n   273\t  · intro h\n   274\t    have h0 : R.rep z = 0 := by\n   275\t      simpa [sourceNorm] using norm_eq_zero.mp h\n   276\t    have : R.rep z = R.rep 0 := by rw [h0, map_zero]\n   277\t    exact R.rep_injective this\n   278\t  · rintro rfl\n   279\t    simp [sourceNorm]\n   280\t\n   281\ttheorem sourceNorm_mul_le (z w : A.SourceLimit) :\n   282\t    R.sourceNorm (z * w) ≤ R.sourceNorm z * R.sourceNorm w := by\n   283\t  simpa [sourceNorm, map_mul] using norm_mul_le (R.rep z) (R.rep w)\n   284\t\n   285\ttheorem sourceNorm_star (z : A.SourceLimit) : R.sourceNorm (star z) = R.sourceNorm z := by\n   286\t  show ‖R.rep (star z)‖ = ‖R.rep z‖\n   287\t  rw [map_star, ContinuousLinearMap.star_eq_adjoint]\n   288\t  exact ContinuousLinearMap.adjoint.norm_map _\n   289\t\n   290\t/-- **The C⋆-identity for the pulled-back norm**, proved from the faithful\n   291\trepresentation.  Norm preservation is never assumed. -/\n   292\ttheorem sourceNorm_star_mul_self (z : A.SourceLimit) :\n   293\t    R.sourceNorm (star z * z) = R.sourceNorm z * R.sourceNorm z := by\n   294\t  have h : R.rep (star z * z) = star (R.rep z) * R.rep z := by\n   295\t    rw [map_mul, map_star]\n   296\t  show ‖R.rep (star z * z)‖ = ‖R.rep z‖ * ‖R.rep z‖\n   297\t  rw [h, ContinuousLinearMap.star_eq_adjoint]\n   298\t  exact ContinuousLinearMap.norm_adjoint_comp_self _\n   299\t\n   300\t/-- The additive inverses of the algebraic source limit, which its stagewise\n   301\tsemiring structure does not carry directly, come from its complex module\n   302\tstructure. -/\n   303\tnoncomputable def sourceRing : Ring A.SourceLimit :=\n   304\t  ringOfComplexAlgebra A.SourceLimit\n   305\t\n   306\t/-- The pulled-back normed ring structure on the algebraic source limit. -/\n   307\tnoncomputable def sourceNormedRing : NormedRing A.SourceLimit :=\n   308\t  letI := sourceRing (A := A)\n   309\t  NormedRing.induced _ _ R.rep R.rep_injective\n   310\t\n   311\t/-- The pulled-back normed ℂ-algebra structure on the algebraic source limit. -/\n   312\tnoncomputable def sourceNormedAlgebra :\n   313\t    letI := R.sourceNormedRing\n   314\t    NormedAlgebra ℂ A.SourceLimit :=\n   315\t  letI := R.sourceNormedRing\n   316\t  NormedAlgebra.induced ℂ _ _ R.rep\n   317\t\n   318\t/-- **The pulled-back structure is a pre-C⋆ structure**: its C⋆-identity is a\n   319\ttheorem, derived from the faithful representation. -/\n   320\ttheorem sourceCStarRing :\n   321\t    letI := R.sourceNormedRing\n   322\t    CStarRing A.SourceLimit := by\n   323\t  letI := R.sourceNormedRing\n   324\t  refine ⟨fun z => ?_⟩\n   325\t  exact le_of_eq (R.sourceNorm_star_mul_self z).symm\n   326\t\n   327\tend SourceConcreteRep\n   328\t\n   329\t/-! ## 3. The infinite branch -/\n   330\t\n   331\t/-- **The infinite-coordinate branch.**  The P54 faithful trace-GNS\n   332\trepresentation `uhfRep` of the dyadic UHF algebra, transported through the P55B\n   333\tidentification `A.sourceUHFEquiv` of the P53 source limit with that algebra. -/\n   334\tnoncomputable def infiniteSourceRep [Infinite I] : A.SourceConcreteRep where\n   335\t  rep := uhfRep.comp (StarAlgHomClass.toStarAlgHom A.sourceUHFEquiv)\n   336\t  rep_injective := uhfRep_injective.comp (EquivLike.injective A.sourceUHFEquiv)\n   337\t\n   338\t@[simp] theorem infiniteSourceRep_rep [Infinite I] (z : A.SourceLimit) :\n   339\t    (A.infiniteSourceRep).rep z = uhfRep (A.sourceUHFEquiv z) := rfl\n   340\t\n   341\t/-- The infinite-branch stage formula: on the image of a stage-`n` element the\n   342\trepresentation is the P54 finite-stage representation of the corresponding\n   343\tdyadic element. -/\n   344\ttheorem infiniteSourceRep_stage [Infinite I] (n : ℕ) (x : pauliAlgebra (A.sourceForm n)) :\n   345\t    (A.infiniteSourceRep).rep (A.sourceOf n x) =\n   346\t      uhfStageRep (A.stageCard n) (A.stageUHFEquiv n x) := by\n   347\t  rw [infiniteSourceRep_rep, A.sourceUHFEquiv_of n x]\n   348\t  rfl\n   349\t\n   350\t/-! ## 4. The finite branch -/\n   351\t\n   352\t/-- **The finite-coordinate branch.**  The P54 faithful finite-stage matrix\n   353\trepresentation of the terminal dyadic block, transported through the P55B\n   354\tterminal-stage identification `A.sourceFiniteEquiv`. -/\n   355\tnoncomputable def finiteSourceRep [Finite I] : A.SourceConcreteRep where\n   356\t  rep := (uhfStageRep (Nat.card I)).comp (StarAlgHomClass.toStarAlgHom A.sourceFiniteEquiv)\n   357\t  rep_injective :=\n   358\t    (uhfStageRep_injective (Nat.card I)).comp (EquivLike.injective A.sourceFiniteEquiv)\n   359\t\n   360\t@[simp] theorem finiteSourceRep_rep [Finite I] (z : A.SourceLimit) :\n   361\t    (A.finiteSourceRep).rep z = uhfStageRep (Nat.card I) (A.sourceFiniteEquiv z) := rfl\n   362\t\n   363\t/-- The finite-branch stage formula, at every stage past the terminal one. -/\n   364\ttheorem finiteSourceRep_stage [Finite I] {n : ℕ} (hn : A.terminalStage ≤ n)\n   365\t    (x : pauliAlgebra (A.sourceForm n)) :\n   366\t    (A.finiteSourceRep).rep (A.sourceOf n x) =\n   367\t      uhfStageRep (Nat.card I)\n   368\t        (UHFBridge.qubitTensorPowerCongr (A.stageCard_eq_card hn) (A.stageUHFEquiv n x)) := by\n   369\t  rw [finiteSourceRep_rep, A.sourceFiniteEquiv_of hn]\n   370\t\n   371\t/-! ## 5. The branch-uniform datum -/\n   372\t\n   373\topen Classical in\n   374\t/-- **The uniform branch datum.**  Every field is filled by the constructions of\n   375\tthis file: the finite branch when the coordinate index type is finite, the\n   376\tinfinite branch otherwise. -/\n   377\tnoncomputable def branchSourceRep : A.SourceConcreteRep :=\n   378\t  if h : Finite I then\n   379\t    letI := h\n   380\t    A.finiteSourceRep\n   381\t  else\n   382\t    letI : Infinite I := not_finite_iff_infinite.mp h\n   383\t    A.infiniteSourceRep\n   384\t\n   385\ttheorem branchSourceRep_finite [hI : Finite I] : A.branchSourceRep = A.finiteSourceRep := by\n   386\t  classical\n   387\t  rw [branchSourceRep, dif_pos hI]\n   388\t\n   389\ttheorem branchSourceRep_infinite [hI : Infinite I] : A.branchSourceRep = A.infiniteSourceRep := by\n   390\t  classical\n   391\t  have h : ¬ Finite I := not_finite_iff_infinite.mpr hI\n   392\t  rw [branchSourceRep, dif_neg h]\n   393\t\n   394\t/-- The uniform datum is faithful on the source limit. -/\n   395\ttheorem branchSourceRep_injective : Function.Injective (A.branchSourceRep).rep :=\n   396\t  (A.branchSourceRep).rep_injective\n   397\t\n   398\t/-- The uniform datum is faithful on the regional limit. -/\n   399\ttheorem branchTargetRep_injective : Function.Injective (A.branchSourceRep).targetRep :=\n   400\t  (A.branchSourceRep).targetRep_injective\n   401\t\n   402\t/-- The canonical embedding of the algebraic source limit into the branch\n   403\tC⋆-model is injective with dense range. -/\n   404\ttheorem branchSourceEmbedding_injective_denseRange :\n   405\t    Function.Injective (A.branchSourceRep).sourceEmbedding ∧\n   406\t      DenseRange (A.branchSourceRep).sourceEmbedding :=\n   407\t  ⟨(A.branchSourceRep).sourceEmbedding_injective,\n   408\t    (A.branchSourceRep).sourceEmbedding_denseRange⟩\n   409\t\n   410\t/-- The canonical embedding of the algebraic regional limit into the branch\n   411\tC⋆-model is injective with dense range. -/\n   412\ttheorem branchTargetEmbedding_injective_denseRange :\n   413\t    Function.Injective (A.branchSourceRep).targetEmbedding ∧\n   414\t      DenseRange (A.branchSourceRep).targetEmbedding :=\n   415\t  ⟨(A.branchSourceRep).targetEmbedding_injective,\n   416\t    (A.branchSourceRep).targetEmbedding_denseRange⟩\n   417\t\n   418\tend AlphaData\n   419\t\n   420\t/-! ## 6. Non-vacuity -/\n   421\t\n   422\t/-- **Non-vacuity of the infinite branch.**  The P53 tautological\n   423\t`standardAlphaData` on the lattice `ℕ` has an infinite coordinate index type, so\n   424\tits branch datum is the constructed infinite branch. -/\n   425\ttheorem standardAlphaData_branchSourceRep :\n   426\t    standardAlphaData.branchSourceRep = standardAlphaData.infiniteSourceRep :=\n   427\t  AlphaData.branchSourceRep_infinite _\n   428\t\n   429\t/-- **Non-vacuity, faithful form.**  For the tautological data the source and\n   430\tregional representations are faithful and the two canonical embeddings into the\n   431\tclosed operator ranges are injective with dense range. -/\n   432\ttheorem standardAlphaData_concrete :\n   433\t    Function.Injective (standardAlphaData.branchSourceRep).rep ∧\n   434\t      Function.Injective (standardAlphaData.branchSourceRep).targetRep ∧\n   435\t      Function.Injective (standardAlphaData.branchSourceRep).sourceEmbedding ∧\n   436\t      DenseRange (standardAlphaData.branchSourceRep).sourceEmbedding ∧\n   437\t      Function.Injective (standardAlphaData.branchSourceRep).targetEmbedding ∧\n   438\t      DenseRange (standardAlphaData.branchSourceRep).targetEmbedding :=\n   439\t  ⟨AlphaData.branchSourceRep_injective _, AlphaData.branchTargetRep_injective _,\n   440\t    (standardAlphaData.branchSourceRep).sourceEmbedding_injective,\n   441\t    (standardAlphaData.branchSourceRep).sourceEmbedding_denseRange,\n   442\t    (standardAlphaData.branchSourceRep).targetEmbedding_injective,\n   443\t    (standardAlphaData.branchSourceRep).targetEmbedding_denseRange⟩\n   444\t\n   445\tend LocalHyperbolicAlpha\n   446\t\n   447\tend StabilizerHyperfinite\n","exit_code":0,"status":"completed"}}
