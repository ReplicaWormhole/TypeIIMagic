 have h : D.tensorUnitaryCLM (D.productGNSUnitary.symm y) = y :=\n830:    D.productGNSUnitary.apply_symm_apply y\n831:  rw [unitaryConj_apply, productGNSUnitary_apply, D.tensorUnitaryCLM_tensorOpC, h]\n832-\n833-/-! ## 8. Identification of the represented algebra\n834-\n835-The manuscript step identifies the represented regional algebra with a tensor product of the two\n836-factor algebras.  Everything below is *constructed* from the fields of `ProductGNSData`; the\n837-remaining, genuinely missing ingredient (a spatial von Neumann tensor product in pinned Mathlib)\n838-is discussed in the module docstring and is **not** assumed anywhere. -/\n839-\n840-/-- The set of elementary tensor operators `π₁(a) ⊗ π₂(b)` on `K_pure ⊗ K_mixed`. -/\n841-def elementaryTensorSet : Set (D.TensorGNS →L[ℂ] D.TensorGNS) :=\n842-  Set.range fun p : D.Pure × D.Mixed => D.tensorOpC p.1 p.2\n843-\n844-/-- The set of represented elementary product elements `π(ι₁(a) ι₂(b))` on the GNS space of the\n845-product state. -/\n846-def representedProductSet : Set (D.TotalGNS →L[ℂ] D.TotalGNS) :=\n847-  Set.range fun p : D.Pure × D.Mixed => D.totalRep (D.prodElt p.1 p.2)\n--\n966-    D.tensorOpC a b = D.tensorOpC 1 b * D.tensorOpC a 1 := by\n967-  ext z\n968-  induction z using Completion.induction_on with\n969-  | hp =>\n970-    exact isClosed_eq (D.tensorOpC a b).continuous\n971-      ((D.tensorOpC 1 b).continuous.comp (D.tensorOpC a 1).continuous)\n972-  | ih t =>\n973-    show D.tensorOpC a b (t : D.TensorGNS) = D.tensorOpC 1 b (D.tensorOpC a 1 (t : D.TensorGNS))\n974-    rw [tensorOpC_coe, tensorOpC_coe, tensorOpC_coe, D.tensorMapₗ_split' a b t]\n975-\n976-/-- The two families of operators commute. -/\n977-theorem tensorOpC_commute (a : D.Pure) (b : D.Mixed) :\n978-    D.tensorOpC a 1 * D.tensorOpC 1 b = D.tensorOpC 1 b * D.tensorOpC a 1 := by\n979-  rw [← D.tensorOpC_split, D.tensorOpC_split']\n980-\n981-/-- The represented pure factor `π₁(A₁) ⊗ 1` on `K_pure ⊗ K_mixed`. -/\n982:def pureFacto