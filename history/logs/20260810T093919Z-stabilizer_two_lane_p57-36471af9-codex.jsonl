{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"nl -ba aristotle_responses/P57-product-gns-tensor-factorization-a7accfb8-36471af9-quarantine/aristotle-stabilizer_two_lane_p57-sznchb36_aristotle/AristotleCandidates/ProductGNSTensorFactorization.lean | sed -n '835,1030p'\"","aggregated_output":"   835\tThe manuscript step identifies the represented regional algebra with a tensor product of the two\n   836\tfactor algebras.  Everything below is *constructed* from the fields of `ProductGNSData`; the\n   837\tremaining, genuinely missing ingredient (a spatial von Neumann tensor product in pinned Mathlib)\n   838\tis discussed in the module docstring and is **not** assumed anywhere. -/\n   839\t\n   840\t/-- The set of elementary tensor operators `π₁(a) ⊗ π₂(b)` on `K_pure ⊗ K_mixed`. -/\n   841\tdef elementaryTensorSet : Set (D.TensorGNS →L[ℂ] D.TensorGNS) :=\n   842\t  Set.range fun p : D.Pure × D.Mixed => D.tensorOpC p.1 p.2\n   843\t\n   844\t/-- The set of represented elementary product elements `π(ι₁(a) ι₂(b))` on the GNS space of the\n   845\tproduct state. -/\n   846\tdef representedProductSet : Set (D.TotalGNS →L[ℂ] D.TotalGNS) :=\n   847\t  Set.range fun p : D.Pure × D.Mixed => D.totalRep (D.prodElt p.1 p.2)\n   848\t\n   849\ttheorem unitaryConj_image_elementaryTensorSet :\n   850\t    D.unitaryConj '' D.elementaryTensorSet = D.representedProductSet := by\n   851\t  rw [elementaryTensorSet, representedProductSet, ← Set.range_comp]\n   852\t  exact congrArg Set.range (funext fun p => D.unitaryConj_tensorOpC p.1 p.2)\n   853\t\n   854\t/-! ### 8.1 Norm density: the elementary operators already determine the commutant -/\n   855\t\n   856\ttheorem continuous_totalRep : Continuous (fun z : D.Total => D.totalRep z) :=\n   857\t  AddMonoidHomClass.continuous_of_bound D.totalRep 1 (fun z => by\n   858\t    simpa using NonUnitalStarAlgHom.norm_apply_le (D.totalRep : D.Total →⋆ₐ[ℂ] _) z)\n   859\t\n   860\t/-- An operator commuting with all represented elementary product elements commutes with the whole\n   861\trepresented algebra.  This uses the density field `span_dense` together with contractivity of the\n   862\tGNS representation. -/\n   863\ttheorem commute_totalRep_of_commute_prodElt (T : D.TotalGNS →L[ℂ] D.TotalGNS)\n   864\t    (hT : ∀ (a : D.Pure) (b : D.Mixed),\n   865\t      D.totalRep (D.prodElt a b) * T = T * D.totalRep (D.prodElt a b)) (z : D.Total) :\n   866\t    D.totalRep z * T = T * D.totalRep z := by\n   867\t  have hclosed : IsClosed {w : D.Total | D.totalRep w * T = T * D.totalRep w} :=\n   868\t    isClosed_eq (D.continuous_totalRep.mul continuous_const)\n   869\t      (continuous_const.mul D.continuous_totalRep)\n   870\t  have hspan : ((Submodule.span ℂ (Set.range fun p : D.Pure × D.Mixed => D.prodElt p.1 p.2) :\n   871\t      Submodule ℂ D.Total) : Set D.Total)\n   872\t      ⊆ {w : D.Total | D.totalRep w * T = T * D.totalRep w} := by\n   873\t    intro w hw\n   874\t    induction hw using Submodule.span_induction with\n   875\t    | mem u hu =>\n   876\t      obtain ⟨p, rfl⟩ := hu\n   877\t      exact hT p.1 p.2\n   878\t    | zero => simp\n   879\t    | add u v _ _ hu hv =>\n   880\t      simp only [Set.mem_setOf_eq] at hu hv ⊢\n   881\t      rw [map_add, add_mul, mul_add, hu, hv]\n   882\t    | smul c u _ hu =>\n   883\t      simp only [Set.mem_setOf_eq] at hu ⊢\n   884\t      rw [map_smul, smul_mul_assoc, mul_smul_comm, hu]\n   885\t  have hz : z ∈ closure {w : D.Total | D.totalRep w * T = T * D.totalRep w} :=\n   886\t    closure_mono hspan (by rw [D.span_dense'.closure_eq]; trivial)\n   887\t  rwa [hclosed.closure_eq] at hz\n   888\t\n   889\t/-- **The elementary product operators have the same commutant as the whole represented\n   890\talgebra.** -/\n   891\ttheorem centralizer_representedProductSet :\n   892\t    D.representedProductSet.centralizer = (Set.range D.totalRep).centralizer := by\n   893\t  refine Set.Subset.antisymm ?_ (Set.centralizer_subset ?_)\n   894\t  · intro T hT\n   895\t    rintro _ ⟨z, rfl⟩\n   896\t    exact D.commute_totalRep_of_commute_prodElt T\n   897\t      (fun a b => hT _ ⟨(a, b), rfl⟩) z\n   898\t  · rintro _ ⟨p, rfl⟩\n   899\t    exact ⟨D.prodElt p.1 p.2, rfl⟩\n   900\t\n   901\t/-! ### 8.2 Transport of commutants and bicommutants along the unitary -/\n   902\t\n   903\ttheorem unitaryConj_image_centralizer (S : Set (D.TensorGNS →L[ℂ] D.TensorGNS)) :\n   904\t    D.unitaryConj '' S.centralizer = (D.unitaryConj '' S).centralizer :=\n   905\t  StabilizerHyperfinite.BoundedStateGNS.image_centralizer_of_mulEquiv\n   906\t    (D.unitaryConj.toRingEquiv.toMulEquiv) S\n   907\t\n   908\t/-- **Commutant transport.**  The commutant of the elementary tensor operators is carried by the\n   909\tproduct GNS unitary onto the commutant of the represented regional algebra. -/\n   910\ttheorem unitaryConj_image_centralizer_elementaryTensorSet :\n   911\t    D.unitaryConj '' D.elementaryTensorSet.centralizer = (Set.range D.totalRep).centralizer := by\n   912\t  rw [D.unitaryConj_image_centralizer, D.unitaryConj_image_elementaryTensorSet,\n   913\t    D.centralizer_representedProductSet]\n   914\t\n   915\t/-- **The product GNS tensor factorization of the represented algebra.**\n   916\t\n   917\tConjugation by the product GNS unitary carries the von Neumann algebra generated (in the\n   918\tbicommutant sense) by the elementary tensor operators `π₁(a) ⊗ π₂(b)` on `K_pure ⊗ K_mixed`\n   919\texactly onto the represented regional algebra `π(Total)''` on the GNS space of the product\n   920\tstate.  This is the strongest form of the manuscript identification available without a spatial\n   921\tvon Neumann tensor product. -/\n   922\ttheorem unitaryConj_image_bicommutant_elementaryTensorSet :\n   923\t    D.unitaryConj '' D.elementaryTensorSet.centralizer.centralizer\n   924\t      = (Set.range D.totalRep).centralizer.centralizer := by\n   925\t  rw [D.unitaryConj_image_centralizer, D.unitaryConj_image_centralizer_elementaryTensorSet]\n   926\t\n   927\t/-! ## 9. The two commuting factors and the spatial tensor product\n   928\t\n   929\tThe two families `{π₁(a) ⊗ 1}` and `{1 ⊗ π₂(b)}` of operators on `K_pure ⊗ K_mixed` are\n   930\tconstructed here, together with the factorization `π₁(a) ⊗ π₂(b) = (π₁(a) ⊗ 1)(1 ⊗ π₂(b))`.\n   931\tThe bicommutant of their union is, by definition, the spatial (von Neumann) tensor product of the\n   932\ttwo represented factor algebras; we prove that it coincides with the bicommutant of the\n   933\telementary tensor operators, and hence is carried by the product GNS unitary exactly onto the\n   934\trepresented regional algebra. -/\n   935\t\n   936\ttheorem tensorMapₗ_split (a : D.Pure) (b : D.Mixed) (t : D.TensorPre) :\n   937\t    D.tensorMapₗ a b t = D.tensorMapₗ a 1 (D.tensorMapₗ 1 b t) := by\n   938\t  induction t using TensorProduct.induction_on with\n   939\t  | zero => simp\n   940\t  | tmul x y =>\n   941\t    rw [tensorMapₗ_tmul, tensorMapₗ_tmul, tensorMapₗ_tmul]\n   942\t    simp [pureRep, mixedRep]\n   943\t  | add t s ht hs => simp only [map_add, ht, hs]\n   944\t\n   945\ttheorem tensorMapₗ_split' (a : D.Pure) (b : D.Mixed) (t : D.TensorPre) :\n   946\t    D.tensorMapₗ a b t = D.tensorMapₗ 1 b (D.tensorMapₗ a 1 t) := by\n   947\t  induction t using TensorProduct.induction_on with\n   948\t  | zero => simp\n   949\t  | tmul x y =>\n   950\t    rw [tensorMapₗ_tmul, tensorMapₗ_tmul, tensorMapₗ_tmul]\n   951\t    simp [pureRep, mixedRep]\n   952\t  | add t s ht hs => simp only [map_add, ht, hs]\n   953\t\n   954\ttheorem tensorOpC_split (a : D.Pure) (b : D.Mixed) :\n   955\t    D.tensorOpC a b = D.tensorOpC a 1 * D.tensorOpC 1 b := by\n   956\t  ext z\n   957\t  induction z using Completion.induction_on with\n   958\t  | hp =>\n   959\t    exact isClosed_eq (D.tensorOpC a b).continuous\n   960\t      ((D.tensorOpC a 1).continuous.comp (D.tensorOpC 1 b).continuous)\n   961\t  | ih t =>\n   962\t    show D.tensorOpC a b (t : D.TensorGNS) = D.tensorOpC a 1 (D.tensorOpC 1 b (t : D.TensorGNS))\n   963\t    rw [tensorOpC_coe, tensorOpC_coe, tensorOpC_coe, D.tensorMapₗ_split a b t]\n   964\t\n   965\ttheorem tensorOpC_split' (a : D.Pure) (b : D.Mixed) :\n   966\t    D.tensorOpC a b = D.tensorOpC 1 b * D.tensorOpC a 1 := by\n   967\t  ext z\n   968\t  induction z using Completion.induction_on with\n   969\t  | hp =>\n   970\t    exact isClosed_eq (D.tensorOpC a b).continuous\n   971\t      ((D.tensorOpC 1 b).continuous.comp (D.tensorOpC a 1).continuous)\n   972\t  | ih t =>\n   973\t    show D.tensorOpC a b (t : D.TensorGNS) = D.tensorOpC 1 b (D.tensorOpC a 1 (t : D.TensorGNS))\n   974\t    rw [tensorOpC_coe, tensorOpC_coe, tensorOpC_coe, D.tensorMapₗ_split' a b t]\n   975\t\n   976\t/-- The two families of operators commute. -/\n   977\ttheorem tensorOpC_commute (a : D.Pure) (b : D.Mixed) :\n   978\t    D.tensorOpC a 1 * D.tensorOpC 1 b = D.tensorOpC 1 b * D.tensorOpC a 1 := by\n   979\t  rw [← D.tensorOpC_split, D.tensorOpC_split']\n   980\t\n   981\t/-- The represented pure factor `π₁(A₁) ⊗ 1` on `K_pure ⊗ K_mixed`. -/\n   982\tdef pureFactorSet : Set (D.TensorGNS →L[ℂ] D.TensorGNS) :=\n   983\t  Set.range fun a : D.Pure => D.tensorOpC a 1\n   984\t\n   985\t/-- The represented mixed factor `1 ⊗ π₂(A₂)` on `K_pure ⊗ K_mixed`. -/\n   986\tdef mixedFactorSet : Set (D.TensorGNS →L[ℂ] D.TensorGNS) :=\n   987\t  Set.range fun b : D.Mixed => D.tensorOpC 1 b\n   988\t\n   989\t/-- The spatial (von Neumann) tensor product of the two represented factor algebras, defined in\n   990\tthe standard way as the bicommutant of the union of the two commuting families. -/\n   991\tdef spatialTensorAlgebra : Set (D.TensorGNS →L[ℂ] D.TensorGNS) :=\n   992\t  (D.pureFactorSet ∪ D.mixedFactorSet).centralizer.centralizer\n   993\t\n   994\ttheorem union_factorSet_subset_elementary :\n   995\t    D.pureFactorSet ∪ D.mixedFactorSet ⊆ D.elementaryTensorSet := by\n   996\t  rintro T (⟨a, rfl⟩ | ⟨b, rfl⟩)\n   997\t  · exact ⟨(a, 1), rfl⟩\n   998\t  · exact ⟨(1, b), rfl⟩\n   999\t\n  1000\ttheorem elementary_subset_spatialTensorAlgebra :\n  1001\t    D.elementaryTensorSet ⊆ D.spatialTensorAlgebra := by\n  1002\t  rintro _ ⟨p, rfl⟩\n  1003\t  show D.tensorOpC p.1 p.2 ∈ D.spatialTensorAlgebra\n  1004\t  rw [spatialTensorAlgebra, D.tensorOpC_split p.1 p.2]\n  1005\t  exact Set.mul_mem_centralizer\n  1006\t    (Set.subset_centralizer_centralizer (Or.inl ⟨p.1, rfl⟩))\n  1007\t    (Set.subset_centralizer_centralizer (Or.inr ⟨p.2, rfl⟩))\n  1008\t\n  1009\t/-- **The bicommutant of the elementary tensor operators is the spatial tensor product of the two\n  1010\trepresented factor algebras.** -/\n  1011\ttheorem bicommutant_elementary_eq_spatial :\n  1012\t    D.elementaryTensorSet.centralizer.centralizer = D.spatialTensorAlgebra := by\n  1013\t  refine Set.Subset.antisymm ?_\n  1014\t    (Set.centralizer_subset (Set.centralizer_subset D.union_factorSet_subset_elementary))\n  1015\t  calc D.elementaryTensorSet.centralizer.centralizer\n  1016\t      ⊆ D.spatialTensorAlgebra.centralizer.centralizer :=\n  1017\t        Set.centralizer_subset (Set.centralizer_subset D.elementary_subset_spatialTensorAlgebra)\n  1018\t    _ = D.spatialTensorAlgebra := by\n  1019\t        rw [spatialTensorAlgebra, Set.centralizer_centralizer_centralizer]\n  1020\t\n  1021\t/-- **The manuscript identification, in the strongest form supported by pinned Mathlib.**\n  1022\t\n  1023\tConjugation by the product GNS unitary carries the spatial tensor product of the two represented\n  1024\tfactor algebras on `K_pure ⊗ K_mixed` exactly onto the represented regional algebra\n  1025\t`π(Total)''` on the GNS space of the product state. -/\n  1026\ttheorem unitaryConj_image_spatialTensorAlgebra :\n  1027\t    D.unitaryConj '' D.spatialTensorAlgebra = (Set.range D.totalRep).centralizer.centralizer := by\n  1028\t  rw [← D.bicommutant_elementary_eq_spatial,\n  1029\t    D.unitaryConj_image_bicommutant_elementaryTensorSet]\n  1030\t\n","exit_code":0,"status":"completed"}}
