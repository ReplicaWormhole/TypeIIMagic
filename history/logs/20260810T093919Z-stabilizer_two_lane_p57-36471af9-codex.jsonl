{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"nl -ba aristotle_responses/P57-product-gns-tensor-factorization-a7accfb8-36471af9-quarantine/aristotle-stabilizer_two_lane_p57-sznchb36_aristotle/AristotleCandidates/ProductGNSTensorFactorization.lean | sed -n '420,840p'\"","aggregated_output":"   420\t          = D.prodRight (D.pureState.ofPreGNS x) + D.prodRight (D.pureState.ofPreGNS y)\n   421\t      rw [h, D.prodRight_add])\n   422\t    (fun r x => by\n   423\t      have h : D.pureState.ofPreGNS (r • x) = r • D.pureState.ofPreGNS x := map_smul _ _ _\n   424\t      show D.prodRight (D.pureState.ofPreGNS (r • x)) = r • D.prodRight (D.pureState.ofPreGNS x)\n   425\t      rw [h, D.prodRight_smul])\n   426\t    (fun a => by\n   427\t      have hb : ∀ y : D.MixedGNS, ‖D.prodRight (D.pureState.ofPreGNS a) y‖ ≤ ‖a‖ * ‖y‖ := by\n   428\t        intro y\n   429\t        simpa using D.norm_prodRight_apply_le (D.pureState.ofPreGNS a) y\n   430\t      rw [one_mul]\n   431\t      exact ContinuousLinearMap.opNorm_le_bound (D.prodRight (D.pureState.ofPreGNS a))\n   432\t        (norm_nonneg a) hb)\n   433\t\n   434\t@[simp] theorem prodCLM_coe (a : D.pureState.PreGNS) :\n   435\t    D.prodCLM (a : D.PureGNS) = D.prodRight (D.pureState.ofPreGNS a) := by\n   436\t  rw [prodCLM, extendOfBound_coe]\n   437\t\n   438\t/-- The defining formula for `prodCLM` on the images of algebra elements. -/\n   439\ttheorem prodCLM_coe_coe (a : D.Pure) (b : D.Mixed) :\n   440\t    D.prodCLM ((D.pureState.toPreGNS a : D.pureState.PreGNS) : D.PureGNS)\n   441\t        ((D.mixedState.toPreGNS b : D.mixedState.PreGNS) : D.MixedGNS)\n   442\t      = ((D.totalState.toPreGNS (D.prodElt a b) : D.totalState.PreGNS) : D.TotalGNS) := by\n   443\t  rw [prodCLM_coe, PositiveLinearMap.ofPreGNS_toPreGNS, prodRight_coe, preProdₗ_apply]\n   444\t\n   445\t/-! ## 3. The inner-product identity for the product map -/\n   446\t\n   447\ttheorem prodCLM_coe_coe' (a : D.pureState.PreGNS) (b : D.mixedState.PreGNS) :\n   448\t    D.prodCLM (a : D.PureGNS) (b : D.MixedGNS)\n   449\t      = ((D.preProdₗ (D.pureState.ofPreGNS a) b : D.totalState.PreGNS) : D.TotalGNS) := by\n   450\t  rw [prodCLM_coe, prodRight_coe]\n   451\t\n   452\ttheorem continuous_prodCLM_left (y : D.MixedGNS) :\n   453\t    Continuous fun x : D.PureGNS => D.prodCLM x y :=\n   454\t  (D.prodCLM.flip y).continuous\n   455\t\n   456\ttheorem inner_prodCLM_coe (a a' : D.pureState.PreGNS) (b b' : D.mixedState.PreGNS) :\n   457\t    ⟪D.prodCLM (a : D.PureGNS) (b : D.MixedGNS),\n   458\t        D.prodCLM (a' : D.PureGNS) (b' : D.MixedGNS)⟫_ℂ\n   459\t      = ⟪(a : D.PureGNS), (a' : D.PureGNS)⟫_ℂ * ⟪(b : D.MixedGNS), (b' : D.MixedGNS)⟫_ℂ := by\n   460\t  rw [prodCLM_coe_coe', prodCLM_coe_coe', Completion.inner_coe, Completion.inner_coe,\n   461\t    Completion.inner_coe]\n   462\t  have h := D.preInner_prodElt (D.pureState.ofPreGNS a) (D.pureState.ofPreGNS a')\n   463\t    (D.mixedState.ofPreGNS b) (D.mixedState.ofPreGNS b')\n   464\t  simpa using h\n   465\t\n   466\t/-- **The product inner-product identity.**  Inner products of product vectors factorize exactly\n   467\tas in the Hilbert tensor product of the two factor GNS spaces. -/\n   468\ttheorem inner_prodCLM (x x' : D.PureGNS) (y y' : D.MixedGNS) :\n   469\t    ⟪D.prodCLM x y, D.prodCLM x' y'⟫_ℂ = ⟪x, x'⟫_ℂ * ⟪y, y'⟫_ℂ := by\n   470\t  induction x using Completion.induction_on with\n   471\t  | hp =>\n   472\t    exact isClosed_eq\n   473\t      (Continuous.inner (D.continuous_prodCLM_left y) continuous_const)\n   474\t      ((Continuous.inner continuous_id continuous_const).mul continuous_const)\n   475\t  | ih a =>\n   476\t    induction x' using Completion.induction_on with\n   477\t    | hp =>\n   478\t      exact isClosed_eq\n   479\t        (Continuous.inner continuous_const (D.continuous_prodCLM_left y'))\n   480\t        ((Continuous.inner continuous_const continuous_id).mul continuous_const)\n   481\t    | ih a' =>\n   482\t      induction y using Completion.induction_on with\n   483\t      | hp =>\n   484\t        exact isClosed_eq\n   485\t          (Continuous.inner (by fun_prop) continuous_const)\n   486\t          (continuous_const.mul (Continuous.inner continuous_id continuous_const))\n   487\t      | ih b =>\n   488\t        induction y' using Completion.induction_on with\n   489\t        | hp =>\n   490\t          exact isClosed_eq\n   491\t            (Continuous.inner continuous_const (by fun_prop))\n   492\t            (continuous_const.mul (Continuous.inner continuous_const continuous_id))\n   493\t        | ih b' => exact D.inner_prodCLM_coe a a' b b'\n   494\t\n   495\t/-! ## 4. The tensor lift and its isometry property -/\n   496\t\n   497\t/-- The algebraic tensor product of the two factor GNS Hilbert spaces, with Mathlib's canonical\n   498\tinner product `⟪x ⊗ y, x' ⊗ y'⟫ = ⟪x, x'⟫ ⟪y, y'⟫`. -/\n   499\tabbrev TensorPre : Type _ := D.PureGNS ⊗[ℂ] D.MixedGNS\n   500\t\n   501\t/-- The Hilbert tensor product of the two factor GNS spaces: the completion of the algebraic\n   502\ttensor product. -/\n   503\tabbrev TensorGNS : Type _ := Completion D.TensorPre\n   504\t\n   505\t/-- The bilinear product map, as an unbundled bilinear map. -/\n   506\tnoncomputable def prodBil : D.PureGNS →ₗ[ℂ] D.MixedGNS →ₗ[ℂ] D.TotalGNS :=\n   507\t  LinearMap.mk₂ ℂ (fun x y => D.prodCLM x y)\n   508\t    (fun x x' y => by\n   509\t      show D.prodCLM (x + x') y = D.prodCLM x y + D.prodCLM x' y\n   510\t      rw [map_add]; rfl)\n   511\t    (fun c x y => by\n   512\t      show D.prodCLM (c • x) y = c • D.prodCLM x y\n   513\t      rw [map_smul]; rfl)\n   514\t    (fun x y y' => by\n   515\t      show D.prodCLM x (y + y') = D.prodCLM x y + D.prodCLM x y'\n   516\t      rw [map_add])\n   517\t    (fun c x y => by\n   518\t      show D.prodCLM x (c • y) = c • D.prodCLM x y\n   519\t      rw [map_smul])\n   520\t\n   521\t@[simp] theorem prodBil_apply (x : D.PureGNS) (y : D.MixedGNS) :\n   522\t    D.prodBil x y = D.prodCLM x y := rfl\n   523\t\n   524\t/-- The induced linear map on the algebraic tensor product. -/\n   525\tnoncomputable def tensorLiftₗ : D.TensorPre →ₗ[ℂ] D.TotalGNS := TensorProduct.lift D.prodBil\n   526\t\n   527\t@[simp] theorem tensorLiftₗ_tmul (x : D.PureGNS) (y : D.MixedGNS) :\n   528\t    D.tensorLiftₗ (x ⊗ₜ[ℂ] y) = D.prodCLM x y := rfl\n   529\t\n   530\t/-- **Inner products are preserved by the tensor lift.** -/\n   531\ttheorem inner_tensorLiftₗ (t s : D.TensorPre) :\n   532\t    ⟪D.tensorLiftₗ t, D.tensorLiftₗ s⟫_ℂ = ⟪t, s⟫_ℂ := by\n   533\t  induction t using TensorProduct.induction_on with\n   534\t  | zero => simp\n   535\t  | tmul x y =>\n   536\t    induction s using TensorProduct.induction_on with\n   537\t    | zero => simp\n   538\t    | tmul x' y' =>\n   539\t      rw [tensorLiftₗ_tmul, tensorLiftₗ_tmul, TensorProduct.inner_tmul, D.inner_prodCLM]\n   540\t    | add s₁ s₂ hs₁ hs₂ =>\n   541\t      rw [map_add, inner_add_right, inner_add_right, hs₁, hs₂]\n   542\t  | add t₁ t₂ ht₁ ht₂ =>\n   543\t    rw [map_add, inner_add_left, inner_add_left, ht₁, ht₂]\n   544\t\n   545\ttheorem norm_tensorLiftₗ (t : D.TensorPre) : ‖D.tensorLiftₗ t‖ = ‖t‖ := by\n   546\t  rw [norm_eq_sqrt_re_inner (𝕜 := ℂ), norm_eq_sqrt_re_inner (𝕜 := ℂ), D.inner_tensorLiftₗ]\n   547\t\n   548\t/-- The tensor lift as a linear isometry of the algebraic tensor product into the total GNS\n   549\tspace. -/\n   550\tnoncomputable def tensorLiftIsometry : D.TensorPre →ₗᵢ[ℂ] D.TotalGNS :=\n   551\t  ⟨D.tensorLiftₗ, D.norm_tensorLiftₗ⟩\n   552\t\n   553\t/-! ## 5. The product GNS unitary -/\n   554\t\n   555\t/-- The canonical map from the Hilbert tensor product of the two factor GNS spaces into the GNS\n   556\tspace of the product state. -/\n   557\tnoncomputable def tensorUnitaryCLM : D.TensorGNS →L[ℂ] D.TotalGNS :=\n   558\t  clmExtend D.tensorLiftIsometry.toContinuousLinearMap\n   559\t\n   560\t@[simp] theorem tensorUnitaryCLM_coe (t : D.TensorPre) :\n   561\t    D.tensorUnitaryCLM (t : D.TensorGNS) = D.tensorLiftₗ t :=\n   562\t  clmExtend_coe _ _\n   563\t\n   564\ttheorem norm_tensorUnitaryCLM (z : D.TensorGNS) : ‖D.tensorUnitaryCLM z‖ = ‖z‖ := by\n   565\t  induction z using Completion.induction_on with\n   566\t  | hp => exact isClosed_eq (by fun_prop) (by fun_prop)\n   567\t  | ih t => rw [tensorUnitaryCLM_coe, Completion.norm_coe, D.norm_tensorLiftₗ]\n   568\t\n   569\ttheorem isometry_tensorUnitaryCLM : Isometry D.tensorUnitaryCLM :=\n   570\t  AddMonoidHomClass.isometry_of_norm _ D.norm_tensorUnitaryCLM\n   571\t\n   572\t/-! ### 5.1 The canonical map of the total algebra into its GNS space -/\n   573\t\n   574\ttheorem norm_totalCoe_le (x : D.Total) :\n   575\t    ‖((D.totalState.toPreGNS x : D.totalState.PreGNS) : D.TotalGNS)‖ ≤ ‖x‖ := by\n   576\t  rw [Completion.norm_coe, PositiveLinearMap.preGNS_norm_def]\n   577\t  have h1 : (D.totalState (star x * x)).re ≤ ‖x‖ ^ 2 := by\n   578\t    have h2 : ‖D.totalState (star x * x)‖ ≤ ‖star x * x‖ := D.state_norm_le _\n   579\t    have h3 : ‖star x * x‖ = ‖x‖ ^ 2 := by\n   580\t      rw [CStarRing.norm_star_mul_self, sq]\n   581\t    have h4 : (D.totalState (star x * x)).re ≤ ‖D.totalState (star x * x)‖ :=\n   582\t      Complex.re_le_norm _\n   583\t    linarith [h2, h3 ▸ h2, h4]\n   584\t  calc √((D.totalState (star (D.totalState.ofPreGNS (D.totalState.toPreGNS x)) *\n   585\t        D.totalState.ofPreGNS (D.totalState.toPreGNS x))).re)\n   586\t      = √((D.totalState (star x * x)).re) := by rw [PositiveLinearMap.ofPreGNS_toPreGNS]\n   587\t    _ ≤ √(‖x‖ ^ 2) := Real.sqrt_le_sqrt h1\n   588\t    _ = ‖x‖ := by rw [Real.sqrt_sq (norm_nonneg x)]\n   589\t\n   590\t/-- The canonical continuous linear map from the total algebra to its GNS space. -/\n   591\tnoncomputable def totalCoe : D.Total →L[ℂ] D.TotalGNS :=\n   592\t  LinearMap.mkContinuous\n   593\t    { toFun := fun x => ((D.totalState.toPreGNS x : D.totalState.PreGNS) : D.TotalGNS)\n   594\t      map_add' := fun x y => by\n   595\t        rw [map_add]\n   596\t        exact Completion.coe_add _ _\n   597\t      map_smul' := fun r x => by\n   598\t        rw [map_smul]\n   599\t        exact Completion.coe_smul r _ } 1\n   600\t    (fun x => by rw [one_mul]; exact D.norm_totalCoe_le x)\n   601\t\n   602\t@[simp] theorem totalCoe_apply (x : D.Total) :\n   603\t    D.totalCoe x = ((D.totalState.toPreGNS x : D.totalState.PreGNS) : D.TotalGNS) := rfl\n   604\t\n   605\t/-! ### 5.2 Density of the range -/\n   606\t\n   607\ttheorem totalCoe_prodElt (a : D.Pure) (b : D.Mixed) :\n   608\t    D.totalCoe (D.prodElt a b)\n   609\t      = D.tensorUnitaryCLM\n   610\t          ((((D.pureState.toPreGNS a : D.pureState.PreGNS) : D.PureGNS) ⊗ₜ[ℂ]\n   611\t            ((D.mixedState.toPreGNS b : D.mixedState.PreGNS) : D.MixedGNS) :\n   612\t              D.TensorPre) : D.TensorGNS) := by\n   613\t  rw [tensorUnitaryCLM_coe, tensorLiftₗ_tmul, D.prodCLM_coe_coe, totalCoe_apply]\n   614\t\n   615\ttheorem span_dense' :\n   616\t    Dense ((Submodule.span ℂ (Set.range fun p : D.Pure × D.Mixed => D.prodElt p.1 p.2) :\n   617\t      Submodule ℂ D.Total) : Set D.Total) := D.span_dense\n   618\t\n   619\ttheorem totalCoe_mem_range_of_mem_span {x : D.Total}\n   620\t    (hx : x ∈ Submodule.span ℂ (Set.range fun p : D.Pure × D.Mixed => D.prodElt p.1 p.2)) :\n   621\t    D.totalCoe x ∈ LinearMap.range (D.tensorUnitaryCLM : D.TensorGNS →ₗ[ℂ] D.TotalGNS) := by\n   622\t  induction hx using Submodule.span_induction with\n   623\t  | mem z hz =>\n   624\t    obtain ⟨p, rfl⟩ := hz\n   625\t    exact ⟨_, (D.totalCoe_prodElt p.1 p.2).symm⟩\n   626\t  | zero =>\n   627\t    rw [map_zero]\n   628\t    exact Submodule.zero_mem _\n   629\t  | add z w _ _ hz hw =>\n   630\t    rw [map_add]\n   631\t    exact Submodule.add_mem _ hz hw\n   632\t  | smul c z _ hz =>\n   633\t    rw [map_smul]\n   634\t    exact Submodule.smul_mem _ c hz\n   635\t\n   636\ttheorem denseRange_tensorUnitaryCLM : DenseRange D.tensorUnitaryCLM := by\n   637\t  classical\n   638\t  set S : Submodule ℂ D.TotalGNS :=\n   639\t    LinearMap.range (D.tensorUnitaryCLM : D.TensorGNS →ₗ[ℂ] D.TotalGNS) with hS\n   640\t  have hSrange : (S : Set D.TotalGNS) = Set.range D.tensorUnitaryCLM := by\n   641\t    ext z; simp [hS, LinearMap.mem_range]\n   642\t  have hcoe : ∀ x : D.Total, D.totalCoe x ∈ closure (S : Set D.TotalGNS) := by\n   643\t    intro x\n   644\t    have hx : x ∈ closure\n   645\t        ((Submodule.span ℂ (Set.range fun p : D.Pure × D.Mixed => D.prodElt p.1 p.2) :\n   646\t          Submodule ℂ D.Total) : Set D.Total) := by\n   647\t      rw [D.span_dense'.closure_eq]; trivial\n   648\t    have h2 : D.totalCoe x ∈ closure (D.totalCoe ''\n   649\t        ((Submodule.span ℂ (Set.range fun p : D.Pure × D.Mixed => D.prodElt p.1 p.2) :\n   650\t          Submodule ℂ D.Total) : Set D.Total)) :=\n   651\t      image_closure_subset_closure_image D.totalCoe.continuous ⟨x, hx, rfl⟩\n   652\t    refine closure_mono ?_ h2\n   653\t    rintro _ ⟨w, hw, rfl⟩\n   654\t    exact D.totalCoe_mem_range_of_mem_span hw\n   655\t  have hdense : Dense (S : Set D.TotalGNS) := by\n   656\t    rw [dense_iff_closure_eq]\n   657\t    refine Set.eq_univ_of_univ_subset ?_\n   658\t    have hcl : Set.range (fun x : D.totalState.PreGNS => (x : D.TotalGNS))\n   659\t        ⊆ closure (S : Set D.TotalGNS) := by\n   660\t      rintro _ ⟨x, rfl⟩\n   661\t      exact hcoe (D.totalState.ofPreGNS x)\n   662\t    calc (Set.univ : Set D.TotalGNS)\n   663\t        = closure (Set.range (fun x : D.totalState.PreGNS => (x : D.TotalGNS))) :=\n   664\t          (Completion.denseRange_coe (α := D.totalState.PreGNS)).closure_eq.symm\n   665\t      _ ⊆ closure (closure (S : Set D.TotalGNS)) := closure_mono hcl\n   666\t      _ = closure (S : Set D.TotalGNS) := closure_closure\n   667\t  rw [DenseRange, ← hSrange]\n   668\t  exact hdense\n   669\t\n   670\ttheorem surjective_tensorUnitaryCLM : Function.Surjective D.tensorUnitaryCLM := by\n   671\t  have hclosed : IsClosed (Set.range D.tensorUnitaryCLM) :=\n   672\t    D.isometry_tensorUnitaryCLM.isClosedEmbedding.isClosed_range\n   673\t  have h : closure (Set.range D.tensorUnitaryCLM) = Set.univ :=\n   674\t    D.denseRange_tensorUnitaryCLM.closure_range\n   675\t  rw [hclosed.closure_eq] at h\n   676\t  intro z\n   677\t  have hz : z ∈ Set.range D.tensorUnitaryCLM := by rw [h]; trivial\n   678\t  exact hz\n   679\t\n   680\t/-- **The product GNS unitary.**  The GNS Hilbert space of the product state is canonically\n   681\tunitarily isomorphic to the Hilbert tensor product of the GNS spaces of the two factor states:\n   682\t`H_ω ≅ K_pure ⊗ K_mixed`. -/\n   683\tnoncomputable def productGNSUnitary : D.TensorGNS ≃ₗᵢ[ℂ] D.TotalGNS :=\n   684\t  LinearIsometryEquiv.ofSurjective\n   685\t    ⟨(D.tensorUnitaryCLM : D.TensorGNS →ₗ[ℂ] D.TotalGNS), D.norm_tensorUnitaryCLM⟩\n   686\t    D.surjective_tensorUnitaryCLM\n   687\t\n   688\t@[simp] theorem productGNSUnitary_apply (z : D.TensorGNS) :\n   689\t    D.productGNSUnitary z = D.tensorUnitaryCLM z := rfl\n   690\t\n   691\ttheorem productGNSUnitary_tmul (x : D.PureGNS) (y : D.MixedGNS) :\n   692\t    D.productGNSUnitary ((x ⊗ₜ[ℂ] y : D.TensorPre) : D.TensorGNS) = D.prodCLM x y := by\n   693\t  rw [productGNSUnitary_apply, tensorUnitaryCLM_coe, tensorLiftₗ_tmul]\n   694\t\n   695\t\n   696\t/-! ## 6. The intertwining identity\n   697\t\n   698\tThis section proves that the product GNS unitary intertwines the (algebraic) tensor product of\n   699\tthe two factor GNS representations with the GNS representation of the total algebra restricted to\n   700\tthe elementary product elements.  These are *constructed* facts: nothing beyond the explicit\n   701\tfields of `ProductGNSData` is used. -/\n   702\t\n   703\ttheorem prodCLM_coe_coe'' (p : D.pureState.PreGNS) (q : D.mixedState.PreGNS) :\n   704\t    D.prodCLM (p : D.PureGNS) (q : D.MixedGNS)\n   705\t      = ((D.totalState.toPreGNS\n   706\t          (D.prodElt (D.pureState.ofPreGNS p) (D.mixedState.ofPreGNS q)) :\n   707\t            D.totalState.PreGNS) : D.TotalGNS) :=\n   708\t  D.prodCLM_coe_coe' p q\n   709\t\n   710\ttheorem pureRep_coe (a : D.Pure) (p : D.pureState.PreGNS) :\n   711\t    D.pureRep a (p : D.PureGNS)\n   712\t      = ((D.pureState.toPreGNS (a * D.pureState.ofPreGNS p) :\n   713\t          D.pureState.PreGNS) : D.PureGNS) := by\n   714\t  simp [pureRep]\n   715\t\n   716\ttheorem mixedRep_coe (b : D.Mixed) (q : D.mixedState.PreGNS) :\n   717\t    D.mixedRep b (q : D.MixedGNS)\n   718\t      = ((D.mixedState.toPreGNS (b * D.mixedState.ofPreGNS q) :\n   719\t          D.mixedState.PreGNS) : D.MixedGNS) := by\n   720\t  simp [mixedRep]\n   721\t\n   722\ttheorem totalRep_coe (z : D.Total) (w : D.totalState.PreGNS) :\n   723\t    D.totalRep z (w : D.TotalGNS)\n   724\t      = ((D.totalState.toPreGNS (z * D.totalState.ofPreGNS w) :\n   725\t          D.totalState.PreGNS) : D.TotalGNS) := by\n   726\t  simp [totalRep]\n   727\t\n   728\ttheorem prodCLM_intertwine_coe (a : D.Pure) (b : D.Mixed)\n   729\t    (p : D.pureState.PreGNS) (q : D.mixedState.PreGNS) :\n   730\t    D.prodCLM (D.pureRep a (p : D.PureGNS)) (D.mixedRep b (q : D.MixedGNS))\n   731\t      = D.totalRep (D.prodElt a b) (D.prodCLM (p : D.PureGNS) (q : D.MixedGNS)) := by\n   732\t  rw [pureRep_coe, mixedRep_coe, prodCLM_coe_coe'', prodCLM_coe_coe'', totalRep_coe]\n   733\t  simp only [PositiveLinearMap.ofPreGNS_toPreGNS]\n   734\t  rw [D.prodElt_mul]\n   735\t\n   736\t/-- **The intertwining identity on product vectors.** -/\n   737\ttheorem prodCLM_intertwine (a : D.Pure) (b : D.Mixed) (x : D.PureGNS) (y : D.MixedGNS) :\n   738\t    D.prodCLM (D.pureRep a x) (D.mixedRep b y)\n   739\t      = D.totalRep (D.prodElt a b) (D.prodCLM x y) := by\n   740\t  induction x using Completion.induction_on with\n   741\t  | hp =>\n   742\t    exact isClosed_eq\n   743\t      ((D.continuous_prodCLM_left (D.mixedRep b y)).comp (D.pureRep a).continuous)\n   744\t      ((D.totalRep (D.prodElt a b)).continuous.comp (D.continuous_prodCLM_left y))\n   745\t  | ih p =>\n   746\t    induction y using Completion.induction_on with\n   747\t    | hp =>\n   748\t      exact isClosed_eq\n   749\t        ((D.prodCLM (D.pureRep a (p : D.PureGNS))).continuous.comp (D.mixedRep b).continuous)\n   750\t        ((D.totalRep (D.prodElt a b)).continuous.comp (D.prodCLM (p : D.PureGNS)).continuous)\n   751\t    | ih q => exact D.prodCLM_intertwine_coe a b p q\n   752\t\n   753\t/-! ### 6.1 The algebraic tensor operator and its norm bound -/\n   754\t\n   755\t/-- The algebraic tensor product operator `π₁(a) ⊗ π₂(b)` on `TensorPre`. -/\n   756\tnoncomputable def tensorMapₗ (a : D.Pure) (b : D.Mixed) : D.TensorPre →ₗ[ℂ] D.TensorPre :=\n   757\t  TensorProduct.map (D.pureRep a).toLinearMap (D.mixedRep b).toLinearMap\n   758\t\n   759\t@[simp] theorem tensorMapₗ_tmul (a : D.Pure) (b : D.Mixed) (x : D.PureGNS) (y : D.MixedGNS) :\n   760\t    D.tensorMapₗ a b (x ⊗ₜ[ℂ] y) = (D.pureRep a x) ⊗ₜ[ℂ] (D.mixedRep b y) := rfl\n   761\t\n   762\t/-- The tensor lift intertwines the algebraic tensor operator with the total GNS\n   763\trepresentation. -/\n   764\ttheorem tensorLiftₗ_tensorMapₗ (a : D.Pure) (b : D.Mixed) (t : D.TensorPre) :\n   765\t    D.tensorLiftₗ (D.tensorMapₗ a b t) = D.totalRep (D.prodElt a b) (D.tensorLiftₗ t) := by\n   766\t  induction t using TensorProduct.induction_on with\n   767\t  | zero => simp\n   768\t  | tmul x y =>\n   769\t    rw [tensorMapₗ_tmul, tensorLiftₗ_tmul, tensorLiftₗ_tmul, D.prodCLM_intertwine]\n   770\t  | add t s ht hs => simp only [map_add, ht, hs]\n   771\t\n   772\ttheorem norm_totalRep_apply_le (z : D.Total) (w : D.TotalGNS) :\n   773\t    ‖D.totalRep z w‖ ≤ ‖z‖ * ‖w‖ := by\n   774\t  refine (D.totalRep z).le_opNorm w |>.trans ?_\n   775\t  exact mul_le_mul_of_nonneg_right\n   776\t    (NonUnitalStarAlgHom.norm_apply_le (D.totalRep : D.Total →⋆ₐ[ℂ] _) z) (norm_nonneg w)\n   777\t\n   778\t/-- **Boundedness of the algebraic tensor operator**, obtained for free from the intertwining\n   779\tidentity together with the isometry property of the tensor lift.  (Pinned Mathlib has no general\n   780\tbound `‖T ⊗ S‖ ≤ ‖T‖ ‖S‖` on an algebraic tensor product of inner-product spaces.) -/\n   781\ttheorem norm_tensorMapₗ_le (a : D.Pure) (b : D.Mixed) (t : D.TensorPre) :\n   782\t    ‖D.tensorMapₗ a b t‖ ≤ ‖D.prodElt a b‖ * ‖t‖ := by\n   783\t  rw [← D.norm_tensorLiftₗ (D.tensorMapₗ a b t), tensorLiftₗ_tensorMapₗ,\n   784\t    ← D.norm_tensorLiftₗ t]\n   785\t  exact D.norm_totalRep_apply_le _ _\n   786\t\n   787\t/-! ## 7. The completed tensor operator and the unitary conjugation -/\n   788\t\n   789\t/-- The elementary tensor operator `π₁(a) ⊗ π₂(b)` as a bounded operator on the algebraic\n   790\ttensor product. -/\n   791\tnoncomputable def tensorOp (a : D.Pure) (b : D.Mixed) : D.TensorPre →L[ℂ] D.TensorPre :=\n   792\t  (D.tensorMapₗ a b).mkContinuous ‖D.prodElt a b‖ (D.norm_tensorMapₗ_le a b)\n   793\t\n   794\t@[simp] theorem tensorOp_apply (a : D.Pure) (b : D.Mixed) (t : D.TensorPre) :\n   795\t    D.tensorOp a b t = D.tensorMapₗ a b t := rfl\n   796\t\n   797\t/-- The elementary tensor operator on the Hilbert tensor product `K_pure ⊗ K_mixed`. -/\n   798\tnoncomputable def tensorOpC (a : D.Pure) (b : D.Mixed) : D.TensorGNS →L[ℂ] D.TensorGNS :=\n   799\t  (D.tensorOp a b).completion\n   800\t\n   801\t@[simp] theorem tensorOpC_coe (a : D.Pure) (b : D.Mixed) (t : D.TensorPre) :\n   802\t    D.tensorOpC a b (t : D.TensorGNS) = ((D.tensorMapₗ a b t : D.TensorPre) : D.TensorGNS) :=\n   803\t  ContinuousLinearMap.completion_apply_coe _ _\n   804\t\n   805\t/-- **The intertwining identity on the Hilbert tensor product.** -/\n   806\ttheorem tensorUnitaryCLM_tensorOpC (a : D.Pure) (b : D.Mixed) (z : D.TensorGNS) :\n   807\t    D.tensorUnitaryCLM (D.tensorOpC a b z)\n   808\t      = D.totalRep (D.prodElt a b) (D.tensorUnitaryCLM z) := by\n   809\t  induction z using Completion.induction_on with\n   810\t  | hp =>\n   811\t    exact isClosed_eq (D.tensorUnitaryCLM.continuous.comp (D.tensorOpC a b).continuous)\n   812\t      ((D.totalRep (D.prodElt a b)).continuous.comp D.tensorUnitaryCLM.continuous)\n   813\t  | ih t => rw [tensorOpC_coe, tensorUnitaryCLM_coe, tensorUnitaryCLM_coe, tensorLiftₗ_tensorMapₗ]\n   814\t\n   815\t/-- Conjugation by the product GNS unitary, as a `⋆`-algebra equivalence between the bounded\n   816\toperators on `K_pure ⊗ K_mixed` and those on the GNS space of the product state. -/\n   817\tnoncomputable def unitaryConj :\n   818\t    (D.TensorGNS →L[ℂ] D.TensorGNS) ≃⋆ₐ[ℂ] (D.TotalGNS →L[ℂ] D.TotalGNS) :=\n   819\t  D.productGNSUnitary.conjStarAlgEquiv\n   820\t\n   821\t@[simp] theorem unitaryConj_apply (T : D.TensorGNS →L[ℂ] D.TensorGNS) (y : D.TotalGNS) :\n   822\t    D.unitaryConj T y = D.productGNSUnitary (T (D.productGNSUnitary.symm y)) := rfl\n   823\t\n   824\t/-- **The represented elementary product operators are exactly the conjugates of the elementary\n   825\ttensor operators.** -/\n   826\ttheorem unitaryConj_tensorOpC (a : D.Pure) (b : D.Mixed) :\n   827\t    D.unitaryConj (D.tensorOpC a b) = D.totalRep (D.prodElt a b) := by\n   828\t  ext y\n   829\t  have h : D.tensorUnitaryCLM (D.productGNSUnitary.symm y) = y :=\n   830\t    D.productGNSUnitary.apply_symm_apply y\n   831\t  rw [unitaryConj_apply, productGNSUnitary_apply, D.tensorUnitaryCLM_tensorOpC, h]\n   832\t\n   833\t/-! ## 8. Identification of the represented algebra\n   834\t\n   835\tThe manuscript step identifies the represented regional algebra with a tensor product of the two\n   836\tfactor algebras.  Everything below is *constructed* from the fields of `ProductGNSData`; the\n   837\tremaining, genuinely missing ingredient (a spatial von Neumann tensor product in pinned Mathlib)\n   838\tis discussed in the module docstring and is **not** assumed anywhere. -/\n   839\t\n   840\t/-- The set of elementary tensor operators `π₁(a) ⊗ π₂(b)` on `K_pure ⊗ K_mixed`. -/\n","exit_code":0,"status":"completed"}}
