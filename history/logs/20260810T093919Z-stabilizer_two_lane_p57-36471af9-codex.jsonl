_\n  1055\t  product _ _ := rfl\n  1056\t  state_norm_le _ := le_rfl\n  1057\t  span_dense := by\n  1058\t    have hr : (Set.range fun p : ℂ × ℂ =>\n  1059\t        (StarAlgHom.id ℂ ℂ) p.1 * (StarAlgHom.id ℂ ℂ) p.2) = Set.univ := by\n  1060\t      ext x\n  1061\t      exact ⟨fun _ => trivial, fun _ => ⟨(x, 1), by simp⟩⟩\n  1062\t    rw [hr, Submodule.span_univ]\n  1063\t    simp\n  1064\t\n  1065\tinstance : Nonempty ProductGNSData.{0} := ⟨trivialProductGNSData⟩\n  1066\t\n  1067\tnamespace ProductGNSData\n  1068\tend ProductGNSData\n  1069\tend ProductGNSTensor\n  1070\tend AristotleCandidates\n","exit_code":0,"status":"completed"}}
