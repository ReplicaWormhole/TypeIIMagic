{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"printf '%s\\\\n' '--- coherence and direct-limit construction ---'\nnl -ba AristotleCandidates/LocalHyperbolicSourceUHFBridge.lean | sed -n '470,715p'\nprintf '%s\\\\n' '--- finite branch and scope scan ---'\nnl -ba AristotleCandidates/LocalHyperbolicSourceUHFBridge.lean | sed -n '716,854p'\nprintf '%s\\\\n' '--- downstream-symbol scan ---'\nrg -n -i 'cstar|operator|representation|regional|state|gns|tensor|factor|trace|weight|vonNeumann|bicommutant' AristotleCandidates/LocalHyperbolicSourceUHFBridge.lean\nprintf '%s\\\\n' '--- candidate diff summary / final tree ---'\ngit diff --stat\ngit status --short\"","aggregated_output":"--- coherence and direct-limit construction ---\n   470\t  · exact main A.xPart (Or.inr (fun n w i => A.xPart_apply n w i))\n   471\t  · exact main A.zPart (Or.inl (fun n w i => A.zPart_apply n w i))\n   472\t\n   473\t/-! ## The coherent finite-stage bridge and its commuting squares -/\n   474\t\n   475\t/-- **The coherent finite-stage bridge** of P55A, taken in the constructed\n   476\tcoherent enumeration of the stage coordinate block. -/\n   477\tnoncomputable def stageUHFEquiv (n : ℕ) :\n   478\t    pauliAlgebra (A.sourceForm n) ≃⋆ₐ[ℂ] QubitTensorPower (A.stageCard n) :=\n   479\t  A.sourceStageUHFEquiv n (A.stageEnum n)\n   480\t\n   481\ttheorem stageUHFEquiv_word (n : ℕ) (v : A.SourceLabel n) :\n   482\t    A.stageUHFEquiv n (pauliWord (A.sourceForm n) v) =\n   483\t      qubitWord (A.stageCard n) (A.enumRepr n (A.stageEnum n) v).1\n   484\t        (A.enumRepr n (A.stageEnum n) v).2 :=\n   485\t  A.sourceStageUHFEquiv_word n (A.stageEnum n) v\n   486\t\n   487\t/-- **The coherence square.**  The constructed finite-stage bridges intertwine\n   488\tthe P53 source connecting maps with the canonical dyadic tower maps.  Nothing\n   489\there is assumed: both the enumeration and the square are constructed. -/\n   490\ttheorem stageUHFEquiv_sourceConnecting {n m : ℕ} (h : n ≤ m)\n   491\t    (x : pauliAlgebra (A.sourceForm n)) :\n   492\t    A.stageUHFEquiv m (A.sourceConnecting n m h x) =\n   493\t      qubitTensorPowerMap (A.stageCard n) (A.stageCard m) (A.stageCard_mono h)\n   494\t        (A.stageUHFEquiv n x) := by\n   495\t  refine pauliAlgebra_linear_ext (A.sourceForm n)\n   496\t    (((A.stageUHFEquiv m).toAlgEquiv.toLinearMap).comp\n   497\t      ((A.sourceConnecting n m h).toAlgHom.toLinearMap))\n   498\t    (((qubitTensorPowerMap (A.stageCard n) (A.stageCard m)\n   499\t        (A.stageCard_mono h)).toAlgHom.toLinearMap).comp\n   500\t      ((A.stageUHFEquiv n).toAlgEquiv.toLinearMap)) ?_ x\n   501\t  intro v\n   502\t  show A.stageUHFEquiv m (A.sourceConnecting n m h (pauliWord (A.sourceForm n) v)) =\n   503\t    qubitTensorPowerMap (A.stageCard n) (A.stageCard m) (A.stageCard_mono h)\n   504\t      (A.stageUHFEquiv n (pauliWord (A.sourceForm n) v))\n   505\t  rw [A.sourceConnecting_word n m h v, A.stageUHFEquiv_word m, A.stageUHFEquiv_word n,\n   506\t    qubitTensorPowerMap_qubitWord, A.enumRepr_sourceIncl h v]\n   507\t\n   508\t/-! ## The coordinate-dyadic direct limit -/\n   509\t\n   510\t/-- The dyadic connecting maps attached to the coordinate stages. -/\n   511\tnoncomputable def coordDyadicMap (n m : ℕ) (h : n ≤ m) :\n   512\t    QubitTensorPower (A.stageCard n) →⋆ₐ[ℂ] QubitTensorPower (A.stageCard m) :=\n   513\t  qubitTensorPowerMap (A.stageCard n) (A.stageCard m) (A.stageCard_mono h)\n   514\t\n   515\tnoncomputable instance coordDyadicDirected :\n   516\t    DirectedSystem (fun n => QubitTensorPower (A.stageCard n))\n   517\t      (fun n m h => A.coordDyadicMap n m h) where\n   518\t  map_self := by\n   519\t    intro n x\n   520\t    change qubitTensorPowerMap (A.stageCard n) (A.stageCard n) _ x = x\n   521\t    rw [qubitTensorPowerMap_self]\n   522\t    rfl\n   523\t  map_map := by\n   524\t    intro k j i hij hjk x\n   525\t    change qubitTensorPowerMap (A.stageCard j) (A.stageCard k) _\n   526\t        (qubitTensorPowerMap (A.stageCard i) (A.stageCard j) _ x) =\n   527\t      qubitTensorPowerMap (A.stageCard i) (A.stageCard k) _ x\n   528\t    rw [qubitTensorPowerMap_comp (A.stageCard i) (A.stageCard j) (A.stageCard k)\n   529\t      (A.stageCard_mono hij) (A.stageCard_mono hjk)]\n   530\t    rfl\n   531\t\n   532\t/-- **The coordinate-dyadic direct limit**: the algebraic direct limit of the\n   533\tdyadic matrix stages attached to the coordinate blocks. -/\n   534\tnoncomputable abbrev CoordinateDyadicLimit : Type :=\n   535\t  DirectLimit (fun n => QubitTensorPower (A.stageCard n)) (fun n m h => A.coordDyadicMap n m h)\n   536\t\n   537\t/-- The canonical map of a coordinate-dyadic stage into the limit. -/\n   538\tnoncomputable abbrev coordDyadicOf (n : ℕ) (x : QubitTensorPower (A.stageCard n)) :\n   539\t    A.CoordinateDyadicLimit :=\n   540\t  DirectLimit.Module.of ℂ ℕ (fun n => QubitTensorPower (A.stageCard n))\n   541\t    (fun n m h => A.coordDyadicMap n m h) n x\n   542\t\n   543\ttheorem coordDyadicOf_map {n m : ℕ} (h : n ≤ m) (x : QubitTensorPower (A.stageCard n)) :\n   544\t    A.coordDyadicOf m (A.coordDyadicMap n m h x) = A.coordDyadicOf n x :=\n   545\t  DirectLimit.Module.of_f (hij := h)\n   546\t\n   547\t/-- **The source-to-coordinate-dyadic star equivalence.**  It is constructed\n   548\tfrom the P55A finite-stage bridges and the proved coherence square, not\n   549\tsupplied. -/\n   550\tnoncomputable def sourceToCoordinateDyadic :\n   551\t    A.SourceLimit ≃⋆ₐ[ℂ] A.CoordinateDyadicLimit :=\n   552\t  algebraicLimitStarAlgEquiv\n   553\t    (A := fun n => pauliAlgebra (A.sourceForm n))\n   554\t    (f := fun n m h => A.sourceConnecting n m h)\n   555\t    (D := fun n => QubitTensorPower (A.stageCard n))\n   556\t    (h := fun n m h => A.coordDyadicMap n m h)\n   557\t    A.stageUHFEquiv (fun _ _ h x => A.stageUHFEquiv_sourceConnecting h x)\n   558\t\n   559\t/-- **The stage formula.** -/\n   560\t@[simp] theorem sourceToCoordinateDyadic_of (n : ℕ) (x : pauliAlgebra (A.sourceForm n)) :\n   561\t    A.sourceToCoordinateDyadic (A.sourceOf n x) = A.coordDyadicOf n (A.stageUHFEquiv n x) :=\n   562\t  rfl\n   563\t\n   564\t/-- **Uniqueness from the stage formulas.**  Any star-algebra homomorphism with\n   565\tthe stage formulas of `sourceToCoordinateDyadic` is that map. -/\n   566\ttheorem sourceToCoordinateDyadic_unique\n   567\t    (psi : A.SourceLimit →⋆ₐ[ℂ] A.CoordinateDyadicLimit)\n   568\t    (hpsi : ∀ (n : ℕ) (x : pauliAlgebra (A.sourceForm n)),\n   569\t      psi (A.sourceOf n x) = A.coordDyadicOf n (A.stageUHFEquiv n x)) :\n   570\t    ∀ z, psi z = A.sourceToCoordinateDyadic z := by\n   571\t  intro z\n   572\t  induction z using DirectLimit.induction with\n   573\t  | _ n x => exact hpsi n x\n   574\t\n   575\t/-! ## The infinite branch: cofinal stage cardinalities and the UHF algebra -/\n   576\t\n   577\t/-- **Cofinality of the stage cardinalities.**  If the coordinate index type is\n   578\tinfinite, every number of qubits is reached by some coordinate block. -/\n   579\ttheorem stageCard_cofinal [Infinite I] (k : ℕ) : ∃ n, k ≤ A.stageCard n := by\n   580\t  classical\n   581\t  obtain ⟨S, hS⟩ := Infinite.exists_subset_card_eq I k\n   582\t  refine ⟨S.sup A.birth, ?_⟩\n   583\t  have hsub : S ⊆ A.blockFinset (S.sup A.birth) := by\n   584\t    intro i hi\n   585\t    rw [mem_blockFinset]\n   586\t    exact A.mem_coordinateBlock_of_birth_le (Finset.le_sup hi)\n   587\t  calc k = S.card := hS.symm\n   588\t    _ ≤ (A.blockFinset (S.sup A.birth)).card := Finset.card_le_card hsub\n   589\t    _ = A.stageCard (S.sup A.birth) := rfl\n   590\t\n   591\t/-- A coordinate stage with at least `k` qubits. -/\n   592\tnoncomputable def cofinalStage [Infinite I] (k : ℕ) : ℕ :=\n   593\t  Nat.find (A.stageCard_cofinal k)\n   594\t\n   595\ttheorem le_stageCard_cofinalStage [Infinite I] (k : ℕ) :\n   596\t    k ≤ A.stageCard (A.cofinalStage k) :=\n   597\t  Nat.find_spec (A.stageCard_cofinal k)\n   598\t\n   599\t/-- The dyadic stage `k`, mapped into the coordinate-dyadic limit through a\n   600\tcoordinate block large enough to contain it. -/\n   601\tnoncomputable def uhfStageToCoord [Infinite I] (k : ℕ) :\n   602\t    QubitTensorPower k →⋆ₐ[ℂ] A.CoordinateDyadicLimit :=\n   603\t  (algebraicLimitStageStarAlgHom\n   604\t      (A := fun n => QubitTensorPower (A.stageCard n))\n   605\t      (f := fun n m h => A.coordDyadicMap n m h) (A.cofinalStage k)).comp\n   606\t    (qubitTensorPowerMap k (A.stageCard (A.cofinalStage k)) (A.le_stageCard_cofinalStage k))\n   607\t\n   608\t/-- The value of `uhfStageToCoord` may be computed at any sufficiently large\n   609\tcoordinate stage. -/\n   610\ttheorem uhfStageToCoord_eq [Infinite I] {k n : ℕ} (hk : k ≤ A.stageCard n)\n   611\t    (hn : A.cofinalStage k ≤ n) (x : QubitTensorPower k) :\n   612\t    A.uhfStageToCoord k x = A.coordDyadicOf n (qubitTensorPowerMap k (A.stageCard n) hk x) := by\n   613\t  have hcomp : qubitTensorPowerMap k (A.stageCard n) hk x =\n   614\t      A.coordDyadicMap (A.cofinalStage k) n hn\n   615\t        (qubitTensorPowerMap k (A.stageCard (A.cofinalStage k))\n   616\t          (A.le_stageCard_cofinalStage k) x) := by\n   617\t    show _ = qubitTensorPowerMap (A.stageCard (A.cofinalStage k)) (A.stageCard n) _\n   618\t      (qubitTensorPowerMap k (A.stageCard (A.cofinalStage k)) _ x)\n   619\t    rw [qubitTensorPowerMap_comp k (A.stageCard (A.cofinalStage k)) (A.stageCard n)\n   620\t      (A.le_stageCard_cofinalStage k) (A.stageCard_mono hn)]\n   621\t    rfl\n   622\t  rw [hcomp, A.coordDyadicOf_map hn]\n   623\t  rfl\n   624\t\n   625\ttheorem uhfStageToCoord_compatible [Infinite I] {k k' : ℕ} (h : k ≤ k')\n   626\t    (x : QubitTensorPower k) :\n   627\t    A.uhfStageToCoord k' (qubitTensorPowerMap k k' h x) = A.uhfStageToCoord k x := by\n   628\t  set n : ℕ := max (A.cofinalStage k) (A.cofinalStage k') with hn\n   629\t  have hk' : k' ≤ A.stageCard n :=\n   630\t    le_trans (A.le_stageCard_cofinalStage k') (A.stageCard_mono (le_max_right _ _))\n   631\t  have hk : k ≤ A.stageCard n := le_trans h hk'\n   632\t  rw [A.uhfStageToCoord_eq hk' (le_max_right _ _), A.uhfStageToCoord_eq hk (le_max_left _ _),\n   633\t    qubitTensorPowerMap_comp k k' (A.stageCard n) h hk']\n   634\t  rfl\n   635\t\n   636\t/-- The star-algebra map from the qubit UHF algebra into the coordinate-dyadic\n   637\tlimit. -/\n   638\tnoncomputable def uhfToCoordDyadic [Infinite I] :\n   639\t    QubitUHFAlgebra →⋆ₐ[ℂ] A.CoordinateDyadicLimit :=\n   640\t  algebraicLimitStarAlgHom A.uhfStageToCoord\n   641\t    (fun _ _ h x => A.uhfStageToCoord_compatible h x)\n   642\t\n   643\t/-- The star-algebra map from the coordinate-dyadic limit into the qubit UHF\n   644\talgebra. -/\n   645\tnoncomputable def coordDyadicToUHF : A.CoordinateDyadicLimit →⋆ₐ[ℂ] QubitUHFAlgebra :=\n   646\t  algebraicLimitStarAlgHom\n   647\t    (A := fun n => QubitTensorPower (A.stageCard n))\n   648\t    (f := fun n m h => A.coordDyadicMap n m h)\n   649\t    (fun n => algebraicLimitStageStarAlgHom\n   650\t      (A := QubitTensorPower) (f := qubitTensorPowerMap) (A.stageCard n))\n   651\t    (fun _ _ h _ => DirectLimit.Module.of_f (hij := A.stageCard_mono h))\n   652\t\n   653\t@[simp] theorem coordDyadicToUHF_of (n : ℕ) (x : QubitTensorPower (A.stageCard n)) :\n   654\t    A.coordDyadicToUHF (A.coordDyadicOf n x) = qubitUHFOf (A.stageCard n) x := rfl\n   655\t\n   656\t@[simp] theorem uhfToCoordDyadic_of [Infinite I] (k : ℕ) (x : QubitTensorPower k) :\n   657\t    A.uhfToCoordDyadic (qubitUHFOf k x) = A.uhfStageToCoord k x := rfl\n   658\t\n   659\t/-- **The coordinate-dyadic limit is the qubit UHF algebra.**  This uses only\n   660\tcofinality of the stage cardinalities. -/\n   661\tnoncomputable def coordinateDyadicUHFEquiv [Infinite I] :\n   662\t    A.CoordinateDyadicLimit ≃⋆ₐ[ℂ] QubitUHFAlgebra :=\n   663\t  StarAlgEquiv.ofStarAlgHom A.coordDyadicToUHF A.uhfToCoordDyadic\n   664\t    (by\n   665\t      intro z\n   666\t      induction z using DirectLimit.induction with\n   667\t      | _ n y =>\n   668\t        show A.uhfToCoordDyadic (A.coordDyadicToUHF (A.coordDyadicOf n y)) = A.coordDyadicOf n y\n   669\t        rw [A.coordDyadicToUHF_of n y, A.uhfToCoordDyadic_of]\n   670\t        set m : ℕ := max n (A.cofinalStage (A.stageCard n)) with hm\n   671\t        have hk : A.stageCard n ≤ A.stageCard m := A.stageCard_mono (le_max_left _ _)\n   672\t        rw [A.uhfStageToCoord_eq hk (le_max_right _ _)]\n   673\t        exact A.coordDyadicOf_map (le_max_left n (A.cofinalStage (A.stageCard n))) y)\n   674\t    (by\n   675\t      intro z\n   676\t      induction z using DirectLimit.induction with\n   677\t      | _ k x =>\n   678\t        show A.coordDyadicToUHF (A.uhfToCoordDyadic (qubitUHFOf k x)) = qubitUHFOf k x\n   679\t        rw [A.uhfToCoordDyadic_of, uhfStageToCoord]\n   680\t        show A.coordDyadicToUHF (A.coordDyadicOf (A.cofinalStage k)\n   681\t          (qubitTensorPowerMap k (A.stageCard (A.cofinalStage k))\n   682\t            (A.le_stageCard_cofinalStage k) x)) = qubitUHFOf k x\n   683\t        rw [A.coordDyadicToUHF_of]\n   684\t        exact qubitUHFOf_map (A.le_stageCard_cofinalStage k) x)\n   685\t\n   686\t@[simp] theorem coordinateDyadicUHFEquiv_of [Infinite I] (n : ℕ)\n   687\t    (x : QubitTensorPower (A.stageCard n)) :\n   688\t    A.coordinateDyadicUHFEquiv (A.coordDyadicOf n x) = qubitUHFOf (A.stageCard n) x :=\n   689\t  A.coordDyadicToUHF_of n x\n   690\t\n   691\t/-- **The infinite branch.**  If the coordinate index type is infinite, the P53\n   692\talgebraic source limit is star-equivalent to the qubit UHF algebra. -/\n   693\tnoncomputable def sourceUHFEquiv [Infinite I] : A.SourceLimit ≃⋆ₐ[ℂ] QubitUHFAlgebra :=\n   694\t  A.sourceToCoordinateDyadic.trans A.coordinateDyadicUHFEquiv\n   695\t\n   696\t/-- **The stage formula of the infinite branch.** -/\n   697\t@[simp] theorem sourceUHFEquiv_of [Infinite I] (n : ℕ) (x : pauliAlgebra (A.sourceForm n)) :\n   698\t    A.sourceUHFEquiv (A.sourceOf n x) = qubitUHFOf (A.stageCard n) (A.stageUHFEquiv n x) := by\n   699\t  show A.coordinateDyadicUHFEquiv (A.sourceToCoordinateDyadic (A.sourceOf n x)) = _\n   700\t  rw [A.sourceToCoordinateDyadic_of n x, A.coordinateDyadicUHFEquiv_of]\n   701\t\n   702\t/-- **Uniqueness from the stage formulas, infinite branch.** -/\n   703\ttheorem sourceUHFEquiv_unique [Infinite I] (psi : A.SourceLimit →⋆ₐ[ℂ] QubitUHFAlgebra)\n   704\t    (hpsi : ∀ (n : ℕ) (x : pauliAlgebra (A.sourceForm n)),\n   705\t      psi (A.sourceOf n x) = qubitUHFOf (A.stageCard n) (A.stageUHFEquiv n x)) :\n   706\t    ∀ z, psi z = A.sourceUHFEquiv z := by\n   707\t  intro z\n   708\t  induction z using DirectLimit.induction with\n   709\t  | _ n x =>\n   710\t    show psi (A.sourceOf n x) = A.sourceUHFEquiv (A.sourceOf n x)\n   711\t    rw [hpsi n x, A.sourceUHFEquiv_of n x]\n   712\t\n   713\t/-! ## The finite branch: a terminal coordinate block -/\n   714\t\n   715\t/-- **The exhaustion reaches a terminal coordinate block.**  If the coordinate\n--- finite branch and scope scan ---\n   716\tindex type is finite, some stage of the exhaustion already contains every\n   717\tcoordinate. -/\n   718\ttheorem exists_terminal_stage [Finite I] : ∃ N : ℕ, ∀ i : I, A.birth i ≤ N := by\n   719\t  classical\n   720\t  haveI : Fintype I := Fintype.ofFinite I\n   721\t  exact ⟨Finset.univ.sup A.birth, fun i => Finset.le_sup (Finset.mem_univ i)⟩\n   722\t\n   723\t/-- The first terminal stage of the exhaustion. -/\n   724\tnoncomputable def terminalStage [Finite I] : ℕ := Nat.find A.exists_terminal_stage\n   725\t\n   726\ttheorem birth_le_terminalStage [Finite I] (i : I) : A.birth i ≤ A.terminalStage :=\n   727\t  Nat.find_spec A.exists_terminal_stage i\n   728\t\n   729\t/-- **The terminal coordinate block is everything.** -/\n   730\ttheorem mem_coordinateBlock_terminal [Finite I] {n : ℕ} (h : A.terminalStage ≤ n) (i : I) :\n   731\t    i ∈ A.family.coordinateBlock A.exhaustion n :=\n   732\t  A.mem_coordinateBlock_of_birth_le (le_trans (A.birth_le_terminalStage i) h)\n   733\t\n   734\t/-- From the terminal stage on, every stage carries exactly `Nat.card I`\n   735\tqubits. -/\n   736\ttheorem stageCard_eq_card [Finite I] {n : ℕ} (h : A.terminalStage ≤ n) :\n   737\t    A.stageCard n = Nat.card I := by\n   738\t  classical\n   739\t  haveI : Fintype I := Fintype.ofFinite I\n   740\t  have huniv : A.blockFinset n = Finset.univ :=\n   741\t    Finset.eq_univ_iff_forall.2 (fun i => (A.mem_blockFinset n i).2\n   742\t      (A.mem_coordinateBlock_terminal h i))\n   743\t  rw [stageCard, huniv, Finset.card_univ, Nat.card_eq_fintype_card]\n   744\t\n   745\ttheorem coordDyadicMap_bijective_of_terminal [Finite I] {n m : ℕ}\n   746\t    (hn : A.terminalStage ≤ n) (h : n ≤ m) : Function.Bijective (A.coordDyadicMap n m h) :=\n   747\t  qubitTensorPowerMap_bijective_of_eq (A.stageCard_mono h)\n   748\t    ((A.stageCard_eq_card hn).trans (A.stageCard_eq_card (le_trans hn h)).symm)\n   749\t\n   750\t/-- **The coordinate-dyadic limit is reached at the terminal stage.** -/\n   751\ttheorem coordDyadicOf_terminal_bijective [Finite I] :\n   752\t    Function.Bijective (fun x : QubitTensorPower (A.stageCard A.terminalStage) =>\n   753\t      A.coordDyadicOf A.terminalStage x) := by\n   754\t  constructor\n   755\t  · intro x y hxy\n   756\t    obtain ⟨i, hx, hy, heq⟩ := Quotient.eq.mp hxy\n   757\t    exact (A.coordDyadicMap_bijective_of_terminal le_rfl hx).1 heq\n   758\t  · intro z\n   759\t    induction z using DirectLimit.induction with\n   760\t    | _ n y =>\n   761\t      obtain ⟨w, hw⟩ := (A.coordDyadicMap_bijective_of_terminal le_rfl\n   762\t        (le_max_left A.terminalStage n)).2\n   763\t          (A.coordDyadicMap n (max A.terminalStage n) (le_max_right _ _) y)\n   764\t      refine ⟨w, ?_⟩\n   765\t      have hstep : A.coordDyadicOf (max A.terminalStage n)\n   766\t          (A.coordDyadicMap n (max A.terminalStage n) (le_max_right _ _) y) =\n   767\t          A.coordDyadicOf n y := A.coordDyadicOf_map (le_max_right _ _) y\n   768\t      show A.coordDyadicOf A.terminalStage w = A.coordDyadicOf n y\n   769\t      rw [← hstep, ← hw]\n   770\t      exact (A.coordDyadicOf_map (le_max_left A.terminalStage n) w).symm\n   771\t\n   772\t/-- **The terminal stage identification** of the coordinate-dyadic limit. -/\n   773\tnoncomputable def terminalDyadicEquiv [Finite I] :\n   774\t    QubitTensorPower (A.stageCard A.terminalStage) ≃⋆ₐ[ℂ] A.CoordinateDyadicLimit :=\n   775\t  StarAlgEquiv.ofBijective\n   776\t    (algebraicLimitStageStarAlgHom\n   777\t      (A := fun n => QubitTensorPower (A.stageCard n))\n   778\t      (f := fun n m h => A.coordDyadicMap n m h) A.terminalStage)\n   779\t    A.coordDyadicOf_terminal_bijective\n   780\t\n   781\t@[simp] theorem terminalDyadicEquiv_apply [Finite I]\n   782\t    (x : QubitTensorPower (A.stageCard A.terminalStage)) :\n   783\t    A.terminalDyadicEquiv x = A.coordDyadicOf A.terminalStage x := rfl\n   784\t\n   785\ttheorem terminalDyadicEquiv_symm_coordDyadicOf [Finite I] {n : ℕ} (hn : A.terminalStage ≤ n)\n   786\t    (y : QubitTensorPower (A.stageCard n)) :\n   787\t    A.terminalDyadicEquiv.symm (A.coordDyadicOf n y) =\n   788\t      qubitTensorPowerCongr ((A.stageCard_eq_card hn).trans\n   789\t        (A.stageCard_eq_card (le_refl A.terminalStage)).symm) y := by\n   790\t  have hmap : A.coordDyadicMap A.terminalStage n hn\n   791\t      (qubitTensorPowerCongr ((A.stageCard_eq_card hn).trans\n   792\t        (A.stageCard_eq_card (le_refl A.terminalStage)).symm) y) = y := by\n   793\t    rw [coordDyadicMap, qubitTensorPowerMap_of_eq (A.stageCard_mono hn)\n   794\t      ((A.stageCard_eq_card (le_refl A.terminalStage)).trans (A.stageCard_eq_card hn).symm),\n   795\t      qubitTensorPowerCongr_trans]\n   796\t    rfl\n   797\t  have hy : A.coordDyadicOf n y =\n   798\t      A.terminalDyadicEquiv (qubitTensorPowerCongr ((A.stageCard_eq_card hn).trans\n   799\t        (A.stageCard_eq_card (le_refl A.terminalStage)).symm) y) := by\n   800\t    rw [terminalDyadicEquiv_apply, ← A.coordDyadicOf_map hn, hmap]\n   801\t  rw [hy, StarAlgEquiv.symm_apply_apply]\n   802\t\n   803\t/-- **The finite branch.**  If the coordinate index type is finite, the P53\n   804\talgebraic source limit is star-equivalent to the finite dyadic algebra of\n   805\t`Nat.card I` qubits. -/\n   806\tnoncomputable def sourceFiniteEquiv [Finite I] :\n   807\t    A.SourceLimit ≃⋆ₐ[ℂ] QubitTensorPower (Nat.card I) :=\n   808\t  (A.sourceToCoordinateDyadic.trans A.terminalDyadicEquiv.symm).trans\n   809\t    (qubitTensorPowerCongr (A.stageCard_eq_card (le_refl A.terminalStage)))\n   810\t\n   811\t/-- **The stage formula of the finite branch**, at every stage from the terminal\n   812\tone on. -/\n   813\ttheorem sourceFiniteEquiv_of [Finite I] {n : ℕ} (hn : A.terminalStage ≤ n)\n   814\t    (x : pauliAlgebra (A.sourceForm n)) :\n   815\t    A.sourceFiniteEquiv (A.sourceOf n x) =\n   816\t      qubitTensorPowerCongr (A.stageCard_eq_card hn) (A.stageUHFEquiv n x) := by\n   817\t  show qubitTensorPowerCongr (A.stageCard_eq_card (le_refl A.terminalStage))\n   818\t    (A.terminalDyadicEquiv.symm (A.sourceToCoordinateDyadic (A.sourceOf n x))) = _\n   819\t  rw [A.sourceToCoordinateDyadic_of n x, A.terminalDyadicEquiv_symm_coordDyadicOf hn,\n   820\t    qubitTensorPowerCongr_trans]\n   821\t\n   822\t/-- The canonical stage maps into the source limit are compatible with the P53\n   823\tsource connecting maps. -/\n   824\ttheorem sourceOf_sourceConnecting {n m : ℕ} (h : n ≤ m) (x : pauliAlgebra (A.sourceForm n)) :\n   825\t    A.sourceOf m (A.sourceConnecting n m h x) = A.sourceOf n x := by\n   826\t  have himg : A.sourceToCoordinateDyadic (A.sourceOf m (A.sourceConnecting n m h x)) =\n   827\t      A.sourceToCoordinateDyadic (A.sourceOf n x) := by\n   828\t    rw [A.sourceToCoordinateDyadic_of, A.sourceToCoordinateDyadic_of,\n   829\t      A.stageUHFEquiv_sourceConnecting h x]\n   830\t    exact A.coordDyadicOf_map h (A.stageUHFEquiv n x)\n   831\t  exact A.sourceToCoordinateDyadic.injective himg\n   832\t\n   833\t/-- **Uniqueness from the stage formulas, finite branch.** -/\n   834\ttheorem sourceFiniteEquiv_unique [Finite I]\n   835\t    (psi : A.SourceLimit →⋆ₐ[ℂ] QubitTensorPower (Nat.card I))\n   836\t    (hpsi : ∀ (n : ℕ) (hn : A.terminalStage ≤ n) (x : pauliAlgebra (A.sourceForm n)),\n   837\t      psi (A.sourceOf n x) =\n   838\t        qubitTensorPowerCongr (A.stageCard_eq_card hn) (A.stageUHFEquiv n x)) :\n   839\t    ∀ z, psi z = A.sourceFiniteEquiv z := by\n   840\t  have key : ∀ (n : ℕ) (x : pauliAlgebra (A.sourceForm n)),\n   841\t      psi (A.sourceOf n x) = A.sourceFiniteEquiv (A.sourceOf n x) := by\n   842\t    intro n x\n   843\t    have hnm : n ≤ max n A.terminalStage := le_max_left _ _\n   844\t    have htm : A.terminalStage ≤ max n A.terminalStage := le_max_right _ _\n   845\t    rw [← A.sourceOf_sourceConnecting hnm x, hpsi _ htm, A.sourceFiniteEquiv_of htm]\n   846\t  intro z\n   847\t  induction z using DirectLimit.induction with\n   848\t  | _ n x => exact key n x\n   849\t\n   850\tend AlphaData\n   851\t\n   852\tend LocalHyperbolicAlpha\n   853\t\n   854\tend StabilizerHyperfinite\n--- downstream-symbol scan ---\n2:import Formalization.DyadicTensorTower\n19:  statements (terminal finite block, cofinal infinite exhaustion) separately.\n20:* No operator-range completion, regional C⋆ alpha, state identity, GNS tensor\n21:  split, factor classification, or trace/weight conclusion is claimed here.\n39:   `QubitTensorPower (Nat.card I)`.\n53:The dyadic connecting map `qubitTensorPowerMap k k'` adjoins new qubits on the\n97:    qubitTensorPowerSuccEmbedding k (qubitX k a) = qubitX (k + 1) (Fin.cons 0 a) := by\n102:          Matrix (Fin 2) (Fin 2) (QubitTensorPower k)) := rfl\n115:    qubitTensorPowerSuccEmbedding k (qubitZ k b) = qubitZ (k + 1) (Fin.cons 0 b) := by\n120:          Matrix (Fin 2) (Fin 2) (QubitTensorPower k)) := rfl\n130:    qubitTensorPowerSuccEmbedding k (qubitWord k a b) =\n137:theorem qubitTensorPowerMap_qubitWord (k k' : ℕ) (h : k ≤ k') (a b : Reg (Fin k)) :\n138:    qubitTensorPowerMap k k' h (qubitWord k a b) =\n141:  | base => rw [qubitTensorPowerMap_self, padReg_self, padReg_self]; rfl\n143:      rw [qubitTensorPowerMap_succ k m hm, StarAlgHom.comp_apply, ih,\n147:noncomputable abbrev qubitUHFOf (k : ℕ) (x : QubitTensorPower k) : QubitUHFAlgebra :=\n148:  DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap k x\n150:theorem qubitUHFOf_map {k k' : ℕ} (h : k ≤ k') (x : QubitTensorPower k) :\n151:    qubitUHFOf k' (qubitTensorPowerMap k k' h x) = qubitUHFOf k x :=\n155:noncomputable def qubitTensorPowerCongr {k k' : ℕ} (h : k = k') :\n156:    QubitTensorPower k ≃⋆ₐ[ℂ] QubitTensorPower k' := by\n159:@[simp] theorem qubitTensorPowerCongr_refl (k : ℕ) (x : QubitTensorPower k) :\n160:    qubitTensorPowerCongr (rfl : k = k) x = x := rfl\n162:theorem qubitTensorPowerCongr_trans {k k' k'' : ℕ} (h : k = k') (h' : k' = k'')\n163:    (x : QubitTensorPower k) :\n164:    qubitTensorPowerCongr h' (qubitTensorPowerCongr h x) =\n165:      qubitTensorPowerCongr (h.trans h') x := by\n169:theorem qubitTensorPowerMap_of_eq {k k' : ℕ} (h : k ≤ k') (he : k = k')\n170:    (x : QubitTensorPower k) :\n171:    qubitTensorPowerMap k k' h x = qubitTensorPowerCongr he x := by\n173:  rw [qubitTensorPowerMap_self]\n176:theorem qubitTensorPowerMap_bijective_of_eq {k k' : ℕ} (h : k ≤ k') (he : k = k') :\n177:    Function.Bijective (qubitTensorPowerMap k k' h) := by\n178:  have : ∀ x, qubitTensorPowerMap k k' h x = qubitTensorPowerCongr he x :=\n179:    qubitTensorPowerMap_of_eq h he\n180:  rw [show (qubitTensorPowerMap k k' h : QubitTensorPower k → QubitTensorPower k') =\n181:    (qubitTensorPowerCongr he : QubitTensorPower k → QubitTensorPower k') from funext this]\n182:  exact (qubitTensorPowerCongr he).bijecti