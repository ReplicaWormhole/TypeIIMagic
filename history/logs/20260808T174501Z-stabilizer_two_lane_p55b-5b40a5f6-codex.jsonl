A.stageCard n) (A.stageUHFEquiv n x) := by\n699:  show A.coordinateDyadicUHFEquiv (A.sourceToCoordinateDyadic (A.sourceOf n x)) = _\n700:  rw [A.sourceToCoordinateDyadic_of n x, A.coordinateDyadicUHFEquiv_of]\n703:theorem sourceUHFEquiv_unique [Infinite I] (psi : A.SourceLimit →⋆ₐ[ℂ] QubitUHFAlgebra)\n705:      psi (A.sourceOf n x) = qubitUHFOf (A.stageCard n) (A.stageUHFEquiv n x)) :\n706:    ∀ z, psi z = A.sourceUHFEquiv z := by\n710:    show psi (A.sourceOf n x) = A.sourceUHFEquiv (A.sourceOf n x)\n711:    rw [hpsi n x, A.sourceUHFEquiv_of n x]\n718:theorem exists_terminal_stage [Finite I] : ∃ N : ℕ, ∀ i : I, A.birth i ≤ N := by\n720:  haveI : Fintype I := Fintype.ofFinite I\n724:noncomputable def terminalStage [Finite I] : ℕ := Nat.find A.exists_terminal_stage\n726:theorem birth_le_terminalStage [Finite I] (i : I) : A.birth i ≤ A.terminalStage :=\n730:theorem mem_coordinateBlock_terminal [Finite I] {n : ℕ} (h : A.terminalStage ≤ n) (i : I) :\n736:theorem stageCard_eq_card [Finite I] {n : ℕ} (h : A.terminalStage ≤ n) :\n739:  haveI : Fintype I := Fintype.ofFinite I\n745:theorem coordDyadicMap_bijective_of_terminal [Finite I] {n m : ℕ}\n751:theorem coordDyadicOf_terminal_bijective [Finite I] :\n773:noncomputable def terminalDyadicEquiv [Finite I] :\n781:@[simp] theorem terminalDyadicEquiv_apply [Finite I]\n785:theorem terminalDyadicEquiv_symm_coordDyadicOf [Finite I] {n : ℕ} (hn : A.terminalStage ≤ n)\n806:noncomputable def sourceFiniteEquiv [Finite I] :\n808:  (A.sourceToCoordinateDyadic.trans A.terminalDyadicEquiv.symm).trans\n813:theorem sourceFiniteEquiv_of [Finite I] {n : ℕ} (hn : A.terminalStage ≤ n)\n815:    A.sourceFiniteEquiv (A.sourceOf n x) =\n816:      qubitTensorPowerCongr (A.stageCard_eq_card hn) (A.stageUHFEquiv n x) := by\n818:    (A.terminalDyadicEquiv.symm (A.sourceToCoordinateDyadic (A.sourceOf n x))) = _\n819:  rw [A.sourceToCoordinateDyadic_of n x, A.terminalDyadicEquiv_symm_coordDyadicOf hn,\n824:theorem sourceOf_sourceConnecting {n m : ℕ} (h