→L[ℂ] H},\n426:  /-- Faithfulness. -/\n427:  faithful : ∀ x ∈ M.corner hp, φ (star x * x) = 0 → x = 0\n435:functional `tau_q(x) = ⟪Ω, q x q Ω⟫` is a **faithful normal finite tracial state** on the von\n438:No fullness, finiteness of `q`, central-summand statement, global trace/weight, or type-III\n440:theorem FaithfulCornerData.isFaithfulNormalTracialState (d : FaithfulCornerData H) :\n441:    IsFaithfulNormalTracialStateOnCorner d.toCornerData.M d.isSelfAdjoint_q\n445:  normalized := d.toCornerData.tau_q\n446:  tracial := fun _ hx _ hy => d.toCornerData.tau_mul_comm hx hy\n447:  normal := fun h => d.toCornerData.tau_tendsto_of_wotTendsto h\n448:  faithful := fun _ hx h => d.faithful hx h\n485:  cstar_tracial := by\n492:/-- The one-dimensional witness for `FaithfulCornerData`. -/\n493:noncomputable def sanityFaithfulCornerData : FaithfulCornerData ℂ where\n519:end NormalFaithfulCornerTrace\n--- QUARANTINE VS LIVE PREDECESSORS ---\nFiniteCornerTrace cmp=0\n12cc9185a24773f85855bfc05ee779e997bf40f05abb2823e3352932ffff7111  aristotle_responses/P50-quarantine/aristotle-stabilizer_two_lane_p50-n98s99xk_aristotle/AristotleCandidates/FiniteCornerTrace.lean\n12cc9185a24773f85855bfc05ee779e997bf40f05abb2823e3352932ffff7111  AristotleCandidates/FiniteCornerTrace.lean\ne57deb88999d442a8882f37fd4b956e7d36df5849b460dea9f5aa1c5bd1ddde4  aristotle_responses/P50-quarantine/aristotle-stabilizer_two_lane_p50-n98s99xk_aristotle/AristotleCandidates/KaplanskyDensity.lean\ne57deb88999d442a8882f37fd4b956e7d36df5849b460dea9f5aa1c5bd1ddde4  AristotleCandidates/KaplanskyDensity.lean\n--- LIVE P49 GIT/REVIEW EVIDENCE ---\nerror: pathspec 'AristotleCandidates/FiniteCornerTrace.lean' did not match any file(s) known to git\nDid you forget to 'git add'?\n2026-08-07 15:31:18.906419395 +0200 AristotleCandidates/FiniteCornerTrace.lean\n2026-08-07 13:35:33.838034864 +0200 reviews/P49-finite-corner-trace-closeout.md\n","exit_code":0,"status":"completed"}}
