bel n) : ℂ) *\n  1182\t      A.stageProductState n x‖ = c * ‖A.stageProductState n x‖ := by\n  1183\t    rw [norm_mul, hc]\n  1184\t    congr 1\n  1185\t    rw [norm_mul]\n  1186\t    simp\n  1187\t  rw [hleft] at hbound\n  1188\t  have h3 : c * ‖A.stageProductState n x‖\n  1189\t      ≤ c * ‖(x : Matrix (A.SourceLabel n) (A.SourceLabel n) ℂ)‖ := by\n  1190\t    refine hbound.trans_eq ?_\n  1191\t    rw [hc]\n  1192\t    ring\n  1193\t  exact le_of_mul_le_mul_left h3 hcpos\n  1194\t\n  1195\t/-- **Stage positivity**, proved from the density-matrix identity. -/\n  1196\ttheorem stageProductState_positive (n : ℕ) : IsPositiveFunctional (A.stageProductState n) := by\n  1197\t  intro x\n  1198\t  have hstar : ((star x * x : pauliAlgebra (A.sourceForm n)) :\n  1199\t      Matrix (A.SourceLabel n) (A.SourceLabel n) ℂ)\n  1200\t      = star (x : Matrix (A.SourceLabel n) (A.SourceLabel n) ℂ) *\n  1201\t        (x : Matrix (A.SourceLabel n) (A.SourceLabel n) ℂ) := rfl\n  1202\t  set c : ℂ := ((A.allowedStage n).card : ℂ) * (Fintype.card (A.SourceLabel n) : ℂ) with hc\n  1203\t  have hcne : c ≠ 0 :=\n  1204\t    mul_ne_zero (Nat.cast_ne_zero.mpr (A.card_allowedStage_pos n).ne')\n  1205\t      (Nat.cast_ne_zero.mpr (Fintype.card_pos (α := A.SourceLabel n)).ne')\n  1206\t  have h1 := A.trace_density_conj n (star x * x)\n  1207\t  rw [hstar, matrix_trace_conj_star_self (A.stageDensityMat n)\n  1208\t    (x : Matrix (A.SourceLabel n) (A.SourceLabel n) ℂ) (A.stageDensityMat_star n)] at h1\n  1209\t  refine ⟨(∑ r : A.SourceLabel n,\n  1210\t      ‖Matrix.toEuclideanCLM (𝕜 := ℂ) (x : Matrix (A.SourceLabel n) (A.SourceLabel n) ℂ)\n  1211\t        (matCol (A.stageDensityMat n) r)‖ ^ 2) / (((A.allowedStage n).card : ℝ) *\n  1212\t        (Fintype.card (A.SourceLabel n) : ℝ)), ?_, ?_⟩\n  1213\t  · refine div_nonneg (Finset.sum_nonneg (fun r _ => sq_nonneg _)) ?_\n  1214\t    positivity\n  1215\t  · rw [Complex.ofReal_div, Complex.ofReal_mul, Complex.ofReal_natCast,\n  1216\t      Complex.ofReal_natCast, eq_div_iff hcne, h1]\n  1217\t    ring\n  1218\t\n  1219\t/-! ### 11.6 The algebraic product state is a state -/\n  1220\t\n  1221\ttheorem sourceProductState_positive : IsPositiveFunctional A.sourceProductState :=\n  1222\t  algebraicLimitTrace_positive A.stageProductState A.stageProductState_connecting\n  1223\t    A.stageProductState_positive\n  1224\t\n  1225\t/-- **The algebraic pure/mixed product state is a state**: unital and positive\n  1226\ton squares.  Nothing is assumed. -/\n  1227\ttheorem sourceProductState_isAlgebraicState : IsAlgebraicState A.sourceProductState :=\n  1228\t  ⟨A.sourceProductState_one, A.sourceProductState_positive⟩\n  1229\t\n  1230\t/-! ### 11.7 The stage maps into the algebraic limit -/\n  1231\t\n  1232\ttheorem sourceIncl_injective {n m : ℕ} (h : n ≤ m) : Function.Injective (A.sourceIncl h) := by\n  1233\t  intro v w hvw\n  1234\t  apply Subtype.ext\n  1235\t  have hcoe := congrArg (fun u : A.SourceLabel m => (u : PauliCoordinateLabels I)) hvw\n  1236\t  simpa using hcoe\n  1237\t\n  1238\ttheorem sourceConnecting_injective {n m : ℕ} (h : n ≤ m) :\n  1239\t    Function.Injective (A.sourceConnecting n m h) :=\n  1240\t  twistHom_injective _ _ _ _ (A.sourceIncl_injective h)\n  1241\t\n  1242\ttheorem sourceOf_injective (n : ℕ) : Function.Injective (A.sourceOf n) :=\n  1243\t  DirectLimit.mk_injective\n  1244\t    (F := A.directedFamily.limitData.Source)\n  1245\t    (f := fun i j h => A.directedFamily.limitData.sourceConnecting i j h)\n  1246\t    (fun _ _ hij => A.sourceConnecting_injective hij) n\n  1247\t\n  1248\t/-- The stage map into the algebraic limit, as a linear map. -/\n  1249\tnoncomputable def sourceOfLin (n : ℕ) : pauliAlgebra (A.sourceForm n) →ₗ[ℂ] A.SourceLimit :=\n  1250\t  DirectLimit.Module.of ℂ A.directedFamily.limitData.Index A.directedFamily.limitData.Source\n  1251\t    (fun i j le => A.directedFamily.limitData.sourceConnecting i j le) n\n  1252\t\n  1253\t/-- The stage map into the algebraic limit, as a star-algebra homomorphism. -/\n  1254\tnoncomputable def stageStarHom (n : ℕ) : pauliAlgebra (A.sourceForm n) →⋆ₐ[ℂ] A.SourceLimit where\n  1255\t  toFun := A.sourceOf n\n  1256\t  map_one' := A.sourceOf_one n\n  1257\t  map_mul' := A.sourceOf_mul n\n  1258\t  map_zero' := map_zero (A.sourceOfLin n)\n  1259\t  map_add' := map_add (A.sourceOfLin n)\n  1260\t  commutes' := by\n  1261\t    intro r\n  1262\t    show A.sourceOf n (algebraMap ℂ _ r) = algebraMap ℂ _ r\n  1263\t    rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,\n  1264\t      show A.sourceOf n (r • (1 : pauliAlgebra (A.sourceForm n))) = r • A.sourceOf n 1 from\n  1265\t        map_smul (A.sourceOfLin n) r 1, A.sourceOf_one]\n  1266\t  map_star' := A.sourceOf_star n\n  1267\t\n  1268\t@[simp] theorem stageStarHom_apply (n : ℕ) (x : pauliAlgebra (A.sourceForm n)) :\n  1269\t    A.stageStarHom n x = A.sourceOf n x := rfl\n  1270\t\n  1271\t/-- **The stage embedding into the concrete C⋆-model is isometric**, because an\n  1272\tinjective star homomorphism of C⋆-algebras is isometric. -/\n  1273\ttheorem norm_sourceEmbedding_sourceOf (R : A.SourceConcreteRep) (n : ℕ)\n  1274\t    (x : pauliAlgebra (A.sourceForm n)) :\n  1275\t    ‖R.sourceEmbedding (A.sourceOf n x)‖\n  1276\t      = ‖(x : Matrix (A.SourceLabel n) (A.SourceLabel n) ℂ)‖ := by\n  1277\t  have hinj : Function.Injective (R.sourceEmbedding.comp (A.stageStarHom n)) :=\n  1278\t    R.sourceEmbedding_injective.comp (A.sourceOf_injective n)\n  1279\t  exact NonUnitalStarAlgHom.norm_map (R.sourceEmbedding.comp (A.stageStarHom n)) hinj x\n  1280\t\n  1281\t/-! ### 11.8 The recovered C⋆ states -/\n  1282\t\n  1283\tnamespace SourceConcreteRep\n  1284\t\n  1285\tvariable {A} (R : A.SourceConcreteRep)\n  1286\t\n  1287\t/-- **The proved norm bound**: the algebraic product state is norm-decreasing\n  1288\tfor the concrete C⋆-norm of P55C.  This is exactly the estimate that §8 had to\n  1289\tassume. -/\n  1290\ttheorem norm_sourceProductState_le (z : A.SourceLimit) :\n  1291\t    ‖A.sourceProductState z‖ ≤ ‖R.sourceEmbedding z‖ := by\n  1292\t  induction z using DirectLimit.induction with\n  1293\t  | _ n x =>\n  1294\t    show ‖A.sourceProductState (A.sourceOf n x)‖ ≤ ‖R.sourceEmbedding (A.sourceOf n x)‖\n  1295\t    rw [A.sourceProductState_of, A.norm_sourceEmbedding_sourceOf R n x]\n  1296\t    exact A.norm_stageProductState_le n x\n  1297\t\n  1298\ttheorem uniformContinuous_sourceProductState_recovered :\n  1299\t    letI := R.sourceNormedRing\n  1300\t    letI := R.sourceNormedAlgebra\n  1301\t    UniformContinuous A.sourceProductState := by\n  1302\t  letI := R.sourceNormedRing\n  1303\t  letI := R.sourceNormedAlgebra\n  1304\t  exact (AddMonoidHomClass.lipschitz_of_bound A.sourceProductState 1\n  1305\t    (fun z => by simpa using R.norm_sourceProductState_le z)).uniformContinuous\n  1306\t\n  1307\t/-- **The recovered continuous pure/mixed product state** on the concrete source\n  1308\tC⋆-algebra.  No `ProductStateBound` and no other supplied datum enters. -/\n  1309\tnoncomputable def cstarProductStateRecovered : R.sourceCStar →L[ℂ] ℂ :=\n  1310\t  letI := R.sourceNormedRing\n  1311\t  letI := R.sourceNormedAlgebra\n  1312\t  extendCLM (i := (R.sourceEmbedding : A.SourceLimit →⋆ₐ[ℂ] R.sourceCStar).toAlgHom.toLinearMap)\n  1313\t    R.isometry_sourceEmbedding R.sourceEmbedding_denseRange\n  1314\t    (uniformContinuous_sourceProductState_recovered R)\n  1315\t\n  1316\t@[simp] theorem cstarProductStateRecovered_sourceEmbedding (z : A.SourceLimit) :\n  1317\t    cstarProductStateRecovered R (R.sourceEmbedding z) = A.sourceProductState z := by\n  1318\t  letI := R.sourceNormedRing\n  1319\t  letI := R.sourceNormedAlgebra\n  1320\t  exact extendCLM_apply (i := (R.sourceEmbedding :\n  1321\t      A.SourceLimit →⋆ₐ[ℂ] R.sourceCStar).toAlgHom.toLinearMap)\n  1322\t    R.isometry_sourceEmbedding R.sourceEmbedding_denseRange\n  1323\t    (uniformContinuous_sourceProductState_recovered R) z\n  1324\t\n  1325\ttheorem cstarProductStateRecovered_one : cstarProductStateRecovered R 1 = 1 := by\n  1326\t  have h1 : (1 : R.sourceCStar) = R.sourceEmbedding 1 := (map_one _).symm\n  1327\t  rw [h1, cstarProductStateRecovered_sourceEmbedding, A.sourceProductState_one]\n  1328\t\n  1329\ttheorem cstarProductStateRecovered_positive (T : R.sourceCStar) :\n  1330\t    ∃ r : ℝ, 0 ≤ r ∧ cstarProductStateRecovered R (star T * T) = (r : ℂ) := by\n  1331\t  have hK : IsClosed {z : ℂ | z.im = 0 ∧ 0 ≤ z.re} :=\n  1332\t    (isClosed_eq Complex.continuous_im continuous_const).inter\n  1333\t      (isClosed_le continuous_const Complex.continuous_re)\n  1334\t  have hg : Continuous (fun T : R.sourceCStar => cstarProductStateRecovered R (star T * T)) :=\n  1335\t    (cstarProductStateRecovered R).continuous.comp\n  1336\t      (continuous_mul.comp (continuous_star.prodMk continuous_id))\n  1337\t  have hsub : (Set.range (fun z : A.SourceLimit => R.sourceEmbedding z)) ⊆\n  1338\t      (fun T : R.sourceCStar => cstarProductStateRecovered R (star T * T)) ⁻¹'\n  1339\t        {z : ℂ | z.im = 0 ∧ 0 ≤ z.re} := by\n  1340\t    rintro _ ⟨z, rfl⟩\n  1341\t    obtain ⟨r, hr, hval⟩ := A.sourceProductState_positive z\n  1342\t    have hz : cstarProductStateRecovered R (star (R.sourceEmbedding z) * R.sourceEmbedding z)\n  1343\t        = (r : ℂ) := by\n  1344\t      rw [← map_star, ← map_mul, cstarProductStateRecovered_sourceEmbedding, hval]\n  1345\t    simp [hz, hr]\n  1346\t  have hclosed : IsClosed ((fun T : R.sourceCStar =>\n  1347\t      cstarProductStateRecovered R (star T * T)) ⁻¹' {z : ℂ | z.im = 0 ∧ 0 ≤ z.re}) :=\n  1348\t    hK.preimage hg\n  1349\t  have hall := hclosed.closure_subset_iff.mpr hsub\n  1350\t  have hmem : cstarProductStateRecovered R (star T * T) ∈ {z : ℂ | z.im = 0 ∧ 0 ≤ z.re} :=\n  1351\t    hall (by rw [R.sourceEmbedding_denseRange.closure_range]; trivial)\n  1352\t  exact ⟨(cstarProductStateRecovered R (star T * T)).re, hmem.2,\n  1353\t    Complex.ext rfl (by simpa using hmem.1)⟩\n  1354\t\n  1355\t/-- **The recovered source state is a state**: unital and positive on squares. -/\n  1356\ttheorem cstarProductStateRecovered_isAlgebraicState :\n  1357\t    IsAlgebraicState (cstarProductStateRecovered R).toLinearMap :=\n  1358\t  ⟨cstarProductStateRecovered_one R, fun T => cstarProductStateRecovered_positive R T⟩\n  1359\t\n  1360\t/-- The recovered source state has norm at most one. -/\n  1361\ttheorem norm_cstarProductStateRecovered_le_one : ‖cstarProductStateRecovered R‖ ≤ 1 := by\n  1362\t  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun T => ?_)\n  1363\t  have hK : IsClosed {p : R.sourceCStar | ‖cstarProductStateRecovered R p‖ ≤ 1 * ‖p‖ } :=\n  1364\t    isClosed_le ((cstarProductStateRecovered R).continuous.norm)\n  1365\t      (continuous_const.mul continuous_norm)\n  1366\t  have hsub : (Set.range (fun z : A.SourceLimit => R.sourceEmbedding z)) ⊆\n  1367\t      {p : R.sourceCStar | ‖cstarProductStateRecovered R p‖ ≤ 1 * ‖p‖ } := by\n  1368\t    rintro _ ⟨z, rfl⟩\n  1369\t    show ‖cstarProductStateRecovered R (R.sourceEmbedding z)‖ ≤ 1 * ‖R.sourceEmbedding z‖\n  1370\t    rw [cstarProductStateRecovered_sourceEmbedding, one_mul]\n  1371\t    exact R.norm_sourceProductState_le z\n  1372\t  have hall := hK.closure_subset_iff.mpr hsub\n  1373\t  exact hall (by rw [R.sourceEmbedding_denseRange.closure_range]; trivial)\n  1374\t\n  1375\t/-- **The recovered continuous regional stabilizer state**, obtained by\n  1376\ttransporting the recovered source state through the exact P55D C⋆ `alpha`. -/\n  1377\tnoncomputable def cstarRegionalStateRecovered : R.targetCStar →L[ℂ] ℂ :=\n  1378\t  (cstarProductStateRecovered R).comp R.cstarAlphaSymmCLM\n  1379\t\n  1380\t@[simp] theorem cstarRegionalStateRecovered_apply (T : R.targetCStar) :\n  1381\t    cstarRegionalStateRecovered R T = cstarProductStateRecovered R (R.cstarAlpha.symm T) := rfl\n  1382\t\n  1383\t@[simp] theorem cstarRegionalStateRecovered_targetEmbedding (y : A.TargetLimit) :\n  1384\t    cstarRegionalStateRecovered R (R.targetEmbedding y) = A.regionalStabilizerState y := by\n  1385\t  rw [cstarRegionalStateRecovered_apply, R.cstarAlpha_symm_targetEmbedding,\n  1386\t    cstarProductStateRecovered_sourceEmbedding, A.sourceProductState_alpha_symm]\n  1387\t\n  1388\ttheorem cstarRegionalStateRecovered_one : cstarRegionalStateRecovered R 1 = 1 := by\n  1389\t  rw [cstarRegionalStateRecovered_apply, map_one, cstarProductStateRecovered_one]\n  1390\t\n  1391\ttheorem cstarRegionalStateRecovered_positive (T : R.targetCStar) :\n  1392\t    ∃ r : ℝ, 0 ≤ r ∧ cstarRegionalStateRecovered R (star T * T) = (r : ℂ) := by\n  1393\t  obtain ⟨r, hr, hval⟩ := cstarProductStateRecovered_positive R (R.cstarAlpha.symm T)\n  1394\t  refine ⟨r, hr, ?_⟩\n  1395\t  rw [cstarRegionalStateRecovered_apply, map_mul, map_star, hval]\n  1396\t\n  1397\t/-- **The recovered regional state is a state**: unital and positive on\n  1398\tsquares. -/\n  1399\ttheorem cstarRegionalStateRecovered_isAlgebraicState :\n  1400\t    IsAlgebraicState (cstarRegionalStateRecovered R).toLinearMap :=\n  1401\t  ⟨cstarRegionalStateRecovered_one R, fun T => cstarRegionalStateRecovered_positive R T⟩\n  1402\t\n  1403\t/-- **The recovery gate of P56R.**  The recovered regional state, transported\n  1404\tthrough the exact P55D C⋆ `alpha`, is the recovered pure/mixed product state on\n  1405\tthe whole concrete quasi-local C⋆-algebra.  Neither side carries a supplied\n  1406\tboundedness, positivity or state hypothesis. -/\n  1407\ttheorem cstarRegionalStateRecovered_cstarAlpha (T : R.sourceCStar) :\n  1408\t    cstarRegionalStateRecovered R (R.cstarAlpha T) = cstarProductStateRecovered R T := by\n  1409\t  rw [cstarRegionalStateRecovered_apply, StarAlgEquiv.symm_apply_apply]\n  1410\t\n  1411\t/-- Function form of the recovery gate. -/\n  1412\ttheorem cstarRegionalStateRecovered_comp_cstarAlpha :\n  1413\t    (fun T : R.sourceCStar => cstarRegionalStateRec