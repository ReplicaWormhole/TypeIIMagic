{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '440,480p' AristotleCandidates/LocalHyperbolicAlgebraicAlpha.lean; sed -n '150,230p' AristotleCandidates/LocalHyperbolicConcreteRepresentations.lean; sed -n '1,120p' AristotleCandidates/RegionalConcreteCStarAlpha.lean\"","aggregated_output":"\n\n/-! ## The local-hyperbolic coordinate data of this packet -/\n\nsection Data\n\nvariable {L I : Type*}\n\n/-- A linear order on the source coordinate index, used only to fix the\nordering convention of the quadratic phase refinement. -/\nnoncomputable local instance sumLinearOrder [LinearOrder I] : LinearOrder (I ⊕ I) :=\n  LinearOrder.lift' (toLex : I ⊕ I → I ⊕ₗ I) (Equiv.injective _)\n\n/-- **The data of this packet.**  On top of the P52 local-hyperbolic family and\nlattice exhaustion it carries exactly two auxiliary assumptions: the coordinate\nmap is symplectic, and it is onto the finite target labels at every stage. -/\nstructure AlphaData (L I : Type*) [LinearOrder I] where\n  /-- The P52 locally supported adapted hyperbolic family. -/\n  family : CoherentLocalHyperbolic.LocalHyperbolicFamily L I\n  /-- The P52 lattice exhaustion. -/\n  exhaustion : CoherentLocalHyperbolic.LatticeExhaustion L\n  /-- **Auxiliary assumption (symplectic coordinates).**  The coordinate map\n  preserves the symplectic form, i.e. the antisymmetrisations of the source and\n  target Pauli pairings agree. -/\n  symplectic : ∀ v w : PauliCoordinateLabels I,\n    (coordPairing I).form v w + (coordPairing I).form w v =\n      (coordPairing L).form (family.coordinateMap v) (family.coordinateMap w) +\n        (coordPairing L).form (family.coordinateMap w) (family.coordinateMap v)\n  /-- **Auxiliary assumption (finite-stage adaptedness).**  At every stage the\n  coordinate map is onto the stage labels of the region. -/\n  stage_surjective : ∀ (n : ℕ), ∀ u ∈ exhaustion.targetLabels n,\n    ∃ c ∈ family.sourceLabels exhaustion n, family.coordinateMap c = u\n\nnamespace AlphaData\n\nvariable [LinearOrder I] (A : AlphaData L I)\n\n/-- The stage-`n` source Pauli labels. -/\nabbrev SourceLabel (n : ℕ) : Submodule PauliBit (PauliCoordinateLabels I) :=\n  A.family.sourceLabels A.exhaustion n\n\n/-! ## 2. The branch interface for the local-hyperbolic limits -/\n\nnamespace LocalHyperbolicAlpha\n\nnamespace AlphaData\n\nopen ConcreteRange\n\nvariable {L I : Type*} [LinearOrder I] (A : AlphaData L I)\n\n/-- **The uniform branch interface.**  A faithful representation of the P53\nalgebraic source limit on the P54 trace-GNS Hilbert space `UHFGNS`.  Both\nbranches below *construct* such a datum; nothing in this file accepts one as an\nexternal hypothesis. -/\nstructure SourceConcreteRep where\n  /-- The representation of the algebraic source limit by bounded operators. -/\n  rep : A.SourceLimit →⋆ₐ[ℂ] (UHFGNS →L[ℂ] UHFGNS)\n  /-- Faithfulness of the representation, proved in each construction. -/\n  rep_injective : Function.Injective rep\n\nnamespace SourceConcreteRep\n\nvariable {A} (R : A.SourceConcreteRep)\n\n/-- **The regional representation**, obtained by transporting the source\nrepresentation through the P53 algebraic equivalence `A.alpha.symm`. -/\nnoncomputable def targetRep : A.TargetLimit →⋆ₐ[ℂ] (UHFGNS →L[ℂ] UHFGNS) :=\n  R.rep.comp (StarAlgHomClass.toStarAlgHom A.alpha.symm)\n\n@[simp] theorem targetRep_apply (y : A.TargetLimit) : R.targetRep y = R.rep (A.alpha.symm y) :=\n  rfl\n\n/-- **The intertwining identity**: the regional representation composed with the\nalgebraic `alpha` is the source representation. -/\n@[simp] theorem targetRep_alpha (z : A.SourceLimit) : R.targetRep (A.alpha z) = R.rep z := by\n  simp\n\n/-- **Faithfulness of the regional representation.** -/\ntheorem targetRep_injective : Function.Injective R.targetRep :=\n  R.rep_injective.comp (EquivLike.injective A.alpha.symm)\n\n/-! ### The two closed operator-range C⋆-algebras -/\n\n/-- The concrete C⋆-algebra of the source limit: the closure of the operator\nrange of `R.rep`. -/\nnoncomputable def sourceCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS) := rangeCStar R.rep\n\n/-- The concrete C⋆-algebra of the regional limit: the closure of the operator\nrange of `R.targetRep`. -/\nnoncomputable def targetCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS) := rangeCStar R.targetRep\n\ninstance : IsClosed ((R.sourceCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS)) :\n    Set (UHFGNS →L[ℂ] UHFGNS)) := instIsClosedRangeCStar _\n\ninstance : IsClosed ((R.targetCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS)) :\n    Set (UHFGNS →L[ℂ] UHFGNS)) := instIsClosedRangeCStar _\n\nnoncomputable instance : CStarAlgebra R.sourceCStar := instCStarAlgebraRangeCStar _\n\nnoncomputable instance : CStarAlgebra R.targetCStar := instCStarAlgebraRangeCStar _\n\n/-- The canonical embedding of the algebraic source limit into its concrete\nC⋆-model. -/\nnoncomputable def sourceEmbedding : A.SourceLimit →⋆ₐ[ℂ] R.sourceCStar := rangeEmbedding R.rep\n\n/-- The canonical embedding of the algebraic regional limit into its concrete\nC⋆-model. -/\nnoncomputable def targetEmbedding : A.TargetLimit →⋆ₐ[ℂ] R.targetCStar :=\n  rangeEmbedding R.targetRep\n\n@[simp] theorem coe_sourceEmbedding (z : A.SourceLimit) :\n    (R.sourceEmbedding z : UHFGNS →L[ℂ] UHFGNS) = R.rep z := rfl\n\n@[simp] theorem coe_targetEmbedding (y : A.TargetLimit) :\n    (R.targetEmbedding y : UHFGNS →L[ℂ] UHFGNS) = R.targetRep y := rfl\n\ntheorem sourceEmbedding_injective : Function.Injective R.sourceEmbedding :=\n  rangeEmbedding_injective R.rep_injective\n\ntheorem targetEmbedding_injective : Function.Injective R.targetEmbedding :=\n  rangeEmbedding_injective R.targetRep_injective\nimport AristotleCandidates.LocalHyperbolicConcreteRepresentations\n\n/-!\n# P55D — the regional concrete C⋆ `alpha`\n\n**Context declaration.**  Source basis: `main.tex:1915-1920` (the extension of\nthe algebraic coordinate isomorphism to the C⋆-completions).  All analytic\ncontent below is proved; nothing is supplied as data.\n\n## Plan alignment\n\n* Package `P55D`, lane `H`; predecessors `P53`\n  (`AristotleCandidates.LocalHyperbolicAlgebraicAlpha`) and `P55C`\n  (`AristotleCandidates.LocalHyperbolicConcreteRepresentations`), together with\n  the checked concrete completion module\n  `AristotleCandidates.ConcreteCStarCompletion`\n  (`Formalization.ConcreteCStarCompletion`), all imported through P55C.\n* Gate discharged: extend the constructed algebraic `alpha` of P53 *uniquely*\n  between the constructed source and regional concrete C⋆ closures of P55C,\n  with the dense stage formulas, the inverse formulas, isometry, surjectivity\n  and uniqueness.\n* Forbidden downstream claims, none of which is made here: no product-state\n  equality, no GNS tensor split, no identification with a state-dependent\n  represented von Neumann algebra, no factor classification, no trivial-centre\n  theorem and no trace or weight conclusion.\n\n## What is constructed\n\nFor every P55C representation datum `R : A.SourceConcreteRep`:\n\n1. `regionalEmbedding`, the canonical embedding of the algebraic source limit\n   into the regional concrete C⋆-algebra through the algebraic `alpha`; it is\n   proved injective, isometric for the P55C pulled-back pre-C⋆ norm, and of\n   dense range.\n2. `cstarAlpha : R.sourceCStar ≃⋆ₐ[ℂ] R.targetCStar`, **constructed by\n   density** from `Formalization.ConcreteCStarCompletion.extendStarAlgEquiv`.\n   It is never a field of a structure.\n3. Its formula on every source stage image (`cstarAlpha_sourceEmbedding_of`)\n   and on every stage Pauli word (`cstarAlpha_sourceEmbedding_word`), the\n   corresponding inverse formulas on every target stage image\n   (`cstarAlpha_symm_targetEmbedding_of`,\n   `cstarAlpha_symm_targetEmbedding_word`), isometry\n   (`isometry_cstarAlpha`), surjectivity (`cstarAlpha_surjective`) and\n   uniqueness among continuous star-algebra equivalences satisfying either the\n   dense formula (`existsUnique_cstarAlpha`) or the stage word formula\n   (`cstarAlpha_unique_word`).\n4. The transparency lemma `coe_cstarAlpha`: since P55C *constructs* the\n   regional representation by transporting the source representation through\n   the algebraic `alpha`, the two closed operator ranges coincide as closed\n   operator algebras and the completed `alpha` is implemented by the identity\n   on operators.  This records exactly what the P55C model gives and claims\n   nothing about represented von Neumann algebras.\n5. The branch-uniform packaging `A.SourceConcreteCStar`,\n   `A.TargetConcreteCStar` and `A.regionalCStarAlpha`, obtained from the P55C\n   branch datum `A.branchSourceRep`, with the finite and infinite branch\n   operator formulas.\n\n## Auxiliary assumptions\n\nNone beyond the explicit `AlphaData` hypotheses of P53 and the finite/infinite\ncoordinate branch already constructed in P55C: `A.branchSourceRep` is the P55C\ncase split on `Finite I` versus `Infinite I`, and no representation,\nfaithfulness, boundedness, closure, density or extension premise is added here.\n-/\n\nnamespace StabilizerHyperfinite\n\nnamespace LocalHyperbolicAlpha\n\nnamespace AlphaData\n\nopen Formalization.ConcreteCStarCompletion\n\nvariable {L I : Type*} [LinearOrder I] {A : AlphaData L I}\n\n/-! ## 1. Word-wise rigidity of linear maps out of the algebraic source limit -/\n\n/-- Two complex-linear maps out of the algebraic source direct limit which agree\non the image of every stage Pauli word are equal.  This is the algebraic\nrigidity used for the word form of the uniqueness theorem. -/\ntheorem sourceLimit_linear_ext {X : Type*} [AddCommMonoid X] [Module ℂ X]\n    (A : AlphaData L I) (f g : A.SourceLimit →ₗ[ℂ] X)\n    (h : ∀ (n : ℕ) (v : A.SourceLabel n),\n      f (A.sourceOf n (pauliWord (A.sourceForm n) v)) =\n        g (A.sourceOf n (pauliWord (A.sourceForm n) v))) :\n    ∀ z, f z = g z := by\n  intro z\n  induction z using DirectLimit.induction with\n  | _ n x =>\n    show f (A.sourceOf n x) = g (A.sourceOf n x)\n    exact pauliAlgebra_linear_ext (A.sourceForm n)\n      (f.comp (DirectLimit.Module.of ℂ A.directedFamily.limitData.Index\n        A.directedFamily.limitData.Source A.directedFamily.limitData.sourceConnecting n))\n      (g.comp (DirectLimit.Module.of ℂ A.directedFamily.limitData.Index\n        A.directedFamily.limitData.Source A.directedFamily.limitData.sourceConnecting n))\n      (fun v => h n v) x\n\nnamespace SourceConcreteRep\n\nvariable (R : A.SourceConcreteRep)\n\n/-! ## 2. The regional embedding of the algebraic source limit -/\n\n/-- The canonical embedding of the algebraic source limit into the **regional**\nconcrete C⋆-algebra: the P55C regional embedding precomposed with the P53\nalgebraic `alpha`. -/\nnoncomputable def regionalEmbedding : A.SourceLimit →⋆ₐ[ℂ] R.targetCStar :=\n  R.targetEmbedding.comp (StarAlgHomClass.toStarAlgHom A.alpha)\n\n@[simp] theorem regionalEmbedding_apply (z : A.SourceLimit) :\n    R.regionalEmbedding z = R.targetEmbedding (A.alpha z) := rfl\n\n/-- As an operator, the regional embedding of a source element is its source\nrepresentation: the algebraic `alpha` is implemented by the identity on\noperators. -/\n@[simp] theorem coe_regionalEmbedding (z : A.SourceLimit) :\n    (R.regionalEmbedding z : UHFGNS →L[ℂ] UHFGNS) = R.rep z := by\n  simp [regionalEmbedding]\n\ntheorem regionalEmbedding_injective : Function.Injective R.regionalEmbedding :=\n","exit_code":0,"status":"completed"}}
