{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"nl -ba AristotleCandidates/VacuumRestrictedInfiniteTensorProduct.lean | sed -n '55,370p'\nprintf '\\\\n-- repository status before closeout review --\\\\n'\ngit status --short\"","aggregated_output":"    55\tnamespace VacuumRestrictedITP\n    56\t\n    57\tuniverse u v\n    58\t\n    59\t/-! ## Finite Gram coordinates in a single mode -/\n    60\t\n    61\t/-- Every finite family of vectors in a complex inner-product space admits finitely many\n    62\tcoordinates reproducing its Gram matrix: this is the coordinate form of the fact that the\n    63\tfamily spans a finite-dimensional subspace, which carries an orthonormal basis. -/\n    64\ttheorem exists_gram_coords {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F]\n    65\t    {n : Type*} [Fintype n] (u : n → F) :\n    66\t    ∃ (m : ℕ) (lam : n → Fin m → ℂ), ∀ a b, ⟪u a, u b⟫_ℂ = ∑ k, conj (lam a k) * lam b k := by\n    67\t  classical\n    68\t  set W := Submodule.span ℂ (Set.range u) with hW\n    69\t  haveI : FiniteDimensional ℂ W := FiniteDimensional.span_of_finite ℂ (Set.finite_range u)\n    70\t  set b := stdOrthonormalBasis ℂ W with hb\n    71\t  have hmem : ∀ a, u a ∈ W := fun a => Submodule.subset_span ⟨a, rfl⟩\n    72\t  refine ⟨Module.finrank ℂ W, fun a k => ⟪b k, (⟨u a, hmem a⟩ : W)⟫_ℂ, ?_⟩\n    73\t  intro a c\n    74\t  have h := b.sum_inner_mul_inner (⟨u a, hmem a⟩ : W) (⟨u c, hmem c⟩ : W)\n    75\t  have hco : ⟪u a, u c⟫_ℂ = ⟪(⟨u a, hmem a⟩ : W), (⟨u c, hmem c⟩ : W)⟫_ℂ := rfl\n    76\t  rw [hco, ← h]\n    77\t  exact Finset.sum_congr rfl fun k _ => by rw [inner_conj_symm]\n    78\t\n    79\tvariable {ι : Type u} {E : ι → Type v}\n    80\t  [∀ i, NormedAddCommGroup (E i)] [∀ i, InnerProductSpace ℂ (E i)]\n    81\t\n    82\t/-! ## Finite-mode realization -/\n    83\t\n    84\t/-- **Finite-mode realization.**  Given finitely many families of vectors `u a : ∀ i, E i` and a\n    85\tfinite mode set `s`, there is a finite tensor-product Hilbert space\n    86\t`EuclideanSpace ℂ (∀ i : s, Fin (m i))` and vectors `Φ a` in it whose inner products are exactly\n    87\tthe finite mode products `∏ i ∈ s, ⟪u a i, u b i⟫`. -/\n    88\ttheorem exists_finiteMode_realization {n : Type*} [Fintype n] (s : Finset ι) (u : n → ∀ i, E i) :\n    89\t    ∃ (K : Type u) (_ : Fintype K) (Φ : n → EuclideanSpace ℂ K),\n    90\t      ∀ a b, ⟪Φ a, Φ b⟫_ℂ = ∏ i ∈ s, ⟪u a i, u b i⟫_ℂ := by\n    91\t  classical\n    92\t  choose m lam hlam using fun i => exists_gram_coords (fun a => u a i)\n    93\t  refine ⟨(∀ i : s, Fin (m i)), inferInstance,\n    94\t    fun a => WithLp.toLp 2 (fun κ => ∏ i : s, lam i a (κ i)), ?_⟩\n    95\t  intro a b\n    96\t  rw [PiLp.inner_apply]\n    97\t  simp only [RCLike.inner_apply]\n    98\t  rw [← Finset.prod_coe_sort s (fun i => ⟪u a i, u b i⟫_ℂ)]\n    99\t  have hco : ∀ i : s, ⟪u a i, u b i⟫_ℂ = ∑ k, conj (lam i a k) * lam i b k := fun i => hlam i a b\n   100\t  simp_rw [hco]\n   101\t  rw [Fintype.prod_sum (fun (i : s) (k : Fin (m i)) => conj (lam i a k) * lam i b k)]\n   102\t  refine Finset.sum_congr rfl fun κ _ => ?_\n   103\t  rw [map_prod, ← Finset.prod_mul_distrib]\n   104\t  exact Finset.prod_congr rfl fun x _ => mul_comm _ _\n   105\t\n   106\t/-- **Positivity of the finite mode kernel on an arbitrary finite linear combination.**\n   107\tThis is the Schur-product-type statement underlying positivity of the infinite tensor product\n   108\tinner product; it is deduced from the finite-mode realization. -/\n   109\ttheorem sum_prod_inner_nonneg {n : Type*} [Fintype n] (s : Finset ι) (u : n → ∀ i, E i)\n   110\t    (c : n → ℂ) :\n   111\t    0 ≤ ∑ a, ∑ b, conj (c a) * c b * ∏ i ∈ s, ⟪u a i, u b i⟫_ℂ := by\n   112\t  obtain ⟨K, _, Φ, hΦ⟩ := exists_finiteMode_realization s u\n   113\t  have key : ∑ a, ∑ b, conj (c a) * c b * ∏ i ∈ s, ⟪u a i, u b i⟫_ℂ\n   114\t      = ⟪∑ a, c a • Φ a, ∑ b, c b • Φ b⟫_ℂ := by\n   115\t    rw [sum_inner]\n   116\t    refine Finset.sum_congr rfl fun a _ => ?_\n   117\t    rw [inner_sum]\n   118\t    refine Finset.sum_congr rfl fun b _ => ?_\n   119\t    rw [inner_smul_left, inner_smul_right, hΦ]\n   120\t    ring\n   121\t  rw [key]\n   122\t  exact CStarModule.inner_self_nonneg\n   123\t\n   124\t/-! ## Vacuum-restricted elementary tensors -/\n   125\t\n   126\t/-- A vacuum-restricted elementary tensor: a choice of vector in each mode, equal to the\n   127\treference vector `Ω i` outside a finite set of active modes. -/\n   128\tstructure VacuumTensor (Ω : ∀ i, E i) where\n   129\t  /-- The vector chosen in each mode. -/\n   130\t  vec : ∀ i, E i\n   131\t  /-- A finite set of modes outside of which the tensor is the reference vector. -/\n   132\t  active : Finset ι\n   133\t  /-- Outside `active` the tensor agrees with the reference vector. -/\n   134\t  vec_eq_vacuum : ∀ i ∉ active, vec i = Ω i\n   135\t\n   136\tvariable {Ω : ∀ i, E i}\n   137\t\n   138\t/-- The vacuum elementary tensor. -/\n   139\tdef VacuumTensor.vacuum (Ω : ∀ i, E i) : VacuumTensor Ω :=\n   140\t  ⟨Ω, ∅, fun _ _ => rfl⟩\n   141\t\n   142\tomit [∀ i, NormedAddCommGroup (E i)] [∀ i, InnerProductSpace ℂ (E i)] in\n   143\t@[simp] theorem VacuumTensor.vacuum_vec (i : ι) : (VacuumTensor.vacuum Ω).vec i = Ω i := rfl\n   144\t\n   145\tomit [∀ i, NormedAddCommGroup (E i)] [∀ i, InnerProductSpace ℂ (E i)] in\n   146\t@[simp] theorem VacuumTensor.vacuum_active :\n   147\t    (VacuumTensor.vacuum Ω).active = (∅ : Finset ι) := rfl\n   148\t\n   149\tvariable [DecidableEq ι]\n   150\t\n   151\t/-- The finite-product kernel of two vacuum-restricted elementary tensors, computed over the\n   152\tunion of their active mode sets. -/\n   153\tnoncomputable def kern (v w : VacuumTensor Ω) : ℂ :=\n   154\t  ∏ i ∈ v.active ∪ w.active, ⟪v.vec i, w.vec i⟫_ℂ\n   155\t\n   156\t/-- The kernel may be computed over any finite mode set containing both active sets:\n   157\toutside the active sets both entries are the unit reference vector. -/\n   158\ttheorem kern_eq_prod_of_subset (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) {v w : VacuumTensor Ω} {s : Finset ι}\n   159\t    (hv : v.active ⊆ s) (hw : w.active ⊆ s) :\n   160\t    kern v w = ∏ i ∈ s, ⟪v.vec i, w.vec i⟫_ℂ := by\n   161\t  refine Finset.prod_subset (Finset.union_subset hv hw) ?_\n   162\t  intro i _ hi\n   163\t  rw [Finset.mem_union, not_or] at hi\n   164\t  rw [v.vec_eq_vacuum i hi.1, w.vec_eq_vacuum i hi.2, hΩ i]\n   165\t\n   166\t@[simp] theorem kern_vacuum_vacuum :\n   167\t    kern (VacuumTensor.vacuum Ω) (VacuumTensor.vacuum Ω) = 1 := by\n   168\t  simp [kern]\n   169\t\n   170\t/-- Conjugate symmetry of the kernel. -/\n   171\ttheorem conj_kern (v w : VacuumTensor Ω) : conj (kern w v) = kern v w := by\n   172\t  rw [kern, kern, map_prod, Finset.union_comm]\n   173\t  exact Finset.prod_congr rfl fun i _ => inner_conj_symm _ _\n   174\t\n   175\t/-! ## The algebraic span and its sesquilinear form -/\n   176\t\n   177\t/-- The algebraic finite span of the vacuum-restricted elementary tensors: the free complex\n   178\tvector space on `VacuumTensor Ω`. -/\n   179\tabbrev ITPSpan (Ω : ∀ i, E i) := VacuumTensor Ω →₀ ℂ\n   180\t\n   181\t/-- The sesquilinear extension of the kernel to the algebraic span, conjugate linear in the\n   182\tfirst variable (Mathlib's convention). -/\n   183\tnoncomputable def itpInner (x y : ITPSpan Ω) : ℂ :=\n   184\t  ∑ v ∈ x.support, ∑ w ∈ y.support, conj (x v) * y w * kern v w\n   185\t\n   186\t/-- The defining double sum may be taken over any pair of finite sets containing the two\n   187\tsupports. -/\n   188\ttheorem itpInner_eq_sum₂ {x y : ITPSpan Ω} {t₁ t₂ : Finset (VacuumTensor Ω)}\n   189\t    (hx : x.support ⊆ t₁) (hy : y.support ⊆ t₂) :\n   190\t    itpInner x y = ∑ v ∈ t₁, ∑ w ∈ t₂, conj (x v) * y w * kern v w := by\n   191\t  have inner_ext : ∀ v : VacuumTensor Ω,\n   192\t      ∑ w ∈ y.support, conj (x v) * y w * kern v w\n   193\t        = ∑ w ∈ t₂, conj (x v) * y w * kern v w := by\n   194\t    intro v\n   195\t    refine Finset.sum_subset hy ?_\n   196\t    intro w _ hw\n   197\t    rw [Finsupp.notMem_support_iff.mp hw]\n   198\t    ring\n   199\t  rw [itpInner]\n   200\t  rw [Finset.sum_congr rfl fun v _ => inner_ext v]\n   201\t  refine Finset.sum_subset hx ?_\n   202\t  intro v _ hv\n   203\t  rw [Finsupp.notMem_support_iff.mp hv]\n   204\t  simp\n   205\t\n   206\t/-- The defining double sum may be taken over any finite set containing both supports. -/\n   207\ttheorem itpInner_eq_sum {x y : ITPSpan Ω} {t : Finset (VacuumTensor Ω)}\n   208\t    (hx : x.support ⊆ t) (hy : y.support ⊆ t) :\n   209\t    itpInner x y = ∑ v ∈ t, ∑ w ∈ t, conj (x v) * y w * kern v w :=\n   210\t  itpInner_eq_sum₂ hx hy\n   211\t\n   212\t/-- The sesquilinear form on elementary tensors is the kernel. -/\n   213\t@[simp] theorem itpInner_single (v w : VacuumTensor Ω) (a b : ℂ) :\n   214\t    itpInner (Finsupp.single v a) (Finsupp.single w b) = conj a * b * kern v w := by\n   215\t  rw [itpInner_eq_sum₂ (t₁ := {v}) (t₂ := {w}) Finsupp.support_single_subset\n   216\t    Finsupp.support_single_subset]\n   217\t  simp\n   218\t\n   219\t/-- Conjugate symmetry of the sesquilinear extension. -/\n   220\ttheorem conj_itpInner_symm (x y : ITPSpan Ω) : conj (itpInner y x) = itpInner x y := by\n   221\t  classical\n   222\t  set t := x.support ∪ y.support with ht\n   223\t  have hx : x.support ⊆ t := Finset.subset_union_left\n   224\t  have hy : y.support ⊆ t := Finset.subset_union_right\n   225\t  rw [itpInner_eq_sum hy hx, itpInner_eq_sum hx hy, map_sum]\n   226\t  rw [Finset.sum_comm]\n   227\t  refine Finset.sum_congr rfl fun v _ => ?_\n   228\t  rw [map_sum]\n   229\t  refine Finset.sum_congr rfl fun w _ => ?_\n   230\t  rw [map_mul, map_mul, conj_kern, RingHomCompTriple.comp_apply, RingHom.id_apply]\n   231\t  ring\n   232\t\n   233\t/-- Additivity in the first variable. -/\n   234\ttheorem itpInner_add_left (x y z : ITPSpan Ω) :\n   235\t    itpInner (x + y) z = itpInner x z + itpInner y z := by\n   236\t  classical\n   237\t  set t := (x.support ∪ y.support) ∪ z.support with ht\n   238\t  have hx : x.support ⊆ t := (Finset.subset_union_left).trans Finset.subset_union_left\n   239\t  have hy : y.support ⊆ t := (Finset.subset_union_right).trans Finset.subset_union_left\n   240\t  have hz : z.support ⊆ t := Finset.subset_union_right\n   241\t  have hxy : (x + y).support ⊆ t := (Finsupp.support_add).trans (Finset.union_subset hx hy)\n   242\t  rw [itpInner_eq_sum hxy hz, itpInner_eq_sum hx hz, itpInner_eq_sum hy hz, ← Finset.sum_add_distrib]\n   243\t  refine Finset.sum_congr rfl fun v _ => ?_\n   244\t  rw [← Finset.sum_add_distrib]\n   245\t  refine Finset.sum_congr rfl fun w _ => ?_\n   246\t  rw [Finsupp.add_apply, map_add]\n   247\t  ring\n   248\t\n   249\t/-- Scalar compatibility (conjugate linearity in the first variable). -/\n   250\ttheorem itpInner_smul_left (x y : ITPSpan Ω) (r : ℂ) :\n   251\t    itpInner (r • x) y = conj r * itpInner x y := by\n   252\t  classical\n   253\t  set t := x.support ∪ y.support with ht\n   254\t  have hx : x.support ⊆ t := Finset.subset_union_left\n   255\t  have hy : y.support ⊆ t := Finset.subset_union_right\n   256\t  have hrx : (r • x).support ⊆ t := (Finsupp.support_smul).trans hx\n   257\t  rw [itpInner_eq_sum hrx hy, itpInner_eq_sum hx hy, Finset.mul_sum]\n   258\t  refine Finset.sum_congr rfl fun v _ => ?_\n   259\t  rw [Finset.mul_sum]\n   260\t  refine Finset.sum_congr rfl fun w _ => ?_\n   261\t  rw [Finsupp.smul_apply, smul_eq_mul, map_mul]\n   262\t  ring\n   263\t\n   264\t/-- **Positivity on an arbitrary finite linear combination** of vacuum-restricted elementary\n   265\ttensors. -/\n   266\ttheorem itpInner_nonneg (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) (x : ITPSpan Ω) : 0 ≤ itpInner x x := by\n   267\t  classical\n   268\t  set t := x.support with ht\n   269\t  set s : Finset ι := t.sup VacuumTensor.active with hs\n   270\t  have hact : ∀ v ∈ t, v.active ⊆ s := fun v hv => Finset.le_sup (f := VacuumTensor.active) hv\n   271\t  have hkern : ∀ v ∈ t, ∀ w ∈ t,\n   272\t      kern v w = ∏ i ∈ s, ⟪v.vec i, w.vec i⟫_ℂ :=\n   273\t    fun v hv w hw => kern_eq_prod_of_subset hΩ (hact v hv) (hact w hw)\n   274\t  have hsum : itpInner x x\n   275\t      = ∑ v : t, ∑ w : t, conj (x (v : VacuumTensor Ω)) * x (w : VacuumTensor Ω)\n   276\t          * ∏ i ∈ s, ⟪(v : VacuumTensor Ω).vec i, (w : VacuumTensor Ω).vec i⟫_ℂ := by\n   277\t    rw [itpInner]\n   278\t    rw [← Finset.sum_coe_sort t]\n   279\t    refine Finset.sum_congr rfl fun v _ => ?_\n   280\t    rw [← Finset.sum_coe_sort t]\n   281\t    refine Finset.sum_congr rfl fun w _ => ?_\n   282\t    rw [hkern _ v.2 _ w.2]\n   283\t  rw [hsum]\n   284\t  exact sum_prod_inner_nonneg s (fun v : t => (v : VacuumTensor Ω).vec)\n   285\t    (fun v : t => x (v : VacuumTensor Ω))\n   286\t\n   287\t/-- Positivity in the real-part form required by `PreInnerProductSpace.Core`. -/\n   288\ttheorem re_itpInner_nonneg (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) (x : ITPSpan Ω) :\n   289\t    0 ≤ RCLike.re (itpInner x x) := by\n   290\t  have h := itpInner_nonneg hΩ x\n   291\t  simpa using (Complex.le_def.mp h).1\n   292\t\n   293\t/-- **The exported pre-inner-product core** on the algebraic span of vacuum-restricted\n   294\telementary tensors.  No quotient and no completion is taken. -/\n   295\tnoncomputable def itpCore (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) :\n   296\t    PreInnerProductSpace.Core ℂ (ITPSpan Ω) where\n   297\t  inner := itpInner\n   298\t  conj_inner_symm := conj_itpInner_symm\n   299\t  re_inner_nonneg := re_itpInner_nonneg hΩ\n   300\t  add_left := itpInner_add_left\n   301\t  smul_left := itpInner_smul_left\n   302\t\n   303\t@[simp] theorem itpCore_inner (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) (x y : ITPSpan Ω) :\n   304\t    (itpCore hΩ).inner x y = itpInner x y := rfl\n   305\t\n   306\t/-! ## The algebraic vacuum vector -/\n   307\t\n   308\t/-- The algebraic vacuum vector of the vacuum-restricted infinite tensor product. -/\n   309\tnoncomputable def vacuumVector (Ω : ∀ i, E i) : ITPSpan Ω :=\n   310\t  Finsupp.single (VacuumTensor.vacuum Ω) 1\n   311\t\n   312\t/-- The algebraic vacuum has norm square one.  (The normalization hypothesis\n   313\t`⟪Ω i, Ω i⟫ = 1` is not needed here, because the vacuum tensor has empty active set and its\n   314\tself-kernel is the empty product; the hypothesis is what makes this consistent with evaluating\n   315\tthe kernel over any larger finite mode set, see `kern_eq_prod_of_subset`.) -/\n   316\ttheorem itpInner_vacuumVector :\n   317\t    itpInner (vacuumVector Ω) (vacuumVector Ω) = 1 := by\n   318\t  classical\n   319\t  have hsupp : (vacuumVector Ω).support ⊆ {VacuumTensor.vacuum Ω} :=\n   320\t    Finsupp.support_single_subset\n   321\t  rw [itpInner_eq_sum hsupp hsupp]\n   322\t  simp [vacuumVector, kern_vacuum_vacuum]\n   323\t\n   324\t/-! ## Finite-mode realization for the algebraic span -/\n   325\t\n   326\t/-- **Finite-mode realization of the kernel.**  All pairings inside a finite family of\n   327\tvacuum-restricted elementary tensors are realized as inner products of vectors in a finite\n   328\ttensor-product Hilbert space. -/\n   329\ttheorem exists_finiteMode_realization_kern (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1)\n   330\t    (t : Finset (VacuumTensor Ω)) :\n   331\t    ∃ (K : Type u) (_ : Fintype K) (Φ : VacuumTensor Ω → EuclideanSpace ℂ K),\n   332\t      ∀ v ∈ t, ∀ w ∈ t, ⟪Φ v, Φ w⟫_ℂ = kern v w := by\n   333\t  classical\n   334\t  set s : Finset ι := t.sup VacuumTensor.active with hs\n   335\t  obtain ⟨K, hK, Φ, hΦ⟩ :=\n   336\t    exists_finiteMode_realization (E := E) s (fun v : t => (v : VacuumTensor Ω).vec)\n   337\t  refine ⟨K, hK, fun v => if hv : v ∈ t then Φ ⟨v, hv⟩ else (0 : EuclideanSpace ℂ K), ?_⟩\n   338\t  intro v hv w hw\n   339\t  have hact : ∀ z ∈ t, z.active ⊆ s := fun z hz => Finset.le_sup (f := VacuumTensor.active) hz\n   340\t  simp only [dif_pos hv, dif_pos hw]\n   341\t  rw [hΦ ⟨v, hv⟩ ⟨w, hw⟩, kern_eq_prod_of_subset hΩ (hact v hv) (hact w hw)]\n   342\t\n   343\t/-- The sesquilinear form is computed entirely inside a finite mode sector. -/\n   344\ttheorem itpInner_eq_finiteMode (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) {x y : ITPSpan Ω}\n   345\t    {t : Finset (VacuumTensor Ω)} (hx : x.support ⊆ t) (hy : y.support ⊆ t)\n   346\t    {s : Finset ι} (hs : ∀ v ∈ t, v.active ⊆ s) :\n   347\t    itpInner x y\n   348\t      = ∑ v ∈ t, ∑ w ∈ t, conj (x v) * y w * ∏ i ∈ s, ⟪v.vec i, w.vec i⟫_ℂ := by\n   349\t  rw [itpInner_eq_sum hx hy]\n   350\t  refine Finset.sum_congr rfl fun v hv => ?_\n   351\t  refine Finset.sum_congr rfl fun w hw => ?_\n   352\t  rw [kern_eq_prod_of_subset hΩ (hs v hv) (hs w hw)]\n   353\t\n   354\t/-! ## A concrete non-degenerate instance\n   355\t\n   356\tA sanity check that the definitions are not vacuous: with `ι = ℕ`, `E i = ℂ` and `Ω i = 1`,\n   357\tthe elementary tensor which is `2` in mode `0` and vacuum elsewhere has self-kernel `4`. -/\n   358\t\n   359\tsection Sanity\n   360\t\n   361\t/-- An elementary vacuum-restricted tensor over `ι = ℕ` with all factors `ℂ` and vacuum `1`. -/\n   362\tdef sanityTensor : VacuumTensor (fun _ : ℕ => (1 : ℂ)) where\n   363\t  vec i := if i = 0 then 2 else 1\n   364\t  active := {0}\n   365\t  vec_eq_vacuum i hi := by\n   366\t    simp only [Finset.mem_singleton] at hi\n   367\t    simp [hi]\n   368\t\n   369\texample : kern sanityTensor sanityTensor = 4 := by\n   370\t  simp [kern, sanityTensor]\n\n-- repository status before closeout review --\n M PLAN.md\n M aristotle_tasks/P49-finite-corner-trace.md\n M aristotle_tasks/P50-normal-faithful-corner-trace.md\n M aristotle_tasks/P51-full-finite-corner-central-exclusion.md\n M aristotle_tasks/P55-regional-concrete-cstar-alpha.md\n M aristotle_tasks/P57-product-gns-tensor-factorization.md\n M aristotle_tasks/P60-full-corner-semifinite-weight.md\n M work/TWO-LANE-FORMALIZATION-DECISION.md\n?? AristotleCandidates/FiniteCornerTrace.lean\n?? AristotleCandidates/FullCornerSemifiniteWeight.lean\n?? AristotleCandidates/FullFiniteCornerCentralExclusion.lean\n?? AristotleCandidates/KaplanskyDensity.lean\n?? AristotleCandidates/LocalHyperbolicAlgebraicAlpha.lean\n?? AristotleCandidates/LocalHyperbolicConcreteRepresentations.lean\n?? AristotleCandidates/LocalHyperbolicFiniteStageUHFBridge.lean\n?? AristotleCandidates/LocalHyperbolicSourceUHFBridge.lean\n?? AristotleCandidates/MixedUHFHyperfiniteFactor.lean\n?? AristotleCandidates/NormalFaithfulCornerTrace.lean\n?? AristotleCandidates/RegionalConcreteCStarAlpha.lean\n?? AristotleCandidates/RegionalProductStateIdentity.lean\n?? AristotleCandidates/StrongOperatorClosedVonNeumann.lean\n?? AristotleCandidates/UltraweakNormality.lean\n?? AristotleCandidates/VacuumRestrictedInfiniteTensorProduct.lean\n?? AristotleCandidates/VonNeumannBicommutantTheorem.lean\n?? aristotle_tasks/P50U-ultraweak-normality-bridge.md\n?? aristotle_tasks/P55A-local-hyperbolic-finite-stage-uhf-bridge.md\n?? aristotle_tasks/P55B-local-hyperbolic-source-uhf-bridge.md\n?? aristotle_tasks/P55C-local-hyperbolic-concrete-representations.md\n?? aristotle_tasks/P55D-regional-concrete-cstar-alpha.md\n?? aristotle_tasks/P56R-regional-cstar-product-state.md\n?? aristotle_tasks/P57A-vacuum-restricted-itp-core.md\n?? aristotle_tasks/P60R-full-corner-standard-semifiniteness-repair.md\n?? reviews/P49-finite-corner-trace-closeout.md\n?? reviews/P49-finite-corner-trace-recovery.md\n?? reviews/P49A-strong-operator-closed-von-neumann-closeout.md\n?? reviews/P49B-von-neumann-bicommutant-theorem-closeout.md\n?? reviews/P49C-kaplansky-density-closeout.md\n?? reviews/P50-normal-faithful-corner-trace-closeout-rerun.md\n?? reviews/P50-normal-faithful-corner-trace-closeout.md\n?? reviews/P50-normal-faithful-corner-trace-recovery.md\n?? reviews/P50U-ultraweak-normality-bridge-closeout.md\n?? reviews/P51-full-finite-corner-central-exclusion-closeout.md\n?? reviews/P51-full-finite-corner-central-exclusion-recovery.md\n?? reviews/P53-local-hyperbolic-algebraic-alpha-c