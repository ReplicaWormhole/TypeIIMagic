{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '460,980p' aristotle_responses/P54-extracted/aristotle-stabilizer_two_lane_p54-0ps3ce65_aristotle/AristotleCandidates/UHFReferenceRepresentation.lean\"","aggregated_output":"    have hx0 : x = 0 := qubitTensorTrace_faithful n x hx\n    show (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x :\n      QubitUHFAlgebra) = 0\n    rw [hx0]\n    exact map_zero (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n)\n\nend TraceProperties\n\n/-! ## 5. The trace bound for left multiplication on the algebraic limit -/\n\nsection LimitBound\n\n/-- The direct-limit trace is nonnegative on the algebraic positive cone. -/\ntheorem qubitUHFTrace_nonneg_of_mem_sumSqCone {a : QubitUHFAlgebra}\n    (ha : a ∈ sumSqCone QubitUHFAlgebra) :\n    ∃ r : ℝ, 0 ≤ r ∧ qubitUHFTrace a = (r : ℂ) := by\n  refine sumSqCone_induction\n    (p := fun a => ∃ r : ℝ, 0 ≤ r ∧ qubitUHFTrace a = (r : ℂ)) ?_ ?_ ?_ ha\n  · exact ⟨0, le_rfl, by simp⟩\n  · intro s\n    exact qubitUHFTrace_positive s\n  · rintro x y ⟨r, hr, hrx⟩ ⟨t, ht, hty⟩\n    exact ⟨r + t, by positivity, by rw [map_add, hrx, hty]; push_cast; ring⟩\n\n/-- **Algebraic operator bound on the limit.**  Every element of the algebraic\nUHF limit satisfies `star z * z ≼ c • 1` for some nonnegative real `c`,\ninherited from the finite-stage bound. -/\ntheorem qubitUHF_exists_bound (z : QubitUHFAlgebra) :\n    ∃ c : ℝ, 0 ≤ c ∧ SumSqLE (star z * z) (algebraMap ℂ QubitUHFAlgebra (c : ℂ)) := by\n  induction z using DirectLimit.induction with\n  | _ n x =>\n    obtain ⟨c, hc, p, hp, hpEq⟩ := qubitTensorPower_exists_bound n x\n    set φ : QubitTensorPower n →⋆ₐ[ℂ] QubitUHFAlgebra :=\n      algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n with hφ\n    refine ⟨c, hc, φ p, sumSqCone_map φ hp, ?_⟩\n    have hz : star (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) *\n        DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x\n        = φ (star x * x) := by\n      rw [map_mul, map_star]\n      rfl\n    show algebraMap ℂ QubitUHFAlgebra (c : ℂ) =\n      star (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) *\n        DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x + φ p\n    rw [hz, ← map_add, ← hpEq]\n    exact (φ.commutes (c : ℂ)).symm\n\n/-- The trace square-norm of an element of the algebraic limit. -/\nnoncomputable def uhfNormSq (w : QubitUHFAlgebra) : ℝ := (qubitUHFTrace (star w * w)).re\n\ntheorem qubitUHFTrace_star_self (w : QubitUHFAlgebra) :\n    qubitUHFTrace (star w * w) = (uhfNormSq w : ℂ) := by\n  obtain ⟨r, _, hval⟩ := qubitUHFTrace_positive w\n  rw [hval]\n  simp [uhfNormSq, hval]\n\ntheorem uhfNormSq_nonneg (w : QubitUHFAlgebra) : 0 ≤ uhfNormSq w := by\n  obtain ⟨r, hr, hval⟩ := qubitUHFTrace_positive w\n  simpa [uhfNormSq, hval] using hr\n\ntheorem uhfNormSq_eq_zero_iff (w : QubitUHFAlgebra) : uhfNormSq w = 0 ↔ w = 0 := by\n  constructor\n  · intro h\n    refine qubitUHFTrace_faithful w ?_\n    rw [qubitUHFTrace_star_self, h]\n    simp\n  · rintro rfl\n    simp [uhfNormSq]\n\n/-- **The left-multiplication bound.**  If `star z * z ≼ c • 1` then left\nmultiplication by `z` is bounded by `c` in the trace square-norm.  This is the\npurely algebraic substitute for the C*-inequality `‖z w‖₂ ≤ ‖z‖ ‖w‖₂`. -/\ntheorem uhfNormSq_mul_le {z : QubitUHFAlgebra} {c : ℝ}\n    (hz : SumSqLE (star z * z) (algebraMap ℂ QubitUHFAlgebra (c : ℂ))) (w : QubitUHFAlgebra) :\n    uhfNormSq (z * w) ≤ c * uhfNormSq w := by\n  obtain ⟨p, hp, hpEq⟩ := hz\n  have hconj : star w * p * w ∈ sumSqCone QubitUHFAlgebra := sumSqCone_conj hp w\n  obtain ⟨t, ht, htval⟩ := qubitUHFTrace_nonneg_of_mem_sumSqCone hconj\n  have hkey : (c : ℂ) • (star w * w) = star (z * w) * (z * w) + star w * p * w := by\n    have h1 : star w * (algebraMap ℂ QubitUHFAlgebra (c : ℂ)) * w\n        = (c : ℂ) • (star w * w) := by\n      rw [Algebra.smul_def, ← mul_assoc, Algebra.commutes]\n    have h2 : star w * (star z * z + p) * w\n        = star (z * w) * (z * w) + star w * p * w := by\n      rw [star_mul]\n      noncomm_ring\n    rw [← h1, hpEq, h2]\n  have happly := congrArg qubitUHFTrace hkey\n  rw [map_smul, map_add, qubitUHFTrace_star_self, qubitUHFTrace_star_self, htval] at happly\n  have hre : c * uhfNormSq w = uhfNormSq (z * w) + t := by\n    have := congrArg Complex.re happly\n    simpa [Complex.ofReal_re, Complex.add_re, smul_eq_mul] using this\n  have : uhfNormSq (z * w) ≤ uhfNormSq (z * w) + t := by linarith\n  linarith [hre]\n\nend LimitBound\n\n/-! ## 6. The trace GNS pre-Hilbert space, its completion, and the\nrepresentation -/\n\nsection GNS\n\nopen scoped InnerProductSpace\nopen UniformSpace ContinuousLinearMap\n\n/-- The GNS pre-Hilbert space of the algebraic dyadic limit for its canonical\nnormalized trace: a type synonym of `QubitUHFAlgebra` carrying the inner\nproduct `⟪a, b⟫ = τ (star a * b)`. -/\ndef UHFL2 : Type := QubitUHFAlgebra\n\nnoncomputable instance : AddCommGroup UHFL2 :=\n  Module.addCommMonoidToAddCommGroup (R := ℂ) (M := QubitUHFAlgebra)\n\nnoncomputable instance : Module ℂ UHFL2 := inferInstanceAs (Module ℂ QubitUHFAlgebra)\n\n/-- The tautological linear equivalence onto the GNS pre-Hilbert space. -/\nnoncomputable def toL2 : QubitUHFAlgebra ≃ₗ[ℂ] UHFL2 := LinearEquiv.refl ℂ _\n\n/-- The tautological linear equivalence out of the GNS pre-Hilbert space. -/\nnoncomputable def ofL2 : UHFL2 ≃ₗ[ℂ] QubitUHFAlgebra := toL2.symm\n\n@[simp] theorem ofL2_toL2 (z : QubitUHFAlgebra) : ofL2 (toL2 z) = z := rfl\n@[simp] theorem toL2_ofL2 (a : UHFL2) : toL2 (ofL2 a) = a := rfl\n\n/-- The trace inner product on the algebraic limit. -/\nnoncomputable abbrev uhfL2Core : PreInnerProductSpace.Core ℂ UHFL2 where\n  inner a b := qubitUHFTrace (star (ofL2 a) * ofL2 b)\n  conj_inner_symm x y := by\n    show (starRingEnd ℂ) (qubitUHFTrace (star (ofL2 y) * ofL2 x)) =\n      qubitUHFTrace (star (ofL2 x) * ofL2 y)\n    rw [← Complex.star_def, ← qubitUHFTrace_star]\n    simp [star_mul]\n  re_inner_nonneg x := by\n    obtain ⟨r, hr, hval⟩ := qubitUHFTrace_positive (ofL2 x)\n    show 0 ≤ (qubitUHFTrace (star (ofL2 x) * ofL2 x)).re\n    rw [hval]\n    simpa using hr\n  add_left x y z := by\n    show qubitUHFTrace (star (ofL2 (x + y)) * ofL2 z) =\n      qubitUHFTrace (star (ofL2 x) * ofL2 z) + qubitUHFTrace (star (ofL2 y) * ofL2 z)\n    simp [map_add, star_add, add_mul]\n  smul_left x y r := by\n    show qubitUHFTrace (star (ofL2 (r • x)) * ofL2 y) =\n      (starRingEnd ℂ) r * qubitUHFTrace (star (ofL2 x) * ofL2 y)\n    rw [map_smul, star_smul, smul_mul_assoc, map_smul]\n    simp [smul_eq_mul]\n\nnoncomputable instance : SeminormedAddCommGroup UHFL2 :=\n  InnerProductSpace.Core.toSeminormedAddCommGroup (c := uhfL2Core)\n\nnoncomputable instance : InnerProductSpace ℂ UHFL2 := InnerProductSpace.ofCore uhfL2Core\n\ntheorem uhfL2_inner_def (a b : UHFL2) :\n    ⟪a, b⟫_ℂ = qubitUHFTrace (star (ofL2 a) * ofL2 b) := rfl\n\ntheorem uhfL2_norm_def (a : UHFL2) : ‖a‖ = Real.sqrt (uhfNormSq (ofL2 a)) := rfl\n\n/-- The trace inner product is definite: the GNS seminorm of the algebraic\ndyadic limit is a genuine norm. -/\ntheorem uhfL2_norm_eq_zero {a : UHFL2} (h : ‖a‖ = 0) : a = 0 := by\n  rw [uhfL2_norm_def] at h\n  have h0 : uhfNormSq (ofL2 a) = 0 :=\n    (Real.sqrt_eq_zero (uhfNormSq_nonneg _)).mp h\n  have := (uhfNormSq_eq_zero_iff (ofL2 a)).mp h0\n  simpa using congrArg toL2 this\n\n/-- The GNS Hilbert space of the algebraic dyadic limit: the completion of the\ntrace pre-Hilbert space.  It is *constructed*, not postulated, and is in\nparticular not an infinite tensor product. -/\nabbrev UHFGNS : Type := UniformSpace.Completion UHFL2\n\n/-- The chosen algebraic operator bound of an element of the limit. -/\nnoncomputable def uhfBound (z : QubitUHFAlgebra) : ℝ :=\n  Classical.choose (qubitUHF_exists_bound z)\n\ntheorem uhfBound_nonneg (z : QubitUHFAlgebra) : 0 ≤ uhfBound z :=\n  (Classical.choose_spec (qubitUHF_exists_bound z)).1\n\ntheorem uhfBound_spec (z : QubitUHFAlgebra) :\n    SumSqLE (star z * z) (algebraMap ℂ QubitUHFAlgebra ((uhfBound z : ℝ) : ℂ)) :=\n  (Classical.choose_spec (qubitUHF_exists_bound z)).2\n\ntheorem uhfNormSq_mul_le_bound (z w : QubitUHFAlgebra) :\n    uhfNormSq (z * w) ≤ uhfBound z * uhfNormSq w :=\n  uhfNormSq_mul_le (uhfBound_spec z) w\n\n/-- Left multiplication on the GNS pre-Hilbert space, as a bounded operator. -/\nnoncomputable def uhfLeftMul (z : QubitUHFAlgebra) : UHFL2 →L[ℂ] UHFL2 :=\n  LinearMap.mkContinuous\n    (toL2.toLinearMap ∘ₗ LinearMap.mulLeft ℂ z ∘ₗ ofL2.toLinearMap)\n    (Real.sqrt (uhfBound z))\n    (by\n      intro a\n      have hle : uhfNormSq (z * ofL2 a) ≤ uhfBound z * uhfNormSq (ofL2 a) :=\n        uhfNormSq_mul_le_bound z (ofL2 a)\n      have h1 : ‖(toL2.toLinearMap ∘ₗ LinearMap.mulLeft ℂ z ∘ₗ ofL2.toLinearMap) a‖\n          = Real.sqrt (uhfNormSq (z * ofL2 a)) := rfl\n      have h2 : Real.sqrt (uhfBound z) * ‖a‖\n          = Real.sqrt (uhfBound z * uhfNormSq (ofL2 a)) := by\n        rw [uhfL2_norm_def, Real.sqrt_mul (uhfBound_nonneg z)]\n      rw [h1, h2]\n      exact Real.sqrt_le_sqrt hle)\n\n@[simp] theorem uhfLeftMul_apply (z : QubitUHFAlgebra) (a : UHFL2) :\n    uhfLeftMul z a = toL2 (z * ofL2 a) := rfl\n\nset_option synthInstance.maxHeartbeats 1000000 in\nset_option maxHeartbeats 1000000 in\n/-- **The reference representation of the algebraic dyadic (UHF) limit** on its\ntrace GNS Hilbert space, by left multiplication. -/\nnoncomputable def uhfRep : QubitUHFAlgebra →⋆ₐ[ℂ] (UHFGNS →L[ℂ] UHFGNS) where\n  toFun z := (uhfLeftMul z).completion\n  map_one' := by\n    ext x\n    induction x using Completion.induction_on with\n    | hp => apply isClosed_eq <;> fun_prop\n    | ih x => simp\n  map_mul' z w := by\n    ext x\n    induction x using Completion.induction_on with\n    | hp => apply isClosed_eq <;> fun_prop\n    | ih x => simp [mul_assoc]\n  map_zero' := by\n    ext x\n    induction x using Completion.induction_on with\n    | hp => apply isClosed_eq <;> fun_prop\n    | ih x => simp [Completion.coe_zero]\n  map_add' z w := by\n    ext x\n    induction x using Completion.induction_on with\n    | hp => apply isClosed_eq <;> fun_prop\n    | ih x => simp [add_mul, Completion.coe_add]\n  commutes' r := by\n    ext x\n    induction x using Completion.induction_on with\n    | hp => apply isClosed_eq <;> fun_prop\n    | ih x =>\n      simp only [ContinuousLinearMap.completion_apply_coe, uhfLeftMul_apply,\n        ← Algebra.smul_def]\n      simp [Algebra.algebraMap_eq_smul_one, ← Completion.coe_smul]\n  map_star' z := by\n    refine (eq_adjoint_iff (uhfLeftMul (star z)).completion (uhfLeftMul z).completion).mpr ?_\n    intro x y\n    induction x, y using Completion.induction_on₂ with\n    | hp => apply isClosed_eq <;> fun_prop\n    | ih x y =>\n      simp only [ContinuousLinearMap.completion_apply_coe, Completion.inner_coe,\n        uhfLeftMul_apply, uhfL2_inner_def, ofL2_toL2]\n      rw [star_mul, star_star, mul_assoc]\n\n@[simp] theorem uhfRep_apply_coe (z : QubitUHFAlgebra) (a : UHFL2) :\n    uhfRep z (a : UHFGNS) = ((toL2 (z * ofL2 a) : UHFL2) : UHFGNS) := by\n  show (uhfLeftMul z).completion (a : UHFGNS) = _\n  simp\n\n/-- The canonical cyclic vector of the reference representation. -/\nnoncomputable def uhfCyclicVector : UHFGNS := ((toL2 (1 : QubitUHFAlgebra) : UHFL2) : UHFGNS)\n\ntheorem uhfRep_apply_cyclicVector (z : QubitUHFAlgebra) :\n    uhfRep z uhfCyclicVector = ((toL2 z : UHFL2) : UHFGNS) := by\n  rw [uhfCyclicVector, uhfRep_apply_coe]\n  simp\n\n/-- The cyclic vector reproduces the canonical trace as a vector state. -/\ntheorem uhfRep_vector_state (z : QubitUHFAlgebra) :\n    ⟪uhfCyclicVector, uhfRep z uhfCyclicVector⟫_ℂ = qubitUHFTrace z := by\n  rw [uhfRep_apply_cyclicVector, uhfCyclicVector, Completion.inner_coe, uhfL2_inner_def]\n  simp\n\n/-- The cyclic vector is a unit vector, because the trace is normalized. -/\ntheorem uhfCyclicVector_norm : ‖uhfCyclicVector‖ = 1 := by\n  have h : ‖uhfCyclicVector‖ = ‖(toL2 (1 : QubitUHFAlgebra) : UHFL2)‖ :=\n    Completion.norm_coe _\n  rw [h, uhfL2_norm_def]\n  have h1 : uhfNormSq (1 : QubitUHFAlgebra) = 1 := by\n    have hval : qubitUHFTrace (star (1 : QubitUHFAlgebra) * 1) = 1 := by\n      simpa using qubitUHFTrace_isAlgebraicTracialState.map_one\n    have := qubitUHFTrace_star_self (1 : QubitUHFAlgebra)\n    rw [hval] at this\n    exact_mod_cast this.symm\n  simp [h1]\n\n/-- The canonical map of the pre-Hilbert space into its completion is\ninjective, because the trace inner product is definite. -/\ntheorem uhfL2_coe_injective : Function.Injective (fun a : UHFL2 => (a : UHFGNS)) := by\n  intro a b hab\n  have hab' : (a : UHFGNS) = (b : UHFGNS) := hab\n  have hnorm : ‖a - b‖ = 0 := by\n    have : ((a - b : UHFL2) : UHFGNS) = 0 := by\n      rw [Completion.coe_sub, hab', sub_self]\n    calc ‖a - b‖ = ‖((a - b : UHFL2) : UHFGNS)‖ := (Completion.norm_coe _).symm\n      _ = 0 := by rw [this, norm_zero]\n  have := uhfL2_norm_eq_zero hnorm\n  exact sub_eq_zero.mp this\n\n/-- **Faithfulness of the reference representation.** -/\ntheorem uhfRep_injective : Function.Injective uhfRep := by\n  intro z w hzw\n  have h := congrArg (fun T : UHFGNS →L[ℂ] UHFGNS => T uhfCyclicVector) hzw\n  simp only [uhfRep_apply_cyclicVector] at h\n  have := uhfL2_coe_injective h\n  simpa using congrArg ofL2 this\n\nend GNS\n\n/-! ## 7. Compatible finite-stage representations and faithfulness -/\n\nsection FiniteStages\n\nopen UniformSpace\n\n/-- A complex-linear map with trivial kernel is injective (the complex module\nstructure supplies the additive inverses that a semiring stage does not carry\non its own). -/\ntheorem injective_of_map_eq_zero {A B : Type*} [AddCommMonoid A] [Module ℂ A]\n    [AddCommMonoid B] [Module ℂ B] (φ : A →ₗ[ℂ] B) (h : ∀ x, φ x = 0 → x = 0) :\n    Function.Injective φ := by\n  letI : AddCommGroup A := Module.addCommMonoidToAddCommGroup ℂ\n  letI : AddCommGroup B := Module.addCommMonoidToAddCommGroup ℂ\n  intro x y hxy\n  have h1 : φ (x - y) = 0 := by rw [map_sub, hxy, sub_self]\n  exact sub_eq_zero.mp (h _ h1)\n\n/-- The canonical stage maps into the algebraic dyadic limit are injective. -/\ntheorem qubitStage_injective (n : ℕ) :\n    Function.Injective (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n) := by\n  refine injective_of_map_eq_zero\n    (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n).toLinearMap ?_\n  intro x hx\n  have hx' : (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x :\n      QubitUHFAlgebra) = 0 := hx\n  refine qubitTensorTrace_faithful n x ?_\n  have hstage : (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n\n      (star x * x) : QubitUHFAlgebra)\n      = star (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) *\n        DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x := by\n    rw [star_of]\n    exact map_mul (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n) (star x) x\n  have h0 : qubitUHFTrace (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n\n      (star x * x)) = 0 := by\n    rw [hstage, hx', mul_zero, map_zero]\n  rw [qubitUHFTrace_of] at h0\n  exact h0\n\n/-- The finite-stage representation of the `n`-qubit dyadic stage on the GNS\nHilbert space of the algebraic limit. -/\nnoncomputable def uhfStageRep (n : ℕ) : QubitTensorPower n →⋆ₐ[ℂ] (UHFGNS →L[ℂ] UHFGNS) :=\n  uhfRep.comp (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n)\n\n/-- The canonical stage maps are compatible with the dyadic inclusions. -/\ntheorem qubitStage_compat (n m : ℕ) (h : n ≤ m) (x : QubitTensorPower n) :\n    algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) m (qubitTensorPowerMap n m h x)\n      = algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n x :=\n  DirectLimit.Ring.of_f (G := QubitTensorPower) (f := qubitTensorPowerMap) h x\n\n/-- The finite-stage representations are compatible with the dyadic\ninclusions. -/\ntheorem uhfStageRep_compat (n m : ℕ) (h : n ≤ m) (x : QubitTensorPower n) :\n    uhfStageRep m (qubitTensorPowerMap n m h x) = uhfStageRep n x := by\n  show uhfRep (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) m\n      (qubitTensorPowerMap n m h x)) = uhfRep _\n  rw [qubitStage_compat]\n  rfl\n\n/-- Every finite-stage representation is injective. -/\ntheorem uhfStageRep_injective (n : ℕ) : Function.Injective (uhfStageRep n) :=\n  uhfRep_injective.comp (qubitStage_injective n)\n\n/-- **The constructed compatible finite-stage representation data.**  This\ninstantiates the (previously only conditional) interface\n`QubitOperatorRepresentationData` with an actual Hilbert space and actual\nfinite-stage representations: nothing here is supplied input. -/\nnoncomputable def uhfRepData : QubitOperatorRepresentationData UHFGNS where\n  rho := uhfStageRep\n  compat := uhfStageRep_compat\n\n@[simp] theorem uhfRepData_rho (n : ℕ) : uhfRepData.rho n = uhfStageRep n := rfl\n\n/-- Each stage representation of the constructed data is injective. -/\ntheorem uhfRepData_rho_injective (n : ℕ) : Function.Injective (uhfRepData.rho n) :=\n  uhfStageRep_injective n\n\n/-- The limit representation induced by the constructed finite-stage data is\nthe trace-GNS representation `uhfRep`. -/\ntheorem uhfRepData_limitRep : uhfRepData.limitRep = uhfRep :=\n  (uhfRepData.limitRep_unique uhfRep (fun _ _ => rfl)).symm\n\n/-- **Faithfulness of the induced limit representation.** -/\ntheorem uhfRepData_limitRep_injective : Function.Injective uhfRepData.limitRep := by\n  rw [uhfRepData_limitRep]\n  exact uhfRep_injective\n\nend FiniteStages\n\n/-! ## 8. The concrete C*-algebra generated by the reference representation -/\n\nsection ConcreteCStar\n\n/-- The concrete C*-algebra of the reference representation: the closure of the\noperator range of `uhfRep` inside the bounded operators on the GNS Hilbert\nspace.  This is a genuine C*-algebra, obtained without postulating any\ncompletion. -/\nnoncomputable def UHFConcreteCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS) :=\n  uhfRep.range.topologicalClosure\n\ninstance : IsClosed ((UHFConcreteCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS)) :\n    Set (UHFGNS →L[ℂ] UHFGNS)) :=\n  uhfRep.range.isClosed_topologicalClosure\n\nnoncomputable instance : CStarAlgebra UHFConcreteCStar := StarSubalgebra.cstarAlgebra _\n\ntheorem uhfRep_mem_concreteCStar (z : QubitUHFAlgebra) : uhfRep z ∈ UHFConcreteCStar :=\n  uhfRep.range.le_topologicalClosure ⟨z, rfl⟩\n\n/-- The canonical star-algebra homomorphism of the algebraic dyadic limit into\nits concrete C*-model. -/\nnoncomputable def uhfConcreteEmbedding : QubitUHFAlgebra →⋆ₐ[ℂ] UHFConcreteCStar :=\n  uhfRep.codRestrict UHFConcreteCStar uhfRep_mem_concreteCStar\n\n@[simp] theorem coe_uhfConcreteEmbedding (z : QubitUHFAlgebra) :\n    (uhfConcreteEmbedding z : UHFGNS →L[ℂ] UHFGNS) = uhfRep z := rfl\n\ntheorem uhfConcreteEmbedding_injective : Function.Injective uhfConcreteEmbedding := by\n  intro z w h\n  exact uhfRep_injective (congrArg Subtype.val h)\n\n/-- The image of the algebraic dyadic limit is dense in its concrete\nC*-model. -/\ntheorem uhfConcreteEmbedding_denseRange : DenseRange uhfConcreteEmbedding := by\n  have hcoe : ((UHFConcreteCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS)) :\n      Set (UHFGNS →L[ℂ] UHFGNS)) = closure (Set.range ⇑uhfRep) := by\n    rw [UHFConcreteCStar, StarSubalgebra.topologicalClosure_coe]\n    rfl\n  rw [DenseRange, Subtype.dense_iff]\n  intro x hx\n  rw [hcoe] at hx\n  refine closure_mono ?_ hx\n  rintro _ ⟨z, rfl⟩\n  exact ⟨uhfConcreteEmbedding z, ⟨z, rfl⟩, rfl⟩\n\n/-- Minimality of the concrete C*-model. -/\ntheorem uhfConcreteCStar_le {S : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS)}\n    (hS : IsClosed (S : Set (UHFGNS →L[ℂ] UHFGNS))) (hrange : ∀ z, uhfRep z ∈ S) :\n    UHFConcreteCStar ≤ S :=\n  StarSubalgebra.topologicalClosure_minimal (by rintro _ ⟨z, rfl⟩; exact hrange z) hS\n\nend ConcreteCStar\n\nend StabilizerHyperfinite\n","exit_code":0,"status":"completed"}}
