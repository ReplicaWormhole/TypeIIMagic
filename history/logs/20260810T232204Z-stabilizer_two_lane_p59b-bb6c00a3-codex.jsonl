{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'q=aristotle_responses/P59B-mixed-gns-uhf-bridge-60d29fa6-bb6c00a3-quarantine/aristotle-stabilizer_two_lane_p59b-thb65jjn_aristotle\nc=\"$q/AristotleCandidates/MixedGNSUHFBridge.lean\"\nwc -l \"$c\"\nsed -n '\"'1,360p' \\\"\"'$c\"\nprintf '\"'\\\\n-- archive/live predecessor hashes --\\\\n'\nsha256sum \\\"\"'$q/AristotleCandidates/ConcretePureMixedProductData.lean\" AristotleCandidates/ConcretePureMixedProductData.lean \"$q/AristotleCandidates/MixedUHFHyperfiniteFactor.lean\" AristotleCandidates/MixedUHFHyperfiniteFactor.lean\nprintf '\"'\\\\n-- candidate placeholder/scope scan --\\\\n'\nrg -n -i '\\\\b(sorry|admit|axiom|opaque|unsafe|implemented_by|native_decide|factor|trace|weight|regional|pure)\\\\b' \\\"\"'$c\" || true\nprintf '\"'\\\\n-- candidate imports and declaration heads --\\\\n'\nrg -n '\"'^(import|namespace|structure|def |theorem |lemma |abbrev |class |instance)'\"' \\\"\"'$c\"'","aggregated_output":"1278 aristotle_responses/P59B-mixed-gns-uhf-bridge-60d29fa6-bb6c00a3-quarantine/aristotle-stabilizer_two_lane_p59b-thb65jjn_aristotle/AristotleCandidates/MixedGNSUHFBridge.lean\nimport AristotleCandidates.ConcretePureMixedProductData\nimport AristotleCandidates.MixedUHFHyperfiniteFactor\n\n/-!\n# P59B — the mixed GNS / UHF bridge\n\n**Context declaration.**  *Source basis:* `main.tex:1945-1967`.\n\n## Plan alignment\n\n* Package `P59B`, lane `H`; predecessors `P59A`\n  (`AristotleCandidates.ConcretePureMixedProductData`) and `P58`\n  (`AristotleCandidates.MixedUHFHyperfiniteFactor`), both integrated and\n  locally audited.\n* Gate discharged: identify the concrete **mixed** component of the P59A\n  product datum with P58's dyadic-UHF model and transport P58's factor and\n  tracial structure to it.\n* Forbidden downstream claims, none of which is made here: no pure type-I\n  factor, no regional product transport, no trace/weight dichotomy, and no\n  fresh mixed-factor premise.\n-/\n\nset_option maxHeartbeats 1000000\nset_option synthInstance.maxHeartbeats 400000\n\nnamespace StabilizerHyperfinite\n\nopen scoped InnerProductSpace ComplexOrder\n\nnamespace UHFBridge\n\nopen LocalHyperbolicAlpha\n\n/-! ## 0. The dyadic Pauli-word basis and the word trace -/\n\nsection DyadicWords\n\nvariable {k : ℕ}\n\n/-- The register matrix model of a dyadic stage, as a complex-linear\nequivalence. -/\nnoncomputable def qubitMatrixLinearEquiv (k : ℕ) :\n    QubitTensorPower k ≃ₗ[ℂ] Matrix (Reg (Fin k)) (Reg (Fin k)) ℂ :=\n  { qubitMatrixEquiv k with map_smul' := fun c x => map_smul (qubitMatrixEquiv k) c x }\n\n@[simp] theorem qubitMatrixLinearEquiv_apply (x : QubitTensorPower k) :\n    qubitMatrixLinearEquiv k x = qubitMatrixEquiv k x := rfl\n\n/-- The standard Pauli words form a complex basis of the dyadic stage. -/\nnoncomputable def qubitWordBasis (k : ℕ) :\n    Module.Basis (Reg (Fin k) × Reg (Fin k)) ℂ (QubitTensorPower k) :=\n  stdWordBasis.map (qubitMatrixLinearEquiv k).symm\n\n@[simp] theorem qubitWordBasis_apply (p : Reg (Fin k) × Reg (Fin k)) :\n    qubitWordBasis k p = qubitWord k p.1 p.2 := by\n  refine qubitMatrixEquiv_injective k ?_\n  show qubitMatrixEquiv k ((qubitMatrixLinearEquiv k).symm (stdWordBasis p)) =\n      qubitMatrixEquiv k (qubitWord k p.1 p.2)\n  rw [stdWordBasis_apply, qubitMatrixEquiv_qubitWord]\n  exact (qubitMatrixLinearEquiv k).apply_symm_apply _\n\n/-- The multiplication rule of the standard dyadic Pauli words. -/\ntheorem qubitWord_mul (k : ℕ) (a b a' b' : Reg (Fin k)) :\n    qubitWord k a b * qubitWord k a' b' =\n      pauliSign (regPairing b a') • qubitWord k (a + a') (b + b') := by\n  refine qubitMatrixEquiv_injective k ?_\n  dsimp only\n  rw [map_mul, map_smul, qubitMatrixEquiv_qubitWord, qubitMatrixEquiv_qubitWord,\n    qubitMatrixEquiv_qubitWord, stdWord_mul]\n\n/-- Every element of the algebraic dyadic limit is the image of a finite\nstage, phrased with the canonical stage map `qubitUHFOf`. -/\ntheorem exists_qubitUHFOf (z : QubitUHFAlgebra) :\n    ∃ (n : ℕ) (x : QubitTensorPower n), z = qubitUHFOf n x := by\n  induction z using DirectLimit.induction with\n  | _ i x => exact ⟨i, x, rfl⟩\n\ntheorem card_reg (k : ℕ) : Fintype.card (Reg (Fin k)) = 2 ^ k := by\n  simp [Reg, PauliBit]\n\ntheorem regSuccEquiv_apply (k : ℕ) (i : Fin 2) (t : Reg (Fin k)) :\n    regSuccEquiv k (i, t) = Fin.cons (bitEquiv i) t := rfl\n\n/-- The normalized dyadic trace is the normalized matrix trace of the register\nmatrix model. -/\ntheorem qubitTensorTrace_eq_regTrace : ∀ (k : ℕ) (x : QubitTensorPower k),\n    qubitTensorTrace k x =\n      ((2 ^ k : ℕ) : ℂ)⁻¹ * Matrix.trace (qubitMatrixEquiv k x)\n  | 0, x => by\n      show scalarTrace x = _\n      have : Matrix.trace (qubitMatrixEquiv 0 x) = x := by\n        rw [Matrix.trace]\n        rw [Finset.sum_eq_single (0 : Reg (Fin 0))]\n        · show (scalarMatrixStarEquiv (Reg (Fin 0)) x) 0 0 = x\n          rw [scalarMatrixStarEquiv_apply]\n        · intro c _ hc\n          exact absurd (Subsingleton.elim _ _) hc\n        · intro h; exact absurd (Finset.mem_univ _) h\n      rw [this]\n      simp [scalarTrace]\n  | k + 1, x => by\n      have hne : ((2 ^ k : ℕ) : ℂ) ≠ 0 := by exact_mod_cast (Nat.two_pow_pos k).ne'\n      show normalizedMatrixTraceOver (Fin 2) (qubitTensorTrace k) x = _\n      rw [normalizedMatrixTraceOver_apply]\n      have htr : Matrix.trace (qubitMatrixEquiv (k + 1) x) =\n          ∑ p : Fin 2 × Reg (Fin k), qubitMatrixEquiv k (x p.1 p.1) p.2 p.2 := by\n        rw [Matrix.trace]\n        rw [← Equiv.sum_comp (regSuccEquiv k)\n          (fun y => Matrix.diag (qubitMatrixEquiv (k + 1) x) y)]\n        refine Finset.sum_congr rfl (fun p _ => ?_)\n        show qubitMatrixEquiv (k + 1) x (regSuccEquiv k p) (regSuccEquiv k p) = _\n        rw [qubitMatrixEquiv_succ_apply]\n        obtain ⟨i, t⟩ := p\n        rw [regSuccEquiv_apply]\n        simp\n      rw [htr, Fintype.sum_prod_type]\n      have hsum : ∀ i : Fin 2, ∑ t : Reg (Fin k), qubitMatrixEquiv k (x i i) t t\n          = ((2 ^ k : ℕ) : ℂ) * qubitTensorTrace k (x i i) := by\n        intro i\n        rw [qubitTensorTrace_eq_regTrace k (x i i)]\n        field_simp\n        rfl\n      simp only [hsum]\n      rw [← Finset.mul_sum]\n      have h2 : ((2 ^ (k + 1) : ℕ) : ℂ) = 2 * ((2 ^ k : ℕ) : ℂ) := by push_cast; ring\n      rw [h2]\n      simp only [Fintype.card_fin]\n      field_simp\n      ring\n\n/-- **The dyadic trace of a Pauli word** is `1` on the identity word and `0` on\nevery other word. -/\ntheorem qubitTensorTrace_qubitWord (k : ℕ) (a b : Reg (Fin k)) :\n    qubitTensorTrace k (qubitWord k a b) = if a = 0 ∧ b = 0 then 1 else 0 := by\n  rw [qubitTensorTrace_eq_regTrace, qubitMatrixEquiv_qubitWord, trace_stdWord, card_reg]\n  have hne : ((2 ^ k : ℕ) : ℂ) ≠ 0 := by exact_mod_cast (Nat.two_pow_pos k).ne'\n  split_ifs with h\n  · exact inv_mul_cancel₀ hne\n  · rw [mul_zero]\n\nend DyadicWords\n\nend UHFBridge\n\n/-! ## 1. Mixed coordinate registers\n\nA **mixed register** is the explicit coordinate-index identification required by\nthe packet: an injective list of `k` *unselected* (mixed) coordinates of the\nP52/P53 model, together with a stage of the coordinate exhaustion containing\nall of them. -/\n\nnamespace LocalHyperbolicAlpha\n\nnamespace AlphaData\n\nopen CoherentLocalHyperbolic UHFBridge\n\nvariable {L I : Type*} [LinearOrder I] (A : AlphaData L I)\n\n/-- **The coordinate-index identification.**  `k` distinct mixed (unselected)\ncoordinates of the local-hyperbolic model, all visible at one stage of the\ncoordinate exhaustion. -/\nstructure MixedRegister (k : ℕ) where\n  /-- the chosen mixed coordinates -/\n  coord : Fin k → I\n  /-- they are distinct -/\n  coord_injective : Function.Injective coord\n  /-- none of them is selected: they carry the maximally mixed factor -/\n  coord_not_selected : ∀ j, coord j ∉ A.family.selected\n  /-- a stage of the exhaustion containing all of them -/\n  stage : ℕ\n  /-- all chosen coordinates are visible at that stage -/\n  coord_mem_block : ∀ j, coord j ∈ A.family.coordinateBlock A.exhaustion stage\n\n/-- Additivity of a Pauli form in the left argument over a finite sum. -/\ntheorem pauliForm_sum_left {V : Type*} [AddCommGroup V] (B : PauliForm V) {J : Type*}\n    (s : Finset J) (f : J → V) (w : V) :\n    B.form (∑ j ∈ s, f j) w = ∑ j ∈ s, B.form (f j) w := by\n  classical\n  induction s using Finset.induction_on with\n  | empty => simp [B.zero_left]\n  | insert a s ha ih =>\n      rw [Finset.sum_insert ha, B.add_left, ih, Finset.sum_insert ha]\n\n/-- The value of the coordinate pairing on a single generator. -/\ntheorem coordPairing_single {J : Type*} (p : J ⊕ J) (c : PauliBit)\n    (w : PauliCoordinateLabels J) :\n    (coordPairing J).form (Finsupp.single p c) w =\n      c * Sum.elim (fun i => w (Sum.inr i)) (fun _ => (0 : PauliBit)) p := by\n  show (Finsupp.single p c).sum\n      (fun q d => d * Sum.elim (fun i => w (Sum.inr i)) (fun _ => (0 : PauliBit)) q) = _\n  rw [Finsupp.sum_single_index]\n  rw [zero_mul]\n\nnamespace MixedRegister\n\nvariable {A} {k : ℕ} (E : A.MixedRegister k)\n\n/-- The coordinate Pauli label of the register word `X^a Z^b`. -/\nnoncomputable def label (a b : Reg (Fin k)) : PauliCoordinateLabels I :=\n  ∑ j : Fin k,\n    (Finsupp.single (Sum.inl (E.coord j)) (b j) + Finsupp.single (Sum.inr (E.coord j)) (a j))\n\ntheorem label_apply_inl (a b : Reg (Fin k)) (i : I) :\n    E.label a b (Sum.inl i) = ∑ j : Fin k, if E.coord j = i then b j else 0 := by\n  classical\n  rw [label, Finsupp.finset_sum_apply]\n  refine Finset.sum_congr rfl fun j _ => ?_\n  rw [Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply]\n  simp\n\ntheorem label_apply_inr (a b : Reg (Fin k)) (i : I) :\n    E.label a b (Sum.inr i) = ∑ j : Fin k, if E.coord j = i then a j else 0 := by\n  classical\n  rw [label, Finsupp.finset_sum_apply]\n  refine Finset.sum_congr rfl fun j _ => ?_\n  rw [Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply]\n  simp\n\ntheorem label_apply_inl_coord (a b : Reg (Fin k)) (j : Fin k) :\n    E.label a b (Sum.inl (E.coord j)) = b j := by\n  classical\n  rw [label_apply_inl]\n  rw [Finset.sum_eq_single j]\n  · rw [if_pos rfl]\n  · intro j' _ hj'\n    rw [if_neg (fun h => hj' (E.coord_injective h))]\n  · intro h\n    exact absurd (Finset.mem_univ j) h\n\ntheorem label_apply_inr_coord (a b : Reg (Fin k)) (j : Fin k) :\n    E.label a b (Sum.inr (E.coord j)) = a j := by\n  classical\n  rw [label_apply_inr]\n  rw [Finset.sum_eq_single j]\n  · rw [if_pos rfl]\n  · intro j' _ hj'\n    rw [if_neg (fun h => hj' (E.coord_injective h))]\n  · intro h\n    exact absurd (Finset.mem_univ j) h\n\ntheorem label_apply_inl_of_ne {i : I} (a b : Reg (Fin k)) (h : ∀ j, E.coord j ≠ i) :\n    E.label a b (Sum.inl i) = 0 := by\n  classical\n  rw [label_apply_inl]\n  exact Finset.sum_eq_zero fun j _ => if_neg (h j)\n\ntheorem label_apply_inr_of_ne {i : I} (a b : Reg (Fin k)) (h : ∀ j, E.coord j ≠ i) :\n    E.label a b (Sum.inr i) = 0 := by\n  classical\n  rw [label_apply_inr]\n  exact Finset.sum_eq_zero fun j _ => if_neg (h j)\n\n/-- Every coordinate touched by a register word is one of the register's\ncoordinates. -/\ntheorem exists_coord_of_ne_zero {a b : Reg (Fin k)} {p : I ⊕ I} (hp : E.label a b p ≠ 0) :\n    ∃ j, site p = E.coord j := by\n  by_contra hcon\n  push_neg at hcon\n  have h : ∀ j, E.coord j ≠ site p := fun j hj => hcon j hj.symm\n  cases p with\n  | inl i =>\n      exact hp (E.label_apply_inl_of_ne a b (i := i) h)\n  | inr i =>\n      exact hp (E.label_apply_inr_of_ne a b (i := i) h)\n\n@[simp] theorem label_zero : E.label 0 0 = 0 := by\n  rw [label]\n  refine Finset.sum_eq_zero fun j _ => ?_\n  show Finsupp.single (Sum.inl (E.coord j)) ((0 : Reg (Fin k)) j)\n      + Finsupp.single (Sum.inr (E.coord j)) ((0 : Reg (Fin k)) j) = 0\n  simp\n\ntheorem label_add (a b a' b' : Reg (Fin k)) :\n    E.label (a + a') (b + b') = E.label a b + E.label a' b' := by\n  rw [label, label, label, ← Finset.sum_add_distrib]\n  refine Finset.sum_congr rfl fun j _ => ?_\n  show Finsupp.single (Sum.inl (E.coord j)) (b j + b' j)\n      + Finsupp.single (Sum.inr (E.coord j)) (a j + a' j) = _\n  rw [Finsupp.single_add, Finsupp.single_add]\n  abel\n\n/-- A register word is a mixed coordinate word in the sense of P59A. -/\ntheorem isMixedLabel_label (a b : Reg (Fin k)) : A.IsMixedLabel (E.label a b) := by\n  intro p hp\n  obtain ⟨j, hj⟩ := E.exists_coord_of_ne_zero hp\n  rw [hj]\n  exact E.coord_not_selected j\n\n/-- A register word is a stage label at the register's stage. -/\ntheorem label_mem_sourceLabel (a b : Reg (Fin k)) : E.label a b ∈ A.SourceLabel E.stage := by\n  rw [CoherentLocalHyperbolic.LocalHyperbolicFamily.mem_sourceLabels_iff]\n  intro p hp\n  obtain ⟨j, hj⟩ := E.exists_coord_of_ne_zero (Finsupp.mem_support_iff.mp hp)\n  rw [hj]\n  exact E.coord_mem_block j\n\n/-- The register word as a stage label. -/\nnoncomputable def stageLabel (a b : Reg (Fin k)) : A.SourceLabel E.stage :=\n  ⟨E.label a b, E.label_mem_sourceLabel a b⟩\n\n@[simp] theorem stageLabel_coe (a b : Reg (Fin k)) :\n    ((E.stageLabel a b : A.SourceLabel E.stage) : PauliCoordinateLabels I) = E.label a b := rfl\n\n/-- **The Pauli cocycle of the register words is the standard register\ncocycle.**  This is why no phase correction is needed in the mixed bridge. -/\ntheorem sourceForm_stageLabel (a b a' b' : Reg (Fin k)) :\n    (A.sourceForm E.stage).form (E.stageLabel a b) (E.stageLabel a' b') = regPairing b a' := by\n  classical\n  show (coordPairing I).form (E.label a b) (E.label a' b') = regPairing b a'\n  rw [label, pauliForm_sum_left]\n  rw [regPairing]\n  refine Finset.sum_congr rfl fun j _ => ?_\n  rw [(coordPairing I).add_left, coordPairing_single, coordPairing_single]\n  show b j * (E.label a' b') (Sum.inr (E.coord j)) + a j * (0 : PauliBit) = b j * a' j\n  rw [E.label_apply_inr_coord, mul_zero, add_zero]\n\n/-! ## 2. The register word operators inside the P55D concrete C⋆-algebra -/\n\nsection WordOps\n\nvariable (R : A.SourceConcreteRep)\n\n/-- The concrete operator of a register Pauli word `X^a Z^b`. -/\nnoncomputable def wordOp (a b : Reg (Fin k)) : R.sourceCStar :=\n  R.wordElt E.stage (E.stageLabel a b)\n\ntheorem stageLabel_add (a b a' b' : Reg (Fin k)) :\n    E.stageLabel a b + E.stageLabel a' b' = E.stageLabel (a + a') (b + b') :=\n  Subtype.ext (by\n    show E.label a b + E.label a' b' = E.label (a + a') (b + b')\n    rw [E.label_add])\n\n@[simp] theorem wordOp_zero_zero : E.wordOp R 0 0 = 1 := by\n  have h : E.stageLabel (0 : Reg (Fin k)) 0 = 0 := Subtype.ext E.label_zero\n  rw [wordOp, h, R.wordElt_zero]\n\ntheorem wordOp_mul (a b a' b' : Reg (Fin k)) :\n    E.wordOp R a b * E.wordOp R a' b' =\n      pauliSign (regPairing b a') • E.wordOp R (a + a') (b + b') := by\n  rw [wordOp, wordOp, R.wordElt_mul, E.sourceForm_stageLabel, E.stageLabel_add]\n  rfl\n\ntheorem wordOp_star (a b : Reg (Fin k)) :\n    star (E.wordOp R a b) = pauliSign (regPairing a b) • E.wordOp R a b := by\n  rw [wordOp, R.wordElt_star, E.sourceForm_stageLabel, regPairing_comm b a]\n\ntheorem wordOp_mem_mixedCStar (a b : Reg (Fin k)) : E.wordOp R a b ∈ R.mixedCStar :=\n  R.wordElt_mem_mixedCStar (E.isMixedLabel_label a b)\n\n/-- Register words with the same coordinate label are the same operator, even\nwhen the two registers are recorded at different stages of the exhaustion. -/\ntheorem wordOp_eq_of_label_eq {k' : ℕ} (E' : A.MixedRegister k') {a b : Reg (Fin k)}\n    {a' b' : Reg (Fin k')} (hlab : E'.label a' b' = E.label a b) :\n    E'.wordOp R a' b' = E.wordOp R a b := by\n  have h1 : E.stage ≤ max E.stage E'.stage := le_max_left _ _\n  have h2 : E'.stage ≤ max E.stage E'.stage := le_max_right _ _\n  have h3 : A.sourceIncl h2 (E'.stageLabel a' b') = A.sourceIncl h1 (E.stageLabel a b) := by\n    refine Subtype.ext ?_\n    rw [A.sourceIncl_coe, A.sourceIncl_coe, stageLabel_coe, stageLabel_coe]\n\n-- archive/live predecessor hashes --\n8e646687234146d34a1e27c63eb8c65ddbe9cfc5