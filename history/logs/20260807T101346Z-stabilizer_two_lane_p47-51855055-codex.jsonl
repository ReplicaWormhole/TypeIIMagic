{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"candidate_path='aristotle_responses/P47-extracted/aristotle-stabilizer_two_lane_p47-80u8nxnx_aristotle/AristotleCandidates/CenterFiniteProjectionCore.lean'; nl -ba \\\"\"'$candidate_path\" | sed -n '\"'300,760p'; printf '\\\\n--- Declaration index ---\\\\n'; rg -n '\"'^(noncomputable )?(def|theorem|protected theorem|lemma|abbrev|instance) '\"' \\\"\"'$candidate_path\"; printf '\"'\\\\n--- Full policy scan ---\\\\n'; rg -n -i '\\\\b(sorry|admit|axiom|opaque|unsafe|implemented_by|native_decide)\\\\b' \\\"\"'$candidate_path\" || true; printf '\"'\\\\n--- Imports ---\\\\n'; rg -n '\"'^import '\"' \\\"\"'$candidate_path\"'","aggregated_output":"   300\t\n   301\tprotected theorem refl (hp : M.IsProjection p) : M.MvNEquiv p p :=\n   302\t  ⟨p, hp.2, by rw [hp.star_eq, hp.mul_self], by rw [hp.star_eq, hp.mul_self]⟩\n   303\t\n   304\tprotected theorem symm (h : M.MvNEquiv p q) : M.MvNEquiv q p := by\n   305\t  obtain ⟨v, hv, h1, h2⟩ := h\n   306\t  exact ⟨star v, star_mem hv, by rwa [star_star], by rwa [star_star]⟩\n   307\t\n   308\tprotected theorem trans (hp : IsIdempotentElem p) (hr : IsIdempotentElem r)\n   309\t    (hpq : M.MvNEquiv p q) (hqr : M.MvNEquiv q r) : M.MvNEquiv p r := by\n   310\t  obtain ⟨v, hv, hv1, hv2⟩ := hpq\n   311\t  obtain ⟨w, hw, hw1, hw2⟩ := hqr\n   312\t  refine ⟨w * v, mul_mem hw hv, ?_, ?_⟩\n   313\t  · have h1 : star (w * v) * (w * v) = star v * ((star w * w) * v) := by\n   314\t      rw [star_mul]; noncomm_ring\n   315\t    rw [h1, hw1, ← hv2, show star v * (v * star v * v) = (star v * v) * (star v * v) from by\n   316\t      noncomm_ring, hv1]\n   317\t    exact hp\n   318\t  · have h1 : (w * v) * star (w * v) = w * ((v * star v) * star w) := by\n   319\t      rw [star_mul]; noncomm_ring\n   320\t    rw [h1, hv2, ← hw1, show w * (star w * w * star w) = (w * star w) * (w * star w) from by\n   321\t      noncomm_ring, hw2]\n   322\t    exact hr\n   323\t\n   324\t/-- The right-hand endpoint of an equivalence starting at a projection is again a\n   325\tprojection. -/\n   326\ttheorem isProjection_right (hp : M.IsProjection p) (h : M.MvNEquiv p q) : M.IsProjection q := by\n   327\t  obtain ⟨v, hv, hv1, hv2⟩ := h\n   328\t  have hidem : IsIdempotentElem (star v * v) := by rw [hv1]; exact hp.mul_self\n   329\t  have hvp : v * (star v * v) = v := mul_star_mul_self_eq_self hidem\n   330\t  refine ⟨⟨?_, ?_⟩, hv2 ▸ mul_mem hv (star_mem hv)⟩\n   331\t  · show q * q = q\n   332\t    rw [← hv2, show (v * star v) * (v * star v) = (v * (star v * v)) * star v from by\n   333\t      noncomm_ring, hvp]\n   334\t  · show star q = q\n   335\t    rw [← hv2, star_mul, star_star]\n   336\t\n   337\ttheorem isProjection_left (hq : M.IsProjection q) (h : M.MvNEquiv p q) : M.IsProjection p :=\n   338\t  isProjection_right hq h.symm\n   339\t\n   340\ttheorem right_eq_zero (h : M.MvNEquiv 0 q) : q = 0 := by\n   341\t  obtain ⟨v, _, hv1, hv2⟩ := h\n   342\t  have : v = 0 := (CStarRing.star_mul_self_eq_zero_iff _).mp hv1\n   343\t  rw [← hv2, this]\n   344\t  simp\n   345\t\n   346\ttheorem left_eq_zero (h : M.MvNEquiv p 0) : p = 0 := right_eq_zero h.symm\n   347\t\n   348\tend MvNEquiv\n   349\t\n   350\t/-- Conjugating a subprojection `r₁ ≤ q` by a partial isometry `w` implementing `q ~ w star w`\n   351\tproduces an equivalent subprojection of `w star w`.  This is the basic transport step of\n   352\tcomparison theory. -/\n   353\ttheorem conj_isProjection_of_projLe {M : VonNeumannAlgebra H} {q r₁ w : H →L[ℂ] H}\n   354\t    (hw : w ∈ M) (hw1 : star w * w = q) (hr₁ : M.IsProjection r₁) (hr₁q : ProjLe r₁ q) :\n   355\t    M.IsProjection (w * r₁ * star w) ∧ M.MvNEquiv r₁ (w * r₁ * star w) ∧\n   356\t      ProjLe (w * r₁ * star w) (w * star w) := by\n   357\t  have hidem : (w * r₁ * star w) * (w * r₁ * star w) = w * r₁ * star w := by\n   358\t    rw [show (w * r₁ * star w) * (w * r₁ * star w) = w * ((r₁ * (star w * w)) * r₁) * star w from\n   359\t      by noncomm_ring, hw1, hr₁q.1, hr₁.mul_self]\n   360\t  have hsa : star (w * r₁ * star w) = w * r₁ * star w := by\n   361\t    rw [star_mul, star_mul, star_star, hr₁.star_eq, mul_assoc]\n   362\t  refine ⟨⟨⟨hidem, hsa⟩, mul_mem (mul_mem hw hr₁.2) (star_mem hw)⟩, ⟨w * r₁,\n   363\t    mul_mem hw hr₁.2, ?_, ?_⟩, ?_, ?_⟩\n   364\t  · rw [show star (w * r₁) * (w * r₁) = (star r₁ * (star w * w)) * r₁ from by\n   365\t      rw [star_mul]; noncomm_ring, hw1, hr₁.star_eq, hr₁q.1, hr₁.mul_self]\n   366\t  · rw [show (w * r₁) * star (w * r₁) = w * (r₁ * star r₁) * star w from by\n   367\t      rw [star_mul]; noncomm_ring, hr₁.star_eq, hr₁.mul_self]\n   368\t  · rw [show (w * r₁ * star w) * (w * star w) = w * (r₁ * (star w * w)) * star w from by\n   369\t      noncomm_ring, hw1, hr₁q.1]\n   370\t  · rw [show (w * star w) * (w * r₁ * star w) = w * ((star w * w) * r₁) * star w from by\n   371\t      noncomm_ring, hw1, hr₁q.2]\n   372\t\n   373\tnamespace MvNLe\n   374\t\n   375\tvariable {M : VonNeumannAlgebra H} {p q r : H →L[ℂ] H}\n   376\t\n   377\ttheorem of_mvNEquiv (hq : M.IsProjection q) (h : M.MvNEquiv p q) : M.MvNLe p q :=\n   378\t  ⟨q, hq, ProjLe.refl hq.mul_self, h⟩\n   379\t\n   380\ttheorem of_projLe (hp : M.IsProjection p) (h : ProjLe p q) : M.MvNLe p q :=\n   381\t  ⟨p, hp, h, MvNEquiv.refl hp⟩\n   382\t\n   383\tprotected theorem refl (hp : M.IsProjection p) : M.MvNLe p p :=\n   384\t  of_projLe hp (ProjLe.refl hp.mul_self)\n   385\t\n   386\tprotected theorem trans (hp : M.IsProjection p) (hpq : M.MvNLe p q) (hqr : M.MvNLe q r) :\n   387\t    M.MvNLe p r := by\n   388\t  obtain ⟨r₁, hr₁, hr₁q, hpr₁⟩ := hpq\n   389\t  obtain ⟨r₂, hr₂, hr₂r, hqr₂⟩ := hqr\n   390\t  obtain ⟨w, hw, hw1, hw2⟩ := hqr₂\n   391\t  obtain ⟨hs, hequiv, hsle⟩ := conj_isProjection_of_projLe hw hw1 hr₁ hr₁q\n   392\t  refine ⟨w * r₁ * star w, hs, ProjLe.trans (hw2 ▸ hsle) hr₂r, ?_⟩\n   393\t  exact MvNEquiv.trans hp.mul_self hs.mul_self hpr₁ hequiv\n   394\t\n   395\tend MvNLe\n   396\t\n   397\t/-! ### Finite projections -/\n   398\t\n   399\t/-- A projection of `M` is **finite** when it is not Murray--von Neumann equivalent to a\n   400\tproper subprojection of itself. -/\n   401\tdef IsFiniteProjection (M : VonNeumannAlgebra H) (p : H →L[ℂ] H) : Prop :=\n   402\t  M.IsProjection p ∧\n   403\t    ∀ q, M.IsProjection q → ProjLe q p → M.MvNEquiv p q → q = p\n   404\t\n   405\ttheorem IsFiniteProjection.isProjection {M : VonNeumannAlgebra H} {p : H →L[ℂ] H}\n   406\t    (hp : M.IsFiniteProjection p) : M.IsProjection p := hp.1\n   407\t\n   408\ttheorem isFiniteProjection_zero (M : VonNeumannAlgebra H) : M.IsFiniteProjection 0 :=\n   409\t  ⟨M.isProjection_zero, fun q _ hq _ => by simpa using hq.1.symm⟩\n   410\t\n   411\t/-- The \"final projection\" form of `mul_star_mul_self_eq_self`. -/\n   412\ttheorem star_mul_self_mul_eq_self {v : H →L[ℂ] H} (h : IsIdempotentElem (v * star v)) :\n   413\t    (v * star v) * v = v := by\n   414\t  have h' : IsIdempotentElem (star (star v) * star v) := by simpa using h\n   415\t  have h1 := mul_star_mul_self_eq_self h'\n   416\t  simp only [star_star] at h1\n   417\t  have h2 := congrArg star h1\n   418\t  simpa [star_mul, mul_assoc] using h2\n   419\t\n   420\t/-- Orthogonal sums of Murray--von Neumann equivalences are equivalences. -/\n   421\ttheorem MvNEquiv.add {M : VonNeumannAlgebra H} {p₁ q₁ p₂ q₂ : H →L[ℂ] H}\n   422\t    (hp₁ : M.IsProjection p₁) (hp₂ : M.IsProjection p₂)\n   423\t    (h₁ : M.MvNEquiv p₁ q₁) (h₂ : M.MvNEquiv p₂ q₂)\n   424\t    (hp : p₁ * p₂ = 0) (hq : q₁ * q₂ = 0) : M.MvNEquiv (p₁ + p₂) (q₁ + q₂) := by\n   425\t  obtain ⟨v, hv, hv1, hv2⟩ := h₁\n   426\t  obtain ⟨w, hw, hw1, hw2⟩ := h₂\n   427\t  have hq₁ : M.IsProjection q₁ := MvNEquiv.isProjection_right hp₁ ⟨v, hv, hv1, hv2⟩\n   428\t  have hq₂ : M.IsProjection q₂ := MvNEquiv.isProjection_right hp₂ ⟨w, hw, hw1, hw2⟩\n   429\t  -- `v` and `w` are partial isometries with the indicated initial and final projections\n   430\t  have hvp : v * p₁ = v := by\n   431\t    rw [← hv1]\n   432\t    exact mul_star_mul_self_eq_self (show IsIdempotentElem (star v * v) by\n   433\t      rw [hv1]; exact hp₁.mul_self)\n   434\t  have hwp : w * p₂ = w := by\n   435\t    rw [← hw1]\n   436\t    exact mul_star_mul_self_eq_self (show IsIdempotentElem (star w * w) by\n   437\t      rw [hw1]; exact hp₂.mul_self)\n   438\t  have hvq : q₁ * v = v := by\n   439\t    rw [← hv2]\n   440\t    exact star_mul_self_mul_eq_self (show IsIdempotentElem (v * star v) by\n   441\t      rw [hv2]; exact hq₁.mul_self)\n   442\t  have hwq : q₂ * w = w := by\n   443\t    rw [← hw2]\n   444\t    exact star_mul_self_mul_eq_self (show IsIdempotentElem (w * star w) by\n   445\t      rw [hw2]; exact hq₂.mul_self)\n   446\t  have e1 : star v * w = 0 := by\n   447\t    conv_lhs => rw [← hvq, ← hwq]\n   448\t    rw [show star (q₁ * v) * (q₂ * w) = star v * ((star q₁ * q₂) * w) from by\n   449\t      rw [star_mul]; noncomm_ring, hq₁.star_eq, hq]\n   450\t    simp\n   451\t  have e2 : star w * v = 0 := by\n   452\t    have := congrArg star e1\n   453\t    rwa [star_mul, star_star, star_zero] at this\n   454\t  have e3 : v * star w = 0 := by\n   455\t    conv_lhs => rw [← hvp, ← hwp]\n   456\t    rw [show (v * p₁) * star (w * p₂) = v * ((p₁ * star p₂) * star w) from by\n   457\t      rw [star_mul]; noncomm_ring, hp₂.star_eq, hp]\n   458\t    simp\n   459\t  have e4 : w * star v = 0 := by\n   460\t    have := congrArg star e3\n   461\t    rwa [star_mul, star_star, star_zero] at this\n   462\t  refine ⟨v + w, add_mem hv hw, ?_, ?_⟩\n   463\t  · rw [star_add, add_mul, mul_add, mul_add, hv1, hw1, e1, e2]\n   464\t    abel\n   465\t  · rw [star_add, add_mul, mul_add, mul_add, hv2, hw2, e3, e4]\n   466\t    abel\n   467\t\n   468\t/-- A central compression of a finite projection is finite. -/\n   469\ttheorem IsFiniteProjection.mul_central {M : VonNeumannAlgebra H} {z p : H →L[ℂ] H}\n   470\t    (hz : M.IsCentralProjection z) (hp : M.IsFiniteProjection p) :\n   471\t    M.IsFiniteProjection (z * p) := by\n   472\t  obtain ⟨hpproj, hpfin⟩ := hp\n   473\t  have hzp : M.IsProjection (z * p) := hz.mul_isProjection hpproj\n   474\t  refine ⟨hzp, fun q hq hqzp hequiv => ?_⟩\n   475\t  set p' : H →L[ℂ] H := (1 - z) * p with hp'\n   476\t  have hz' : M.IsCentralProjection (1 - z) := hz.one_sub\n   477\t  have hp'proj : M.IsProjection p' := hz'.mul_isProjection hpproj\n   478\t  have hcomm : z * p = p * z := hz.commute hpproj.2\n   479\t  have hzq : z * q = q := (hqzp.trans (hz.mul_projLe_left hpproj)).2\n   480\t  have hqz : q * z = z * q := (hz.commute hq.2).symm\n   481\t  have hqp' : q * p' = 0 := by\n   482\t    rw [hp', ← mul_assoc, mul_sub, mul_one, hqz, hzq, sub_self, zero_mul]\n   483\t  have hzpp' : (z * p) * p' = 0 := by\n   484\t    rw [hp', show (z * p) * ((1 - z) * p) = (z * p) * p - (z * (p * z)) * p from by noncomm_ring,\n   485\t      ← hcomm, show (z * (z * p)) * p = (z * z) * (p * p) from by noncomm_ring,\n   486\t      show (z * p) * p = z * (p * p) from by noncomm_ring, hz.1.isIdempotentElem,\n   487\t      hpproj.mul_self, sub_self]\n   488\t  have hsum : z * p + p' = p := by rw [hp']; noncomm_ring\n   489\t  have hqsum : M.IsProjection (q + p') := ⟨hq.1.add hp'proj.1 hqp', add_mem hq.2 hp'proj.2⟩\n   490\t  have hequiv' : M.MvNEquiv p (q + p') := by\n   491\t    rw [← hsum]\n   492\t    exact MvNEquiv.add hzp hp'proj hequiv (MvNEquiv.refl hp'proj) hzpp' hqp'\n   493\t  have hqp : q * p = q := (hqzp.trans (hz.mul_projLe_right hpproj)).1\n   494\t  have hp'p : p' * p = p' := by rw [hp', mul_assoc, hpproj.mul_self]\n   495\t  have hle : ProjLe (q + p') p :=\n   496\t    projLe_of_mul_eq_left hqsum.1 hpproj.1 (by rw [add_mul, hqp, hp'p])\n   497\t  have hfin := hpfin (q + p') hqsum hle hequiv'\n   498\t  have hqval : q = p - p' := by rw [← hfin]; abel\n   499\t  rw [hqval, hp']\n   500\t  noncomm_ring\n   501\t\n   502\t/-! ### Corners -/\n   503\t\n   504\t/-- The **corner** `p M p` of `M` cut down by a self-adjoint element `p`, as a non-unital star\n   505\tsubalgebra of `H →L[ℂ] H`.  When `p` is a projection of `M` this is the usual compressed\n   506\talgebra, with unit `p` (see `VonNeumannAlgebra.corner_eq_image`). -/\n   507\tdef corner (M : VonNeumannAlgebra H) {p : H →L[ℂ] H} (hp : IsSelfAdjoint p) :\n   508\t    NonUnitalStarSubalgebra ℂ (H →L[ℂ] H) where\n   509\t  carrier := {x | x ∈ M ∧ p * x = x ∧ x * p = x}\n   510\t  add_mem' := by\n   511\t    rintro x y ⟨hx, hx1, hx2⟩ ⟨hy, hy1, hy2⟩\n   512\t    exact ⟨add_mem hx hy, by rw [mul_add, hx1, hy1], by rw [add_mul, hx2, hy2]⟩\n   513\t  zero_mem' := ⟨zero_mem M, by simp, by simp⟩\n   514\t  mul_mem' := by\n   515\t    rintro x y ⟨hx, hx1, hx2⟩ ⟨hy, hy1, hy2⟩\n   516\t    exact ⟨mul_mem hx hy, by rw [← mul_assoc, hx1], by rw [mul_assoc, hy2]⟩\n   517\t  smul_mem' := by\n   518\t    rintro c x ⟨hx, hx1, hx2⟩\n   519\t    refine ⟨?_, by rw [mul_smul_comm, hx1], by rw [smul_mul_assoc, hx2]⟩\n   520\t    exact mem_carrier.mp (SMulMemClass.smul_mem c (mem_carrier.mpr hx))\n   521\t  star_mem' := by\n   522\t    rintro x ⟨hx, hx1, hx2⟩\n   523\t    refine ⟨star_mem hx, ?_, ?_⟩\n   524\t    · have h := congrArg star hx2\n   525\t      rwa [star_mul, hp.star_eq] at h\n   526\t    · have h := congrArg star hx1\n   527\t      rwa [star_mul, hp.star_eq] at h\n   528\t\n   529\ttheorem mem_corner_iff {M : VonNeumannAlgebra H} {p x : H →L[ℂ] H} {hp : IsSelfAdjoint p} :\n   530\t    x ∈ M.corner hp ↔ x ∈ M ∧ p * x = x ∧ x * p = x := Iff.rfl\n   531\t\n   532\ttheorem corner_subset {M : VonNeumannAlgebra H} {p : H →L[ℂ] H} {hp : IsSelfAdjoint p} :\n   533\t    (M.corner hp : Set (H →L[ℂ] H)) ⊆ (M : Set (H →L[ℂ] H)) := fun _ hx => hx.1\n   534\t\n   535\ttheorem mul_mul_mem_corner {M : VonNeumannAlgebra H} {p x : H →L[ℂ] H}\n   536\t    (hp : M.IsProjection p) (hx : x ∈ M) : p * x * p ∈ M.corner hp.1.isSelfAdjoint :=\n   537\t  ⟨mul_mem (mul_mem hp.2 hx) hp.2,\n   538\t    by rw [← mul_assoc, ← mul_assoc, hp.mul_self],\n   539\t    by rw [mul_assoc, hp.mul_self]⟩\n   540\t\n   541\t/-- The corner is exactly the set of compressions `p x p`, `x ∈ M`. -/\n   542\ttheorem corner_eq_image {M : VonNeumannAlgebra H} {p : H →L[ℂ] H} (hp : M.IsProjection p) :\n   543\t    (M.corner hp.1.isSelfAdjoint : Set (H →L[ℂ] H)) =\n   544\t      (fun x => p * x * p) '' (M : Set (H →L[ℂ] H)) := by\n   545\t  ext x\n   546\t  constructor\n   547\t  · rintro ⟨hx, hx1, hx2⟩\n   548\t    refine ⟨x, hx, ?_⟩\n   549\t    show p * x * p = x\n   550\t    rw [hx1, hx2]\n   551\t  · rintro ⟨y, hy, rfl⟩\n   552\t    exact mul_mul_mem_corner hp hy\n   553\t\n   554\t/-- `p` is a unit for its own corner. -/\n   555\ttheorem corner_mul_left {M : VonNeumannAlgebra H} {p x : H →L[ℂ] H} {hp : IsSelfAdjoint p}\n   556\t    (hx : x ∈ M.corner hp) : p * x = x := hx.2.1\n   557\t\n   558\ttheorem corner_mul_right {M : VonNeumannAlgebra H} {p x : H →L[ℂ] H} {hp : IsSelfAdjoint p}\n   559\t    (hx : x ∈ M.corner hp) : x * p = x := hx.2.2\n   560\t\n   561\ttheorem mem_corner_one {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} :\n   562\t    x ∈ M.corner (IsSelfAdjoint.one (H →L[ℂ] H)) ↔ x ∈ M := by\n   563\t  simp [mem_corner_iff]\n   564\t\n   565\t/-- Corners are monotone in the compressing projection. -/\n   566\ttheorem corner_mono {M : VonNeumannAlgebra H} {p q : H →L[ℂ] H} {hp : IsSelfAdjoint p}\n   567\t    {hq : IsSelfAdjoint q} (h : ProjLe p q) :\n   568\t    (M.corner hp : Set (H →L[ℂ] H)) ⊆ (M.corner hq : Set (H →L[ℂ] H)) := by\n   569\t  rintro x ⟨hx, hx1, hx2⟩\n   570\t  refine ⟨hx, ?_, ?_⟩\n   571\t  · rw [← hx1, ← mul_assoc, h.2]\n   572\t  · rw [← hx2, mul_assoc, h.1]\n   573\t\n   574\ttheorem corner_zero (M : VonNeumannAlgebra H) :\n   575\t    (M.corner (IsSelfAdjoint.zero (H →L[ℂ] H)) : Set (H →L[ℂ] H)) = {0} := by\n   576\t  ext x\n   577\t  constructor\n   578\t  · rintro ⟨-, -, hx2⟩\n   579\t    simpa using hx2.symm\n   580\t  · rintro rfl\n   581\t    exact ⟨zero_mem M, by simp, by simp⟩\n   582\t\n   583\t/-- Compression by a *central* projection is just multiplication by it. -/\n   584\ttheorem central_corner_eq_image {M : VonNeumannAlgebra H} {z : H →L[ℂ] H}\n   585\t    (hz : M.IsCentralProjection z) :\n   586\t    (M.corner hz.1.isSelfAdjoint : Set (H →L[ℂ] H)) =\n   587\t      (fun x => z * x) '' (M : Set (H →L[ℂ] H)) := by\n   588\t  ext x\n   589\t  constructor\n   590\t  · rintro ⟨hx, hx1, -⟩\n   591\t    exact ⟨x, hx, hx1⟩\n   592\t  · rintro ⟨y, hy, rfl⟩\n   593\t    refine ⟨mul_mem (mem_of_mem_center hz.2) hy, ?_, ?_⟩\n   594\t    · show z * (z * y) = z * y\n   595\t      rw [← mul_assoc, hz.1.isIdempotentElem]\n   596\t    · show z * y * z = z * y\n   597\t      rw [mul_assoc, ← hz.commute hy, ← mul_assoc, hz.1.isIdempotentElem]\n   598\t\n   599\t/-- Compression by a central projection is multiplicative on `M`. -/\n   600\ttheorem central_mul_mul_central {M : VonNeumannAlgebra H} {z x y : H →L[ℂ] H}\n   601\t    (hz : M.IsCentralProjection z) (hx : x ∈ M) : (z * x) * (z * y) = z * (x * y) := by\n   602\t  rw [← mul_assoc, mul_assoc z x z, ← hz.commute hx, ← mul_assoc, hz.1.isIdempotentElem,\n   603\t    mul_assoc]\n   604\t\n   605\t/-! ### Central support and fullness -/\n   606\t\n   607\t/-- `z` is a **central support** (central carrier) of `p`: the smallest central projection\n   608\tacting as the identity on `p`.\n   609\t\n   610\tThis is phrased as a predicate rather than as a construction, so that no completeness of the\n   611\tprojection lattice (an analytic input) is needed. -/\n   612\tdef IsCentralSupport (M : VonNeumannAlgebra H) (p z : H →L[ℂ] H) : Prop :=\n   613\t  M.IsCentralProjection z ∧ z * p = p ∧\n   614\t    ∀ w, M.IsCentralProjection w → w * p = p → z * w = z\n   615\t\n   616\t/-- A projection is **full** when its central support is `1`. -/\n   617\tdef IsFull (M : VonNeumannAlgebra H) (p : H →L[ℂ] H) : Prop :=\n   618\t  M.IsCentralSupport p 1\n   619\t\n   620\tnamespace IsCentralSupport\n   621\t\n   622\tvariable {M : VonNeumannAlgebra H} {p z z' : H →L[ℂ] H}\n   623\t\n   624\ttheorem isCentralProjection (h : M.IsCentralSupport p z) : M.IsCentralProjection z := h.1\n   625\t\n   626\ttheorem mul_eq (h : M.IsCentralSupport p z) : z * p = p := h.2.1\n   627\t\n   628\t/-- `p ≤ z` for the central support `z` of a projection `p` of `M`. -/\n   629\ttheorem projLe (h : M.IsCentralSupport p z) (hp : M.IsProjection p) : ProjLe p z :=\n   630\t  ⟨by rw [← h.1.commute hp.2, h.2.1], h.2.1⟩\n   631\t\n   632\t/-- The central support is unique. -/\n   633\ttheorem unique (h : M.IsCentralSupport p z) (h' : M.IsCentralSupport p z') : z = z' := by\n   634\t  have h1 : z * z' = z := h.2.2 z' h'.1 h'.2.1\n   635\t  have h2 : z' * z = z' := h'.2.2 z h.1 h.2.1\n   636\t  calc z = z * z' := h1.symm\n   637\t    _ = z' * z := (center_commute h.1.2 (mem_of_mem_center h'.1.2)).eq\n   638\t    _ = z' := h2\n   639\t\n   640\tend IsCentralSupport\n   641\t\n   642\t/-- A full projection meets every nonzero central projection nontrivially: this is the basic\n   643\tcentral-intersection statement of comparison theory. -/\n   644\ttheorem IsFull.mul_ne_zero {M : VonNeumannAlgebra H} {p z : H →L[ℂ] H} (hp : M.IsFull p)\n   645\t    (hz : M.IsCentralProjection z) (hz0 : z ≠ 0) : z * p ≠ 0 := by\n   646\t  intro hzp\n   647\t  refine hz0 ?_\n   648\t  have hw : (1 - z) * p = p := by rw [sub_mul, one_mul, hzp, sub_zero]\n   649\t  have h1 := hp.2.2 (1 - z) hz.one_sub hw\n   650\t  rw [one_mul] at h1\n   651\t  exact sub_eq_self.mp h1\n   652\t\n   653\t/-- Conversely, a projection meeting every nonzero central projection is full. -/\n   654\ttheorem isFull_of_forall_central {M : VonNeumannAlgebra H} {p : H →L[ℂ] H}\n   655\t    (h : ∀ z, M.IsCentralProjection z → z ≠ 0 → z * p ≠ 0) : M.IsFull p := by\n   656\t  refine ⟨M.isCentralProjection_one, one_mul p, fun w hw hwp => ?_⟩\n   657\t  rw [one_mul]\n   658\t  have hz : (1 - w) * p = 0 := by rw [sub_mul, one_mul, hwp, sub_self]\n   659\t  have h1 : (1 : H →L[ℂ] H) - w = 0 := by\n   660\t    by_contra hne\n   661\t    exact h (1 - w) hw.one_sub hne hz\n   662\t  exact (sub_eq_zero.mp h1).symm\n   663\t\n   664\t/-- Sanity checks: `1` is full and `0` has central support `0`. -/\n   665\ttheorem isFull_one (M : VonNeumannAlgebra H) : M.IsFull 1 :=\n   666\t  ⟨M.isCentralProjection_one, one_mul 1, fun w _ hw => by rw [one_mul]; rwa [mul_one] at hw⟩\n   667\t\n   668\ttheorem isCentralSupport_zero (M : VonNeumannAlgebra H) : M.IsCentralSupport 0 0 :=\n   669\t  ⟨M.isCentralProjection_zero, mul_zero 0, fun w _ _ => zero_mul w⟩\n   670\t\n   671\ttheorem isFull_iff_forall_central {M : VonNeumannAlgebra H} {p : H →L[ℂ] H} :\n   672\t    M.IsFull p ↔ ∀ z, M.IsCentralProjection z → z ≠ 0 → z * p ≠ 0 :=\n   673\t  ⟨fun hp _ hz hz0 => hp.mul_ne_zero hz hz0, isFull_of_forall_central⟩\n   674\t\n   675\t/-- For a full projection `p` of `M` and a nonzero central projection `z`, the compression\n   676\t`z * p` is a nonzero projection of `M` dominated by both `z` and `p`. -/\n   677\ttheorem IsFull.exists_nonzero_projection {M : VonNeumannAlgebra H} {p z : H →L[ℂ] H}\n   678\t    (hp : M.IsProjection p) (hfull : M.IsFull p) (hz : M.IsCentralProjection z) (hz0 : z ≠ 0) :\n   679\t    M.IsProjection (z * p) ∧ z * p ≠ 0 ∧ ProjLe (z * p) z ∧ ProjLe (z * p) p :=\n   680\t  ⟨hz.mul_isProjection hp, hfull.mul_ne_zero hz hz0, hz.mul_projLe_left hp,\n   681\t    hz.mul_projLe_right hp⟩\n   682\t\n   683\tend VonNeumannAlgebra\n\n--- Declaration index ---\n65:noncomputable def center (M : VonNeumannAlgebra H) : VonNeumannAlgebra H where\n83:theorem coe_center (M : VonNeumannAlgebra H) :\n93:theorem mem_center_iff {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} :\n98:theorem mem_of_mem_center {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} (hx : x ∈ M.center) :\n101:theorem center_commute {M : VonNeumannAlgebra H} {x y : H →L[ℂ] H} (hx : x ∈ M.center)\n105:theorem center_le (M : VonNeumannAlgebra H) :\n108:theorem center_le_commutant (M : VonN