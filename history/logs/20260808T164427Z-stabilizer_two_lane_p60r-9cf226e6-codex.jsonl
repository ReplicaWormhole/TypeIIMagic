dule.span ℂ\n  1417\t      {ξ : H | ∃ a ∈ (A : Set (H →L[ℂ] H)), ∃ b ∈ B, ξ = (b * a) Ω} : Set H))\n  1418\t    (v : ℕ → H →L[ℂ] H)\n  1419\t    (hf : ComparisonFamily (StarSubalgebra.vonNeumannGenerated A)\n  1420\t      (limitProj D.toFiniteCodespaceSystem.stageProj) v) :\n  1421\t    (StarSubalgebra.vonNeumannGenerated A).IsFiniteProjection\n  1422\t        (limitProj D.toFiniteCodespaceSystem.stageProj) ∧\n  1423\t      (StarSubalgebra.vonNeumannGenerated A).IsFull\n  1424\t        (limitProj D.toFiniteCodespaceSystem.stageProj) ∧\n  1425\t      IsGlobalFaithfulNormalSemifiniteTrace (StarSubalgebra.vonNeumannGenerated A)\n  1426\t        (limitProj D.toFiniteCodespaceSystem.stageProj) Ω v := by\n  1427\t  obtain ⟨hfin, hfull, -⟩ :=\n  1428\t    FullFiniteCornerCentralExclusion.full_finite_corner_central_exclusion D hp A hAclosed\n  1429\t      hlocal hAdense B hB hdense\n  1430\t  have hcorner := ultraweak_normal_faithful_corner_trace D hp A hAclosed hlocal hAdense B hB\n  1431\t    hdense\n  1432\t  have hqΩ : limitProj D.toFiniteCodespaceSystem.stageProj Ω = Ω :=\n  1433\t    limitProj_apply_self fun n => D.toFiniteCodespaceSystem.stageProj_apply_self n\n  1434\t  exact ⟨hfin, hfull, full_corner_global_semifinite_weight hf hcorner hqΩ⟩\n  1435\t\n  1436\tend P51Globalization\n  1437\t\n  1438\tend FullCornerSemifiniteWeight\n  1439\tend AristotleCandidates\n-- exact forbidden token scan in candidate --\n-- identifiers and signatures --\n978-/-- **The positive square root**, defined by the pinned Mathlib continuous functional calculus\n979-of the C⋆-algebra `H →L[ℂ] H`.  Nothing about it is assumed: its defining properties are the\n980-theorems below. -/\n981:noncomputable def posSqrt (x : H →L[ℂ] H) : H →L[ℂ] H := cfc Real.sqrt x\n982-\n983-/-- The square root is self-adjoint. -/\n984-theorem posSqrt_isSelfAdjoint (x : H →L[ℂ] H) : IsSelfAdjoint (posSqrt x) :=\n--\n999-/-- **The square root stays in the von Neumann algebra.**  This uses only the bicommutant\n1