{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"qroot='aristotle_responses/P60R-full-corner-standard-semifiniteness-repair-ae5ca7f3-9cf226e6-quarantine/aristotle-stabilizer_two_lane_p60r-7kr05gwd_aristotle'\nf=\\\"\"'$qroot/AristotleCandidates/FullCornerSemifiniteWeight.lean\"\nnl -ba \"$f\" | sed -n '\"'950,1510p'\nprintf '%s\\\\n' '-- exact forbidden token scan in candidate --'\nrg -n \\\"\\\\b(sorry|admit|axiom|opaque|unsafe|implemented_by|native_decide)\\\\b\\\" \\\"\"'$f\" || true\nprintf '\"'%s\\\\n' '-- identifiers and signatures --'\nrg -n -C 3 \\\"\"'^(noncomputable def posSqrt|theorem posSqrt_mem|theorem compressedSub_le|theorem globalWeight_semifinite_positiveCone|def positiveCone|structure IsGlobalFaithfulNormalSemifiniteTrace|theorem full_corner_global_semifinite_weight|theorem full_finite_corner_globalized_weight)'\"\\\\b\\\" \\\"\"'$f\"'","aggregated_output":"   950\t  refine hx0 (eq_zero_of_compress_eq_zero hf fun N => ?_)\n   951\t  by_contra hN\n   952\t  exact absurd (globalWeight_compress_lt_top hf x N) (by simpa using hcon N hN)\n   953\t\n   954\tend Semifinite\n   955\t\n   956\t/-! ## §8b  Positive square roots and standard positive-cone semifiniteness\n   957\t\n   958\tThe compression certificate of §8 is not the standard definition of semifiniteness, because a\n   959\tcompression `f_N x f_N` need not lie below `x` in the operator order.  This section proves the\n   960\tstandard statement on the positive cone: for every nonzero positive `x ∈ M` there is a nonzero\n   961\tpositive `y ∈ M` with `y ≤ x` and `W y < ⊤`.\n   962\t\n   963\tThe construction is the classical one.  The positive square root `a = x^{1/2}` is *proved* to\n   964\texist inside `M` using the pinned Mathlib continuous functional calculus of the C⋆-algebra\n   965\t`H →L[ℂ] H` together with the bicommutant characterisation of `M`; it is not a new hypothesis.\n   966\tWith the finite comparison projection `p_N = ∑_{m<N} v m v m ^*` we take\n   967\t\n   968\t`y_N = a^* p_N a = (p_N a)^* (p_N a)`,\n   969\t\n   970\twhich is positive, lies in `M`, satisfies `x - y_N = ((1 - p_N) a)^* ((1 - p_N) a) ≥ 0`, and has\n   971\tfinite weight because traciality turns `W (y_N)` into `W (p_N (a a^*) p_N) = W (p_N x p_N)`,\n   972\twhich is finite by §8. -/\n   973\t\n   974\tsection PositiveSqrt\n   975\t\n   976\tvariable {M : VonNeumannAlgebra H}\n   977\t\n   978\t/-- **The positive square root**, defined by the pinned Mathlib continuous functional calculus\n   979\tof the C⋆-algebra `H →L[ℂ] H`.  Nothing about it is assumed: its defining properties are the\n   980\ttheorems below. -/\n   981\tnoncomputable def posSqrt (x : H →L[ℂ] H) : H →L[ℂ] H := cfc Real.sqrt x\n   982\t\n   983\t/-- The square root is self-adjoint. -/\n   984\ttheorem posSqrt_isSelfAdjoint (x : H →L[ℂ] H) : IsSelfAdjoint (posSqrt x) :=\n   985\t  cfc_predicate _ _\n   986\t\n   987\ttheorem posSqrt_star (x : H →L[ℂ] H) : star (posSqrt x) = posSqrt x :=\n   988\t  (posSqrt_isSelfAdjoint x).star_eq\n   989\t\n   990\t/-- **The square-root identity** `x^{1/2} x^{1/2} = x` for a positive operator. -/\n   991\ttheorem posSqrt_mul_self {x : H →L[ℂ] H} (hx : x.IsPositive) : posSqrt x * posSqrt x = x := by\n   992\t  have hx' : (0 : H →L[ℂ] H) ≤ x := (ContinuousLinearMap.nonneg_iff_isPositive x).mpr hx\n   993\t  rw [posSqrt, ← cfc_mul _ _ x Real.continuous_sqrt.continuousOn\n   994\t    Real.continuous_sqrt.continuousOn]\n   995\t  nth_rewrite 2 [← cfc_id ℝ x]\n   996\t  refine cfc_congr fun t ht => ?_\n   997\t  simpa using Real.mul_self_sqrt (spectrum_nonneg_of_nonneg hx' ht)\n   998\t\n   999\t/-- **The square root stays in the von Neumann algebra.**  This uses only the bicommutant\n  1000\tproperty of `M` and the fact that the continuous functional calculus of `x` commutes with\n  1001\teverything commuting with `x`. -/\n  1002\ttheorem posSqrt_mem {x : H →L[ℂ] H} (hx : x ∈ M) : posSqrt x ∈ M := by\n  1003\t  rw [posSqrt, ← VonNeumannAlgebra.commutant_commutant M, VonNeumannAlgebra.mem_commutant_iff]\n  1004\t  intro z hz\n  1005\t  rw [VonNeumannAlgebra.mem_commutant_iff] at hz\n  1006\t  exact ((Commute.cfc_real (hz x hx) Real.sqrt).symm : _)\n  1007\t\n  1008\t/-- A nonzero positive operator has a nonzero square root. -/\n  1009\ttheorem posSqrt_ne_zero {x : H →L[ℂ] H} (hx : x.IsPositive) (hx0 : x ≠ 0) : posSqrt x ≠ 0 := by\n  1010\t  intro h\n  1011\t  exact hx0 (by rw [← posSqrt_mul_self hx, h, mul_zero])\n  1012\t\n  1013\tend PositiveSqrt\n  1014\t\n  1015\tsection StandardSemifinite\n  1016\t\n  1017\tvariable {M : VonNeumannAlgebra H} {q : H →L[ℂ] H} {Ω : H} {v : ℕ → H →L[ℂ] H}\n  1018\t\n  1019\t/-- An operator killed by all the *left* compressions `p_N ·` is zero. -/\n  1020\ttheorem eq_zero_of_partialProj_mul_eq_zero (hf : ComparisonFamily M q v) {a : H →L[ℂ] H}\n  1021\t    (h0 : ∀ N, partialProj v N * a = 0) : a = 0 := by\n  1022\t  refine ContinuousLinearMap.ext fun ξ => ?_\n  1023\t  have h1 : Tendsto (fun N => partialProj v N (a ξ)) atTop (𝓝 (a ξ)) := hf.sum_strong (a ξ)\n  1024\t  have h2 : ∀ N, partialProj v N (a ξ) = 0 := by\n  1025\t    intro N\n  1026\t    have := congrArg (fun t : H →L[ℂ] H => t ξ) (h0 N)\n  1027\t    simpa using this\n  1028\t  simp only [h2] at h1\n  1029\t  simpa using tendsto_nhds_unique h1 tendsto_const_nhds\n  1030\t\n  1031\t/-- **The compressed positive subelement** `y_N = x^{1/2} p_N x^{1/2}`. -/\n  1032\tnoncomputable def compressedSub (v : ℕ → H →L[ℂ] H) (N : ℕ) (x : H →L[ℂ] H) : H →L[ℂ] H :=\n  1033\t  posSqrt x * partialProj v N * posSqrt x\n  1034\t\n  1035\t/-- `y_N = (p_N x^{1/2})^* (p_N x^{1/2})`. -/\n  1036\ttheorem compressedSub_eq_star_mul_self (hf : ComparisonFamily M q v) (N : ℕ)\n  1037\t    (x : H →L[ℂ] H) :\n  1038\t    compressedSub v N x\n  1039\t      = star (partialProj v N * posSqrt x) * (partialProj v N * posSqrt x) := by\n  1040\t  have hproj := partialProj_isStarProjection hf N\n  1041\t  rw [star_mul, posSqrt_star, hproj.isSelfAdjoint.star_eq, compressedSub]\n  1042\t  calc posSqrt x * partialProj v N * posSqrt x\n  1043\t      = posSqrt x * (partialProj v N * partialProj v N) * posSqrt x := by\n  1044\t        rw [hproj.isIdempotentElem]\n  1045\t    _ = posSqrt x * partialProj v N * (partialProj v N * posSqrt x) := by noncomm_ring\n  1046\t\n  1047\ttheorem compressedSub_isPositive (hf : ComparisonFamily M q v) (N : ℕ) (x : H →L[ℂ] H) :\n  1048\t    (compressedSub v N x).IsPositive := by\n  1049\t  rw [compressedSub_eq_star_mul_self hf]\n  1050\t  exact isPositive_star_mul_self _\n  1051\t\n  1052\ttheorem compressedSub_mem (hf : ComparisonFamily M q v) {x : H →L[ℂ] H} (hx : x ∈ M)\n  1053\t    (N : ℕ) : compressedSub v N x ∈ M :=\n  1054\t  mul_mem (mul_mem (posSqrt_mem hx) (partialProj_mem hf N)) (posSqrt_mem hx)\n  1055\t\n  1056\t/-- **The order inequality** `y_N ≤ x`. -/\n  1057\ttheorem compressedSub_le (hf : ComparisonFamily M q v) {x : H →L[ℂ] H} (hx : x.IsPositive)\n  1058\t    (N : ℕ) : compressedSub v N x ≤ x := by\n  1059\t  have hproj := partialProj_isStarProjection hf N\n  1060\t  set a := posSqrt x with ha\n  1061\t  set p := partialProj v N with hp\n  1062\t  set c := (1 - p) * a with hc\n  1063\t  have hstarc : star c = a * (1 - p) := by\n  1064\t    rw [hc, star_mul, posSqrt_star, star_sub, star_one, hproj.isSelfAdjoint.star_eq]\n  1065\t  have hkey : star c * c = x - compressedSub v N x := by\n  1066\t    rw [hstarc, hc, compressedSub, ← ha, ← hp]\n  1067\t    have hpp : p * p = p := hproj.isIdempotentElem\n  1068\t    calc a * (1 - p) * ((1 - p) * a)\n  1069\t        = a * a - a * p * a - (a * p * a - a * (p * p) * a) := by noncomm_ring\n  1070\t      _ = a * a - a * p * a := by rw [hpp]; abel\n  1071\t      _ = x - a * p * a := by rw [ha, posSqrt_mul_self hx]\n  1072\t  rw [← sub_nonneg, ContinuousLinearMap.nonneg_iff_isPositive, ← hkey]\n  1073\t  exact isPositive_star_mul_self c\n  1074\t\n  1075\t/-- **The compressed subelement has finite weight.**  This is where the tracial law and the\n  1076\tfinite compression `p_N (x^{1/2} x^{1/2}) p_N = p_N x p_N` of §8 are used. -/\n  1077\ttheorem globalWeight_compressedSub_lt_top (hf : ComparisonFamily M q v)\n  1078\t    (h : IsFaithfulUltraweakNormalTracialCorner M q Ω) {x : H →L[ℂ] H} (hx : x ∈ M)\n  1079\t    (hxpos : x.IsPositive) (N : ℕ) :\n  1080\t    globalWeight q Ω v (compressedSub v N x) < ⊤ := by\n  1081\t  have hb : partialProj v N * posSqrt x ∈ M :=\n  1082\t    mul_mem (partialProj_mem hf N) (posSqrt_mem hx)\n  1083\t  have hproj := partialProj_isStarProjection hf N\n  1084\t  have hstar : star (partialProj v N * posSqrt x) = posSqrt x * partialProj v N := by\n  1085\t    rw [star_mul, posSqrt_star, hproj.isSelfAdjoint.star_eq]\n  1086\t  have hflip : (partialProj v N * posSqrt x) * star (partialProj v N * posSqrt x)\n  1087\t      = partialProj v N * x * partialProj v N := by\n  1088\t    rw [hstar]\n  1089\t    calc partialProj v N * posSqrt x * (posSqrt x * partialProj v N)\n  1090\t        = partialProj v N * (posSqrt x * posSqrt x) * partialProj v N := by noncomm_ring\n  1091\t      _ = partialProj v N * x * partialProj v N := by rw [posSqrt_mul_self hxpos]\n  1092\t  rw [compressedSub_eq_star_mul_self hf, globalWeight_tracial hf h hb, hflip]\n  1093\t  exact globalWeight_compress_lt_top hf x N\n  1094\t\n  1095\t/-- For nonzero positive `x`, some compressed subelement is nonzero. -/\n  1096\ttheorem exists_compressedSub_ne_zero (hf : ComparisonFamily M q v) {x : H →L[ℂ] H}\n  1097\t    (hx : x.IsPositive) (hx0 : x ≠ 0) : ∃ N, compressedSub v N x ≠ 0 := by\n  1098\t  by_contra hcon\n  1099\t  push_neg at hcon\n  1100\t  refine posSqrt_ne_zero hx hx0 (eq_zero_of_partialProj_mul_eq_zero hf fun N => ?_)\n  1101\t  have hzero := hcon N\n  1102\t  rw [compressedSub_eq_star_mul_self hf] at hzero\n  1103\t  refine ContinuousLinearMap.ext fun ξ => ?_\n  1104\t  have h1 : ‖(partialProj v N * posSqrt x) ξ‖ ^ 2 = 0 := by\n  1105\t    rw [← inner_star_mul_self (partialProj v N * posSqrt x) ξ, hzero]\n  1106\t    simp\n  1107\t  have h2 : ‖(partialProj v N * posSqrt x) ξ‖ = 0 := by\n  1108\t    have hnn := norm_nonneg ((partialProj v N * posSqrt x) ξ)\n  1109\t    nlinarith [h1, hnn]\n  1110\t  simpa using norm_eq_zero.mp h2\n  1111\t\n  1112\t/-- **Standard positive-cone semifiniteness of the global weight.**\n  1113\t\n  1114\tFor every nonzero positive `x ∈ M` there is a nonzero positive `y ∈ M` with `y ≤ x` in the\n  1115\toperator order and `W y < ⊤`.  This is the standard definition of semifiniteness of an\n  1116\textended-positive weight, not merely a statement about compressions. -/\n  1117\ttheorem globalWeight_semifinite_positiveCone (hf : ComparisonFamily M q v)\n  1118\t    (h : IsFaithfulUltraweakNormalTracialCorner M q Ω) :\n  1119\t    ∀ x ∈ M, x.IsPositive → x ≠ 0 → ∃ y ∈ M,\n  1120\t      y.IsPositive ∧ y ≠ 0 ∧ y ≤ x ∧ globalWeight q Ω v y < ⊤ := by\n  1121\t  intro x hx hxpos hx0\n  1122\t  obtain ⟨N, hN⟩ := exists_compressedSub_ne_zero (v := v) hf hxpos hx0\n  1123\t  exact ⟨compressedSub v N x, compressedSub_mem hf hx N, compressedSub_isPositive hf N x, hN,\n  1124\t    compressedSub_le hf hxpos N, globalWeight_compressedSub_lt_top hf h hx hxpos N⟩\n  1125\t\n  1126\t/-- **Faithfulness on the positive cone.**  A positive element of `M` of zero weight is zero. -/\n  1127\ttheorem globalWeight_faithful_positiveCone (hf : ComparisonFamily M q v)\n  1128\t    (h : IsFaithfulUltraweakNormalTracialCorner M q Ω) (hqΩ : q Ω = Ω) {x : H →L[ℂ] H}\n  1129\t    (hx : x ∈ M) (hxpos : x.IsPositive) (h0 : globalWeight q Ω v x = 0) : x = 0 := by\n  1130\t  have hsq : star (posSqrt x) * posSqrt x = x := by\n  1131\t    rw [posSqrt_star, posSqrt_mul_self hxpos]\n  1132\t  have ha : posSqrt x = 0 :=\n  1133\t    globalWeight_faithful hf h hqΩ (posSqrt_mem hx) (by rw [hsq]; exact h0)\n  1134\t  rw [← posSqrt_mul_self hxpos, ha, mul_zero]\n  1135\t\n  1136\t/-- **Monotonicity in the operator order** on the positive cone. -/\n  1137\ttheorem globalWeight_mono_le (hf : ComparisonFamily M q v) {x y : H →L[ℂ] H} (hxy : x ≤ y) :\n  1138\t    globalWeight q Ω v x ≤ globalWeight q Ω v y := by\n  1139\t  have hpos : (y - x).IsPositive :=\n  1140\t    (ContinuousLinearMap.nonneg_iff_isPositive (y - x)).mp (sub_nonneg.mpr hxy)\n  1141\t  refine globalWeight_mono hf fun ξ => ?_\n  1142\t  have h1 := reInner_nonneg_of_isPositive hpos ξ\n  1143\t  have h2 : (⟪ξ, (y - x) ξ⟫_ℂ).re = (⟪ξ, y ξ⟫_ℂ).re - (⟪ξ, x ξ⟫_ℂ).re := by\n  1144\t    simp\n  1145\t  rw [h2] at h1\n  1146\t  linarith\n  1147\t\n  1148\tend StandardSemifinite\n  1149\t\n  1150\t/-! ## §9  Where the comparison family comes from\n  1151\t\n  1152\tThe classical route to the hypothesis of this packet is the σ-finite comparison theorem: for a\n  1153\tfull projection `q` of a von Neumann algebra with separable predual, `1` decomposes into a\n  1154\tcountable orthogonal family of projections each equivalent to a subprojection of `q`.  That\n  1155\tcomparison theorem is a genuine analytic result which pinned Mathlib does **not** provide and\n  1156\twhich is **not** proved here.\n  1157\t\n  1158\tWhat *is* proved here is the purely algebraic reduction: once such an orthogonal decomposition\n  1159\tis given, the comparison family of P60 exists.  Fullness of `q` therefore never by itself\n  1160\tproduces a global weight anywhere in this file. -/\n  1161\t\n  1162\tsection Existence\n  1163\t\n  1164\t/-- **From an orthogonal decomposition of `1` by projections subequivalent to `q` to a\n  1165\tcomparison family.**\n  1166\t\n  1167\tThe hypotheses `he0`, `horth`, `hsum`, `hequiv` are exactly the output of the σ-finite\n  1168\tcomparison theorem; that theorem itself is *not* proved here, so this statement is\n  1169\tconditional. -/\n  1170\ttheorem exists_comparisonFamily_of_orthogonal_decomposition {M : VonNeumannAlgebra H}\n  1171\t    {q : H →L[ℂ] H} (hq : M.IsProjection q) (e : ℕ → H →L[ℂ] H) (he0 : e 0 = q)\n  1172\t    (horth : ∀ m n, m ≠ n → e m * e n = 0)\n  1173\t    (hsum : ∀ ξ : H, Tendsto (fun N => (∑ m ∈ Finset.range N, e m) ξ) atTop (𝓝 ξ))\n  1174\t    (hequiv : ∀ n, ∃ p, M.IsProjection p ∧ VonNeumannAlgebra.ProjLe p q ∧ M.MvNEquiv p (e n)) :\n  1175\t    ∃ v : ℕ → H →L[ℂ] H, ComparisonFamily M q v ∧ ∀ n, rngProj v n = e n := by\n  1176\t  classical\n  1177\t  choose p hpproj hple hpequiv using hequiv\n  1178\t  choose w hw using hpequiv\n  1179\t  set v : ℕ → H →L[ℂ] H := fun n => if n = 0 then q else w n with hvdef\n  1180\t  have hv0 : v 0 = q := by simp [hvdef]\n  1181\t  have hvn : ∀ n, n ≠ 0 → v n = w n := fun n hn => by simp [hvdef, hn]\n  1182\t  have hrng : ∀ n, rngProj v n = e n := by\n  1183\t    intro n\n  1184\t    by_cases hn : n = 0\n  1185\t    · subst hn\n  1186\t      rw [rngProj, hv0, hq.star_eq, hq.mul_self, he0]\n  1187\t    · rw [rngProj, hvn n hn]\n  1188\t      exact (hw n).2.2\n  1189\t  have hsrc : ∀ n, srcProj v n = if n = 0 then q else p n := by\n  1190\t    intro n\n  1191\t    by_cases hn : n = 0\n  1192\t    · subst hn\n  1193\t      rw [srcProj, hv0, hq.star_eq, hq.mul_self, if_pos rfl]\n  1194\t    · rw [srcProj, hvn n hn, (hw n).2.1, if_neg hn]\n  1195\t  refine ⟨v, ?_, hrng⟩\n  1196\t  refine\n  1197\t    { mem := ?_, idem_src := ?_, src_le := ?_, orthogonal := ?_, sum_strong := ?_,\n  1198\t      src_zero := ?_, rng_zero := ?_ }\n  1199\t  · intro n\n  1200\t    by_cases hn : n = 0\n  1201\t    · rw [hn, hv0]; exact hq.2\n  1202\t    · rw [hvn n hn]; exact (hw n).1\n  1203\t  · intro n\n  1204\t    rw [hsrc n]\n  1205\t    by_cases hn : n = 0\n  1206\t    · rw [if_pos hn]; exact hq.mul_self\n  1207\t    · rw [if_neg hn]; exact (hpproj n).mul_self\n  1208\t  · intro n\n  1209\t    rw [hsrc n]\n  1210\t    by_cases hn : n = 0\n  1211\t    · rw [if_pos hn]; exact ⟨hq.mul_self, hq.mul_self⟩\n  1212\t    · rw [if_neg hn]; exact hple n\n  1213\t  · intro m n hmn\n  1214\t    rw [hrng m, hrng n]\n  1215\t    exact horth m n hmn\n  1216\t  · intro ξ\n  1217\t    have h1 : ∀ N, partialProj v N = ∑ m ∈ Finset.range N, e m := by\n  1218\t      intro N\n  1219\t      rw [partialProj]\n  1220\t      exact Finset.sum_congr rfl fun m _ => hrng m\n  1221\t    simpa [h1] using hsum ξ\n  1222\t  · rw [hsrc 0, if_pos rfl]\n  1223\t  · rw [hrng 0, he0]\n  1224\t\n  1225\t/-- **Non-vacuity of the comparison premises.**  The unit projection of any concrete von\n  1226\tNeumann algebra carries a normalized countable comparison family, namely the one whose zeroth\n  1227\tmember is `1` and whose remaining members vanish.  This is a consistency check on the\n  1228\tstructure `ComparisonFamily`; it carries no manuscript content. -/\n  1229\ttheorem comparisonFamily_one (M : VonNeumannAlgebra H) :\n  1230\t    ComparisonFamily M 1 (fun n => if n = 0 then (1 : H →L[ℂ] H) else 0) := by\n  1231\t  classical\n  1232\t  set v : ℕ → H →L[ℂ] H := fun n => if n = 0 then (1 : H →L[ℂ] H) else 0 with hvdef\n  1233\t  have hrng : ∀ n, rngProj v n = if n = 0 then (1 : H →L[ℂ] H) else 0 := by\n  1234\t    intro n\n  1235\t    by_cases hn : n = 0 <;> simp [rngProj, hvdef, hn]\n  1236\t  have hsrc : ∀ n, srcProj v n = if n = 0 then (1 : H →L[ℂ] H) else 0 := by\n  1237\t    intro n\n  1238\t    by_cases hn : n = 0 <;> simp [srcProj, hvdef, hn]\n  1239\t  refine\n  1240\t    { mem := ?_, idem_src := ?_, src_le := ?_, orthogonal := ?_, sum_strong := ?_,\n  1241\t      src_zero := ?_, rng_zero := ?_ }\n  1242\t  · intro n\n  1243\t    by_cases hn : n = 0\n  1244\t    · simp only [hvdef, if_pos hn]; exact one_mem M\n  1245\t    · simp only [hvdef, if_neg hn]; exact zero_mem M\n  1246\t  · intro n\n  1247\t    rw [hsrc n]\n  1248\t    by_cases hn : n = 0 <;> simp [hn, IsIdempotentElem]\n  1249\t  · intro n\n  1250\t    rw [hsrc n]\n  1251\t    by_cases hn : n = 0 <;> simp [hn, VonNeumannAlgebra.ProjLe]\n  1252\t  · intro m n hmn\n  1253\t    rw [hrng m, hrng n]\n  1254\t    rcases Nat.eq_zero_or_pos m with hm | hm\n  1255\t    · have hn : n ≠ 0 := by omega\n  1256\t      simp [hn]\n  1257\t    · have hm' : m ≠ 0 := by omega\n  1258\t      simp [hm']\n  1259\t  · intro ξ\n  1260\t    have h1 : ∀ N, 1 ≤ N → partialProj v N ξ = ξ := by\n  1261\t      intro N hN\n  1262\t      have h2 : partialProj v N = ∑ m ∈ Finset.range N, (if m = 0 then (1 : H →L[ℂ] H) else 0) :=\n  1263\t        Finset.sum_congr rfl fun m _ => hrng m\n  1264\t      rw [h2, Finset.sum_ite_eq' (Finset.range N) 0 (fun _ => (1 : H →L[ℂ] H))]\n  1265\t      simp [Finset.mem_range, Nat.lt_of_lt_of_le Nat.zero_lt_one hN]\n  1266\t    refine Tendsto.congr' ?_ tendsto_const_nhds\n  1267\t    filter_upwards [Filter.eventually_ge_atTop 1] with N hN\n  1268\t    exact (h1 N hN).symm\n  1269\t  · rw [hsrc 0, if_pos rfl]\n  1270\t  · rw [hrng 0, if_pos rfl]\n  1271\t\n  1272\t/-- **Non-vacuity of the weight construction.**  For the unit comparison family of\n  1273\t`comparisonFamily_one` the global weight is the vector state at `Ω`, which is neither\n  1274\tidentically zero nor identically infinite. -/\n  1275\ttheorem globalWeight_one_family (Ω : H) (x : H →L[ℂ] H) :\n  1276\t    globalWeight 1 Ω (fun n => if n = 0 then (1 : H →L[ℂ] H) else 0) x\n  1277\t      = ENNReal.ofReal ((⟪Ω, x Ω⟫_ℂ).re) := by\n  1278\t  classical\n  1279\t  rw [globalWeight_def]\n  1280\t  refine tsum_eq_single 0 ?_ |>.trans ?_\n  1281\t  · intro m hm\n  1282\t    simp [weightTerm, hm]\n  1283\t  · simp [weightTerm, cornerTau_apply]\n  1284\t\n  1285\tend Existence\n  1286\t\n  1287\t/-! ## §10  The exported P60R theorem -/\n  1288\t\n  1289\tsection Export\n  1290\t\n  1291\tvariable {M : VonNeumannAlgebra H} {q : H →L[ℂ] H} {Ω : H} {v : ℕ → H →L[ℂ] H}\n  1292\t\n  1293\t/-- **The public domain of the weight**: the positive cone of `M`.\n  1294\t\n  1295\tThe extended weight is `ℝ≥0∞`-valued and is *not* presented as a linear functional on\n  1296\tarbitrary operators; all of its laws below are stated for elements of this cone. -/\n  1297\tdef positiveCone (M : VonNeumannAlgebra H) : Set (H →L[ℂ] H) :=\n  1298\t  {x | x ∈ M ∧ x.IsPositive}\n  1299\t\n  1300\ttheorem mem_positiveCone_iff {M : VonNeumannAlgebra H} {x : H →L[ℂ] H} :\n  1301\t    x ∈ positiveCone M ↔ x ∈ M ∧ x.IsPositive := Iff.rfl\n  1302\t\n  1303\t/-- **The weight laws proved in this file**, bundled as a single predicate on the positive\n  1304\tcone `positiveCone M`.  It is a *conclusion*, never a hypothesis: no theorem of this file\n  1305\tassumes it. -/\n  1306\tstructure IsGlobalFaithfulNormalSemifiniteTrace (M : VonNeumannAlgebra H) (q : H →L[ℂ] H)\n  1307\t    (Ω : H) (v : ℕ → H →L[ℂ] H) : Prop where\n  1308\t  /-- Additivity on the positive cone. -/\n  1309\t  additive : ∀ x ∈ positiveCone M, ∀ y ∈ positiveCone M,\n  1310\t    globalWeight q Ω v (x + y) = globalWeight q Ω v x + globalWeight q Ω v y\n  1311\t  /-- Positive homogeneity on the positive cone. -/\n  1312\t  homogeneous : ∀ c : ℝ, 0 ≤ c → ∀ x ∈ positiveCone M,\n  1313\t    globalWeight q Ω v ((c : ℂ) • x) = ENNReal.ofReal c * globalWeight q Ω v x\n  1314\t  /-- Monotonicity for the operator order on the positive cone. -/\n  1315\t  monotone : ∀ x ∈ positiveCone M, ∀ y ∈ positiveCone M, x ≤ y →\n  1316\t    globalWeight q Ω v x ≤ globalWeight q Ω v y\n  1317\t  /-- Traciality: `W (a^* a) = W (a a^*)` for `a ∈ M`.  Both arguments are positive. -/\n  1318\t  tracial : ∀ a ∈ M, globalWeight q Ω v (star a * a) = globalWeight q Ω v (a * star a)\n  1319\t  /-- Faithfulness on the positive cone. -/\n  1320\t  faithful : ∀ x ∈ positiveCone M, globalWeight q Ω v x = 0 → x = 0\n  1321\t  /-- Normality: the monotone-supremum law for increasing ultraweakly convergent sequences\n  1322\t  in the positive cone. -/\n  1323\t  normal : ∀ (x : ℕ → H →L[ℂ] H), (∀ k, x k ∈ positiveCone M) → ∀ y ∈ positiveCone M,\n  1324\t    (∀ k, ∀ ξ : H, (⟪ξ, x k ξ⟫_ℂ).re ≤ (⟪ξ, x (k + 1) ξ⟫_ℂ).re) →\n  1325\t    Tendsto (fun k => toUltraweak (x k)) atTop (𝓝 (toUltraweak y)) →\n  1326\t    (⨆ k, globalWeight q Ω v (x k)) = globalWeight q Ω v y\n  1327\t  /-- The weight restricts to the P50U corner trace on `q M q`. -/\n  1328\t  corner : ∀ x ∈ M, q * x = x → x * q = x →\n  1329\t    globalWeight q Ω v x = ENNReal.ofReal ((cornerTau q Ω x).re)\n  1330\t  /-- The value on the finite partial sums of the comparison family. -/\n  1331\t  partialProj_value : ∀ N : ℕ, globalWeight q Ω v (partialProj v N)\n  1332\t    = ∑ m ∈ Finset.range N, ENNReal.ofReal ((cornerTau q Ω (srcProj v m)).re)\n  1333\t  /-- **Standard semifiniteness on the positive cone**: every nonzero positive element of `M`\n  1334\t  dominates a nonzero positive element of `M` of finite weight. -/\n  1335\t  semifinite : ∀ x ∈ positiveCone M, x ≠ 0 → ∃ y ∈ positiveCone M,\n  1336\t    y ≠ 0 ∧ y ≤ x ∧ globalWeight q Ω v y < ⊤\n  1337\t  /-- The retained finite-compression certificate of §8: the finite partial sums are\n  1338\t  projections of `M` of finite weight converging strongly to `1`, all of whose compressions\n  1339\t  have finite weight and separate nonzero operators. -/\n  1340\t  finite_compressions : (∀ N, IsStarProjection (partialProj v N) ∧ partialProj v N ∈ M ∧\n  1341\t      globalWeight q Ω v (partialProj v N) < ⊤) ∧\n  1342\t    (∀ ξ : H, Tendsto (fun N => partialProj v N ξ) atTop (𝓝 ξ)) ∧\n  1343\t    (∀ x : H →L[ℂ] H, ∀ N,\n  1344\t      globalWeight q Ω v (partialProj v N * x * partialProj v N) < ⊤) ∧\n  1345\t    (∀ x : H →L[ℂ] H, x ≠ 0 → ∃ N,\n  1346\t      partialProj v N * x * partialProj v N ≠ 0 ∧\n  1347\t      globalWeight q Ω v (partialProj v N * x * partialProj v N) < ⊤)\n  1348\t\n  1349\t/-- **Exported P60R theorem: the global faithful normal semifinite weight on the positive\n  1350\tcone.**\n  1351\t\n  1352\tInput data:\n  1353\t\n  1354\t* `hf`, a normalized countable comparison family for `q` in `M` (the explicit optional\n  1355\t  assumption of this packet: partial isometries of `M` with source projections below `q`,\n  1356\t  pairwise orthogonal range projections whose partial sums converge stro