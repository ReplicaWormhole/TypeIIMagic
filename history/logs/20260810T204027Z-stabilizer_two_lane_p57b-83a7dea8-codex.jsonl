{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"nl -ba AristotleCandidates/VacuumRestrictedITPCompletion.lean | sed -n '46,230p'\nnl -ba AristotleCandidates/VacuumRestrictedITPCompletion.lean | sed -n '234,325p'\ngit status --short\"","aggregated_output":"    46\topen scoped ComplexConjugate ComplexOrder InnerProductSpace\n    47\t\n    48\tset_option synthInstance.maxHeartbeats 1000000\n    49\tset_option maxHeartbeats 1000000\n    50\t\n    51\tnamespace AristotleCandidates\n    52\tnamespace VacuumRestrictedITP\n    53\t\n    54\tuniverse u v\n    55\t\n    56\t/-- A nonnegative complex number vanishes iff the square root of its real part does. -/\n    57\ttheorem sqrt_re_eq_zero_iff {c : ℂ} (hc : 0 ≤ c) : √(RCLike.re c) = 0 ↔ c = 0 := by\n    58\t  obtain ⟨hre, him⟩ := Complex.le_def.mp hc\n    59\t  have hre' : (0 : ℝ) ≤ c.re := by simpa using hre\n    60\t  constructor\n    61\t  · intro h\n    62\t    have : c.re = 0 := by\n    63\t      have := Real.sq_sqrt (by simpa using hre' : (0:ℝ) ≤ RCLike.re c)\n    64\t      rw [h] at this\n    65\t      simpa [eq_comm] using this\n    66\t    exact Complex.ext (by simpa using this) (by simpa using him.symm)\n    67\t  · intro h\n    68\t    simp [h]\n    69\t\n    70\tvariable {ι : Type u} {E : ι → Type v}\n    71\t  [∀ i, NormedAddCommGroup (E i)] [∀ i, InnerProductSpace ℂ (E i)]\n    72\t  {Ω : ∀ i, E i} [DecidableEq ι]\n    73\t\n    74\t/-! ## The seminormed pre-Hilbert space of the algebraic span -/\n    75\t\n    76\t/-- The algebraic span of vacuum-restricted elementary tensors, viewed as a type carrying the\n    77\tseminormed complex inner-product structure produced by the P57A core `itpCore hΩ`.  This is a\n    78\ttype synonym for `ITPSpan Ω`; the synonym exists only so that the core-generated seminorm does\n    79\tnot clash with any other structure on `Finsupp`. -/\n    80\tdef ITPPre (_hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) : Type max u v := ITPSpan Ω\n    81\t\n    82\tnamespace ITPPre\n    83\t\n    84\tvariable (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1)\n    85\t\n    86\tnoncomputable instance : AddCommGroup (ITPPre hΩ) := inferInstanceAs (AddCommGroup (ITPSpan Ω))\n    87\t\n    88\tnoncomputable instance : Module ℂ (ITPPre hΩ) := inferInstanceAs (Module ℂ (ITPSpan Ω))\n    89\t\n    90\t/-- The P57A pre-inner-product core, installed as a class instance on the synonym. -/\n    91\tnoncomputable instance instCore : PreInnerProductSpace.Core ℂ (ITPPre hΩ) := itpCore hΩ\n    92\t\n    93\t/-- The seminormed group structure generated by the core. -/\n    94\tnoncomputable instance instSeminormedAddCommGroup : SeminormedAddCommGroup (ITPPre hΩ) :=\n    95\t  InnerProductSpace.Core.toSeminormedAddCommGroup (𝕜 := ℂ) (F := ITPPre hΩ)\n    96\t\n    97\t/-- The (semi-definite) complex inner-product space structure generated by the core. -/\n    98\tnoncomputable instance instInnerProductSpace : InnerProductSpace ℂ (ITPPre hΩ) :=\n    99\t  InnerProductSpace.ofCore (F := ITPPre hΩ) (instCore hΩ)\n   100\t\n   101\t/-- The inner product on `ITPPre hΩ` is the P57A sesquilinear form. -/\n   102\t@[simp] theorem inner_eq (x y : ITPPre hΩ) :\n   103\t    ⟪x, y⟫_ℂ = itpInner (Ω := Ω) x y := rfl\n   104\t\n   105\ttheorem norm_eq (x : ITPPre hΩ) : ‖x‖ = √(RCLike.re (itpInner (Ω := Ω) x x)) := rfl\n   106\t\n   107\t/-- The seminorm of `x` vanishes exactly when `x` is null for the P57A form. -/\n   108\ttheorem norm_eq_zero_iff (x : ITPPre hΩ) : ‖x‖ = 0 ↔ itpInner (Ω := Ω) x x = 0 := by\n   109\t  rw [norm_eq]\n   110\t  exact sqrt_re_eq_zero_iff (itpInner_nonneg hΩ x)\n   111\t\n   112\tend ITPPre\n   113\t\n   114\t/-! ## The null-space quotient -/\n   115\t\n   116\t/-- The genuine quotient of the algebraic span by its null space: two elements of `ITPPre hΩ`\n   117\tbecome equal exactly when their difference has vanishing self-inner-product. -/\n   118\tabbrev ITPQuot (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) : Type max u v := SeparationQuotient (ITPPre hΩ)\n   119\t\n   120\tsection Quot\n   121\t\n   122\tvariable (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1)\n   123\t\n   124\t/-- The quotient carries a genuine (positive definite) norm. -/\n   125\tnoncomputable def itpQuotNormedAddCommGroup : NormedAddCommGroup (ITPQuot hΩ) := inferInstance\n   126\t\n   127\t/-- The quotient is a complex inner-product space. -/\n   128\tnoncomputable def itpQuotInnerProductSpace : InnerProductSpace ℂ (ITPQuot hΩ) := inferInstance\n   129\t\n   130\t/-- The null space that is being quotiented out is exactly the set of vectors with vanishing\n   131\tself-inner-product for the P57A form. -/\n   132\ttheorem mem_nullSubmodule_iff_inner (x : ITPPre hΩ) :\n   133\t    x ∈ nullSubmodule ℂ (ITPPre hΩ) ↔ itpInner (Ω := Ω) x x = 0 := by\n   134\t  rw [mem_nullSubmodule_iff, ITPPre.norm_eq_zero_iff hΩ]\n   135\t\n   136\t/-- The quotient map kills exactly the null vectors: this is the null-space quotient. -/\n   137\ttheorem mk_eq_zero_iff_inner (x : ITPPre hΩ) :\n   138\t    (SeparationQuotient.mk x : ITPQuot hΩ) = 0 ↔ itpInner (Ω := Ω) x x = 0 := by\n   139\t  rw [← norm_eq_zero (E := ITPQuot hΩ) (a := SeparationQuotient.mk x),\n   140\t    SeparationQuotient.norm_mk, ITPPre.norm_eq_zero_iff hΩ]\n   141\t\n   142\tend Quot\n   143\t\n   144\t/-! ## The completion: an actual Hilbert space -/\n   145\t\n   146\t/-- The vacuum-restricted infinite tensor product Hilbert space: the completion of the\n   147\tnull-space quotient of the algebraic span. -/\n   148\tabbrev ITPHilbert (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) : Type max u v :=\n   149\t  UniformSpace.Completion (ITPQuot hΩ)\n   150\t\n   151\tsection Hilbert\n   152\t\n   153\tvariable (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1)\n   154\t\n   155\t/-- `ITPHilbert hΩ` carries a genuine (positive definite) norm. -/\n   156\tnoncomputable def itpHilbertNormedAddCommGroup : NormedAddCommGroup (ITPHilbert hΩ) :=\n   157\t  inferInstance\n   158\t\n   159\t/-- `ITPHilbert hΩ` is a complex inner-product space. -/\n   160\tnoncomputable def itpHilbertInnerProductSpace : InnerProductSpace ℂ (ITPHilbert hΩ) :=\n   161\t  inferInstance\n   162\t\n   163\t/-- `ITPHilbert hΩ` is complete: together with the two structures above it is a Hilbert space. -/\n   164\ttheorem itpHilbert_completeSpace : CompleteSpace (ITPHilbert hΩ) := inferInstance\n   165\t\n   166\t/-- The canonical continuous linear map from the algebraic span into the completion. -/\n   167\tnoncomputable def itpEmbedL : ITPPre hΩ →L[ℂ] ITPHilbert hΩ :=\n   168\t  (UniformSpace.Completion.toComplL : ITPQuot hΩ →L[ℂ] ITPHilbert hΩ).comp\n   169\t    (SeparationQuotient.mkCLM ℂ (ITPPre hΩ))\n   170\t\n   171\t/-- The canonical linear map from the P57A algebraic span into the completion Hilbert space. -/\n   172\tnoncomputable def itpEmbed : ITPSpan Ω →ₗ[ℂ] ITPHilbert hΩ := (itpEmbedL hΩ).toLinearMap\n   173\t\n   174\ttheorem itpEmbed_apply (x : ITPSpan Ω) :\n   175\t    itpEmbed hΩ x\n   176\t      = ((SeparationQuotient.mk (x : ITPPre hΩ) : ITPQuot hΩ) : ITPHilbert hΩ) := rfl\n   177\t\n   178\t/-- **The embedding preserves the P57A form.** -/\n   179\t@[simp] theorem itpEmbed_inner (x y : ITPSpan Ω) :\n   180\t    ⟪itpEmbed hΩ x, itpEmbed hΩ y⟫_ℂ = itpInner (Ω := Ω) x y := by\n   181\t  rw [itpEmbed_apply, itpEmbed_apply, UniformSpace.Completion.inner_coe,\n   182\t    SeparationQuotient.inner_mk_mk, ITPPre.inner_eq]\n   183\t\n   184\t/-- **The embedding is isometric for the core seminorm.** -/\n   185\ttheorem norm_itpEmbed (x : ITPSpan Ω) :\n   186\t    ‖itpEmbed hΩ x‖ = √(RCLike.re (itpInner (Ω := Ω) x x)) := by\n   187\t  rw [itpEmbed_apply, UniformSpace.Completion.norm_coe, SeparationQuotient.norm_mk,\n   188\t    ITPPre.norm_eq]\n   189\t\n   190\t/-- **The embedding identifies exactly the null vectors**: two algebraic vectors have the same\n   191\timage iff their difference is null for the P57A form.  This is what makes the construction a\n   192\tgenuine quotient rather than a seminormed space renamed as a Hilbert space. -/\n   193\ttheorem itpEmbed_eq_iff (x y : ITPSpan Ω) :\n   194\t    itpEmbed hΩ x = itpEmbed hΩ y ↔ itpInner (Ω := Ω) (x - y) (x - y) = 0 := by\n   195\t  rw [← sub_eq_zero, ← map_sub, ← norm_eq_zero (a := itpEmbed hΩ (x - y)), norm_itpEmbed]\n   196\t  exact sqrt_re_eq_zero_iff (itpInner_nonneg hΩ (x - y))\n   197\t\n   198\ttheorem itpEmbed_eq_zero_iff (x : ITPSpan Ω) :\n   199\t    itpEmbed hΩ x = 0 ↔ itpInner (Ω := Ω) x x = 0 := by\n   200\t  rw [← norm_eq_zero (a := itpEmbed hΩ x), norm_itpEmbed]\n   201\t  exact sqrt_re_eq_zero_iff (itpInner_nonneg hΩ x)\n   202\t\n   203\t/-- **The algebraic image is dense.** -/\n   204\ttheorem denseRange_itpEmbed : DenseRange (itpEmbed hΩ) := by\n   205\t  have hcoe : DenseRange ((↑) : ITPQuot hΩ → ITPHilbert hΩ) :=\n   206\t    UniformSpace.Completion.denseRange_coe\n   207\t  have hmk : Function.Surjective (SeparationQuotient.mk : ITPPre hΩ → ITPQuot hΩ) :=\n   208\t    SeparationQuotient.surjective_mk\n   209\t  have hrange : Set.range (itpEmbed hΩ) = Set.range ((↑) : ITPQuot hΩ → ITPHilbert hΩ) := by\n   210\t    apply Set.Subset.antisymm\n   211\t    · rintro z ⟨x, rfl⟩\n   212\t      exact ⟨SeparationQuotient.mk (x : ITPPre hΩ), rfl⟩\n   213\t    · rintro z ⟨q, rfl⟩\n   214\t      obtain ⟨x, rfl⟩ := hmk q\n   215\t      exact ⟨(x : ITPSpan Ω), rfl⟩\n   216\t  rw [DenseRange, hrange]\n   217\t  exact hcoe\n   218\t\n   219\t/-- **The vacuum image is a unit vector.** -/\n   220\t@[simp] theorem norm_itpEmbed_vacuumVector :\n   221\t    ‖itpEmbed hΩ (vacuumVector Ω)‖ = 1 := by\n   222\t  rw [norm_itpEmbed, itpInner_vacuumVector]\n   223\t  simp\n   224\t\n   225\t/-- The vacuum image is in particular nonzero, so the completion is nontrivial. -/\n   226\ttheorem itpEmbed_vacuumVector_ne_zero : itpEmbed hΩ (vacuumVector Ω) ≠ 0 := by\n   227\t  intro h\n   228\t  have hn := norm_itpEmbed_vacuumVector hΩ\n   229\t  rw [h] at hn\n   230\t  simp at hn\n   234\t/-! ## The quotient is not vacuous\n   235\t\n   236\tThe algebraic span really does contain nonzero null vectors, so the passage to\n   237\t`SeparationQuotient` genuinely identifies distinct algebraic vectors.  Take `ι = ℕ`, `E i = ℂ`,\n   238\t`Ω i = 1`; the elementary tensor which is `1` in every mode but declares mode `0` active is a\n   239\tdifferent `VacuumTensor` from the vacuum, yet all four kernels are `1`, so their difference is a\n   240\tnonzero null vector. -/\n   241\t\n   242\tsection Nondegenerate\n   243\t\n   244\t/-- The all-ones elementary tensor over `ι = ℕ` with mode `0` declared active. -/\n   245\tdef dupTensor : VacuumTensor (fun _ : ℕ => (1 : ℂ)) where\n   246\t  vec _ := 1\n   247\t  active := {0}\n   248\t  vec_eq_vacuum _ _ := rfl\n   249\t\n   250\ttheorem vacuum_inner_one : ∀ _i : ℕ, ⟪(1 : ℂ), (1 : ℂ)⟫_ℂ = 1 := by\n   251\t  intro _; simp\n   252\t\n   253\ttheorem dupTensor_ne_vacuum :\n   254\t    dupTensor ≠ VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ)) := by\n   255\t  intro h\n   256\t  have hact : dupTensor.active = (VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ))).active := by rw [h]\n   257\t  simp [dupTensor, VacuumTensor.vacuum] at hact\n   258\t\n   259\t/-- A nonzero vector of the algebraic span which is null for the P57A form. -/\n   260\tnoncomputable def nullExample : ITPSpan (fun _ : ℕ => (1 : ℂ)) :=\n   261\t  Finsupp.single dupTensor 1 - Finsupp.single (VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ))) 1\n   262\t\n   263\ttheorem nullExample_dup : nullExample dupTensor = 1 := by\n   264\t  rw [nullExample, Finsupp.sub_apply, Finsupp.single_eq_same,\n   265\t    Finsupp.single_eq_of_ne dupTensor_ne_vacuum]\n   266\t  ring\n   267\t\n   268\ttheorem nullExample_vacuum :\n   269\t    nullExample (VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ))) = -1 := by\n   270\t  rw [nullExample, Finsupp.sub_apply, Finsupp.single_eq_same,\n   271\t    Finsupp.single_eq_of_ne (Ne.symm dupTensor_ne_vacuum)]\n   272\t  ring\n   273\t\n   274\ttheorem nullExample_ne_zero : nullExample ≠ 0 := by\n   275\t  intro h\n   276\t  have hv : nullExample dupTensor = 0 := by rw [h]; rfl\n   277\t  rw [nullExample_dup] at hv\n   278\t  exact one_ne_zero hv\n   279\t\n   280\ttheorem itpInner_nullExample : itpInner nullExample nullExample = 0 := by\n   281\t  classical\n   282\t  set t : Finset (VacuumTensor (fun _ : ℕ => (1 : ℂ))) :=\n   283\t    {dupTensor, VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ))} with ht\n   284\t  have hsupp : (nullExample).support ⊆ t := by\n   285\t    refine (Finsupp.support_sub).trans (Finset.union_subset ?_ ?_)\n   286\t    · exact Finsupp.support_single_subset.trans (by simp [ht])\n   287\t    · exact Finsupp.support_single_subset.trans (by simp [ht])\n   288\t  have hkern : ∀ v ∈ t, ∀ w ∈ t, kern v w = 1 := by\n   289\t    intro v hv w hw\n   290\t    have hv' : v.vec = fun _ => (1 : ℂ) := by\n   291\t      rcases Finset.mem_insert.mp hv with h | h\n   292\t      · subst h; rfl\n   293\t      · rw [Finset.mem_singleton] at h; subst h; rfl\n   294\t    have hw' : w.vec = fun _ => (1 : ℂ) := by\n   295\t      rcases Finset.mem_insert.mp hw with h | h\n   296\t      · subst h; rfl\n   297\t      · rw [Finset.mem_singleton] at h; subst h; rfl\n   298\t    simp [kern, hv', hw']\n   299\t  have hsum : ∑ w ∈ t, nullExample w = 0 := by\n   300\t    rw [ht, Finset.sum_pair dupTensor_ne_vacuum, nullExample_dup, nullExample_vacuum]\n   301\t    ring\n   302\t  have hconj : ∑ v ∈ t, (starRingEnd ℂ) (nullExample v) = 0 := by\n   303\t    rw [← map_sum, hsum, map_zero]\n   304\t  rw [itpInner_eq_sum hsupp hsupp]\n   305\t  have hrw : ∀ v ∈ t, ∑ w ∈ t, (starRingEnd ℂ) (nullExample v) * nullExample w * kern v w\n   306\t      = ∑ w ∈ t, (starRingEnd ℂ) (nullExample v) * nullExample w := by\n   307\t    intro v hv\n   308\t    refine Finset.sum_congr rfl fun w hw => ?_\n   309\t    rw [hkern v hv w hw, mul_one]\n   310\t  rw [Finset.sum_congr rfl hrw, ← Finset.sum_mul_sum, hconj, zero_mul]\n   311\t\n   312\t/-- **The quotient is genuine**: a nonzero algebraic vector is sent to `0` in the completion. -/\n   313\ttheorem itpEmbed_nullExample_eq_zero :\n   314\t    itpEmbed (Ω := fun _ : ℕ => (1 : ℂ)) vacuum_inner_one nullExample = 0 ∧ nullExample ≠ 0 :=\n   315\t  ⟨(itpEmbed_eq_zero_iff vacuum_inner_one nullExample).2 itpInner_nullExample,\n   316\t    nullExample_ne_zero⟩\n   317\t\n   318\tend Nondegenerate\n   319\t\n   320\tend VacuumRestrictedITP\n   321\tend AristotleCandidates\n M PLAN.md\n M aristotle_tasks/P49-finite-corner-trace.md\n M aristotle_tasks/P50-normal-faithful-corner-trace.md\n M aristotle_tasks/P51-full-finite-corner-central-exclusion.md\n M aristotle_tasks/P55-regional-concrete-cstar-alpha.md\n M aristotle_tasks/P57-product-gns-tensor-factorization.md\n M aristotle_tasks/P60-full-corner-semifinite-weight.md\n M work/TWO-LANE-FORMALIZATION-DECISION.md\n?? AristotleCandidates/FiniteCornerTrace.lean\n?? AristotleCandidates/FullCornerSemifiniteWeight.lean\n?? AristotleCandidates/FullFiniteCornerCentralExclusion.lean\n?? AristotleCandidates/KaplanskyDensity.lean\n?? AristotleCandidates/LocalHyperbolicAlgebraicAlpha.lean\n?? AristotleCandidates/LocalHyperbolicConcreteRepresentations.lean\n?? AristotleCandidates/LocalHyperbolicFactorTraceTheorem.lean\n?? AristotleCandidates/LocalHyperbolicFiniteStageUHFBridge.lean\n?? AristotleCandidates/LocalHyperbolicSourceUHFBridge.lean\n?? AristotleCandidates/MixedUHFHyperfiniteFactor.lean\n?? AristotleCandidates/NormalFaithfulCornerTrace.lean\n?? AristotleCandidates/ProductGNSTensorFactorization.lean\n?? AristotleCandidates/RegionalConcreteCStarAlpha.lean\n?? AristotleCandidates/RegionalProductStateIdentity.lean\n?? AristotleCandidates/StrongOperatorClosedVonNeumann.lean\n?? AristotleCandidates/UltraweakNormality.lean\n?? AristotleCandidates/VacuumRestrictedITPCompletion.lean\n?? AristotleCandidates/VacuumRestrictedInfiniteTensorProduct.lean\n?? AristotleCandidates/VonNeumannBicommutantTheorem.lean\n?? aristotle_tasks/P50U-ultraweak-normality-bridge.md\n?? aristotle_tasks/P55A-local-hype