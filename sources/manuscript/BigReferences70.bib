@Article{weinstein_parameters_2008,
  title                     = {Parameters of {Pseudo}-{Random} {Quantum} {Circuits}},
  Author                   = {Weinstein, Y. S. and Brown, W. G. and Viola, L.},
  Journal                  = {Phys. Rev. A},
  Year                     = {2008},

  Month                    = nov,
  Note                     = {arXiv: 0808.3758},
  optNumber                   = {5},
  Volume                   = {78},

  Abstract                 = {Pseudorandom circuits generate quantum states and unitary operators which are approximately distributed according to the unitarily invariant Haar measure. We explore how several design parameters affect the efficiency of pseudo-random circuits, with the goal of identifying relevant trade-offs and optimizing convergence. The parameters we explore include the choice of single- and two-qubit gates, the topology of the underlying physical qubit architecture, the probabilistic application of two-qubit gates, as well as circuit size, initialization, and the effect of control constraints. Building on the equivalence between pseudo-random circuits and approximate \$t\$-designs, a Markov matrix approach is employed to analyze asymptotic convergence properties of pseudo-random second-order moments to a 2-design. Quantitative results on the convergence rate as a function of the circuit size are presented for qubit topologies with a sufficient degree of symmetry. Our results may be theoretically and practically useful to optimize the efficiency of random state and operator generation.},
  Doi                      = {10.1103/PhysRevA.78.052332},
  File                     = {APS Snapshot:/home/dhangleiter/.mozilla/firefox/2jx0egeo.default/zotero/storage/X22AWGDS/PhysRevA.78.html:text/html;arXiv\:0808.3758 PDF:/home/dhangleiter/.mozilla/firefox/2jx0egeo.default/zotero/storage/B6FP47QX/Weinstein et al. - 2008 - Parameters of Pseudo-Random Quantum Circuits.pdf:application/pdf;arXiv.org Snapshot:/home/dhangleiter/.mozilla/firefox/2jx0egeo.default/zotero/storage/2FGIV7A5/0808.html:text/html},
  optissn                     = {1050-2947, 1094-1622},
  Keywords                 = {Quantum Physics},
  opturl                   = {http://arxiv.org/abs/0808.3758},
  opturldate                  = {2016-11-03}
}

