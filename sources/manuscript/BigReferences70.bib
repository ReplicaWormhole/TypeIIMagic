@Article{nakata_generating_2014,
  title = {Generating a state $t$-design by diagonal quantum circuits},
  Author = {Nakata, Yoshifumi and Koashi, Masato and Murao, Mio},
  Journal = {New J. Phys.},
  Year = {2014},
  Month = may,
  optNumber = {5},
  Pages = {053043},
  Volume = {16},
  Abstract = {We investigate protocols for generating a state \$t\$-design by using a fixed separable initial state and a diagonal-unitary \$t\$-design in the computational basis, which is a \$t\$-design of an ensemble of diagonal unitary matrices with random phases as their eigenvalues. We first show that a diagonal-unitary \$t\$-design generates a \$O(1/2{\textasciicircum}N)\$-approximate state \$t\$-design, where \$N\$ is the number of qubits. We then discuss a way of improving the degree of approximation by exploiting non-diagonal gates after applying a diagonal-unitary \$t\$-design. We also show that it is necessary and sufficient to use \$O({\textbackslash}log\_2 t)\$-qubit gates with random phases to generate a diagonal-unitary \$t\$-design by diagonal quantum circuits, and that each multi-qubit diagonal gate can be replaced by a sequence of multi-qubit controlled-phase-type gates with discrete-valued random phases. Finally, we analyze the number of gates for implementing a diagonal-unitary \$t\$-design by \{{\textbackslash}it non-diagonal\} two- and one-qubit gates. Our results provide a concrete application of diagonal quantum circuits in quantum informational tasks.},
  Archiveprefix            = {arXiv},
  Doi                      = {10.1088/1367-2630/16/5/053043},
  Eprint                   = {1311.1128},
  optissn                     = {1367-2630},
  Keywords                 = {Quantum Physics},
  opturl                      = {http://arxiv.org/abs/1311.1128},
  opturldate                  = {2017-05-12}
}

