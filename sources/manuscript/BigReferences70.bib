@Article{brown_quantum_2008,
  title                     = {Quantum chaos, delocalization, and entanglement in disordered {Heisenberg} models},
  Author                   = {Brown, W. G. and Santos, L. F. and Starling,  and  J. and Viola, L.},
  Journal                  = {Phys. Rev. E},
  Year                     = {2008},

  Month                    = feb,
  optNumber                   = {2},
  Pages                    = {021106},
  Volume                   = {77},

  Abstract                 = {We investigate disordered one- and two-dimensional Heisenberg spin lattices across the transition from integrability to quantum chaos from both statistical many-body and quantum-information perspectives. Special emphasis is devoted to quantitatively exploring the interplay between eigenvector statistics, delocalization, and entanglement in the presence of nontrivial symmetries. The implication of the basis dependence of state delocalization indicators (such as the number of principal components) is addressed, and a measure of relative delocalization is proposed in order to robustly characterize the onset of chaos in the presence of disorder. Both standard multipartite and generalized entanglement are investigated in a wide parameter regime by using a family of spin- and fermion-purity measures, their dependence on delocalization and on energy spectrum statistics being examine and  A distinctive correlation between entanglement, delocalization, and integrability is uncovered, which may be generic to systems described by the two-body random ensemble and may point to a new diagnostic tool for quantum chaos. Analytical estimates for typical entanglement of random pure states restricted to a proper subspace of the full Hilbert space are also established and compared with random matrix theory predictions.},
  Doi                      = {10.1103/PhysRevE.77.021106},
  File                     = {APS Snapshot:/home/dhangleiter/.mozilla/firefox/2jx0egeo.default/zotero/storage/5N69MUZT/PhysRevE.77.html:text/html;arXiv\:0707.1331 PDF:/home/dhangleiter/.mozilla/firefox/2jx0egeo.default/zotero/storage/9J5RBGHN/Brown et al. - 2008 - Quantum Chaos, Delocalization, and Entanglement in.pdf:application/pdf;arXiv.org Snapshot:/home/dhangleiter/.mozilla/firefox/2jx0egeo.default/zotero/storage/7V48ZZ85/0707.html:text/html},
  Keywords                 = {Condensed Matter - Other Condensed Matter, Quantum Physics},
  opturl                   = {http://link.aps.org/doi/10.1103/PhysRevE.77.021106},
  opturldate                  = {2016-11-07}
}

