@article{yoshikawa_generation_2016,
	 title = {Generation of one-million-mode continuous-variable cluster state by unlimited time-domain multiplexing},
	volume = {1},
	optissn = {2378-0967},
	opturl= {http://arxiv.org/abs/1606.06688},
	doi = {10.1063/1.4962732},
	optabstract = {In recent quantum optical continuous-variable experiments, the optnumber of fully inseparable light modes has drastically increased by introducing a multiplexing scheme either in the time domain or in the frequency domain. Here, modifying the time-domain multiplexing experiment reported in Nature Photonics 7, 982 (2013), we demonstrate successive generation of fully inseparable light modes for more than one million modes. The resulting multi-mode state is useful as a dual-rail CV cluster state. We circumvent the previous problem of optical phase drifts, which has limited the optnumber of fully inseparable light modes to around ten thousands, by continuous feedback control of the optical system.},
	number = {6},
	journal = {APL Photonics},
	author = {Yoshikawa, Jun-Ichi and  Yokoyama, Shota and  {\it et al.} and Furusawa, Akira},
	optmonth = sep,
	year = {2016},
	optarchivePrefix ={arXiv}, opteprint= {1606.06688},
	keywords = {Quantum Physics},
	pages = {060801},
	annote = {Comment: 12 pages, 8 figures},
	file = {arXiv\:1606.06688 PDF:/Users/garrapito/Zotero/storage/XBC6TID9/Yoshikawa et al. - 2016 - Generation of one-million-mode continuous-variable.pdf:application/pdf;arXiv.org Snapshot:/Users/garrapito/Zotero/storage/ZBEFP2F8/1606.html:text/html}
}


