@article{arrazola_quantum_2018,
	title = {Quantum approximate optimization with {Gaussian} boson sampling},
	volume = {98},
	opturl = {https://link.aps.org/doi/10.1103/PhysRevA.98.012322},
	doi = {10.1103/PhysRevA.98.012322},
	abstract = {Hard optimization problems are often approached by finding approximate solutions. Here, we highlight the concept of proportional sampling and discuss how it can be used to improve the performance of stochastic algorithms for optimization. We introduce an NP-Hard problem called Max-Haf and show that Gaussian boson sampling (GBS) can be used to enhance any stochastic algorithm for this problem. These results are applied by enhancing the random search, simulated annealing, and greedy algorithms. With numerical simulations, we confirm that all algorithms are improved when employing GBS, and that a GBS-enhanced random search performs the best despite being the one with the simplest underlying classical routine.},
	number = {1},
	opturldate = {2019-06-18},
	journal = {Phys. Rev. A},
	author = {Arrazola, Juan Miguel and Bromley, Thomas R. and Rebentrost, Patrick},
	month = jul,
	year = {2018},
	pages = {012322},
	file = {APS Snapshot:/home/dhangleiter/.mozilla/firefox/2jx0egeo.default/zotero/storage/YB2ZUSZP/PhysRevA.98.html:text/html;Full Text PDF:/home/dhangleiter/.mozilla/firefox/2jx0egeo.default/zotero/storage/DPIQDHDL/Arrazola et al. - 2018 - Quantum approximate optimization with Gaussian bos.pdf:application/pdf}
}


