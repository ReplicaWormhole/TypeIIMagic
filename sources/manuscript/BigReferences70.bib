@article{jordan_error_2006,
	 title = {Error correcting codes for adiabatic quantum computation},
	  pages = {052322},
	volume = {74},
	optissn = {1050-2947, 1094-1622},
	optopturl= {http://arxiv.org/abs/quant-ph/0512170},
	optdoi= {10.1103/PhysRevA.74.052322},
	abstract = {Recently, there has been growing interest in using adiabatic quantum computation as an architecture for experimentally realizable quantum computers. One of the reasons for this is the idea that the energy gap should provide some inherent resistance to noise. It is now known that universal quantum computation can be achieved adiabatically using 2-local Hamiltonians. The energy gap in these Hamiltonians scales as an inverse polynomial in the problem size. Here we present stabilizer codes which can be used to produce a constant energy gap against 1-local and 2-local noise. The corresponding fault-tolerant universal Hamiltonians are 4-local and 6-local respectively, which is the optimal result achievable within this framework.},
	issue = {5},
	journal = {Phys. Rev. A},
	author = {Jordan, S. P. and Farhi, E. and Shor, P. W.},
	optmonth = nov,
	year = {2006},
	eprint= {quant-ph/0512170},
	keywords = {Quantum Physics},
	annote = {Comment: Errors corrected},
	file = {arXiv\:quant-ph/0512170 PDF:/Users/garrapito/Zotero/storage/TE4PJ63G/Jordan et al. - 2006 - Error correcting codes for adiabatic quantum compu.pdf:application/pdf;arXiv.org Snapshot:/Users/garrapito/Zotero/storage/QUFCP6KP/0512170.html:text/html}
}


