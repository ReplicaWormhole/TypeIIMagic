/-- The exported scoped C-star instance makes the finite-region norm theorem usable downstream. -/
example {Site : Type*} [DecidableEq Site] (F F' : Finset Site) (hFF' : F ⊆ F')
    (A : FiniteFiber.finiteRegionQubitAlgebra F) :
    ‖FiniteFiber.finiteRegionEmbed F F' hFF' A‖ = ‖A‖ :=
  FiniteFiber.finiteRegionEmbed_norm F F' hFF' A
