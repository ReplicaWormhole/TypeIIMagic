import FiniteFiber.FiniteStabilizerStateChain
import Mathlib.Algebra.Colimit.Module

/-!
# A compatible functional on the sequential local quotient

The physical one-site inclusions determine coherent typed unital
star-algebra embeddings between any two finite volumes.  This file uses their
finite-state compatibility to descend the family of finite stabilizer
functionals to the module direct limit generated by those transitions.

This is deliberately not called the quasilocal C-star algebra or a state on
that algebra.  The component maps are now multiplicative, star preserving,
unital, norm preserving, and a directed system, but this file does not construct a
noncommutative star-algebra colimit on the quotient, its norm completion, or
positivity of the descended functional there.  The construction remains the
linear local-functional bridge only.
-/

namespace FiniteFiber

/--
The module direct limit generated by the finite matrix spaces and their typed
sequential transition relations.  No multiplication or star operation on this
quotient is asserted at this stage.
-/
abbrev SequentialFiniteQubitLocalSpace := Module.DirectLimit
  (fun n : ℕ => Matrix (QubitIndex n) (QubitIndex n) ℂ)
  (fun n m h => sequentialTransition n m h)

/--
The compatible finite stabilizer functionals descend to the sequential local
quotient vector space.
-/
noncomputable def sequentialLocalFunctional
    (C : StepwiseCompatibleFiniteStabilizerChain) :
    SequentialFiniteQubitLocalSpace →ₗ[ℂ] ℂ :=
  Module.DirectLimit.lift ℂ ℕ
    (fun n : ℕ => Matrix (QubitIndex n) (QubitIndex n) ℂ)
    (fun n m h => sequentialTransition n m h)
    (fun n => C.state n)
    (fun n m h A => C.state_sequentialTransition n m h A)

/--
The descended functional agrees with the original finite stabilizer state on
every canonical finite-volume representative.
-/
theorem sequentialLocalFunctional_of
    (C : StepwiseCompatibleFiniteStabilizerChain) (n : ℕ)
    (A : Matrix (QubitIndex n) (QubitIndex n) ℂ) :
    sequentialLocalFunctional C
      (Module.DirectLimit.of ℂ ℕ
        (fun n : ℕ => Matrix (QubitIndex n) (QubitIndex n) ℂ)
        (fun n m h => sequentialTransition n m h) n A) = C.state n A := by
  simp [sequentialLocalFunctional]

namespace InitialSegmentStepwiseCompatibleFiniteStabilizerChain

/--
The initial-segment literal-coordinate chain supplies the same quotient
functional through its derived generic stepwise chain.
-/
noncomputable def sequentialLocalFunctional
    (C : InitialSegmentStepwiseCompatibleFiniteStabilizerChain) :
    SequentialFiniteQubitLocalSpace →ₗ[ℂ] ℂ :=
  _root_.FiniteFiber.sequentialLocalFunctional C.toStepwiseCompatibleFiniteStabilizerChain

end InitialSegmentStepwiseCompatibleFiniteStabilizerChain

end FiniteFiber
