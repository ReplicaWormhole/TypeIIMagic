import FiniteFiber.FullPauliDirectedLocalSystem
import FiniteFiber.GNSVector
import Mathlib.Analysis.CStarAlgebra.Hom
import Mathlib.Analysis.CStarAlgebra.PositiveLinearMap

/-!
# The quasilocal state and GNS interface for the actual local system

The directed system of `FiniteFiber.FullPauliDirectedLocalSystem` supplies, for
every finite region `F : Finset Site`, the finite local matrix algebra
`finiteRegionQubitAlgebra F`, the identity-padding inclusions `localInclusion`,
and — for a consistent stabilizer system `S` — the compatible finite local
states `S.localState F`.  This file adds the *smallest explicit interface*
which turns that purely finite/algebraic data into the manuscript's quasilocal
C-star algebra `𝒜 = closure (⋃_F 𝒜_F)`, its stabilizer state `ω`, and the GNS
data attached to `ω` by Mathlib.

## The conditional inputs, enumerated exactly

Exactly two bundles of data are assumed; nothing else in this file is
conditional.

`QuasilocalEmbedding Site A` (the C-star completion input), with fields

1. `embed`  : for each finite region a unital star-algebra map
   `𝒜_F →⋆ₐ[ℂ] A` into a C-star algebra `A`;
2. `embed_injective` : each `embed F` is injective (the local algebras are
   faithfully represented in `A`);
3. `embed_localInclusion` : `embed F' ∘ localInclusion h = embed F` for
   `F ⊆ F'` — the manuscript's identification `𝒜_F ≃ 𝒜_F ⊗ id_{F' \ F}`;
4. `dense_localAlgebra` : the union of the images is norm dense in `A`, i.e.
   `A` really is the norm completion of `𝒜_loc`.

`QuasilocalStabilizerState S Q` (the global state input), with fields

5. `state` : a positive linear functional `ω : A →ₚ[ℂ] ℂ`;
6. `state_embed` : `ω (embed F x) = S.localState F x` for every finite region
   `F` — `ω` extends the compatible finite stabilizer functionals.

Everything else is *derived* here.  In particular the following are **not**
assumed:

* the continuity bound of the embeddings: `‖embed F x‖ = ‖x‖` is proved from
  injectivity (`norm_embed`), so `embed F` is an isometry;
* the continuity of `ω`: positive linear functionals on a C-star algebra are
  automatically bounded in Mathlib, so `continuous_state` is proved;
* normalization `ω 1 = 1`, which is derived from field 6 at `F = ∅`;
* uniqueness of the extension (`state_eq`, the B.L.T. uniqueness step of
  Proposition `prop:define_state`), derived from continuity and density.

## What is proved

* Algebraic direct-limit facts: the images of the finite local algebras are
  directed (`exists_localSet_common_region`), and for every subregion
  `Γ : Set Site` the local elements supported in `Γ` form a star subalgebra
  `Q.localStarAlgebra Γ` of `A` (`𝒜_{Γ,loc}`), monotone in `Γ` and dense for
  `Γ = univ`.
* Finite-stage evaluation: `state_embed_fullPauliRegionMatrix` (every local
  stabilizer has expectation one), region-independence of the value on a word
  (`state_embed_eq_of_supportedIn`), and normalization.
* The GNS connection through the generic bridge of `FiniteFiber.GNSVector`:
  the cyclic unit vector `Ω`, the reconstruction formula
  `⟪Ω, π(embed F x) Ω⟫ = S.localState F x`, cyclicity, the local
  representations `π ∘ embed F` and their coherence along the directed system,
  and the invariance `π(embed F g) Ω = Ω` of the GNS vector under every local
  stabilizer.
* Finite-stage positivity: the finite local state `ω_F(x) = Tr(ρ_F x)` is a
  positive linear functional for the Loewner order
  (`FullPauliStabilizerSystem.localPositiveState`).
* Non-vacuity of both interfaces: `emptySiteQuasilocalEmbedding` and
  `emptySiteQuasilocalStabilizerState`.

## What is *not* claimed

No product/tensor factorization of the GNS representation, no normality
statement, no von Neumann algebra generated by the local algebras, no type
classification, and no construction of `A` or of `ω` for an infinite lattice:
those remain the explicit inputs listed above.
-/

namespace FiniteFiber

open scoped BigOperators ComplexOrder InnerProductSpace
open scoped FiniteFiber.FiniteRegionQubitMatrix

variable {Site : Type*} [DecidableEq Site]

/-! ### Finite-stage facts about involutive supported words -/

/-- `pauliSign` is a real sign, hence star-invariant. -/
@[simp] theorem star_pauliSign (b : Bool) : star (pauliSign b) = pauliSign b := by
  cases b <;> simp [pauliSign]

/-- The finite-region matrix of an involutive word supported in `F` is self-adjoint. -/
theorem fullPauliRegionMatrix_isSelfAdjoint (F : Finset Site) (a : FullPauliWord Site)
    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :
    IsSelfAdjoint (fullPauliRegionMatrix F a) := by
  rw [fullPauliRegionMatrix_eq_pauliSign_smul F a ha hinv]
  show star _ = _
  rw [star_smul, star_pauliSign,
    (finiteRegionPauliMatrix_isSelfAdjoint F (regionPauliLabels F a))]

/-- The finite-region matrix of an involutive word supported in `F` squares to `1`. -/
theorem fullPauliRegionMatrix_mul_self (F : Finset Site) (a : FullPauliWord Site)
    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :
    fullPauliRegionMatrix F a * fullPauliRegionMatrix F a = 1 := by
  rw [← fullPauliRegionMatrix_mul F a a ha, hinv, fullPauliRegionMatrix_one]

/-- The deviation element `(g - 1)^*(g - 1)` of an involutive supported word. -/
theorem star_sub_one_mul_sub_one_fullPauliRegionMatrix
    (F : Finset Site) (a : FullPauliWord Site)
    (ha : a.label.support ⊆ F) (hinv : a * a = 1) :
    star (fullPauliRegionMatrix F a - 1) * (fullPauliRegionMatrix F a - 1) =
      (2 : ℂ) • (1 : finiteRegionQubitAlgebra F) -
        (2 : ℂ) • fullPauliRegionMatrix F a := by
  have hsa : star (fullPauliRegionMatrix F a) = fullPauliRegionMatrix F a :=
    fullPauliRegionMatrix_isSelfAdjoint F a ha hinv
  have hsq := fullPauliRegionMatrix_mul_self F a ha hinv
  rw [star_sub, star_one, hsa, sub_mul, mul_sub, mul_sub, hsq, one_mul, mul_one]
  simp only [mul_one]
  module

/-! ### The explicit C-star completion input -/

variable (Site) in
/--
**The C-star completion input.**  A concrete C-star algebra `A` together with
faithful unital star embeddings of every finite local algebra which are
compatible with the identity padding of the directed system and whose images
are norm dense.  This is exactly the manuscript's quasilocal algebra
`𝒜 = closure (⋃_{F} 𝒜_F)` together with the identification
`𝒜_F ≃ 𝒜_F ⊗ id_{F' \ F}`.
-/
structure QuasilocalEmbedding (A : Type*) [CStarAlgebra A] where
  /-- The star embedding of the finite local algebra of a region. -/
  embed : ∀ F : Finset Site, finiteRegionQubitAlgebra F →⋆ₐ[ℂ] A
  /-- The finite local algebras are faithfully represented. -/
  embed_injective : ∀ F : Finset Site, Function.Injective (embed F)
  /-- The embeddings are compatible with the identity padding of the directed system. -/
  embed_localInclusion : ∀ (F F' : Finset Site) (h : F ⊆ F')
    (x : finiteRegionQubitAlgebra F), embed F' (localInclusion h x) = embed F x
  /-- The local elements are norm dense: `A` is the completion of `⋃_F 𝒜_F`. -/
  dense_localAlgebra : Dense (⋃ F : Finset Site, Set.range (embed F))

namespace QuasilocalEmbedding

variable {A : Type*} [CStarAlgebra A] (Q : QuasilocalEmbedding Site A)

/-- **The continuity bound is derived, not assumed**: each embedding is isometric. -/
theorem norm_embed (F : Finset Site) (x : finiteRegionQubitAlgebra F) :
    ‖Q.embed F x‖ = ‖x‖ :=
  NonUnitalStarAlgHom.norm_map (Q.embed F) (Q.embed_injective F) x

/-- Each embedding is an isometry. -/
theorem isometry_embed (F : Finset Site) : Isometry (Q.embed F) :=
  AddMonoidHomClass.isometry_of_norm (Q.embed F) (Q.norm_embed F)

/-- Each embedding is continuous. -/
theorem continuous_embed (F : Finset Site) : Continuous (Q.embed F) :=
  (Q.isometry_embed F).continuous

@[simp] theorem embed_one (F : Finset Site) : Q.embed F 1 = 1 := map_one _

/--
A full-Pauli word has a single image in `A`: its finite-region matrices on all
regions containing its support agree there.
-/
theorem embed_fullPauliRegionMatrix_eq (F F' : Finset Site) (hFF' : F ⊆ F')
    (a : FullPauliWord Site) (ha : a.SupportedIn F) :
    Q.embed F' (fullPauliRegionMatrix F' a) = Q.embed F (fullPauliRegionMatrix F a) := by
  rw [← localInclusion_fullPauliRegionMatrix F F' hFF' a ha,
    Q.embed_localInclusion F F' hFF']

/-- The image of a smaller region is contained in the image of a larger one. -/
theorem range_embed_mono (F F' : Finset Site) (hFF' : F ⊆ F') :
    Set.range (Q.embed F) ⊆ Set.range (Q.embed F') := by
  rintro _ ⟨x, rfl⟩
  exact ⟨localInclusion hFF' x, Q.embed_localInclusion F F' hFF' x⟩

/-! ### The local star algebra of a subregion -/

/--
The set of elements of `A` which are local in the subregion `Γ`: images of the
finite local algebras of the finite regions contained in `Γ`.  This is the
manuscript's `𝒜_{Γ,loc} = ⋃_{F ⋐ Γ} 𝒜_F`.
-/
def localSet (Γ : Set Site) : Set A :=
  {x | ∃ F : Finset Site, ↑F ⊆ Γ ∧ x ∈ Set.range (Q.embed F)}

theorem mem_localSet_iff (Γ : Set Site) (x : A) :
    x ∈ Q.localSet Γ ↔ ∃ F : Finset Site, ↑F ⊆ Γ ∧ ∃ y, Q.embed F y = x := Iff.rfl

theorem embed_mem_localSet {Γ : Set Site} {F : Finset Site} (hF : ↑F ⊆ Γ)
    (x : finiteRegionQubitAlgebra F) : Q.embed F x ∈ Q.localSet Γ :=
  ⟨F, hF, ⟨x, rfl⟩⟩

theorem localSet_mono {Γ Δ : Set Site} (h : Γ ⊆ Δ) : Q.localSet Γ ⊆ Q.localSet Δ := by
  rintro x ⟨F, hF, hx⟩
  exact ⟨F, hF.trans h, hx⟩

/-- The local set of the whole lattice is the union of all the images. -/
theorem localSet_univ : Q.localSet (Set.univ : Set Site) = ⋃ F : Finset Site,
    Set.range (Q.embed F) := by
  ext x
  simp [localSet]

/--
**Directedness of the local system.**  Any two elements local in `Γ` are images
of one and the same finite region contained in `Γ`.
-/
theorem exists_localSet_common_region {Γ : Set Site} {x y : A}
    (hx : x ∈ Q.localSet Γ) (hy : y ∈ Q.localSet Γ) :
    ∃ G : Finset Site, ↑G ⊆ Γ ∧ ∃ a b : finiteRegionQubitAlgebra G,
      Q.embed G a = x ∧ Q.embed G b = y := by
  obtain ⟨F, hF, a, rfl⟩ := hx
  obtain ⟨F', hF', b, rfl⟩ := hy
  refine ⟨F ∪ F', ?_, localInclusion Finset.subset_union_left a,
    localInclusion Finset.subset_union_right b, ?_, ?_⟩
  · rw [Finset.coe_union]
    exact Set.union_subset hF hF'
  · exact Q.embed_localInclusion F (F ∪ F') Finset.subset_union_left a
  · exact Q.embed_localInclusion F' (F ∪ F') Finset.subset_union_right b

/--
**The local star algebra of a subregion.**  The local elements of `Γ` form a
star subalgebra of `A`: sums, products and adjoints of elements local in `F`
and `E` are local in `F ∪ E`.
-/
def localStarAlgebra (Γ : Set Site) : StarSubalgebra ℂ A where
  carrier := Q.localSet Γ
  mul_mem' := by
    intro x y hx hy
    obtain ⟨G, hG, a, b, rfl, rfl⟩ := Q.exists_localSet_common_region hx hy
    exact ⟨G, hG, ⟨a * b, map_mul _ _ _⟩⟩
  add_mem' := by
    intro x y hx hy
    obtain ⟨G, hG, a, b, rfl, rfl⟩ := Q.exists_localSet_common_region hx hy
    exact ⟨G, hG, ⟨a + b, map_add _ _ _⟩⟩
  algebraMap_mem' := by
    intro r
    exact ⟨∅, by simp, ⟨algebraMap ℂ _ r, AlgHomClass.commutes _ r⟩⟩
  star_mem' := by
    rintro x ⟨F, hF, a, rfl⟩
    exact ⟨F, hF, ⟨star a, map_star _ _⟩⟩

@[simp] theorem coe_localStarAlgebra (Γ : Set Site) :
    (Q.localStarAlgebra Γ : Set A) = Q.localSet Γ := rfl

theorem localStarAlgebra_mono {Γ Δ : Set Site} (h : Γ ⊆ Δ) :
    Q.localStarAlgebra Γ ≤ Q.localStarAlgebra Δ := Q.localSet_mono h

/-- **The quasilocal algebra.**  The global local star algebra is dense in `A`. -/
theorem dense_localStarAlgebra_univ :
    Dense (Q.localStarAlgebra (Set.univ : Set Site) : Set A) := by
  rw [coe_localStarAlgebra, localSet_univ]
  exact Q.dense_localAlgebra

/-- The topological closure of the global local star algebra is all of `A`. -/
theorem localStarAlgebra_univ_topologicalClosure :
    (Q.localStarAlgebra (Set.univ : Set Site)).topologicalClosure = ⊤ := by
  apply SetLike.ext'
  simpa using Q.dense_localStarAlgebra_univ.closure_eq

end QuasilocalEmbedding

/-! ### The explicit global state input -/

variable {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/--
**The global state input.**  A positive linear functional on the quasilocal
algebra `A` which restricts on every finite local algebra to the compatible
finite stabilizer state `ω_F(x) = Tr(ρ_F x)`.  This is the state of
Proposition `prop:define_state`; the interface supplies it, it is not
constructed here.
-/
structure QuasilocalStabilizerState (S : FullPauliStabilizerSystem Site)
    (Q : QuasilocalEmbedding Site A) where
  /-- The global positive linear functional. -/
  state : A →ₚ[ℂ] ℂ
  /-- It extends the compatible finite local stabilizer states. -/
  state_embed : ∀ (F : Finset Site) (x : finiteRegionQubitAlgebra F),
    state (Q.embed F x) = S.localState F x

namespace QuasilocalStabilizerState

variable {S : FullPauliStabilizerSystem Site} {Q : QuasilocalEmbedding Site A}
variable (W : QuasilocalStabilizerState S Q)

/-- **Continuity is derived, not assumed**: positive functionals on `A` are bounded. -/
theorem continuous_state : Continuous (W.state : A → ℂ) := by fun_prop

omit [StarOrderedRing A] in
/-- **Normalization is derived**: `ω(1) = 1`, from the empty region. -/
@[simp] theorem state_one : W.state 1 = 1 := by
  have h := W.state_embed ∅ 1
  rwa [Q.embed_one, S.localState_one] at h

omit [StarOrderedRing A] in
/-- The state is positive, by definition of a positive linear map. -/
theorem state_nonneg {x : A} (hx : 0 ≤ x) : 0 ≤ W.state x := W.state.map_nonneg hx

/--
**Uniqueness of the continuous extension** (the B.L.T. step of the
manuscript's Proposition): a positive functional extending the compatible
finite local states is unique.
-/
theorem state_eq (W W' : QuasilocalStabilizerState S Q) :
    (W.state : A → ℂ) = (W'.state : A → ℂ) := by
  refine Continuous.ext_on Q.dense_localAlgebra W.continuous_state W'.continuous_state ?_
  rintro x hx
  simp only [Set.mem_iUnion, Set.mem_range] at hx
  obtain ⟨F, y, rfl⟩ := hx
  rw [W.state_embed, W'.state_embed]

omit [StarOrderedRing A] in
/-- The value of the state on a local element is the finite-stage trace value. -/
theorem state_embed_apply (F : Finset Site) (x : finiteRegionQubitAlgebra F) :
    W.state (Q.embed F x) = ((S.regionDensity F) * x).trace := W.state_embed F x

omit [StarOrderedRing A] in
/--
**Finite-stage evaluation is region independent**: the value on a full-Pauli
word does not depend on which region containing its support is used.
-/
theorem state_embed_eq_of_supportedIn (F F' : Finset Site) (hFF' : F ⊆ F')
    (a : FullPauliWord Site) (ha : a.SupportedIn F) :
    W.state (Q.embed F' (fullPauliRegionMatrix F' a)) =
      W.state (Q.embed F (fullPauliRegionMatrix F a)) := by
  rw [Q.embed_fullPauliRegionMatrix_eq F F' hFF' a ha]

omit [StarOrderedRing A] in
/-- **Every local stabilizer has expectation one in the global state.** -/
theorem state_embed_fullPauliRegionMatrix (F : Finset Site)
    (g : ↥(S.regionStabilizer F).group) :
    W.state (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site))) = 1 := by
  rw [W.state_embed, S.localState_fullPauliRegionMatrix F g]

omit [StarOrderedRing A] in
/-- The deviation of a local stabilizer from the unit is null in the state. -/
theorem state_deviation_eq_zero (F : Finset Site)
    (g : ↥(S.regionStabilizer F).group) :
    W.state (star (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site)) - 1) *
      (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site)) - 1)) = 0 := by
  obtain ⟨hmem, hsupp⟩ := (S.mem_regionStabilizer_group_iff F (g : FullPauliWord Site)).mp
    g.property
  have hinv : (g : FullPauliWord Site) * (g : FullPauliWord Site) = 1 :=
    S.involutive _ hmem
  have hstar : star (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site)) - 1) *
      (Q.embed F (fullPauliRegionMatrix F (g : FullPauliWord Site)) - 1) =
      Q.embed F (star (fullPauliRegionMatrix F (g : FullPauliWord Site) - 1) *
        (fullPauliRegionMatrix F (g : FullPauliWord Site) - 1)) := by
    rw [map_mul, map_star, map_sub, map_one]
  rw [hstar, star_sub_one_mul_sub_one_fullPauliRegionMatrix F _ hsupp hinv,
    W.state_embed, map_sub, map_smul, map_smul, S.localState_one,
    S.localState_fullPauliRegionMatrix F g]
  simp

/-! ### The GNS data of the quasilocal state -/

/-- The GNS Hilbert space of the quasilocal stabilizer state. -/
protected abbrev GNS := W.state.GNS

/-- The cyclic GNS vector `|Ω⟩` of the quasilocal stabilizer state. -/
noncomputable def gnsVector : W.GNS := gnsCyclicVector W.state

/-- The GNS representation `π_ω` of the quasilocal algebra. -/
noncomputable def gnsRepresentation : A →⋆ₐ[ℂ] (W.GNS →L[ℂ] W.GNS) :=
  W.state.gnsStarAlgHom

/-- The GNS vector is a unit vector. -/
theorem norm_gnsVector : ‖W.gnsVector‖ = 1 :=
  norm_gnsCyclicVector_eq_one W.state W.state_one

/-- **The GNS reconstruction formula** `ω(a) = ⟪Ω, π_ω(a) Ω⟫`. -/
theorem inner_gnsVector_gnsRepresentation (a : A) :
    ⟪W.gnsVector, W.gnsRepresentation a W.gnsVector⟫_ℂ = W.state a :=
  inner_gnsCyclicVector_gnsStarAlgHom_apply W.state a

/-- The finite-stage form of the reconstruction formula. -/
theorem inner_gnsVector_gnsRepresentation_embed (F : Finset Site)
    (x : finiteRegionQubitAlgebra F) :
    ⟪W.gnsVector, W.gnsRepresentation (Q.embed F x) W.gnsVector⟫_ℂ = S.localState F x := by
  rw [inner_gnsVector_gnsRepresentation, W.state_embed]

/-- The GNS vector is cyclic for the represented quasilocal algebra. -/
theorem denseRange_gnsRepresentation_gnsVector :
    DenseRange (fun a : A => W.gnsRepresentation a W.gnsVector) :=
  denseRange_gnsStarAlgHom_apply_gnsCyclicVector W.state

/--
The represented finite local algebra `𝒰_F = π_ω(𝒜_F)` of the manuscript, as a
star-algebra map from the finite matrix algebra.
-/
noncomputable def localRepresentation (F : Finset Site) :
    finiteRegionQubitAlgebra F →⋆ₐ[ℂ] (W.GNS →L[ℂ] W.GNS) :=
  W.gnsRepresentation.comp (Q.embed F)

theorem localRepresentation_apply (F : Finset Site) (x : finiteRegionQubitAlgebra F) :
    W.localRepresentation F x = W.gnsRepresentation (Q.embed F x) := rfl

/-- **Coherence of the local representations** along the directed system. -/
theorem localRepresentation_localInclusion (F F' : Finset Site) (hFF' : F ⊆ F')
    (x : finiteRegionQubitAlgebra F) :
    W.localRepresentation F' (localInclusion hFF' x) = W.localRepresentation F x := by
  rw [localRepresentation_apply, localRepresentation_apply, Q.embed_localInclusion]

/-- The finite-stage matrix coefficient of the local representation. -/
theorem inner_gnsVector_localRepresentation (F : Finset Site)
    (x : finiteRegionQubitAlgebra F) :
    ⟪W.gnsVector, W.localRepresentation F x W.gnsVector⟫_ℂ = S.localState F x :=
  W.inner_gnsVector_gnsRepresentation_embed F x

/--
**Stabilizer invariance of the GNS vector.**  Every local stabilizer fixes
`|Ω⟩` in the GNS representation.
-/
theorem gnsRepresentation_fullPauliRegionMatrix_gnsVector (F : Finset Site)
    (g : ↥(S.regionStabilizer F).group) :
    W.localRepresentation F (fullPauliRegionMatrix F (g : FullPauliWord Site))
        W.gnsVector = W.gnsVector :=
  gnsStarAlgHom_apply_gnsCyclicVector_eq_of_deviation_eq_zero W.state _
    (W.state_deviation_eq_zero F g)

end QuasilocalStabilizerState

/-! ### Positivity of the finite local states -/

section Positivity

open scoped MatrixOrder

/-- The trace pairing of two positive semidefinite matrices is nonnegative. -/
theorem posSemidef_trace_mul_nonneg {n : Type*} [Fintype n] [DecidableEq n]
    {M N : Matrix n n ℂ} (hM : M.PosSemidef) (hN : N.PosSemidef) :
    0 ≤ (M * N).trace := by
  have hs : CFC.sqrt M * CFC.sqrt M = M := CFC.sqrt_mul_sqrt_self M (ha := hM.nonneg)
  have hsq : (CFC.sqrt M).PosSemidef := Matrix.nonneg_iff_posSemidef.mp (CFC.sqrt_nonneg M)
  have h : ((CFC.sqrt M).conjTranspose * N * CFC.sqrt M).PosSemidef :=
    hN.conjTranspose_mul_mul_same _
  have h2 := h.trace_nonneg
  rw [hsq.isHermitian.eq] at h2
  calc (0 : ℂ) ≤ (CFC.sqrt M * N * CFC.sqrt M).trace := h2
    _ = (M * N).trace := by rw [Matrix.trace_mul_comm, ← mul_assoc, hs]

/--
**The finite local stabilizer state is a positive linear functional** on the
finite local matrix algebra, in the Loewner order.  This is the finite-stage
positivity behind the manuscript's approximation argument.
-/
noncomputable def FullPauliStabilizerSystem.localPositiveState
    (S : FullPauliStabilizerSystem Site) (F : Finset Site) :
    finiteRegionQubitAlgebra F →ₚ[ℂ] ℂ where
  __ := S.localState F
  monotone' := by
    intro x y hxy
    have hpos : (y - x).PosSemidef := Matrix.le_iff.mp hxy
    have h := posSemidef_trace_mul_nonneg (S.regionDensity_posSemidef F) hpos
    rw [mul_sub, Matrix.trace_sub] at h
    change S.localState F x ≤ S.localState F y
    rw [S.localState_apply, S.localState_apply]
    exact sub_nonneg.mp h

@[simp] theorem FullPauliStabilizerSystem.localPositiveState_apply
    (S : FullPauliStabilizerSystem Site) (F : Finset Site)
    (x : finiteRegionQubitAlgebra F) :
    S.localPositiveState F x = S.localState F x := rfl

end Positivity

/-! ### Non-vacuity of the completion interface -/

/--
**The interface is non-vacuous.**  Over the empty site type every finite region
is empty, and the finite local algebra of the empty region is itself a C-star
algebra satisfying all four conditions of `QuasilocalEmbedding`.
-/
noncomputable def emptySiteQuasilocalEmbedding :
    QuasilocalEmbedding Empty (finiteRegionQubitAlgebra (∅ : Finset Empty)) where
  embed F := finiteRegionEmbed F ∅ (by
    intro x _
    exact (IsEmpty.false x).elim)
  embed_injective F := finiteRegionEmbed_injective F ∅ _
  embed_localInclusion F F' h x := by
    have hF : F ⊆ (∅ : Finset Empty) := fun x _ => (IsEmpty.false x).elim
    have hF' : F' ⊆ (∅ : Finset Empty) := fun x _ => (IsEmpty.false x).elim
    exact finiteRegionEmbed_trans F F' ∅ h hF' x
  dense_localAlgebra := by
    intro x
    refine subset_closure (Set.mem_iUnion.mpr ⟨∅, x, ?_⟩)
    exact finiteRegionEmbed_self ∅ x

section EmptySiteState

open scoped MatrixOrder

/--
**The state interface is non-vacuous too.**  Over the empty site type the
finite local state of the empty region is a global state for the witness
completion, so `QuasilocalStabilizerState` is inhabited for every consistent
stabilizer system on `Empty`.
-/
noncomputable def emptySiteQuasilocalStabilizerState
    (S : FullPauliStabilizerSystem Empty) :
    QuasilocalStabilizerState S emptySiteQuasilocalEmbedding where
  state := S.localPositiveState ∅
  state_embed F x := S.localState_localInclusion F ∅ (fun y _ => (IsEmpty.false y).elim) x

end EmptySiteState

end FiniteFiber
