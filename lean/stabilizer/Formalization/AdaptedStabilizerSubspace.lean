import Formalization.SymplecticCoordinates
import Mathlib.LinearAlgebra.Finsupp.Supported
import Mathlib.LinearAlgebra.Span.Basic

/-!
# Stabilizer membership in adapted coordinates

For an adapted symplectic coordinate basis, the stabilizer subspace is the
span of its selected Z coordinates.  This module makes its finite-coordinate
membership criterion explicit: a coordinate word is a stabilizer word exactly
when it has no X coordinates and no Z coordinate outside the selected set.
-/

namespace StabilizerHyperfinite

variable {I V : Type*} [AddCommGroup V] [Module PauliBit V]

/-- The coordinate realization of the stabilizer subspace generated by the
selected Z coordinates. -/
noncomputable def coordinateStabilizerSubmodule
    (data : AdaptedPauliCoordinateBasis (I := I) (V := V)) (P : Set I) :
    Submodule PauliBit V :=
  (Finsupp.supported PauliBit PauliBit (Sum.inl '' P)).map
    data.coordinateLabelEquiv.toLinearMap

/-- A coordinate word belongs to the selected-Z stabilizer subspace exactly
when its finite support is contained in the selected Z coordinates. -/
theorem coordinateLabelEquiv_mem_coordinateStabilizerSubmodule_iff
    (data : AdaptedPauliCoordinateBasis (I := I) (V := V)) (P : Set I)
    (label : PauliCoordinateLabels I) :
    data.coordinateLabelEquiv label ∈ coordinateStabilizerSubmodule data P ↔
      (label.support : Set (Sum I I)) ⊆ Sum.inl '' P := by
  constructor
  · intro h
    rcases h with ⟨c, hc, h_equal⟩
    have h_c_eq : c = label := data.coordinateLabelEquiv.injective h_equal
    subst c
    exact (Finsupp.mem_supported PauliBit label).mp hc
  · intro h
    refine ⟨label, ?_, rfl⟩
    exact (Finsupp.mem_supported PauliBit label).mpr h

/-- The coordinate submodule is precisely the span of the selected Z basis
vectors, matching the stabilizer subspace in the short-range theorem. -/
theorem coordinateStabilizerSubmodule_eq_span_selectedZ
    (data : AdaptedPauliCoordinateBasis (I := I) (V := V)) (P : Set I) :
    coordinateStabilizerSubmodule data P =
      Submodule.span PauliBit (data.z '' P) := by
  rw [coordinateStabilizerSubmodule, Finsupp.supported_eq_span_single,
    Submodule.map_span]
  congr 1
  ext v
  constructor
  · intro h
    rcases h with ⟨label, ⟨i, ⟨j, hj, rfl⟩, rfl⟩, rfl⟩
    change data.coordinateLabelEquiv (Finsupp.single (Sum.inl j) 1) ∈ data.z '' P
    rw [data.coordinateLabelEquiv_z]
    exact ⟨j, hj, rfl⟩
  · intro h
    rcases h with ⟨j, hj, rfl⟩
    refine ⟨Finsupp.single (Sum.inl j) 1, ?_, ?_⟩
    · exact ⟨Sum.inl j, ⟨j, hj, rfl⟩, rfl⟩
    · change data.coordinateLabelEquiv (Finsupp.single (Sum.inl j) 1) = data.z j
      exact data.coordinateLabelEquiv_z j

/-- The support condition has the pointwise form used in the stabilizer-state
selection rule: all X coefficients vanish and only selected Z coefficients
may remain. -/
theorem coordinateSupport_subset_selectedZ_iff
    (P : Set I) (label : PauliCoordinateLabels I) :
    (label.support : Set (Sum I I)) ⊆ Sum.inl '' P ↔
      (∀ i, label (Sum.inr i) = 0) ∧
        ∀ i, i ∉ P → label (Sum.inl i) = 0 := by
  constructor
  · intro h
    constructor
    · intro i
      by_contra h_nonzero
      have h_mem : Sum.inr i ∈ label.support := Finsupp.mem_support_iff.mpr h_nonzero
      have h_image := h h_mem
      rcases h_image with ⟨j, hj, h_eq⟩
      cases h_eq
    · intro i hi
      by_contra h_nonzero
      have h_mem : Sum.inl i ∈ label.support := Finsupp.mem_support_iff.mpr h_nonzero
      rcases h h_mem with ⟨j, hj, h_eq⟩
      have h_ji : j = i := Sum.inl.inj h_eq
      exact hi (h_ji ▸ hj)
  · intro h index h_index
    cases index with
    | inl i =>
      by_cases hi : i ∈ P
      · exact ⟨i, hi, rfl⟩
      · have h_nonzero : label (Sum.inl i) ≠ 0 := Finsupp.mem_support_iff.mp h_index
        exact (h_nonzero (h.2 i hi)).elim
    | inr i =>
      have h_nonzero : label (Sum.inr i) ≠ 0 := Finsupp.mem_support_iff.mp h_index
      exact (h_nonzero (h.1 i)).elim

/-- Stabilizer membership in adapted coordinates is exactly the pure/mixed
Pauli selection rule appearing in the proposed regional density matrix. -/
theorem coordinateLabelEquiv_mem_selectedZ_iff
    (data : AdaptedPauliCoordinateBasis (I := I) (V := V)) (P : Set I)
    (label : PauliCoordinateLabels I) :
    data.coordinateLabelEquiv label ∈ coordinateStabilizerSubmodule data P ↔
      (∀ i, label (Sum.inr i) = 0) ∧
        ∀ i, i ∉ P → label (Sum.inl i) = 0 := by
  rw [coordinateLabelEquiv_mem_coordinateStabilizerSubmodule_iff,
    coordinateSupport_subset_selectedZ_iff]

end StabilizerHyperfinite
