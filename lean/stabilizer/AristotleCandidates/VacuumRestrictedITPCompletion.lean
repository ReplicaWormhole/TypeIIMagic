/-
P57B — vacuum-restricted ITP quotient and completion.

**Context declaration: Infrastructure only.**  This file makes no manuscript
claim: no GNS identification, no `B(K)` closure or factor theorem, no spatial
von Neumann tensor product, and no trace or weight statement.

Starting from the *proved* finite-support pre-inner-product core
`AristotleCandidates.VacuumRestrictedITP.itpCore` of P57A, this module builds
the Hilbert space implicit in that core:

* `ITPPre hΩ` — the algebraic span `ITPSpan Ω` carrying the seminormed
  complex inner-product structure generated by `itpCore hΩ` (Mathlib's
  `InnerProductSpace.Core.toSeminormedAddCommGroup` and
  `InnerProductSpace.ofCore`);
* `ITPQuot hΩ = SeparationQuotient (ITPPre hΩ)` — the genuine quotient by the
  null space `{x | ‖x‖ = 0} = {x | ⟪x, x⟫ = 0}`, a *normed* (hence
  positive-definite) complex inner-product space
  (`SeparationQuotient`'s `NormedAddCommGroup` instance from
  `Mathlib.Analysis.Normed.Group.Uniform` and its `InnerProductSpace` instance
  from `Mathlib.Analysis.InnerProductSpace.Completion`);
* `ITPHilbert hΩ = UniformSpace.Completion (ITPQuot hΩ)` — its uniform-space
  completion, a complete normed complex inner-product space, i.e. a Hilbert
  space (`UniformSpace.Completion.instNormedAddCommGroup`, the completion's
  `CompleteSpace` instance, and
  `UniformSpace.Completion.innerProductSpace`).

The algebraic span maps into it by the continuous linear map
`itpEmbed hΩ : ITPSpan Ω →ₗ[ℂ] ITPHilbert hΩ`, which

* preserves the P57A form: `itpEmbed_inner`;
* is isometric for the core seminorm: `norm_itpEmbed`;
* identifies exactly the null vectors: `itpEmbed_eq_iff`,
  `itpEmbed_eq_zero_iff`;
* has dense range: `denseRange_itpEmbed`; and
* sends the algebraic vacuum to a unit vector: `norm_itpEmbed_vacuumVector`.

Nothing here is assumed: every instance is transferred by proof from P57A and
the pinned Mathlib, and no axiom, `sorry`, or completion interface is used.
-/
import AristotleCandidates.VacuumRestrictedInfiniteTensorProduct
import Mathlib.Analysis.InnerProductSpace.Completion
import Mathlib.Analysis.Normed.Module.Completion
import Mathlib.Analysis.Normed.Group.NullSubmodule

open scoped ComplexConjugate ComplexOrder InnerProductSpace

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

namespace AristotleCandidates
namespace VacuumRestrictedITP

universe u v

/-- A nonnegative complex number vanishes iff the square root of its real part does. -/
theorem sqrt_re_eq_zero_iff {c : ℂ} (hc : 0 ≤ c) : √(RCLike.re c) = 0 ↔ c = 0 := by
  obtain ⟨hre, him⟩ := Complex.le_def.mp hc
  have hre' : (0 : ℝ) ≤ c.re := by simpa using hre
  constructor
  · intro h
    have : c.re = 0 := by
      have := Real.sq_sqrt (by simpa using hre' : (0:ℝ) ≤ RCLike.re c)
      rw [h] at this
      simpa [eq_comm] using this
    exact Complex.ext (by simpa using this) (by simpa using him.symm)
  · intro h
    simp [h]

variable {ι : Type u} {E : ι → Type v}
  [∀ i, NormedAddCommGroup (E i)] [∀ i, InnerProductSpace ℂ (E i)]
  {Ω : ∀ i, E i} [DecidableEq ι]

/-! ## The seminormed pre-Hilbert space of the algebraic span -/

/-- The algebraic span of vacuum-restricted elementary tensors, viewed as a type carrying the
seminormed complex inner-product structure produced by the P57A core `itpCore hΩ`.  This is a
type synonym for `ITPSpan Ω`; the synonym exists only so that the core-generated seminorm does
not clash with any other structure on `Finsupp`. -/
def ITPPre (_hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) : Type max u v := ITPSpan Ω

namespace ITPPre

variable (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1)

noncomputable instance : AddCommGroup (ITPPre hΩ) := inferInstanceAs (AddCommGroup (ITPSpan Ω))

noncomputable instance : Module ℂ (ITPPre hΩ) := inferInstanceAs (Module ℂ (ITPSpan Ω))

/-- The P57A pre-inner-product core, installed as a class instance on the synonym. -/
noncomputable instance instCore : PreInnerProductSpace.Core ℂ (ITPPre hΩ) := itpCore hΩ

/-- The seminormed group structure generated by the core. -/
noncomputable instance instSeminormedAddCommGroup : SeminormedAddCommGroup (ITPPre hΩ) :=
  InnerProductSpace.Core.toSeminormedAddCommGroup (𝕜 := ℂ) (F := ITPPre hΩ)

/-- The (semi-definite) complex inner-product space structure generated by the core. -/
noncomputable instance instInnerProductSpace : InnerProductSpace ℂ (ITPPre hΩ) :=
  InnerProductSpace.ofCore (F := ITPPre hΩ) (instCore hΩ)

/-- The inner product on `ITPPre hΩ` is the P57A sesquilinear form. -/
@[simp] theorem inner_eq (x y : ITPPre hΩ) :
    ⟪x, y⟫_ℂ = itpInner (Ω := Ω) x y := rfl

theorem norm_eq (x : ITPPre hΩ) : ‖x‖ = √(RCLike.re (itpInner (Ω := Ω) x x)) := rfl

/-- The seminorm of `x` vanishes exactly when `x` is null for the P57A form. -/
theorem norm_eq_zero_iff (x : ITPPre hΩ) : ‖x‖ = 0 ↔ itpInner (Ω := Ω) x x = 0 := by
  rw [norm_eq]
  exact sqrt_re_eq_zero_iff (itpInner_nonneg hΩ x)

end ITPPre

/-! ## The null-space quotient -/

/-- The genuine quotient of the algebraic span by its null space: two elements of `ITPPre hΩ`
become equal exactly when their difference has vanishing self-inner-product. -/
abbrev ITPQuot (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) : Type max u v := SeparationQuotient (ITPPre hΩ)

section Quot

variable (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1)

/-- The quotient carries a genuine (positive definite) norm. -/
noncomputable def itpQuotNormedAddCommGroup : NormedAddCommGroup (ITPQuot hΩ) := inferInstance

/-- The quotient is a complex inner-product space. -/
noncomputable def itpQuotInnerProductSpace : InnerProductSpace ℂ (ITPQuot hΩ) := inferInstance

/-- The null space that is being quotiented out is exactly the set of vectors with vanishing
self-inner-product for the P57A form. -/
theorem mem_nullSubmodule_iff_inner (x : ITPPre hΩ) :
    x ∈ nullSubmodule ℂ (ITPPre hΩ) ↔ itpInner (Ω := Ω) x x = 0 := by
  rw [mem_nullSubmodule_iff, ITPPre.norm_eq_zero_iff hΩ]

/-- The quotient map kills exactly the null vectors: this is the null-space quotient. -/
theorem mk_eq_zero_iff_inner (x : ITPPre hΩ) :
    (SeparationQuotient.mk x : ITPQuot hΩ) = 0 ↔ itpInner (Ω := Ω) x x = 0 := by
  rw [← norm_eq_zero (E := ITPQuot hΩ) (a := SeparationQuotient.mk x),
    SeparationQuotient.norm_mk, ITPPre.norm_eq_zero_iff hΩ]

end Quot

/-! ## The completion: an actual Hilbert space -/

/-- The vacuum-restricted infinite tensor product Hilbert space: the completion of the
null-space quotient of the algebraic span. -/
abbrev ITPHilbert (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1) : Type max u v :=
  UniformSpace.Completion (ITPQuot hΩ)

section Hilbert

variable (hΩ : ∀ i, ⟪Ω i, Ω i⟫_ℂ = 1)

/-- `ITPHilbert hΩ` carries a genuine (positive definite) norm. -/
noncomputable def itpHilbertNormedAddCommGroup : NormedAddCommGroup (ITPHilbert hΩ) :=
  inferInstance

/-- `ITPHilbert hΩ` is a complex inner-product space. -/
noncomputable def itpHilbertInnerProductSpace : InnerProductSpace ℂ (ITPHilbert hΩ) :=
  inferInstance

/-- `ITPHilbert hΩ` is complete: together with the two structures above it is a Hilbert space. -/
theorem itpHilbert_completeSpace : CompleteSpace (ITPHilbert hΩ) := inferInstance

/-- The canonical continuous linear map from the algebraic span into the completion. -/
noncomputable def itpEmbedL : ITPPre hΩ →L[ℂ] ITPHilbert hΩ :=
  (UniformSpace.Completion.toComplL : ITPQuot hΩ →L[ℂ] ITPHilbert hΩ).comp
    (SeparationQuotient.mkCLM ℂ (ITPPre hΩ))

/-- The canonical linear map from the P57A algebraic span into the completion Hilbert space. -/
noncomputable def itpEmbed : ITPSpan Ω →ₗ[ℂ] ITPHilbert hΩ := (itpEmbedL hΩ).toLinearMap

theorem itpEmbed_apply (x : ITPSpan Ω) :
    itpEmbed hΩ x
      = ((SeparationQuotient.mk (x : ITPPre hΩ) : ITPQuot hΩ) : ITPHilbert hΩ) := rfl

/-- **The embedding preserves the P57A form.** -/
@[simp] theorem itpEmbed_inner (x y : ITPSpan Ω) :
    ⟪itpEmbed hΩ x, itpEmbed hΩ y⟫_ℂ = itpInner (Ω := Ω) x y := by
  rw [itpEmbed_apply, itpEmbed_apply, UniformSpace.Completion.inner_coe,
    SeparationQuotient.inner_mk_mk, ITPPre.inner_eq]

/-- **The embedding is isometric for the core seminorm.** -/
theorem norm_itpEmbed (x : ITPSpan Ω) :
    ‖itpEmbed hΩ x‖ = √(RCLike.re (itpInner (Ω := Ω) x x)) := by
  rw [itpEmbed_apply, UniformSpace.Completion.norm_coe, SeparationQuotient.norm_mk,
    ITPPre.norm_eq]

/-- **The embedding identifies exactly the null vectors**: two algebraic vectors have the same
image iff their difference is null for the P57A form.  This is what makes the construction a
genuine quotient rather than a seminormed space renamed as a Hilbert space. -/
theorem itpEmbed_eq_iff (x y : ITPSpan Ω) :
    itpEmbed hΩ x = itpEmbed hΩ y ↔ itpInner (Ω := Ω) (x - y) (x - y) = 0 := by
  rw [← sub_eq_zero, ← map_sub, ← norm_eq_zero (a := itpEmbed hΩ (x - y)), norm_itpEmbed]
  exact sqrt_re_eq_zero_iff (itpInner_nonneg hΩ (x - y))

theorem itpEmbed_eq_zero_iff (x : ITPSpan Ω) :
    itpEmbed hΩ x = 0 ↔ itpInner (Ω := Ω) x x = 0 := by
  rw [← norm_eq_zero (a := itpEmbed hΩ x), norm_itpEmbed]
  exact sqrt_re_eq_zero_iff (itpInner_nonneg hΩ x)

/-- **The algebraic image is dense.** -/
theorem denseRange_itpEmbed : DenseRange (itpEmbed hΩ) := by
  have hcoe : DenseRange ((↑) : ITPQuot hΩ → ITPHilbert hΩ) :=
    UniformSpace.Completion.denseRange_coe
  have hmk : Function.Surjective (SeparationQuotient.mk : ITPPre hΩ → ITPQuot hΩ) :=
    SeparationQuotient.surjective_mk
  have hrange : Set.range (itpEmbed hΩ) = Set.range ((↑) : ITPQuot hΩ → ITPHilbert hΩ) := by
    apply Set.Subset.antisymm
    · rintro z ⟨x, rfl⟩
      exact ⟨SeparationQuotient.mk (x : ITPPre hΩ), rfl⟩
    · rintro z ⟨q, rfl⟩
      obtain ⟨x, rfl⟩ := hmk q
      exact ⟨(x : ITPSpan Ω), rfl⟩
  rw [DenseRange, hrange]
  exact hcoe

/-- **The vacuum image is a unit vector.** -/
@[simp] theorem norm_itpEmbed_vacuumVector :
    ‖itpEmbed hΩ (vacuumVector Ω)‖ = 1 := by
  rw [norm_itpEmbed, itpInner_vacuumVector]
  simp

/-- The vacuum image is in particular nonzero, so the completion is nontrivial. -/
theorem itpEmbed_vacuumVector_ne_zero : itpEmbed hΩ (vacuumVector Ω) ≠ 0 := by
  intro h
  have hn := norm_itpEmbed_vacuumVector hΩ
  rw [h] at hn
  simp at hn

end Hilbert

/-! ## The quotient is not vacuous

The algebraic span really does contain nonzero null vectors, so the passage to
`SeparationQuotient` genuinely identifies distinct algebraic vectors.  Take `ι = ℕ`, `E i = ℂ`,
`Ω i = 1`; the elementary tensor which is `1` in every mode but declares mode `0` active is a
different `VacuumTensor` from the vacuum, yet all four kernels are `1`, so their difference is a
nonzero null vector. -/

section Nondegenerate

/-- The all-ones elementary tensor over `ι = ℕ` with mode `0` declared active. -/
def dupTensor : VacuumTensor (fun _ : ℕ => (1 : ℂ)) where
  vec _ := 1
  active := {0}
  vec_eq_vacuum _ _ := rfl

theorem vacuum_inner_one : ∀ _i : ℕ, ⟪(1 : ℂ), (1 : ℂ)⟫_ℂ = 1 := by
  intro _; simp

theorem dupTensor_ne_vacuum :
    dupTensor ≠ VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ)) := by
  intro h
  have hact : dupTensor.active = (VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ))).active := by rw [h]
  simp [dupTensor, VacuumTensor.vacuum] at hact

/-- A nonzero vector of the algebraic span which is null for the P57A form. -/
noncomputable def nullExample : ITPSpan (fun _ : ℕ => (1 : ℂ)) :=
  Finsupp.single dupTensor 1 - Finsupp.single (VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ))) 1

theorem nullExample_dup : nullExample dupTensor = 1 := by
  rw [nullExample, Finsupp.sub_apply, Finsupp.single_eq_same,
    Finsupp.single_eq_of_ne dupTensor_ne_vacuum]
  ring

theorem nullExample_vacuum :
    nullExample (VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ))) = -1 := by
  rw [nullExample, Finsupp.sub_apply, Finsupp.single_eq_same,
    Finsupp.single_eq_of_ne (Ne.symm dupTensor_ne_vacuum)]
  ring

theorem nullExample_ne_zero : nullExample ≠ 0 := by
  intro h
  have hv : nullExample dupTensor = 0 := by rw [h]; rfl
  rw [nullExample_dup] at hv
  exact one_ne_zero hv

theorem itpInner_nullExample : itpInner nullExample nullExample = 0 := by
  classical
  set t : Finset (VacuumTensor (fun _ : ℕ => (1 : ℂ))) :=
    {dupTensor, VacuumTensor.vacuum (fun _ : ℕ => (1 : ℂ))} with ht
  have hsupp : (nullExample).support ⊆ t := by
    refine (Finsupp.support_sub).trans (Finset.union_subset ?_ ?_)
    · exact Finsupp.support_single_subset.trans (by simp [ht])
    · exact Finsupp.support_single_subset.trans (by simp [ht])
  have hkern : ∀ v ∈ t, ∀ w ∈ t, kern v w = 1 := by
    intro v hv w hw
    have hv' : v.vec = fun _ => (1 : ℂ) := by
      rcases Finset.mem_insert.mp hv with h | h
      · subst h; rfl
      · rw [Finset.mem_singleton] at h; subst h; rfl
    have hw' : w.vec = fun _ => (1 : ℂ) := by
      rcases Finset.mem_insert.mp hw with h | h
      · subst h; rfl
      · rw [Finset.mem_singleton] at h; subst h; rfl
    simp [kern, hv', hw']
  have hsum : ∑ w ∈ t, nullExample w = 0 := by
    rw [ht, Finset.sum_pair dupTensor_ne_vacuum, nullExample_dup, nullExample_vacuum]
    ring
  have hconj : ∑ v ∈ t, (starRingEnd ℂ) (nullExample v) = 0 := by
    rw [← map_sum, hsum, map_zero]
  rw [itpInner_eq_sum hsupp hsupp]
  have hrw : ∀ v ∈ t, ∑ w ∈ t, (starRingEnd ℂ) (nullExample v) * nullExample w * kern v w
      = ∑ w ∈ t, (starRingEnd ℂ) (nullExample v) * nullExample w := by
    intro v hv
    refine Finset.sum_congr rfl fun w hw => ?_
    rw [hkern v hv w hw, mul_one]
  rw [Finset.sum_congr rfl hrw, ← Finset.sum_mul_sum, hconj, zero_mul]

/-- **The quotient is genuine**: a nonzero algebraic vector is sent to `0` in the completion. -/
theorem itpEmbed_nullExample_eq_zero :
    itpEmbed (Ω := fun _ : ℕ => (1 : ℂ)) vacuum_inner_one nullExample = 0 ∧ nullExample ≠ 0 :=
  ⟨(itpEmbed_eq_zero_iff vacuum_inner_one nullExample).2 itpInner_nullExample,
    nullExample_ne_zero⟩

end Nondegenerate

end VacuumRestrictedITP
end AristotleCandidates
