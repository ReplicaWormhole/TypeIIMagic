import Formalization.DyadicTensorTower
import AristotleCandidates.AlgebraicLimitOperatorRepresentation
import AristotleCandidates.ConcreteCStarCompletion

/-!
# A faithful reference representation of the dyadic (UHF) algebra

**Context declaration.** *Infrastructure only*: this module makes no manuscript
claim.  It constructs reusable Lean mathematics.

Starting from the checked dyadic finite-stage system
`StabilizerHyperfinite.QubitTensorPower` / `qubitTensorPowerMap` of
`Formalization.DyadicTensorTower` and its canonical normalized finite-stage
traces, this file **constructs**

* the algebraic positive cone `sumSqCone` of finite sums of elements
  `star s * s` in a `*`-ring, and the induced algebraic order `SumSqLE`;
* the finite-stage operator bound `qubitTensorPower_exists_bound`: for every
  finite dyadic stage element `x` there are `c ≥ 0` and an explicit cone
  certificate for `star x * x ≼ c • 1`, and its direct-limit form
  `qubitUHF_exists_bound`.  These are proved *algebraically*, by induction
  along the matrix tower; no C*-norm, functional calculus or completion is
  used;
* faithfulness `qubitTensorTrace_faithful` and hermitianity
  `qubitTensorTrace_star` of the finite-stage normalized traces, and their
  direct-limit counterparts;
* the **GNS pre-Hilbert space** `UHFL2` of the algebraic limit
  `QubitUHFAlgebra` for the canonical trace `qubitUHFTrace`, i.e. the algebraic
  limit equipped with the inner product `⟪a, b⟫ = τ (star a * b)`;
* its Hilbert-space completion `UHFGNS := UniformSpace.Completion UHFL2`
  (a genuine `NormedAddCommGroup` + `InnerProductSpace ℂ` + `CompleteSpace`);
* the trace-square-norm bound `uhfNormSq_mul_le` for left multiplication, the
  purely algebraic substitute for the C*-inequality `‖z w‖₂ ≤ ‖z‖ ‖w‖₂`;
* the representation `uhfRep : QubitUHFAlgebra →⋆ₐ[ℂ] (UHFGNS →L[ℂ] UHFGNS)`
  by left multiplication, its **faithfulness** `uhfRep_injective`, its unit
  cyclic vector (`uhfCyclicVector_norm`), and the vector-state identity
  `uhfRep_vector_state : ⟪Ω, uhfRep z Ω⟫ = τ z`;
* the compatible family of finite-stage representations
  `uhfRepData : QubitOperatorRepresentationData UHFGNS`, each stage
  representation being injective (`uhfRepData_rho_injective`), whose induced
  limit representation is `uhfRep` (`uhfRepData_limitRep`);
* the concrete C*-algebra `UHFConcreteCStar`, the closure of the operator range
  of `uhfRep` inside `UHFGNS →L[ℂ] UHFGNS`, together with the dense range of the
  canonical map from the algebraic limit.

## What is supplied and what is constructed

Everything above is **constructed** from the dyadic tower and its traces.  In
particular the Hilbert space is *not* supplied: it is the trace-GNS completion
of the algebraic limit.  **No infinite tensor-product Hilbert space is
postulated**, no von Neumann algebra, bicommutant, weak closure, tensor
factorization, factor type, trace or weight classification is claimed, and no
manuscript statement is used or asserted.

## Auxiliary assumptions

None.  All statements below are unconditional consequences of the pinned
Mathlib version and of the previously checked dyadic tower.
-/

namespace StabilizerHyperfinite

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

open scoped ComplexOrder InnerProductSpace
open Complex UniformSpace

/-! ## 1. The algebraic sum-of-squares cone -/

section Cone

variable {A : Type*} [Semiring A] [StarRing A]

/-- The algebraic positive cone of a `*`-semiring: the additive submonoid
generated by the elements `star s * s`.  This is the purely algebraic
substitute for the positive cone of a C*-algebra; no norm, order structure or
functional calculus is involved. -/
def sumSqCone (A : Type*) [Semiring A] [StarRing A] : AddSubmonoid A :=
  AddSubmonoid.closure (Set.range fun s : A => star s * s)

theorem star_mul_self_mem_sumSqCone (s : A) : star s * s ∈ sumSqCone A :=
  AddSubmonoid.subset_closure ⟨s, rfl⟩

theorem zero_mem_sumSqCone : (0 : A) ∈ sumSqCone A := (sumSqCone A).zero_mem

theorem add_mem_sumSqCone {a b : A} (ha : a ∈ sumSqCone A) (hb : b ∈ sumSqCone A) :
    a + b ∈ sumSqCone A := (sumSqCone A).add_mem ha hb

theorem nsmul_mem_sumSqCone {a : A} (ha : a ∈ sumSqCone A) (k : ℕ) :
    k • a ∈ sumSqCone A := AddSubmonoid.nsmul_mem _ ha k

/-- Induction principle for membership in the algebraic positive cone. -/
theorem sumSqCone_induction {p : A → Prop}
    (hzero : p 0) (hgen : ∀ s : A, p (star s * s))
    (hadd : ∀ x y, p x → p y → p (x + y)) {a : A} (ha : a ∈ sumSqCone A) : p a := by
  refine AddSubmonoid.closure_induction (motive := fun x _ => p x) ?_ hzero
    (fun x y _ _ => hadd x y) ha
  rintro x ⟨s, rfl⟩
  exact hgen s

/-- The algebraic positive cone is stable under conjugation `a ↦ star v * a * v`. -/
theorem sumSqCone_conj {a : A} (ha : a ∈ sumSqCone A) (v : A) :
    star v * a * v ∈ sumSqCone A := by
  refine sumSqCone_induction (p := fun a => star v * a * v ∈ sumSqCone A) ?_ ?_ ?_ ha
  · simp
  · intro s
    have h : star v * (star s * s) * v = star (s * v) * (s * v) := by
      simp [star_mul, mul_assoc]
    rw [h]
    exact star_mul_self_mem_sumSqCone _
  · intro x y hx hy
    have h : star v * (x + y) * v = star v * x * v + star v * y * v := by
      simp [mul_add, add_mul]
    rw [h]
    exact add_mem_sumSqCone hx hy

/-- Star-algebra homomorphisms map the algebraic positive cone into the
algebraic positive cone. -/
theorem sumSqCone_map {B : Type*} [Semiring B] [StarRing B] [Algebra ℂ A] [Algebra ℂ B]
    (φ : A →⋆ₐ[ℂ] B) {a : A} (ha : a ∈ sumSqCone A) : φ a ∈ sumSqCone B := by
  refine sumSqCone_induction (p := fun a => φ a ∈ sumSqCone B) ?_ ?_ ?_ ha
  · simp
  · intro s
    rw [map_mul, map_star]
    exact star_mul_self_mem_sumSqCone _
  · intro x y hx hy
    rw [map_add]
    exact add_mem_sumSqCone hx hy

/-- The algebraic order attached to the sum-of-squares cone, in a
subtraction-free formulation: `SumSqLE a b` means that `b` exceeds `a` by an
element of the algebraic positive cone.  Stating it this way makes it
meaningful for `*`-semirings, and in particular independent of which additive
inverse structure a given stage algebra is equipped with. -/
def SumSqLE (a b : A) : Prop := ∃ p ∈ sumSqCone A, b = a + p

theorem SumSqLE.refl (a : A) : SumSqLE a a :=
  ⟨0, zero_mem_sumSqCone, by simp⟩

theorem SumSqLE.trans {a b c : A} (hab : SumSqLE a b) (hbc : SumSqLE b c) : SumSqLE a c := by
  obtain ⟨p, hp, hpEq⟩ := hab
  obtain ⟨q, hq, hqEq⟩ := hbc
  refine ⟨p + q, add_mem_sumSqCone hp hq, ?_⟩
  rw [hqEq, hpEq, add_assoc]

theorem SumSqLE.add {a b a' b' : A} (h : SumSqLE a b) (h' : SumSqLE a' b') :
    SumSqLE (a + a') (b + b') := by
  obtain ⟨p, hp, hpEq⟩ := h
  obtain ⟨q, hq, hqEq⟩ := h'
  refine ⟨p + q, add_mem_sumSqCone hp hq, ?_⟩
  rw [hpEq, hqEq]
  abel

theorem SumSqLE.nsmul {a b : A} (h : SumSqLE a b) (k : ℕ) : SumSqLE (k • a) (k • b) := by
  obtain ⟨p, hp, hpEq⟩ := h
  refine ⟨k • p, nsmul_mem_sumSqCone hp k, ?_⟩
  rw [hpEq, smul_add]

/-- The two-term parallelogram bound
`star (a+b) * (a+b) ≼ 2 • star a * a + 2 • star b * b`, witnessed by the
explicit cone element `star (a-b) * (a-b)`. -/
theorem SumSqLE.star_add_mul_self {A : Type*} [Ring A] [StarRing A] (a b : A) :
    SumSqLE (star (a + b) * (a + b)) ((2 : ℕ) • (star a * a) + (2 : ℕ) • (star b * b)) := by
  refine ⟨star (a - b) * (a - b), star_mul_self_mem_sumSqCone _, ?_⟩
  simp only [star_add, star_sub, two_nsmul]
  noncomm_ring

end Cone

/-! ## 2. The algebraic operator bound along the matrix tower -/

section MatrixBound

open Matrix

variable {B : Type*} [Semiring B] [StarRing B] [Algebra ℂ B] [StarModule ℂ B]

/-- A nonnegative real scalar lies in the algebraic positive cone. -/
theorem algebraMap_mem_sumSqCone {c : ℝ} (hc : 0 ≤ c) :
    algebraMap ℂ B (c : ℂ) ∈ sumSqCone B := by
  have h : algebraMap ℂ B (c : ℂ)
      = star (algebraMap ℂ B ((Real.sqrt c : ℝ) : ℂ)) *
          algebraMap ℂ B ((Real.sqrt c : ℝ) : ℂ) := by
    rw [← algebraMap_star_comm, ← map_mul, Complex.star_def, Complex.conj_ofReal,
      ← Complex.ofReal_mul, Real.mul_self_sqrt hc]
  rw [h]
  exact star_mul_self_mem_sumSqCone _

omit [StarRing B] [StarModule ℂ B] in
/-- Natural-number multiples of scalars are scalars. -/
theorem nsmul_algebraMap (k : ℕ) (z : ℂ) :
    k • algebraMap ℂ B z = algebraMap ℂ B ((k : ℂ) * z) := by
  rw [map_mul, map_natCast, nsmul_eq_mul]

variable {n : Type*} [Fintype n] [DecidableEq n]

omit [Algebra ℂ B] [StarModule ℂ B] in
/-- The star-square of a matrix unit is a diagonal matrix unit. -/
theorem star_single_mul_single (i j : n) (b : B) :
    star (Matrix.single i j b) * Matrix.single i j b = Matrix.single j j (star b * b) := by
  ext k l
  simp only [Matrix.mul_apply, Matrix.star_apply, Matrix.single_apply, ite_and]
  aesop

omit [Algebra ℂ B] [StarModule ℂ B] in
/-- Diagonal matrix units of cone elements lie in the cone. -/
theorem single_diag_mem_sumSqCone {w : B} (hw : w ∈ sumSqCone B) (j : n) :
    Matrix.single j j w ∈ sumSqCone (Matrix n n B) := by
  refine sumSqCone_induction (p := fun w => Matrix.single j j w ∈ sumSqCone (Matrix n n B))
    ?_ ?_ ?_ hw
  · simp
  · intro s
    rw [← star_single_mul_single j j s]
    exact star_mul_self_mem_sumSqCone _
  · intro x y hx hy
    rw [Matrix.single_add]
    exact add_mem_sumSqCone hx hy

omit [StarRing B] [StarModule ℂ B] in
/-- Scalars in a matrix algebra are the sum of the diagonal matrix units. -/
theorem algebraMap_matrix_eq_sum_single (c : ℂ) :
    algebraMap ℂ (Matrix n n B) c = ∑ i : n, Matrix.single i i (algebraMap ℂ B c) := by
  rw [Matrix.algebraMap_eq_diagonal]
  ext k l
  rw [Matrix.sum_apply]
  by_cases h : k = l
  · subst h; simp [Matrix.single_apply]
  · rw [Matrix.diagonal_apply_ne _ h]
    refine (Finset.sum_eq_zero ?_).symm
    intro x _
    rw [Matrix.single_apply, if_neg]
    rintro ⟨rfl, rfl⟩
    exact h rfl

/-- A coefficient bound lifts to a bound for the corresponding diagonal matrix
unit. -/
theorem SumSqLE.single_diag {w : B} {c : ℝ} (hc : 0 ≤ c)
    (h : SumSqLE w (algebraMap ℂ B (c : ℂ))) (j : n) :
    SumSqLE (Matrix.single j j w) (algebraMap ℂ (Matrix n n B) (c : ℂ)) := by
  obtain ⟨p, hp, hpEq⟩ := h
  refine ⟨Matrix.single j j p +
      ∑ i ∈ Finset.univ.erase j, Matrix.single i i (algebraMap ℂ B (c : ℂ)),
    add_mem_sumSqCone (single_diag_mem_sumSqCone hp j) (AddSubmonoid.sum_mem _ ?_), ?_⟩
  · intro i _
    exact single_diag_mem_sumSqCone (algebraMap_mem_sumSqCone hc) i
  · rw [algebraMap_matrix_eq_sum_single, ← Finset.add_sum_erase _ _ (Finset.mem_univ j), hpEq,
      Matrix.single_add, add_assoc]

/-- **Matrix induction step.**  If every coefficient of a `*`-algebra `B`
admits an algebraic scalar bound for its star-square, then so does every
element of the `2 × 2` matrix algebra over `B`.  The proof is purely
algebraic: matrix-unit decomposition plus the parallelogram bound.  No norm,
completion or functional calculus is used. -/
theorem matrix_two_exists_bound {B : Type*} [Ring B] [StarRing B] [Algebra ℂ B] [StarModule ℂ B]
    (hB : ∀ b : B, ∃ c : ℝ, 0 ≤ c ∧ SumSqLE (star b * b) (algebraMap ℂ B (c : ℂ)))
    (X : Matrix (Fin 2) (Fin 2) B) :
    ∃ c : ℝ, 0 ≤ c ∧
      SumSqLE (star X * X) (algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c : ℂ)) := by
  obtain ⟨c00, hc00, k00⟩ := hB (X 0 0)
  obtain ⟨c01, hc01, k01⟩ := hB (X 0 1)
  obtain ⟨c10, hc10, k10⟩ := hB (X 1 0)
  obtain ⟨c11, hc11, k11⟩ := hB (X 1 1)
  set P : Matrix (Fin 2) (Fin 2) B := Matrix.single 0 0 (X 0 0) with hP
  set Q : Matrix (Fin 2) (Fin 2) B := Matrix.single 0 1 (X 0 1) with hQ
  set R : Matrix (Fin 2) (Fin 2) B := Matrix.single 1 0 (X 1 0) with hR
  set S : Matrix (Fin 2) (Fin 2) B := Matrix.single 1 1 (X 1 1) with hS
  have hX : X = (P + Q) + (R + S) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [hP, hQ, hR, hS]
  refine ⟨4 * c00 + 4 * c01 + 4 * c10 + 4 * c11, by positivity, ?_⟩
  have step1 : SumSqLE (star X * X)
      ((2 : ℕ) • (star (P + Q) * (P + Q)) + (2 : ℕ) • (star (R + S) * (R + S))) := by
    rw [hX]
    exact SumSqLE.star_add_mul_self _ _
  have step2 : SumSqLE ((2 : ℕ) • (star (P + Q) * (P + Q)))
      ((2 : ℕ) • ((2 : ℕ) • (star P * P) + (2 : ℕ) • (star Q * Q))) :=
    (SumSqLE.star_add_mul_self P Q).nsmul 2
  have step3 : SumSqLE ((2 : ℕ) • (star (R + S) * (R + S)))
      ((2 : ℕ) • ((2 : ℕ) • (star R * R) + (2 : ℕ) • (star S * S))) :=
    (SumSqLE.star_add_mul_self R S).nsmul 2
  have step4 := step1.trans (step2.add step3)
  have hPP : SumSqLE (star P * P)
      (algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c00 : ℂ)) := by
    rw [hP, star_single_mul_single]
    exact SumSqLE.single_diag hc00 k00 0
  have hQQ : SumSqLE (star Q * Q)
      (algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c01 : ℂ)) := by
    rw [hQ, star_single_mul_single]
    exact SumSqLE.single_diag hc01 k01 1
  have hRR : SumSqLE (star R * R)
      (algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c10 : ℂ)) := by
    rw [hR, star_single_mul_single]
    exact SumSqLE.single_diag hc10 k10 0
  have hSS : SumSqLE (star S * S)
      (algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c11 : ℂ)) := by
    rw [hS, star_single_mul_single]
    exact SumSqLE.single_diag hc11 k11 1
  have step5 := ((hPP.nsmul 2).add (hQQ.nsmul 2)).nsmul 2
  have step6 := ((hRR.nsmul 2).add (hSS.nsmul 2)).nsmul 2
  have step7 := step4.trans (step5.add step6)
  have hval :
      (2 : ℕ) • ((2 : ℕ) • algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c00 : ℂ) +
          (2 : ℕ) • algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c01 : ℂ)) +
        (2 : ℕ) • ((2 : ℕ) • algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c10 : ℂ) +
          (2 : ℕ) • algebraMap ℂ (Matrix (Fin 2) (Fin 2) B) (c11 : ℂ))
        = algebraMap ℂ (Matrix (Fin 2) (Fin 2) B)
            (((4 * c00 + 4 * c01 + 4 * c10 + 4 * c11 : ℝ) : ℂ)) := by
    simp only [nsmul_algebraMap, ← map_add]
    congr 1
    push_cast
    ring
  rwa [hval] at step7

end MatrixBound

/-! ## 3. The dyadic stages satisfy the algebraic operator bound -/

section DyadicBound

/-- Every complex algebra whose additive structure is a semiring is in fact a
ring: the additive inverse is `(-1 : ℂ) • ·`.  The resulting `Ring` structure
has *the same* underlying `Semiring`, so it can be introduced locally in a
proof without disturbing the ambient algebraic structure. -/
noncomputable def ringOfComplexAlgebra (A : Type*) [S : Semiring A] [Algebra ℂ A] : Ring A :=
  letI : AddCommGroup A := Module.addCommMonoidToAddCommGroup ℂ
  { S, (inferInstance : AddCommGroup A) with }

theorem ringOfComplexAlgebra_toSemiring (A : Type*) [S : Semiring A] [Algebra ℂ A] :
    (ringOfComplexAlgebra A).toSemiring = S := rfl

/-- The scalar stage: `star z * z` is the scalar `normSq z`. -/
theorem complex_exists_bound (z : ℂ) :
    ∃ c : ℝ, 0 ≤ c ∧ SumSqLE (star z * z) (algebraMap ℂ ℂ (c : ℂ)) := by
  refine ⟨Complex.normSq z, Complex.normSq_nonneg z, 0, zero_mem_sumSqCone, ?_⟩
  simp [Complex.normSq_eq_conj_mul_self]

/-- **Finite-stage algebraic operator bound.**  For every element `x` of a
finite dyadic stage there is a nonnegative real `c` with
`star x * x ≼ c • 1` in the algebraic sum-of-squares order.  Proved by
induction along the matrix tower, with no analytic input. -/
theorem qubitTensorPower_exists_bound (n : ℕ) (x : QubitTensorPower n) :
    ∃ c : ℝ, 0 ≤ c ∧ SumSqLE (star x * x) (algebraMap ℂ (QubitTensorPower n) (c : ℂ)) := by
  induction n with
  | zero => exact complex_exists_bound x
  | succ n ih =>
    letI : Ring (QubitTensorPower n) := ringOfComplexAlgebra _
    exact matrix_two_exists_bound (B := QubitTensorPower n) ih x

end DyadicBound

/-! ## 4. Hermitianity and faithfulness of the dyadic traces -/

section TraceProperties

/-- The finite-stage normalized traces are hermitian. -/
theorem qubitTensorTrace_star (n : ℕ) (x : QubitTensorPower n) :
    qubitTensorTrace n (star x) = star (qubitTensorTrace n x) := by
  induction n with
  | zero =>
    show scalarTrace (star (x : ℂ)) = star (scalarTrace (x : ℂ))
    rfl
  | succ n ih =>
    show normalizedMatrixTraceOver (Fin 2) (qubitTensorTrace n)
        (star (x : Matrix (Fin 2) (Fin 2) (QubitTensorPower n))) =
      star (normalizedMatrixTraceOver (Fin 2) (qubitTensorTrace n) x)
    rw [normalizedMatrixTraceOver_apply, normalizedMatrixTraceOver_apply]
    have hentry : ∀ i : Fin 2,
        qubitTensorTrace n ((star (x : Matrix (Fin 2) (Fin 2) (QubitTensorPower n))) i i) =
          star (qubitTensorTrace n (x i i)) := by
      intro i
      rw [Matrix.star_apply, ih]
    rw [Finset.sum_congr rfl fun i _ => hentry i]
    simp [Fintype.card_fin]

/-- Faithfulness at the scalar stage. -/
theorem complex_trace_faithful (z : ℂ) (hz : scalarTrace (star z * z) = 0) : z = 0 := by
  have h : star z * z = 0 := hz
  rcases mul_eq_zero.mp h with h' | h'
  · exact star_eq_zero.mp h'
  · exact h'

/-- The finite-stage normalized traces are faithful. -/
theorem qubitTensorTrace_faithful (n : ℕ) (x : QubitTensorPower n)
    (hx : qubitTensorTrace n (star x * x) = 0) : x = 0 := by
  induction n with
  | zero => exact complex_trace_faithful x hx
  | succ n ih =>
    set X : Matrix (Fin 2) (Fin 2) (QubitTensorPower n) := x with hXdef
    have hpos : ∀ i j : Fin 2, ∃ r : ℝ, 0 ≤ r ∧
        qubitTensorTrace n (star (X j i) * X j i) = (r : ℂ) :=
      fun i j => (qubitTensorTrace_isAlgebraicTracialState n).positive (X j i)
    choose r hr_nonneg hr_val using hpos
    have hsum : ((∑ i : Fin 2, ∑ j : Fin 2, r i j : ℝ) : ℂ) = 0 := by
      have hx' : normalizedMatrixTraceOver (Fin 2) (qubitTensorTrace n) (star X * X) = 0 := hx
      rw [normalizedMatrixTraceOver_apply] at hx'
      have hmt : ∑ i : Fin 2, qubitTensorTrace n ((star X * X) i i)
          = ∑ i : Fin 2, ∑ j : Fin 2, qubitTensorTrace n (star (X j i) * X j i) :=
        matrixTraceOver_star_mul_self (Fin 2) (qubitTensorTrace n) X
      rw [hmt] at hx'
      have hne : (1 / (Fintype.card (Fin 2) : ℂ)) ≠ 0 := by
        simp [Fintype.card_fin]
      have hzero : ∑ i : Fin 2, ∑ j : Fin 2, qubitTensorTrace n (star (X j i) * X j i) = 0 :=
        (mul_eq_zero.mp hx').resolve_left hne
      rw [← hzero]
      push_cast
      exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => (hr_val i j).symm
    have hsumR : ∑ i : Fin 2, ∑ j : Fin 2, r i j = 0 := by exact_mod_cast hsum
    have hall : ∀ i j : Fin 2, r i j = 0 := by
      intro i j
      have h1 : ∀ i ∈ (Finset.univ : Finset (Fin 2)), 0 ≤ ∑ j : Fin 2, r i j :=
        fun i _ => Finset.sum_nonneg fun j _ => hr_nonneg i j
      have h2 : ∑ j : Fin 2, r i j = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg h1).mp hsumR i (Finset.mem_univ i)
      exact (Finset.sum_eq_zero_iff_of_nonneg
        (fun j _ => hr_nonneg i j)).mp h2 j (Finset.mem_univ j)
    have hentry : ∀ i j : Fin 2, X j i = 0 := by
      intro i j
      refine ih (X j i) ?_
      rw [hr_val i j, hall i j]
      simp
    show X = 0
    ext j i
    simpa using hentry i j

/-- The direct-limit trace is hermitian. -/
theorem qubitUHFTrace_star (z : QubitUHFAlgebra) :
    qubitUHFTrace (star z) = star (qubitUHFTrace z) := by
  induction z using DirectLimit.induction with
  | _ n x =>
    show qubitUHFTrace (star (DirectLimit.Module.of ℂ ℕ QubitTensorPower
        qubitTensorPowerMap n x)) = star (qubitUHFTrace
        (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x))
    rw [star_of, qubitUHFTrace_of, qubitUHFTrace_of]
    exact qubitTensorTrace_star n x

/-- The direct-limit trace is positive. -/
theorem qubitUHFTrace_positive (z : QubitUHFAlgebra) :
    ∃ r : ℝ, 0 ≤ r ∧ qubitUHFTrace (star z * z) = (r : ℂ) :=
  qubitUHFTrace_isAlgebraicTracialState.positive z

/-- The direct-limit trace is faithful. -/
theorem qubitUHFTrace_faithful (z : QubitUHFAlgebra)
    (hz : qubitUHFTrace (star z * z) = 0) : z = 0 := by
  induction z using DirectLimit.induction with
  | _ n x =>
    have hstage : (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n
        (star x * x) : QubitUHFAlgebra)
        = star (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) *
          DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x := by
      rw [star_of]
      exact map_mul (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n) (star x) x
    have hz' : qubitUHFTrace
        (star (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) *
          DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) = 0 := hz
    have hx : qubitTensorTrace n (star x * x) = 0 := by
      rw [← hstage, qubitUHFTrace_of] at hz'
      exact hz'
    have hx0 : x = 0 := qubitTensorTrace_faithful n x hx
    show (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x :
      QubitUHFAlgebra) = 0
    rw [hx0]
    exact map_zero (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n)

end TraceProperties

/-! ## 5. The trace bound for left multiplication on the algebraic limit -/

section LimitBound

/-- The direct-limit trace is nonnegative on the algebraic positive cone. -/
theorem qubitUHFTrace_nonneg_of_mem_sumSqCone {a : QubitUHFAlgebra}
    (ha : a ∈ sumSqCone QubitUHFAlgebra) :
    ∃ r : ℝ, 0 ≤ r ∧ qubitUHFTrace a = (r : ℂ) := by
  refine sumSqCone_induction
    (p := fun a => ∃ r : ℝ, 0 ≤ r ∧ qubitUHFTrace a = (r : ℂ)) ?_ ?_ ?_ ha
  · exact ⟨0, le_rfl, by simp⟩
  · intro s
    exact qubitUHFTrace_positive s
  · rintro x y ⟨r, hr, hrx⟩ ⟨t, ht, hty⟩
    exact ⟨r + t, by positivity, by rw [map_add, hrx, hty]; push_cast; ring⟩

/-- **Algebraic operator bound on the limit.**  Every element of the algebraic
UHF limit satisfies `star z * z ≼ c • 1` for some nonnegative real `c`,
inherited from the finite-stage bound. -/
theorem qubitUHF_exists_bound (z : QubitUHFAlgebra) :
    ∃ c : ℝ, 0 ≤ c ∧ SumSqLE (star z * z) (algebraMap ℂ QubitUHFAlgebra (c : ℂ)) := by
  induction z using DirectLimit.induction with
  | _ n x =>
    obtain ⟨c, hc, p, hp, hpEq⟩ := qubitTensorPower_exists_bound n x
    set φ : QubitTensorPower n →⋆ₐ[ℂ] QubitUHFAlgebra :=
      algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n with hφ
    refine ⟨c, hc, φ p, sumSqCone_map φ hp, ?_⟩
    have hz : star (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) *
        DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x
        = φ (star x * x) := by
      rw [map_mul, map_star]
      rfl
    show algebraMap ℂ QubitUHFAlgebra (c : ℂ) =
      star (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) *
        DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x + φ p
    rw [hz, ← map_add, ← hpEq]
    exact (φ.commutes (c : ℂ)).symm

/-- The trace square-norm of an element of the algebraic limit. -/
noncomputable def uhfNormSq (w : QubitUHFAlgebra) : ℝ := (qubitUHFTrace (star w * w)).re

theorem qubitUHFTrace_star_self (w : QubitUHFAlgebra) :
    qubitUHFTrace (star w * w) = (uhfNormSq w : ℂ) := by
  obtain ⟨r, _, hval⟩ := qubitUHFTrace_positive w
  rw [hval]
  simp [uhfNormSq, hval]

theorem uhfNormSq_nonneg (w : QubitUHFAlgebra) : 0 ≤ uhfNormSq w := by
  obtain ⟨r, hr, hval⟩ := qubitUHFTrace_positive w
  simpa [uhfNormSq, hval] using hr

theorem uhfNormSq_eq_zero_iff (w : QubitUHFAlgebra) : uhfNormSq w = 0 ↔ w = 0 := by
  constructor
  · intro h
    refine qubitUHFTrace_faithful w ?_
    rw [qubitUHFTrace_star_self, h]
    simp
  · rintro rfl
    simp [uhfNormSq]

/-- **The left-multiplication bound.**  If `star z * z ≼ c • 1` then left
multiplication by `z` is bounded by `c` in the trace square-norm.  This is the
purely algebraic substitute for the C*-inequality `‖z w‖₂ ≤ ‖z‖ ‖w‖₂`. -/
theorem uhfNormSq_mul_le {z : QubitUHFAlgebra} {c : ℝ}
    (hz : SumSqLE (star z * z) (algebraMap ℂ QubitUHFAlgebra (c : ℂ))) (w : QubitUHFAlgebra) :
    uhfNormSq (z * w) ≤ c * uhfNormSq w := by
  obtain ⟨p, hp, hpEq⟩ := hz
  have hconj : star w * p * w ∈ sumSqCone QubitUHFAlgebra := sumSqCone_conj hp w
  obtain ⟨t, ht, htval⟩ := qubitUHFTrace_nonneg_of_mem_sumSqCone hconj
  have hkey : (c : ℂ) • (star w * w) = star (z * w) * (z * w) + star w * p * w := by
    have h1 : star w * (algebraMap ℂ QubitUHFAlgebra (c : ℂ)) * w
        = (c : ℂ) • (star w * w) := by
      rw [Algebra.smul_def, ← mul_assoc, Algebra.commutes]
    have h2 : star w * (star z * z + p) * w
        = star (z * w) * (z * w) + star w * p * w := by
      rw [star_mul]
      noncomm_ring
    rw [← h1, hpEq, h2]
  have happly := congrArg qubitUHFTrace hkey
  rw [map_smul, map_add, qubitUHFTrace_star_self, qubitUHFTrace_star_self, htval] at happly
  have hre : c * uhfNormSq w = uhfNormSq (z * w) + t := by
    have := congrArg Complex.re happly
    simpa [Complex.ofReal_re, Complex.add_re, smul_eq_mul] using this
  have : uhfNormSq (z * w) ≤ uhfNormSq (z * w) + t := by linarith
  linarith [hre]

end LimitBound

/-! ## 6. The trace GNS pre-Hilbert space, its completion, and the
representation -/

section GNS

open scoped InnerProductSpace
open UniformSpace ContinuousLinearMap

/-- The GNS pre-Hilbert space of the algebraic dyadic limit for its canonical
normalized trace: a type synonym of `QubitUHFAlgebra` carrying the inner
product `⟪a, b⟫ = τ (star a * b)`. -/
def UHFL2 : Type := QubitUHFAlgebra

noncomputable instance : AddCommGroup UHFL2 :=
  Module.addCommMonoidToAddCommGroup (R := ℂ) (M := QubitUHFAlgebra)

noncomputable instance : Module ℂ UHFL2 := inferInstanceAs (Module ℂ QubitUHFAlgebra)

/-- The tautological linear equivalence onto the GNS pre-Hilbert space. -/
noncomputable def toL2 : QubitUHFAlgebra ≃ₗ[ℂ] UHFL2 := LinearEquiv.refl ℂ _

/-- The tautological linear equivalence out of the GNS pre-Hilbert space. -/
noncomputable def ofL2 : UHFL2 ≃ₗ[ℂ] QubitUHFAlgebra := toL2.symm

@[simp] theorem ofL2_toL2 (z : QubitUHFAlgebra) : ofL2 (toL2 z) = z := rfl
@[simp] theorem toL2_ofL2 (a : UHFL2) : toL2 (ofL2 a) = a := rfl

/-- The trace inner product on the algebraic limit. -/
noncomputable abbrev uhfL2Core : PreInnerProductSpace.Core ℂ UHFL2 where
  inner a b := qubitUHFTrace (star (ofL2 a) * ofL2 b)
  conj_inner_symm x y := by
    show (starRingEnd ℂ) (qubitUHFTrace (star (ofL2 y) * ofL2 x)) =
      qubitUHFTrace (star (ofL2 x) * ofL2 y)
    rw [← Complex.star_def, ← qubitUHFTrace_star]
    simp [star_mul]
  re_inner_nonneg x := by
    obtain ⟨r, hr, hval⟩ := qubitUHFTrace_positive (ofL2 x)
    show 0 ≤ (qubitUHFTrace (star (ofL2 x) * ofL2 x)).re
    rw [hval]
    simpa using hr
  add_left x y z := by
    show qubitUHFTrace (star (ofL2 (x + y)) * ofL2 z) =
      qubitUHFTrace (star (ofL2 x) * ofL2 z) + qubitUHFTrace (star (ofL2 y) * ofL2 z)
    simp [map_add, star_add, add_mul]
  smul_left x y r := by
    show qubitUHFTrace (star (ofL2 (r • x)) * ofL2 y) =
      (starRingEnd ℂ) r * qubitUHFTrace (star (ofL2 x) * ofL2 y)
    rw [map_smul, star_smul, smul_mul_assoc, map_smul]
    simp [smul_eq_mul]

noncomputable instance : SeminormedAddCommGroup UHFL2 :=
  InnerProductSpace.Core.toSeminormedAddCommGroup (c := uhfL2Core)

noncomputable instance : InnerProductSpace ℂ UHFL2 := InnerProductSpace.ofCore uhfL2Core

theorem uhfL2_inner_def (a b : UHFL2) :
    ⟪a, b⟫_ℂ = qubitUHFTrace (star (ofL2 a) * ofL2 b) := rfl

theorem uhfL2_norm_def (a : UHFL2) : ‖a‖ = Real.sqrt (uhfNormSq (ofL2 a)) := rfl

/-- The trace inner product is definite: the GNS seminorm of the algebraic
dyadic limit is a genuine norm. -/
theorem uhfL2_norm_eq_zero {a : UHFL2} (h : ‖a‖ = 0) : a = 0 := by
  rw [uhfL2_norm_def] at h
  have h0 : uhfNormSq (ofL2 a) = 0 :=
    (Real.sqrt_eq_zero (uhfNormSq_nonneg _)).mp h
  have := (uhfNormSq_eq_zero_iff (ofL2 a)).mp h0
  simpa using congrArg toL2 this

/-- The GNS Hilbert space of the algebraic dyadic limit: the completion of the
trace pre-Hilbert space.  It is *constructed*, not postulated, and is in
particular not an infinite tensor product. -/
abbrev UHFGNS : Type := UniformSpace.Completion UHFL2

/-- The chosen algebraic operator bound of an element of the limit. -/
noncomputable def uhfBound (z : QubitUHFAlgebra) : ℝ :=
  Classical.choose (qubitUHF_exists_bound z)

theorem uhfBound_nonneg (z : QubitUHFAlgebra) : 0 ≤ uhfBound z :=
  (Classical.choose_spec (qubitUHF_exists_bound z)).1

theorem uhfBound_spec (z : QubitUHFAlgebra) :
    SumSqLE (star z * z) (algebraMap ℂ QubitUHFAlgebra ((uhfBound z : ℝ) : ℂ)) :=
  (Classical.choose_spec (qubitUHF_exists_bound z)).2

theorem uhfNormSq_mul_le_bound (z w : QubitUHFAlgebra) :
    uhfNormSq (z * w) ≤ uhfBound z * uhfNormSq w :=
  uhfNormSq_mul_le (uhfBound_spec z) w

/-- Left multiplication on the GNS pre-Hilbert space, as a bounded operator. -/
noncomputable def uhfLeftMul (z : QubitUHFAlgebra) : UHFL2 →L[ℂ] UHFL2 :=
  LinearMap.mkContinuous
    (toL2.toLinearMap ∘ₗ LinearMap.mulLeft ℂ z ∘ₗ ofL2.toLinearMap)
    (Real.sqrt (uhfBound z))
    (by
      intro a
      have hle : uhfNormSq (z * ofL2 a) ≤ uhfBound z * uhfNormSq (ofL2 a) :=
        uhfNormSq_mul_le_bound z (ofL2 a)
      have h1 : ‖(toL2.toLinearMap ∘ₗ LinearMap.mulLeft ℂ z ∘ₗ ofL2.toLinearMap) a‖
          = Real.sqrt (uhfNormSq (z * ofL2 a)) := rfl
      have h2 : Real.sqrt (uhfBound z) * ‖a‖
          = Real.sqrt (uhfBound z * uhfNormSq (ofL2 a)) := by
        rw [uhfL2_norm_def, Real.sqrt_mul (uhfBound_nonneg z)]
      rw [h1, h2]
      exact Real.sqrt_le_sqrt hle)

@[simp] theorem uhfLeftMul_apply (z : QubitUHFAlgebra) (a : UHFL2) :
    uhfLeftMul z a = toL2 (z * ofL2 a) := rfl

set_option synthInstance.maxHeartbeats 1000000 in
set_option maxHeartbeats 1000000 in
/-- **The reference representation of the algebraic dyadic (UHF) limit** on its
trace GNS Hilbert space, by left multiplication. -/
noncomputable def uhfRep : QubitUHFAlgebra →⋆ₐ[ℂ] (UHFGNS →L[ℂ] UHFGNS) where
  toFun z := (uhfLeftMul z).completion
  map_one' := by
    ext x
    induction x using Completion.induction_on with
    | hp => apply isClosed_eq <;> fun_prop
    | ih x => simp
  map_mul' z w := by
    ext x
    induction x using Completion.induction_on with
    | hp => apply isClosed_eq <;> fun_prop
    | ih x => simp [mul_assoc]
  map_zero' := by
    ext x
    induction x using Completion.induction_on with
    | hp => apply isClosed_eq <;> fun_prop
    | ih x => simp [Completion.coe_zero]
  map_add' z w := by
    ext x
    induction x using Completion.induction_on with
    | hp => apply isClosed_eq <;> fun_prop
    | ih x => simp [add_mul, Completion.coe_add]
  commutes' r := by
    ext x
    induction x using Completion.induction_on with
    | hp => apply isClosed_eq <;> fun_prop
    | ih x =>
      simp only [ContinuousLinearMap.completion_apply_coe, uhfLeftMul_apply,
        ← Algebra.smul_def]
      simp [Algebra.algebraMap_eq_smul_one, ← Completion.coe_smul]
  map_star' z := by
    refine (eq_adjoint_iff (uhfLeftMul (star z)).completion (uhfLeftMul z).completion).mpr ?_
    intro x y
    induction x, y using Completion.induction_on₂ with
    | hp => apply isClosed_eq <;> fun_prop
    | ih x y =>
      simp only [ContinuousLinearMap.completion_apply_coe, Completion.inner_coe,
        uhfLeftMul_apply, uhfL2_inner_def, ofL2_toL2]
      rw [star_mul, star_star, mul_assoc]

@[simp] theorem uhfRep_apply_coe (z : QubitUHFAlgebra) (a : UHFL2) :
    uhfRep z (a : UHFGNS) = ((toL2 (z * ofL2 a) : UHFL2) : UHFGNS) := by
  show (uhfLeftMul z).completion (a : UHFGNS) = _
  simp

/-- The canonical cyclic vector of the reference representation. -/
noncomputable def uhfCyclicVector : UHFGNS := ((toL2 (1 : QubitUHFAlgebra) : UHFL2) : UHFGNS)

theorem uhfRep_apply_cyclicVector (z : QubitUHFAlgebra) :
    uhfRep z uhfCyclicVector = ((toL2 z : UHFL2) : UHFGNS) := by
  rw [uhfCyclicVector, uhfRep_apply_coe]
  simp

/-- The cyclic vector reproduces the canonical trace as a vector state. -/
theorem uhfRep_vector_state (z : QubitUHFAlgebra) :
    ⟪uhfCyclicVector, uhfRep z uhfCyclicVector⟫_ℂ = qubitUHFTrace z := by
  rw [uhfRep_apply_cyclicVector, uhfCyclicVector, Completion.inner_coe, uhfL2_inner_def]
  simp

/-- The cyclic vector is a unit vector, because the trace is normalized. -/
theorem uhfCyclicVector_norm : ‖uhfCyclicVector‖ = 1 := by
  have h : ‖uhfCyclicVector‖ = ‖(toL2 (1 : QubitUHFAlgebra) : UHFL2)‖ :=
    Completion.norm_coe _
  rw [h, uhfL2_norm_def]
  have h1 : uhfNormSq (1 : QubitUHFAlgebra) = 1 := by
    have hval : qubitUHFTrace (star (1 : QubitUHFAlgebra) * 1) = 1 := by
      simpa using qubitUHFTrace_isAlgebraicTracialState.map_one
    have := qubitUHFTrace_star_self (1 : QubitUHFAlgebra)
    rw [hval] at this
    exact_mod_cast this.symm
  simp [h1]

/-- The canonical map of the pre-Hilbert space into its completion is
injective, because the trace inner product is definite. -/
theorem uhfL2_coe_injective : Function.Injective (fun a : UHFL2 => (a : UHFGNS)) := by
  intro a b hab
  have hab' : (a : UHFGNS) = (b : UHFGNS) := hab
  have hnorm : ‖a - b‖ = 0 := by
    have : ((a - b : UHFL2) : UHFGNS) = 0 := by
      rw [Completion.coe_sub, hab', sub_self]
    calc ‖a - b‖ = ‖((a - b : UHFL2) : UHFGNS)‖ := (Completion.norm_coe _).symm
      _ = 0 := by rw [this, norm_zero]
  have := uhfL2_norm_eq_zero hnorm
  exact sub_eq_zero.mp this

/-- **Faithfulness of the reference representation.** -/
theorem uhfRep_injective : Function.Injective uhfRep := by
  intro z w hzw
  have h := congrArg (fun T : UHFGNS →L[ℂ] UHFGNS => T uhfCyclicVector) hzw
  simp only [uhfRep_apply_cyclicVector] at h
  have := uhfL2_coe_injective h
  simpa using congrArg ofL2 this

end GNS

/-! ## 7. Compatible finite-stage representations and faithfulness -/

section FiniteStages

open UniformSpace

/-- A complex-linear map with trivial kernel is injective (the complex module
structure supplies the additive inverses that a semiring stage does not carry
on its own). -/
theorem injective_of_map_eq_zero {A B : Type*} [AddCommMonoid A] [Module ℂ A]
    [AddCommMonoid B] [Module ℂ B] (φ : A →ₗ[ℂ] B) (h : ∀ x, φ x = 0 → x = 0) :
    Function.Injective φ := by
  letI : AddCommGroup A := Module.addCommMonoidToAddCommGroup ℂ
  letI : AddCommGroup B := Module.addCommMonoidToAddCommGroup ℂ
  intro x y hxy
  have h1 : φ (x - y) = 0 := by rw [map_sub, hxy, sub_self]
  exact sub_eq_zero.mp (h _ h1)

/-- The canonical stage maps into the algebraic dyadic limit are injective. -/
theorem qubitStage_injective (n : ℕ) :
    Function.Injective (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n) := by
  refine injective_of_map_eq_zero
    (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n).toLinearMap ?_
  intro x hx
  have hx' : (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x :
      QubitUHFAlgebra) = 0 := hx
  refine qubitTensorTrace_faithful n x ?_
  have hstage : (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n
      (star x * x) : QubitUHFAlgebra)
      = star (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x) *
        DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n x := by
    rw [star_of]
    exact map_mul (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n) (star x) x
  have h0 : qubitUHFTrace (DirectLimit.Module.of ℂ ℕ QubitTensorPower qubitTensorPowerMap n
      (star x * x)) = 0 := by
    rw [hstage, hx', mul_zero, map_zero]
  rw [qubitUHFTrace_of] at h0
  exact h0

/-- The finite-stage representation of the `n`-qubit dyadic stage on the GNS
Hilbert space of the algebraic limit. -/
noncomputable def uhfStageRep (n : ℕ) : QubitTensorPower n →⋆ₐ[ℂ] (UHFGNS →L[ℂ] UHFGNS) :=
  uhfRep.comp (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n)

/-- The canonical stage maps are compatible with the dyadic inclusions. -/
theorem qubitStage_compat (n m : ℕ) (h : n ≤ m) (x : QubitTensorPower n) :
    algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) m (qubitTensorPowerMap n m h x)
      = algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) n x :=
  DirectLimit.Ring.of_f (G := QubitTensorPower) (f := qubitTensorPowerMap) h x

/-- The finite-stage representations are compatible with the dyadic
inclusions. -/
theorem uhfStageRep_compat (n m : ℕ) (h : n ≤ m) (x : QubitTensorPower n) :
    uhfStageRep m (qubitTensorPowerMap n m h x) = uhfStageRep n x := by
  show uhfRep (algebraicLimitStageStarAlgHom (f := qubitTensorPowerMap) m
      (qubitTensorPowerMap n m h x)) = uhfRep _
  rw [qubitStage_compat]
  rfl

/-- Every finite-stage representation is injective. -/
theorem uhfStageRep_injective (n : ℕ) : Function.Injective (uhfStageRep n) :=
  uhfRep_injective.comp (qubitStage_injective n)

/-- **The constructed compatible finite-stage representation data.**  This
instantiates the (previously only conditional) interface
`QubitOperatorRepresentationData` with an actual Hilbert space and actual
finite-stage representations: nothing here is supplied input. -/
noncomputable def uhfRepData : QubitOperatorRepresentationData UHFGNS where
  rho := uhfStageRep
  compat := uhfStageRep_compat

@[simp] theorem uhfRepData_rho (n : ℕ) : uhfRepData.rho n = uhfStageRep n := rfl

/-- Each stage representation of the constructed data is injective. -/
theorem uhfRepData_rho_injective (n : ℕ) : Function.Injective (uhfRepData.rho n) :=
  uhfStageRep_injective n

/-- The limit representation induced by the constructed finite-stage data is
the trace-GNS representation `uhfRep`. -/
theorem uhfRepData_limitRep : uhfRepData.limitRep = uhfRep :=
  (uhfRepData.limitRep_unique uhfRep (fun _ _ => rfl)).symm

/-- **Faithfulness of the induced limit representation.** -/
theorem uhfRepData_limitRep_injective : Function.Injective uhfRepData.limitRep := by
  rw [uhfRepData_limitRep]
  exact uhfRep_injective

end FiniteStages

/-! ## 8. The concrete C*-algebra generated by the reference representation -/

section ConcreteCStar

/-- The concrete C*-algebra of the reference representation: the closure of the
operator range of `uhfRep` inside the bounded operators on the GNS Hilbert
space.  This is a genuine C*-algebra, obtained without postulating any
completion. -/
noncomputable def UHFConcreteCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS) :=
  uhfRep.range.topologicalClosure

instance : IsClosed ((UHFConcreteCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS)) :
    Set (UHFGNS →L[ℂ] UHFGNS)) :=
  uhfRep.range.isClosed_topologicalClosure

noncomputable instance : CStarAlgebra UHFConcreteCStar := StarSubalgebra.cstarAlgebra _

theorem uhfRep_mem_concreteCStar (z : QubitUHFAlgebra) : uhfRep z ∈ UHFConcreteCStar :=
  uhfRep.range.le_topologicalClosure ⟨z, rfl⟩

/-- The canonical star-algebra homomorphism of the algebraic dyadic limit into
its concrete C*-model. -/
noncomputable def uhfConcreteEmbedding : QubitUHFAlgebra →⋆ₐ[ℂ] UHFConcreteCStar :=
  uhfRep.codRestrict UHFConcreteCStar uhfRep_mem_concreteCStar

@[simp] theorem coe_uhfConcreteEmbedding (z : QubitUHFAlgebra) :
    (uhfConcreteEmbedding z : UHFGNS →L[ℂ] UHFGNS) = uhfRep z := rfl

theorem uhfConcreteEmbedding_injective : Function.Injective uhfConcreteEmbedding := by
  intro z w h
  exact uhfRep_injective (congrArg Subtype.val h)

/-- The image of the algebraic dyadic limit is dense in its concrete
C*-model. -/
theorem uhfConcreteEmbedding_denseRange : DenseRange uhfConcreteEmbedding := by
  have hcoe : ((UHFConcreteCStar : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS)) :
      Set (UHFGNS →L[ℂ] UHFGNS)) = closure (Set.range ⇑uhfRep) := by
    rw [UHFConcreteCStar, StarSubalgebra.topologicalClosure_coe]
    rfl
  rw [DenseRange, Subtype.dense_iff]
  intro x hx
  rw [hcoe] at hx
  refine closure_mono ?_ hx
  rintro _ ⟨z, rfl⟩
  exact ⟨uhfConcreteEmbedding z, ⟨z, rfl⟩, rfl⟩

/-- Minimality of the concrete C*-model. -/
theorem uhfConcreteCStar_le {S : StarSubalgebra ℂ (UHFGNS →L[ℂ] UHFGNS)}
    (hS : IsClosed (S : Set (UHFGNS →L[ℂ] UHFGNS))) (hrange : ∀ z, uhfRep z ∈ S) :
    UHFConcreteCStar ≤ S :=
  StarSubalgebra.topologicalClosure_minimal (by rintro _ ⟨z, rfl⟩; exact hrange z) hS

end ConcreteCStar

end StabilizerHyperfinite
